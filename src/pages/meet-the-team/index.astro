---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import ProviderCard from '../../components/shared/ProviderCard.astro';
import elainaPhoto from '../../assets/staff/elaina-gleason.jpg';

const allProviders = await getCollection('providers');
const allTeam = await getCollection('team');

const members = [
  ...allProviders,
  ...allTeam,
].sort((a, b) => a.data.displayOrder - b.data.displayOrder);

// Practice-wide staff card (no bio page, no route, no JSON-LD) — rendered as a
// non-linked card immediately after Ritamarie Smedile.
const elaina = {
  collection: 'team',
  data: {
    name: 'Elaina Gleason',
    credentials: '',
    title: 'Practice Manager',
    photo: elainaPhoto,
    photoAlt: 'Elaina Gleason — Practice Manager, Forward Family Medicine',
    descriptor: 'Keeps Forward Family Medicine running smoothly across all three locations.',
    slug: '',
  },
} as any;

const ritamarieIdx = members.findIndex(m => m.data.slug === 'ritamarie-smedile');
members.splice(ritamarieIdx + 1, 0, elaina);

const siteUrl = 'https://www.forwardfamilymedicine.com';
const canonicalUrl = `${siteUrl}/meet-the-team/`;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Meet the Team", "item": canonicalUrl },
  ],
};
---

<MainLayout
  title="Meet the Team | Forward Family Medicine Wayne PA"
  description="Meet the physicians and wellness team at Forward Family Medicine — Dr. David Bigley, Dr. Philip Lieberman, Dr. Brian Landi, and Ritamarie Smedile. Direct Primary Care on the Main Line and in Chester County."
  canonical={canonicalUrl}
  schema={breadcrumb}
>
  <section class="providers-hero section" style="background: linear-gradient(160deg, var(--green-50) 0%, var(--cream-100) 100%);">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <span>Meet the Team</span>
      </nav>
      <span class="section-label">Our Team</span>
      <h1>Meet the Team</h1>
      <div class="divider"></div>
      <p class="section-intro">
        Forward Family Medicine is built around relationships. Our physicians keep small panels —
        about 250 patients each — so they can actually know you, not just your chart. They're
        supported by a wellness team that brings depth to the care you receive.
      </p>
    </div>
  </section>

  <section class="providers-grid-section section" style="background: var(--cream-100);">
    <div class="container">
      <div class="providers-grid">
        {members.map(m => <ProviderCard provider={m} noLink={!m.data.slug} />)}
      </div>
    </div>
  </section>

  <section class="providers-cta-section section" style="background: var(--green-50); padding-top: 3rem; padding-bottom: 3rem;">
    <div class="container" style="text-align:center; max-width:600px;">
      <h2 style="font-size:clamp(1.4rem, 3vw, 2rem); margin-bottom:1rem;">Ready to find your physician?</h2>
      <p style="color:var(--ink-500); margin-bottom:1.5rem;">
        Schedule a free, no-pressure Meet &amp; Greet to find the right fit.
      </p>
      <a href="/contact" class="btn btn-accent">Schedule a Free Meet &amp; Greet →</a>
    </div>
  </section>
</MainLayout>

<style>
  .breadcrumb { font-size: 0.85rem; color: var(--ink-300); margin-bottom: 1.5rem; display: flex; align-items: center; gap: 0.4rem; }
  .breadcrumb a { color: var(--green-300); text-decoration: none; }
  .breadcrumb a:hover { color: var(--green-400); }
  .divider { width: 48px; height: 3px; background: var(--green-300); border-radius: 2px; margin: 1.25rem 0; }

  .providers-grid { display: flex; flex-wrap: wrap; justify-content: center; gap: 2rem; margin-top: 1rem; }
</style>
