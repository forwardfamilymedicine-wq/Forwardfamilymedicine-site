---
/**
 * Meet the Team, per the Team board. The members are whoever the providers and
 * team collections hold, in displayOrder, exactly as before; copy is the live
 * page's. The board's second closing-band button ("See our locations") is
 * board-only and not built.
 */
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import ProviderCard from '../../components/shared/ProviderCard.astro';
import CTABanner from '../../components/shared/CTABanner.astro';
import { openOfficeName } from '../../utils/credentialRows';

const allProviders = await getCollection('providers');
const allTeam = await getCollection('team');
const allLocations = await getCollection('locations');

const members = [
  ...allProviders,
  ...allTeam,
].sort((a, b) => a.data.displayOrder - b.data.displayOrder);

const siteUrl = 'https://www.forwardfamilymedicine.com';
const canonicalUrl = `${siteUrl}/meet-the-team/`;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Meet the Team", "item": canonicalUrl },
  ],
};
---

<MainLayout
  title="Meet the Team | Forward Family Medicine Wayne PA"
  description="Meet the team at Forward Family Medicine — Dr. Philip Lieberman, Dr. Brian Landi, and founder Dr. David Bigley. Direct Primary Care on the Main Line and in Chester County."
  canonical={canonicalUrl}
  schema={breadcrumb}
>
  <PageHero crumb="Meet the Team" title="Meet the Team" pt={88} pb={0} maxW={720} lede={17}>
    <p>
      Forward Family Medicine is built around relationships. Our physicians keep small panels —
      about 250 patients each — so they can actually know you, not just your chart. They're
      supported by a wellness team that brings depth to the care you receive.
    </p>
  </PageHero>

  <section class="team-sec">
    <div class="rd-wrap">
      <div class="team-grid" data-reveal="0.1">
        {members.map((m, i) => (
          <ProviderCard
            provider={m}
            as="h2"
            noLink={!m.data.slug}
            priority={i === 0}
            office={m.collection === 'providers' ? openOfficeName(m.data, allLocations) : undefined}
          />
        ))}
      </div>
    </div>
  </section>

  <CTABanner
    headline="Ready to find your physician?"
    subhead="Schedule a free, no-pressure Meet & Greet to find the right fit."
    btnText="Schedule a Free Meet & Greet →"
    btnHref="/contact/"
    ch={16}
  />
</MainLayout>

<style>
  .team-sec { background: var(--linen); padding: 64px 0 96px; }
  .team-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 48px; }
  .team-grid :global(.pcard) {
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .team-grid.on :global(.pcard) { opacity: 1; transform: none; }
  .team-grid.on :global(.pcard:nth-child(2)) { transition-delay: 0.2s; }
  .team-grid.on :global(.pcard:nth-child(3)) { transition-delay: 0.4s; }
  .team-grid.on :global(.pcard:nth-child(4)) { transition-delay: 0.6s; }
  @media (max-width: 860px) {
    .team-sec { padding: 40px 0 64px; }
    .team-grid { grid-template-columns: 1fr; gap: 44px; }
  }
</style>
