---
/**
 * Physician and team profiles, per the Bio boards: one template, four
 * instances. Portrait and status beside the name, role, specialties and a
 * ruled list of credentials; "About" with the bio; "Education & Training" as
 * a path timeline beside the details list and a sage card; patient reviews;
 * the closing band. Everything is read from the providers and team
 * collections; the only page-level copy is live text reused from elsewhere
 * on the site (noted inline).
 *
 * Dr. Bigley (panel full): "Panel currently full", his notice, and "Meet All
 * Providers" in place of a scheduling CTA, here and in the closing band.
 * Ashley: no timeline, details, card or reviews; her non-clinical notice is
 * dropped (approved removal).
 */
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import PathTimeline from '../../components/shared/PathTimeline.astro';
import QuotePair from '../../components/shared/QuotePair.astro';
import GoogleReviewsLink from '../../components/shared/GoogleReviewsLink.astro';
import CTABanner from '../../components/shared/CTABanner.astro';
import reviewsData from '../../data/reviews.json';
import { getAvailability } from '../../utils/availability';
import { isPlanned } from '../../utils/physicianRouting';
import { contactHrefForPath } from '../../utils/leadSource';
import { ORG_ID } from '../../utils/practiceSchema';
import { physicianNode, headshotUrl, awardLabel, HEADSHOT } from '../../utils/physicianSchema';

// Verified Google reviews, keyed by provider slug. Verbatim, never reworded.
// Lieberman's M.M. and P.M. reviews are also used on lifestyle-medicine.astro
// (and the homepage carries D.B., M.M. and P.M. too) — that overlap is
// intentional here, not an oversight: his bio should stand on its own with
// real proof rather than none. Landi's second review (I.B.) is the verified
// text in src/data/reviews.json.
const REVIEWS: Record<string, { quote: string; author: string }[]> = {
  'philip-lieberman-md': [
    {
      quote: "Dr. Lieberman is the way a doctor should be. He spent significant amount of time with me, not only around my concerns about a stroke, but also my mental and nutritional well-being. He took the time to answer my questions and to perform tests that were created to address my specific concerns and he gave me the answers that I simply was not able to get anywhere else. As a Hospice chaplain who works with numerous doctors and nurses, I can honestly say I've never seen anything like this. I wish I switched sooner.",
      author: 'M.M.',
    },
    {
      quote: "I was so happy that I found a Doctor who listens. He was so tuned in and prepared for my appointments. He is incredibly kind and compassionate. I am just coming off major open heart surgery, he has excellent knowledge not only the body but tremendous in nutrition. I could not be happier.",
      author: 'P.M.',
    },
  ],
  'brian-landi-do': [
    {
      quote: "I've been a patient of Dr. Landi's for sometime now and I'm excited that he's transitioning to direct primary care! He always takes time to listen and thoroughly explain treatment options and provide truly personalized care! If you're looking for a family medicine doctor who focuses on preventative care, wellness and building long-term relationships, I highly recommend Dr. Landi.",
      author: 'E.G.',
    },
    ...reviewsData.filter(r => r.who === 'I.B.').map(r => ({ quote: r.text, author: r.who })),
  ],
  'david-bigley-do': [
    {
      quote: "Dr Bigley sat and spoke with me for an hour and 45 minutes, getting to know me as a whole person. I felt so comfortable with him that I was totally honest in a way in which I usually do not feel comfortable with other physicians. This is a very rare person. You can tell he cares and will be dedicated to help you.",
      author: 'A.K.',
    },
    {
      quote: "I'm 81 years young with a couple medical issues. But Dr Bigley brings back memories from my childhood — house calls! He takes the time to listen and amazingly, his first recommendation does not include a prescription pad. And the phone answers and the next appointment available is not next month.",
      author: 'J.O.',
    },
  ],
};

// The sage card beside the details: live copy from elsewhere on the site.
// Lieberman: the footer tagline and the homepage Lifestyle Medicine link.
// Landi: the Lifestyle Medicine page's menopause note. Bigley: the homepage
// founder paragraph on why the panel is full.
const CARD: Record<string, { html: string; link?: { href: string; label: string } }> = {
  'philip-lieberman-md': {
    html: "The Main Line's only Direct Primary Care practice with in-person, board-certified Lifestyle Medicine.",
    link: { href: '/lifestyle-medicine/', label: 'Learn About Our Lifestyle Medicine Approach →' },
  },
  'brian-landi-do': {
    html: 'Navigating perimenopause or menopause? Dr. Landi at our Malvern location offers comprehensive, Menopause Society Certified care — see our <a href="/menopause/">Menopause Care page</a> for details.',
  },
  'david-bigley-do': {
    html: 'Every physician here practices with a deliberate cap on panel size, because the time, the direct access, and the continuity this practice is built on are only possible when a doctor has room for them. A full panel is that commitment kept.',
  },
};

// Approved wording for a DO board-certified in Family Medicine. Dr. Lieberman's
// board lines are already in his additionalCertifications as written.
const DO_BOARD_LINE = 'Board Certified, American Osteopathic Board of Family Physicians';

export async function getStaticPaths() {
  const providers = await getCollection('providers');
  const team = await getCollection('team');
  return [
    ...providers.map(entry => ({
      params: { slug: entry.data.slug },
      props: { entry, type: 'physician' as const },
    })),
    ...team.map(entry => ({
      params: { slug: entry.data.slug },
      props: { entry, type: 'team' as const },
    })),
  ];
}

const { entry, type } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const d = data as any;
const isPhysician = type === 'physician';
// Availability is derived once, in src/utils/availability.ts. Null for team members,
// who use the separate acceptingNewClients flag handled further down.
const availability = isPhysician ? getAvailability(d) : null;

const siteUrl = 'https://www.forwardfamilymedicine.com';
const canonicalUrl = `${siteUrl}/meet-the-team/${d.slug}/`;
const credentialedName = `${d.name}, ${d.credentials}`;
const pageTitle = `${credentialedName} | Forward Family Medicine`;
const lastName = d.name.trim().split(/\s+/).pop();

const cityMap: Record<string, string> = {
  'wayne': 'Wayne, PA',
  'west-chester': 'West Chester, PA',
  'malvern': 'Malvern, PA',
};
// A planned office (coming soon, no opening date) is not somewhere anyone
// practises. The provider's `locations` list keeps it, because that list also
// feeds physicianRouting; this page leaves it out of both the description and
// "Practices at".
const allLocations = await getCollection('locations');
const plannedSlugs = new Set(allLocations.filter(isPlanned).map(l => l.data.slug));
const locationSlugs: string[] = d.locations || ['wayne'];
const sidebarLocations = (d.locations ?? [])
  .filter((slug: string) => !plannedSlugs.has(slug))
  .map((slug: string) => allLocations.find(l => l.data.slug === slug))
  .filter(Boolean)
  .sort((a: any, b: any) => a.data.displayOrder - b.data.displayOrder);
const cityNames = locationSlugs.filter((s: string) => !plannedSlugs.has(s)).map((s: string) => cityMap[s] || s);
const cityString = cityNames.length <= 1
  ? cityNames[0] ?? ''
  : cityNames.length === 2
    ? `${cityNames[0]} and ${cityNames[1]}`
    : `${cityNames.slice(0, -1).join(', ')}, and ${cityNames[cityNames.length - 1]}`;
const inCities = cityString ? ` in ${cityString}` : '';
// The open office named in the status line and the timeline's last step.
const officeName: string | undefined = sidebarLocations.find((l: any) => l.data.status === 'open')?.data.name;

// Physician awards, labelled by awardLabel ("Organization Name, Year"). The
// wording is the award's own and must not be paraphrased.
const awards: any[] = isPhysician ? (d.awards ?? []) : [];

const pageDescription = isPhysician
  ? `Meet ${credentialedName}, ${d.title} at Forward Family Medicine${inCities}. ${d.boardStatus === 'board-certified' ? 'Board-certified' : 'Board-eligible'} in ${d.boardSpecialties.join(' and ')}.`
  : `Meet ${credentialedName}, ${d.title} at Forward Family Medicine${inCities}.`;

// A physician's node comes from utils/physicianSchema.ts. A team member is a
// Person; the team collection keeps their job title in `credentials` and a
// location line in `title`, so the job title is `credentials`.
const memberSchema = isPhysician ? await physicianNode(entry as any) : {
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${canonicalUrl}#person`,
  "name": d.name,
  "jobTitle": d.credentials,
  "image": d.photo ? await headshotUrl(d.photo) : undefined,
  "knowsAbout": d.specialties,
  "url": canonicalUrl,
  "worksFor": { "@id": ORG_ID },
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Meet the Team", "item": `${siteUrl}/meet-the-team/` },
    { "@type": "ListItem", "position": 3, "name": credentialedName, "item": canonicalUrl },
  ],
};

// Status: the live wording from the previous banner, with the office added.
const statusText = !availability ? null
  : availability.status === 'full' ? 'Panel currently full'
  : availability.status === 'future' ? `Accepting patients starting ${availability.startLabel}`
  : 'Now accepting new patients';
const statusLine = statusText && availability?.status === 'accepting' && officeName ? `${statusText} · ${officeName}` : statusText;

// Hero credential rows: board certification, then the named certifications,
// then awards. Team members list their notable experience.
const credentialRows: string[] = isPhysician
  ? [
      ...(d.boardStatus === 'board-certified'
        ? (d.credentials === 'DO' && d.boardSpecialties.includes('Family Medicine') ? [DO_BOARD_LINE] : [])
        : [`Board-Eligible: ${d.boardSpecialties.join(', ')}`]),
      ...d.additionalCertifications.map((c: any) => c.name),
    ]
  : (d.notableExperience ?? []).map((x: any) => x.label);

// Education & Training as a path: degrees and residency as today's sidebar
// labelled them, notable experience, then the practice as the current step.
const eduTitle = (e: any) => {
  const base = e.degree ? (e.field ? `${e.degree} — ${e.field}` : e.degree) : e.residency ? `${e.residency} Residency` : '';
  return e.year ? `${base}, ${e.year}` : base;
};
// A notable-experience step with `beforeStep` sits ahead of the education step with that title;
// one with `inTimeline: false` is a plain line under the timeline instead of a step.
const eduSteps: { title: string; body?: string }[] = isPhysician
  ? (d.education ?? []).map((e: any) => ({ title: eduTitle(e), body: e.institution || undefined }))
  : [];
const laterSteps: { title: string; body?: string }[] = [];
for (const x of isPhysician ? (d.notableExperience ?? []) : []) {
  if (x.inTimeline === false) continue;
  const step = { title: x.label, body: x.description || undefined };
  const at = x.beforeStep ? eduSteps.findIndex(s => s.title === x.beforeStep) : -1;
  if (at >= 0) eduSteps.splice(at, 0, step); else laterSteps.push(step);
}
const steps = isPhysician
  ? [...eduSteps, ...laterSteps, { title: 'Forward Family Medicine', body: [officeName, statusText].filter(Boolean).join('. ') }]
  : [];
const timelineNotes: string[] = isPhysician ? (d.notableExperience ?? []).filter((x: any) => x.inTimeline === false).map((x: any) => x.label) : [];
// A certification whose name already carries its issuing body is printed once.
const certLine = (c: any) => c.name.toLowerCase().includes(c.organization.toLowerCase()) ? c.name : `${c.name}, ${c.organization}`;

const card = isPhysician ? CARD[d.slug] : undefined;
const contactHref = contactHrefForPath(`/meet-the-team/${d.slug}/`);
const joinHref = `/contact/?subject=${encodeURIComponent(`Join Dr. ${lastName}'s Patient List`)}`;
const reviews = REVIEWS[d.slug] ?? [];
const quotes = reviews.map(r => ({ text: r.quote, who: r.author, attribution: '— Verified Google review' }));

// Closing band. Accepting physicians: the shared band copy with their lead
// source. Dr. Bigley and team members: "Ready to find your physician?" from the
// team page, with "Meet All Providers" and no scheduling CTA for Dr. Bigley.
const closing = isPhysician && availability?.status !== 'full'
  ? { btnText: 'Schedule a Meet & Greet', btnHref: availability?.status === 'future' ? joinHref : contactHref, btn2Text: 'Meet All Providers', btn2Href: '/meet-the-team/' }
  : isPhysician
    ? { headline: 'Ready to find your physician?', subhead: availability?.note ?? "Schedule a free, no-pressure Meet & Greet to find the right fit.", btnText: 'Meet All Providers', btnHref: '/meet-the-team/' }
    : { headline: 'Ready to find your physician?', subhead: 'Schedule a free, no-pressure Meet & Greet to find the right fit.', btnText: 'Meet All Providers', btnHref: '/meet-the-team/', btn2Text: 'Schedule a Free Meet & Greet →', btn2Href: '/contact/' };
---

<MainLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl} schema={[memberSchema, breadcrumb]}>

  <section class="bio-hero">
    <div class="rd-wrap">
      <nav class="rd-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span>
        <a href="/meet-the-team/">Meet the Team</a> <span aria-hidden="true">›</span>
        <span aria-current="page">{credentialedName}</span>
      </nav>

      <div class="bio-hero__grid">
        <div class="bio-hero__photo">
          {d.photo ? (
            <Image src={d.photo} alt={d.photoAlt || credentialedName} {...HEADSHOT} widths={[480, 720, 960]} sizes="(max-width: 860px) calc(100vw - 40px), 480px" loading="eager" fetchpriority="high" class="bio-headshot" />
          ) : (
            <div class="bio-headshot bio-headshot--placeholder" role="img" aria-label="Photo coming soon">
              <span>Photo coming soon</span>
            </div>
          )}
        </div>

        <div class="bio-hero__info">
          {isPhysician && statusLine && (
            <p class:list={['rd-eyebrow', availability?.status === 'full' ? 'bio-status--full' : 'rd-eyebrow--gold']}>{statusLine}</p>
          )}
          {!isPhysician && d.title && <p class="rd-eyebrow">{d.title}</p>}
          <h1 class:list={['rd-h1', 'bio-h1', { 'bio-h1--long': credentialedName.length > 18 }]}>{isPhysician ? credentialedName : d.name}</h1>
          <p class="bio-role">{isPhysician ? d.title : d.credentials}</p>
          {d.specialties?.length > 0 && <p class="bio-specs">{d.specialties.join(' · ')}</p>}
          {!isPhysician && sidebarLocations.length > 0 && (
            <p class="bio-specs">Practices at {sidebarLocations.map((l: any, i: number) => (
              <Fragment>{i > 0 && ' · '}<a href={`/locations/${l.data.slug}/`}>{l.data.name}</a></Fragment>
            ))}</p>
          )}

          {(credentialRows.length > 0 || awards.length > 0) && (
            <ul class="bio-creds">
              {credentialRows.map(row => <li>{row}</li>)}
              {awards.map((a: any) => (
                <li class="bio-creds__award">
                  {a.image && (
                    <Image
                      src={a.image}
                      alt={a.imageAlt || awardLabel(a)}
                      width={96}
                      widths={[48, 96, 144]}
                      sizes="48px"
                      format="webp"
                      quality={90}
                      loading="lazy"
                      class="bio-creds__badge"
                    />
                  )}
                  <span>{awardLabel(a)}</span>
                </li>
              ))}
            </ul>
          )}

          {availability && availability.status === 'accepting' && (
            <div class="bio-hero__actions">
              <a href={contactHref} class="btn-forest">Schedule a Free Meet &amp; Greet →</a>
            </div>
          )}
          {availability && availability.status === 'future' && (
            <Fragment>
              {availability.note && <p class="bio-notice">{availability.note}</p>}
              <div class="bio-hero__actions">
                <a href={joinHref} class="btn-forest">Join Dr. {lastName}'s Patient List →</a>
              </div>
            </Fragment>
          )}
          {availability && availability.status === 'full' && (
            <Fragment>
              {availability.note && <p class="bio-notice">{availability.note}</p>}
              <div class="bio-hero__actions">
                <a href="/meet-the-team/" class="btn-forest">Meet All Providers</a>
              </div>
            </Fragment>
          )}
          {!isPhysician && d.acceptingNewClients !== undefined && (
            <Fragment>
              {!d.acceptingNewClients && <p class="bio-notice"><strong>Not currently accepting new clients</strong>{d.acceptingNewClientsNote && <Fragment> {d.acceptingNewClientsNote}</Fragment>}</p>}
              <div class="bio-hero__actions">
                {d.acceptingNewClients
                  ? <a href="/contact/" class="btn-forest">Contact Us</a>
                  : <a href="/meet-the-team/" class="btn-forest">Meet All Providers</a>}
              </div>
            </Fragment>
          )}
        </div>
      </div>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--b">
      <h2 class="rd-h2 rd-sticky">About {isPhysician ? `Dr. ${lastName}` : d.name.split(' ')[0]}</h2>
      <div class="bio-prose">
        <Content />
      </div>
    </div>
  </section>

  {isPhysician && (
    <section class="rd-section">
      <div class="rd-wrap rd-split rd-split--eq bio-facts">
        <div class="rd-stack">
          <h2 class="rd-h2">Education &amp; Training</h2>
          <PathTimeline steps={steps} variant="profile" />
          {timelineNotes.map(n => <p class="bio-note">{n}</p>)}
        </div>
        <div class="bio-facts__side">
          <div class="rd-stack">
            <h2 class="rd-h2">Details</h2>
            <dl class="bio-dl">
              {sidebarLocations.length > 0 && (
                <div class="bio-dl__row">
                  <dt>Practices at</dt>
                  <dd>
                    {sidebarLocations.map((l: any) => (
                      <span class="bio-dl__line">
                        <a href={`/locations/${l.data.slug}/`}>{l.data.name}</a><br />
                        <span class="bio-dl__muted">{[l.data.addressStreet, `${l.data.addressCity}, ${l.data.addressState} ${l.data.addressZip}`].filter(Boolean).join(', ')}</span>
                      </span>
                    ))}
                  </dd>
                </div>
              )}
              {d.additionalCertifications?.length > 0 && (
                <div class="bio-dl__row">
                  <dt>Certifications</dt>
                  <dd>{d.additionalCertifications.map((c: any) => <span class="bio-dl__line">{certLine(c)}</span>)}</dd>
                </div>
              )}
              {awards.length > 0 && (
                <div class="bio-dl__row">
                  <dt>Awards</dt>
                  <dd>{awards.map((a: any) => <span class="bio-dl__line">{a.name}, {a.organization}, {a.year}</span>)}</dd>
                </div>
              )}
              {d.npi && (
                <div class="bio-dl__row">
                  <dt>NPI Number</dt>
                  <dd>{d.npi}</dd>
                </div>
              )}
            </dl>
          </div>
          {card && (
            <div class="bio-card">
              <p class="bio-card__text rd-serif" set:html={card.html}></p>
              {card.link && <a class="rd-link" href={card.link.href}>{card.link.label}</a>}
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  {quotes.length > 0 && (
    <section class="rd-section rd-alt" aria-label="Patient reviews">
      <div class="rd-wrap">
        <div class="bio-rev__head">
          <h2 class="rd-h2">What patients say</h2>
          <GoogleReviewsLink align="end" />
        </div>
        <div class="bio-rev__quotes"><QuotePair quotes={quotes} /></div>
      </div>
    </section>
  )}

  <CTABanner {...closing} ch={16} />
</MainLayout>

<style>
  .bio-hero { background: var(--linen); padding: 72px 0 88px; }
  .bio-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: 72px;
    align-items: start;
  }
  .bio-hero :global(.bio-headshot) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 2px;
    background: var(--linen-300);
  }
  .bio-headshot--placeholder { display: flex; align-items: center; justify-content: center; color: var(--text-600); font-size: 13px; }
  .bio-hero__info { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; padding-top: 8px; }
  .bio-hero__info > p { margin: 0; }
  .bio-status--full { color: var(--text-600); }
  .bio-h1 { font-size: 64px; }
  .bio-h1--long { font-size: 56px; line-height: 1.04; }
  .bio-role { font-size: 18px; font-weight: 500; color: var(--sage-600); }
  .bio-specs { font-size: 14px; color: var(--text-600); }
  .bio-note { margin: 0; font-size: 15px; line-height: 1.5; color: var(--forest); }
  .bio-specs a { color: var(--sage-600); text-decoration: none; }
  .bio-specs a:hover { color: var(--forest); }
  .bio-creds { list-style: none; margin: 8px 0 0; padding: 0; width: 100%; display: flex; flex-direction: column; font-size: 15px; line-height: 1.5; color: var(--forest); }
  .bio-creds li { padding: 12px 0; border-top: 1px solid var(--hairline-strong); }
  .bio-creds li:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .bio-creds__award { display: flex; align-items: center; gap: 12px; }
  .bio-creds :global(.bio-creds__badge) { width: 48px; height: auto; flex-shrink: 0; }
  .bio-notice {
    width: 100%;
    margin: 10px 0 0 !important;
    padding: 18px 22px;
    background: var(--sage-50);
    border-top: 2px solid var(--sage-600);
    font-size: 15px;
    line-height: 1.65;
    color: var(--forest);
  }
  .bio-hero__actions { display: flex; flex-wrap: wrap; gap: 14px; align-items: center; margin-top: 6px; }

  .bio-prose { display: flex; flex-direction: column; gap: 22px; }
  .bio-prose :global(p) { margin: 0; font-size: 16px; line-height: 1.75; color: var(--text-900); }
  .bio-prose :global(h2), .bio-prose :global(h3) { margin: 12px 0 0; font-size: 22px; color: var(--forest); font-weight: 400; }
  .bio-prose :global(ul), .bio-prose :global(ol) { margin: 0; padding-left: 1.4rem; color: var(--text-900); line-height: 1.7; }
  .bio-prose :global(a) { color: var(--sage-600); }

  .bio-facts__side { display: flex; flex-direction: column; gap: 40px; }
  .bio-dl { margin: 12px 0 0; display: flex; flex-direction: column; }
  .bio-dl__row {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 14px;
    line-height: 1.6;
  }
  .bio-dl__row:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .bio-dl dt { margin: 0; color: var(--text-600); }
  .bio-dl dd { margin: 0; color: var(--forest); }
  .bio-dl dd a { color: var(--sage-600); text-decoration: none; }
  .bio-dl dd a:hover { color: var(--forest); }
  .bio-dl__line { display: block; }
  .bio-dl__muted { color: var(--text-600); }
  .bio-card {
    padding: 28px 30px;
    background: var(--sage-50);
    border-top: 3px solid var(--forest);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .bio-card__text { margin: 0; font-size: 22px; line-height: 1.35; color: var(--forest); }
  .bio-card__text :global(a) { color: var(--sage-600); text-decoration: none; border-bottom: 1px solid var(--sage); }
  .bio-card__text :global(a:hover) { color: var(--forest); border-color: var(--forest); }
  .bio-card .rd-link { align-self: flex-start; }

