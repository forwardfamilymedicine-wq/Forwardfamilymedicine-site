---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import ServiceHero from '../components/shared/ServiceHero.astro';
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import NearYouExpander from '../components/shared/NearYouExpander.astro';
import TitledGrid from '../components/shared/TitledGrid.astro';
import PathTimeline from '../components/shared/PathTimeline.astro';
import QuotePair from '../components/shared/QuotePair.astro';
import { reviewBy } from '../utils/reviews';
import RuledList from '../components/shared/RuledList.astro';
import SageCard from '../components/shared/SageCard.astro';
import GoogleReviewsLink from '../components/shared/GoogleReviewsLink.astro';
import { getAvailability } from '../utils/availability';
import { physicianRef } from '../utils/physicianSchema';

// Dr. Lieberman's name, credentials, photo, bio link and availability all come
// from the providers collection — the same source meet-the-team, the homepage
// team section and the menopause hub read. Nothing about him is hardcoded here.
const allProviders = await getCollection('providers');
const lieberman = allProviders.find(p => p.id === 'philip-lieberman-md');
const d = lieberman?.data;
const availability = d ? getAvailability(d) : null;

// Town list is derived from the local collection, never hardcoded, so a new
// /local/lifestyle-medicine-*.md file appears here the moment it is added.
const lifestyleTowns = (await getCollection('local'))
  .map(e => ({ slug: e.id.replace(/\.mdx?$/, ''), label: e.data.location ?? '' }))
  .filter(t => t.slug.startsWith('lifestyle-medicine-') && t.label)
  .sort((a, b) => a.label.localeCompare(b.label));

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Lifestyle Medicine", "item": "https://www.forwardfamilymedicine.com/lifestyle-medicine/" }
  ]
};

// The physician's node lives on their bio page; this page refers to it.
if (!lieberman) throw new Error('[lifestyle-medicine] no providers entry "philip-lieberman-md".');
const physicianSchema = physicianRef(lieberman);

const faqs = [
  {
    q: 'What is Lifestyle Medicine?',
    a: 'Lifestyle medicine is an evidence-based clinical specialty that uses therapeutic changes in nutrition, physical activity, sleep, stress management, social connection, and avoidance of harmful substances to prevent, treat, and even reverse chronic disease. Dr. Lieberman is board-certified in it as a Diplomate of the American Board of Lifestyle Medicine.',
  },
  {
    q: 'Is Lifestyle Medicine included in my membership?',
    a: "Yes. Lifestyle medicine is fully integrated into Dr. Lieberman's practice — not a separate fee or add-on service. It's part of how he practices with every patient.",
  },
  {
    q: 'Does Lifestyle Medicine replace medication?',
    a: 'Not necessarily — changes happen based on your progress and your preferences. Many patients are able to reduce or eliminate certain medications as their health improves, but this is always a collaborative, evidence-based process. Your safety and comfort come first.',
  },
  {
    q: 'Do I have to have a chronic condition to benefit?',
    a: "No. Lifestyle medicine is equally powerful for prevention — helping healthy patients stay healthy, optimize their energy, and build a foundation for long-term wellness. You don't have to be sick to benefit from better nutrition, sleep, and stress management.",
  },
  {
    q: 'How is this different from what my current doctor offers?',
    a: "Most primary care physicians receive very limited nutrition and lifestyle training in medical school. Dr. Lieberman earned degrees in culinary arts and nutrition science before medical school, is board-certified in Lifestyle Medicine, and developed a formal LM curriculum for other physicians. The depth of his training is genuinely different.",
  },
  {
    q: 'What conditions can Lifestyle Medicine help with?',
    a: 'Lifestyle medicine has the strongest evidence base for type 2 diabetes, hypertension, cardiovascular disease, obesity, metabolic syndrome, sleep disorders, anxiety, and depression. It also plays a powerful role in cancer prevention and overall longevity. For members interested in a structured longevity program, see the <a href="/clarity/">Clarity Program</a>.',
  },
];
const why = [
  { title: 'Dual Board-Certified', body: 'Family Medicine + Lifestyle Medicine' },
  { title: 'Culinary Trained', body: 'Real food knowledge, not textbook advice' },
  { title: 'Built the Curriculum', body: 'Trained other physicians at Abington' },
  { title: 'Included in Membership', body: 'No extra fees, no separate appointments' },
];

const included = [
  'Comprehensive lifestyle assessment at intake and regularly throughout care',
  'Personalized nutrition guidance — culinary-informed, practical, real food',
  'Physical activity planning tailored to your fitness level and preferences',
  'Sleep optimization protocols based on your specific patterns',
  'Stress and mental wellness support',
  'Evidence-based protocols for type 2 diabetes, hypertension, cardiovascular disease, obesity',
  'Chronic disease management through lifestyle intervention — alongside or instead of medication',
  'Ongoing accountability built into your regular appointments',
];

const who = [
  { title: 'You Have a Chronic Condition', body: 'Type 2 diabetes, hypertension, cardiovascular disease, high cholesterol, obesity, or metabolic syndrome — lifestyle medicine has the strongest evidence base for all of them.' },
  { title: 'You Want to Stay Healthy', body: "Prevention is the most powerful application of lifestyle medicine. Build a foundation now so that chronic disease doesn't become your story later." },
  { title: 'You Want More Energy', body: 'Sleep, nutrition, movement, and stress management are the levers. Dr. Lieberman knows how to use them — and how to fit them into your real life.' },
  { title: "You've Tried Before and It Didn't Stick", body: "Generic advice doesn't work. A culinary-trained, board-certified physician who builds a plan around your specific situation — that's different." },
];

const path = [
  { title: 'Culinary Arts Degree', body: 'Learning food, technique, and flavor from the ground up' },
  { title: 'BS in Nutrition Science', body: 'The clinical science of food, metabolism, and health' },
  { title: 'MD — Thomas Jefferson University', body: 'Medical training grounded in an already-deep nutritional foundation' },
  { title: 'U.S. Navy Physician', body: 'Primary care practice in a demanding environment' },
  { title: 'Dual Board Certification', body: 'Family Medicine + Lifestyle Medicine' },
  { title: 'Built the LM Residency Curriculum', body: 'Enabled Abington residents to earn their own Lifestyle Medicine board certification' },
];

const quotes = ['M.M.', 'P.M.'].map(who => ({ text: reviewBy(who).text, who, attribution: '— Verified Google review' }));

---

<MainLayout
  title="Lifestyle Medicine Wayne PA | Forward Family Medicine"
  description="In-person, board-certified Lifestyle Medicine in Wayne PA. The only DPC practice on the Main Line offering evidence-based lifestyle medicine integrated into primary care. Dr. Philip Lieberman, MD."
  schema={[breadcrumb, physicianSchema]}
>
  <section class="lm-hero">
    <div class="rd-wrap">
      <nav class="lm-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span> <span>Lifestyle Medicine</span>
      </nav>
      <div class="lm-hero__grid">
        <div class="lm-hero__copy">
          <h1 class="rd-h1 lm-hero__h1">Lifestyle Medicine Wayne PA</h1>
          <p class="rd-serif lm-hero__lead">What is Lifestyle Medicine, and why does it matter for your primary care?</p>
          <p class="rd-copy lm-hero__p">Lifestyle medicine is an evidence-based clinical specialty that uses therapeutic changes in nutrition, physical activity, sleep, stress management, social connection, and avoidance of harmful substances to prevent, treat, and even reverse chronic disease.</p>
          <p class="rd-copy lm-hero__p">At Forward Family Medicine, you don't have to seek this out separately. It's integrated into every visit. Dr. Lieberman is board-certified in Lifestyle Medicine and leads this dimension of the practice. Dr. Bigley, our founder, also incorporates lifestyle medicine principles into his care — together, the practice is built around treating root causes, not just symptoms.</p>
          <a href="/contact/?source=lifestyle-medicine" class="btn-forest lm-hero__cta">Schedule a Free Meet &amp; Greet</a>
        </div>
        <div class="lm-card">
          {d?.photo && (
            <Image
              src={d.photo}
              alt={d.photoAlt}
              width={480}
              widths={[480, 720, 960]}
              sizes="(max-width: 860px) calc(100vw - 40px), 420px"
              format="webp"
              quality={82}
              loading="eager"
              class="lm-card__photo"
            />
          )}
          <div class="lm-card__body">
            {availability?.status === 'accepting' && (
              <p class="lm-card__status">Now accepting new patients</p>
            )}
            <p class="rd-serif lm-card__name">{d ? `Dr. ${d.name}, ${d.credentials}` : 'Dr. Philip Lieberman, MD'}</p>
            <p class="lm-card__role">Dual Board-Certified Physician</p>
            <ul class="lm-card__creds">
              <li>Board-Certified: Lifestyle Medicine</li>
              <li>Board-Certified: Family Medicine</li>
              <li>Culinary Arts Degree</li>
              <li>Nutrition Science Degree</li>
              <li>Thomas Jefferson University MD</li>
              <li>U.S. Navy Physician</li>
              <li>Built LM Residency Curriculum at Abington</li>
            </ul>
            {d && (
              <a href={`/meet-the-team/${d.slug}/`} class="rd-link lm-card__link">
                Read Dr. {d.name.split(' ').pop()}'s full bio &rarr;
              </a>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">We Are the Only Practice on the Main Line With This</h2>
        <p class="rd-copy">No other local DPC practice offers it at all. At Forward Family Medicine, it's in-person, it's board-certified, and it's integrated into every visit at no extra charge.</p>
      </div>
      <TitledGrid reveal columns={2} items={why} />
    </div>
  </section>

  <section class="rd-section lm-incl">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack">
        <h2 class="rd-h2 lm-incl__h2">What's Included in Your Lifestyle Medicine Care</h2>
        <p class="rd-copy lm-incl__p">Your lifestyle medicine care at Forward Family Medicine is built around your specific health history, your labs, your goals, and — critically — your actual life. Dr. Lieberman doesn't hand you a pamphlet. He works with you on a real, practical plan that accounts for what you eat, how you sleep, what stresses you, and what your body needs.</p>
        <p class="rd-copy lm-incl__p">Because he trained in culinary arts before medical school, his nutrition guidance is specific, practical, and grounded in food that actually tastes good. That's rare in medicine.</p>
      </div>
      <RuledList reveal size="md" class="lm-incl__list">
        {included.map(t => <li>{t}</li>)}
      </RuledList>
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap">
      <h2 class="rd-h2 lm-who__h2">Lifestyle Medicine Is For You If…</h2>
      <TitledGrid reveal columns={2} items={who} class="lm-who" />
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--eq">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">A Different Kind of Medical Training</h2>
        <p class="rd-serif lm-story__lead">Most doctors learn about nutrition in a single semester. Dr. Lieberman went to culinary school first. Then nutrition science. Then Jefferson Medical College. Then the Navy. Then he wrote the curriculum that teaches other physicians how to practice lifestyle medicine.</p>
        <p class="rd-copy">The result is a doctor who can sit with you in the exam room, interpret your labs, and then help you figure out exactly what to put on your plate — and how to make it taste good.</p>
      </div>
      <div class="lm-path">
        <h3 class="rd-h3">Dr. Lieberman's Path</h3>
        <PathTimeline steps={path} />
      </div>
    </div>
  </section>

  <section class="rd-section" aria-label="Patient reviews">
    <div class="rd-wrap">
      <div class="lm-rev__head">
        <h2 class="rd-h2">What patients say about Dr. Lieberman</h2>
        <GoogleReviewsLink align="end" />
      </div>
      <div class="lm-rev__quotes"><QuotePair quotes={quotes} /></div>
    </div>
  </section>

  <section class="rd-section rd-sage lm-lib">
    <div class="rd-wrap lm-lib__grid">
      <div class="rd-stack">
        <h2 class="rd-h2 lm-lib__h2">Lifestyle Medicine Library</h2>
        <p class="rd-copy">Browse our evidence-based article library covering nutrition, physical activity, sleep, metabolic health, stress management, and cardiovascular prevention — all through a lifestyle medicine lens.</p>
        <a href="/lifestyle/" class="btn-forest lm-lib__btn">Browse the Library</a>
      </div>
      <SageCard class="lm-lib__note">
        <p>Navigating perimenopause or menopause? Dr. Landi at our Malvern location offers comprehensive, Menopause Society Certified care — see our <a href="/menopause/">Menopause Care page</a> for details.</p>
      </SageCard>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Lifestyle Medicine FAQs" />

  <CTABanner
    headline="Ready to Experience Medicine That Treats the Root Cause?"
    subhead="Schedule a free meet and greet with Dr. Lieberman. Come in, ask everything, and see for yourself what in-person, board-certified lifestyle medicine actually looks like."
    btnHref="/contact/?source=lifestyle-medicine"
  />

  <!-- Wayfinding, not persuasion: sits below the conversion content and
       connects the /local/lifestyle-medicine-* pages, which had no inbound
       links anywhere on the site before the front-doors batch. -->
  <NearYouExpander
    id="lifestyle-near-you"
    ariaLabel="Lifestyle Medicine by location"
    summary={`Lifestyle Medicine in ${lifestyleTowns.length} towns near you`}
    links={lifestyleTowns.map(t => ({ href: `/local/${t.slug}/`, label: t.label }))}
  />
</MainLayout>

<style>
  .lm-hero { background: var(--linen); padding: 80px 0 96px; }
  .lm-crumb { font-size: 13px; color: var(--text-600); margin-bottom: 40px; }
  .lm-crumb a { color: var(--text-600); }
  .lm-crumb a:hover { color: var(--forest); }
  .lm-crumb span:last-child { color: var(--text-700); }
  .lm-hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 72px; align-items: start; }
  .lm-hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; padding-top: 8px; }
  .lm-hero__h1 { font-size: 60px; max-width: 16ch; }
  .lm-hero__lead { margin: 0; font-size: 24px; line-height: 1.4; color: var(--forest); max-width: 30ch; }
  .lm-hero__p { max-width: 620px; }
  .lm-hero__cta { margin-top: 6px; }
  .lm-card { background: var(--linen-50); border: 1px solid var(--hairline); border-top: 3px solid var(--forest); }
  .lm-card :global(.lm-card__photo) { display: block; width: 100%; height: auto; aspect-ratio: 5/4; object-fit: cover; object-position: 50% 20%; }
  .lm-card__body { padding: 26px 28px 28px; display: flex; flex-direction: column; gap: 10px; }
  .lm-card__body p { margin: 0; }
  .lm-card__status { font-size: 13px; font-weight: 500; color: var(--gold-text); }
  .lm-card__name { font-size: 28px; line-height: 1.1; color: var(--forest); }
  .lm-card__role { font-size: 14px; font-weight: 500; color: var(--sage-600); }
  .lm-card__creds { margin: 14px 0 0; padding: 0; list-style: none; }
  .lm-card__creds li { padding: 11px 0; border-top: 1px solid var(--hairline-strong); font-size: 14px; line-height: 1.5; color: var(--forest); }
  .lm-card__creds li:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .lm-card__link { align-self: flex-start; margin-top: 16px; }

  .lm-incl { background: var(--forest); color: var(--linen); }
  .lm-incl__h2 { color: var(--linen); }
  .lm-incl__p { color: var(--on-forest); }
  .lm-incl :global(.lm-incl__list > li) { border-color: var(--sage); font-size: 15.5px; color: var(--on-forest); }
  .lm-incl :global(.lm-incl__list > li:last-child) { border-color: var(--sage); }

  .lm-who__h2 { margin-bottom: 40px; }
  .lm-story__lead { margin: 0; font-size: 22px; line-height: 1.45; color: var(--forest); }
  .lm-path { display: flex; flex-direction: column; gap: 12px; }

  .lm-rev__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px 40px; }
  .lm-rev__quotes { margin-top: 44px; }

  .lm-lib { padding: 80px 0; }
  .lm-lib__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 0.7fr); gap: 64px; align-items: start; }
  .lm-lib__h2 { font-size: 40px; }
  .lm-lib__btn { align-self: flex-start; margin-top: 6px; }
  .lm-lib :global(.lm-lib__note) { background: var(--linen); }

  @media (max-width: 860px) {
    .lm-hero { padding: 48px 0 64px; }
    .lm-crumb { margin-bottom: 24px; }
    .lm-hero__grid, .lm-lib__grid { grid-template-columns: 1fr; gap: 36px; }
    .lm-hero__h1 { font-size: 40px; max-width: none; }
    .lm-hero__lead { font-size: 21px; }
    .lm-lib { padding: 56px 0; }
    .lm-lib__h2 { font-size: 30px; }
  }
</style>
