---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import NearYouExpander from '../components/shared/NearYouExpander.astro';
import NumberedRows from '../components/shared/NumberedRows.astro';
import PathTimeline from '../components/shared/PathTimeline.astro';
import QuotePair from '../components/shared/QuotePair.astro';
import { reviewBy } from '../utils/reviews';
import RuledList from '../components/shared/RuledList.astro';
import GoogleReviewsLink from '../components/shared/GoogleReviewsLink.astro';
import { formatMonthYear, getAvailability } from '../utils/availability';
import { physicianRef } from '../utils/physicianSchema';

const allProviders = await getCollection('providers');
const landi = allProviders.find(p => p.id === 'brian-landi-do');
const d = landi?.data;
const availability = d ? getAvailability(d) : null;

// Malvern is the only office a patient can go to. Its opening month comes from
// the locations entry, never hardcoded, and the opening copy drops out the
// moment that entry's status flips to "open".
const malvern = (await getCollection('locations')).find(l => l.data.slug === 'malvern');
if (!malvern) throw new Error('[menopause] no locations entry has the slug "malvern".');
const malvernOpen = malvern.data.status === 'open';
if (!malvernOpen && !malvern.data.openingDate) {
  throw new Error(`[menopause] locations/malvern is "${malvern.data.status}" but has no openingDate.`);
}
const malvernOpening = malvernOpen ? '' : formatMonthYear(malvern.data.openingDate!);

// Town list is derived from the local collection, never hardcoded, so a new
// /local/menopause-*.md file appears here the moment it is added.
const menopauseTowns = (await getCollection('local'))
  .map(e => ({ slug: e.id.replace(/\.mdx?$/, ''), label: e.data.location ?? '' }))
  .filter(t => t.slug.startsWith('menopause-') && t.label)
  .sort((a, b) => a.label.localeCompare(b.label));

// The library cluster, in reading order. Titles and descriptions come from the
// lifestyle collection, never retyped, and a slug with no entry fails the build.
const LIBRARY_READING_ORDER = [
  'perimenopause-early-forties',
  'what-a-menopause-visit-should-cover',
  'hormone-therapy-evidence-2026',
  'bone-and-heart-after-menopause',
];
const lifestyleEntries = await getCollection('lifestyle');
const libraryArticles = LIBRARY_READING_ORDER.map(slug => {
  const entry = lifestyleEntries.find(e => e.id.replace(/\.mdx?$/, '') === `menopause/${slug}`);
  if (!entry) throw new Error(`[menopause] no lifestyle entry at menopause/${slug}.`);
  return { href: `/lifestyle/menopause/${slug}/`, title: entry.data.title, description: entry.data.description };
});

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Menopause Care", "item": "https://www.forwardfamilymedicine.com/menopause/" }
  ]
};

// The physician's node lives on their bio page; this page refers to it.
if (!landi) throw new Error('[menopause] no providers entry "brian-landi-do".');
const physicianSchema = physicianRef(landi);

const faqs = [
  {
    q: 'What does menopause care at Forward Family Medicine include?',
    a: 'Comprehensive symptom assessment, hormone and metabolic labs when indicated, HRT consultation and prescribing when appropriate, non-hormonal symptom management, cardiovascular and bone health risk assessment, and integration with the rest of your primary care. The full scope of the transition — not a 15-minute slice.',
  },
  {
    q: 'Is menopause care covered in my DPC membership?',
    a: "Yes. Menopause care is part of how Dr. Landi practices primary care — it's included at no additional cost. Labs and any prescribed medications are at wholesale or near-cost pricing, separate from the membership fee.",
  },
  {
    q: 'Do I need to keep seeing my gynecologist for HRT?',
    a: "Not necessarily. Dr. Landi can prescribe and manage hormone therapy directly when it's appropriate. For procedural gynecology or specialty issues outside the scope of primary care, we coordinate referrals to GYN partners directly. Many patients find that primary care–based menopause management eliminates the need for a separate ongoing relationship.",
  },
  {
    q: 'When is the right time to start menopause care?',
    a: "Earlier than most patients are told. Symptoms often begin in perimenopause — typically the early forties, sometimes earlier — years before periods stop. If you're noticing changes in sleep, mood, cycles, or energy that feel different from baseline, that's the right time to have the conversation. We don't wait for menopause itself to start the workup.",
  },
  {
    q: 'Where is Dr. Landi located?',
    a: malvernOpen
      ? 'Dr. Landi sees patients at our Malvern office, at 301 Lindenwood Dr #206, and by telehealth. He is accepting new patients now. A West Chester location is planned. He is not at the Wayne office; Dr. Bigley and Dr. Lieberman remain there.'
      : `Dr. Landi's office is in Malvern, at 301 Lindenwood Dr #206, opening ${malvernOpening}. He is accepting new patients now, with meet and greets and telehealth visits available today. A West Chester location is planned. He is not at the Wayne office; Dr. Bigley and Dr. Lieberman remain there.`,
  },
  {
    q: 'Can menopause visits be done by telehealth?',
    a: 'Yes — many menopause check-ins, follow-ups, and HRT titration conversations work well by phone or video. Initial intake and any visit requiring physical examination is in-person.',
  },
  {
    q: "I don't live near Malvern. Can I still see Dr. Landi?",
    a: "Yes. Many menopause follow-ups and hormone therapy check-ins work well by phone or video, so ongoing care is accessible wherever you live. In-person visits are at our Malvern office, which is most convenient if you're in Malvern, Paoli, Exton, West Chester, Downingtown, or surrounding communities.",
  },
];
const reasons = [
  { title: "You're in perimenopause and the symptoms don't add up", body: "Sleep is off, mood is unpredictable, cycles are changing, you're gaining weight you don't recognize, and your last visit gave you fifteen minutes and a vitamin D recommendation. Perimenopause requires a proper workup and a longitudinal plan — not a single visit and a guess." },
  { title: "You're considering HRT and want a real conversation about it", body: "The evidence on hormone therapy has shifted significantly since the early 2000s. Most current data supports HRT for the right candidates — but the decision depends on your timing, symptoms, risk profile, and preferences. That conversation takes more than fifteen minutes." },
  { title: "You're post-menopause and want to age well", body: "Menopause accelerates bone loss, cardiovascular risk, and metabolic changes. The decade after menopause is when prevention pays the most. Cardiovascular and bone health screening, strength training, and risk-factor management — done together, longitudinally — are how the post-menopause years go differently." },
  { title: "Your current primary care doctor doesn't have the training for this", body: "Menopause was a single lecture in most medical school curricula until very recently. A physician with Menopause Society Certified Practitioner credentialing has trained specifically in evidence-based menopause management — and a DPC practice has the visit length to actually use that training." },
];

const path = [
  { title: "BS — Pennsylvania State University", body: "Foundation in the sciences" },
  { title: "DO — Philadelphia College of Osteopathic Medicine (2022)", body: "Whole-person, hands-on medical training" },
  { title: "Family Medicine Residency — ChristianaCare (2025)", body: "Comprehensive primary care across all ages and conditions" },
  { title: "Chief Resident — ChristianaCare", body: "Selected for clinical excellence and leadership" },
  { title: "Board-Certified — AOBFP", body: "American Osteopathic Board of Family Physicians" },
  { title: "Menopause Society Certified Practitioner (MSCP)", body: "Evidence-based credential through The Menopause Society" },
  { title: "Forward Family Medicine — accepting new patients now", body: `${malvernOpen ? 'Malvern office now open.' : `Malvern office opens ${malvernOpening}.`} West Chester location planned.` },
];

const quotes = ['I.B.', 'E.G.'].map(who => ({ text: reviewBy(who).text, who, attribution: '— Verified Google review' }));

const stats = [
  { value: '15 min', caption: 'average primary care visit, nationally', muted: true },
  { value: '1–2 hr', caption: 'visit length at Forward Family Medicine' },
  { value: '4–10 yrs', caption: 'typical perimenopause + menopause span', muted: true },
  { value: 'Included', caption: 'menopause care in every DPC membership' },
];

---

<MainLayout
  title="Menopause Care | Forward Family Medicine | Malvern, PA"
  description="Evidence-based menopause care in Malvern, PA and by telehealth across the Main Line and Chester County. Menopause Society Certified Practitioner, 1 to 2 hour visits, included in DPC membership."
  schema={[breadcrumb, physicianSchema]}
>
  <section class="mp-hero">
    <div class="rd-wrap">
      <nav class="mp-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span> <span>Menopause Care</span>
      </nav>
      <div class="mp-hero__grid">
        <div class="mp-hero__copy">
          <p class="rd-eyebrow">Menopause + Midlife Women's Health</p>
          <h1 class="rd-h1 mp-hero__h1">Menopause Care, Built Into Your Primary Care</h1>
          <p class="rd-serif mp-lead" data-reveal>
            <span class="mp-beat">Perimenopause and menopause unfold over four to ten years.</span>
            <span class="mp-beat">The average primary care visit is fifteen minutes.</span>
            <span class="mp-beat mp-beat--last">The math doesn't work.</span>
          </p>
          <p class="mp-hero__p">At Forward Family Medicine, menopause care is delivered by Dr. Brian Landi, DO — a board-certified family physician with Menopause Society Certified Practitioner credentialing — across visits long enough to actually walk through what's happening, what your options are, and what you want to do about it. No outside referral. No separate appointment. Included in your membership.</p>
          <a href="/contact/?source=menopause" class="btn-forest mp-hero__cta">Schedule a Free Meet &amp; Greet</a>
        </div>
        <article class="mp-card">
          {d?.photo && (
            <Image
              src={d.photo}
              alt={d.photoAlt}
              width={300}
              widths={[150, 300, 450]}
              sizes="150px"
              format="webp"
              quality={82}
              loading="eager"
              class="mp-card__photo"
            />
          )}
          <div class="mp-card__body">
            {availability?.status === 'accepting' && (
              <p class="rd-eyebrow rd-eyebrow--gold">Accepting new patients · Malvern</p>
            )}
            <h2 class="rd-serif mp-card__name">{d ? `${d.name}, ${d.credentials}` : 'Dr. Brian Landi, DO'}</h2>
            <p class="mp-card__role">Menopause Society Certified Practitioner</p>
            <ul class="mp-card__creds">
              <li>Menopause Society Certified Practitioner (MSCP)</li>
              <li>Family Medicine Board-Certified (AOBFP)</li>
              <li>Direct Primary Care Model</li>
              <li>{malvernOpen ? 'Malvern office' : `Malvern office, opening ${malvernOpening}`}</li>
            </ul>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="rd-section mp-why">
    <div class="rd-wrap mp-why__grid">
      <div class="rd-stack mp-why__copy">
        <h2 class="rd-h2 mp-why__h2">Few Practices on the Main Line Are Built for This</h2>
        <p class="rd-copy mp-why__p">Menopause care has historically fallen between two stools. Primary care physicians don't have the appointment length to do it well. Gynecologists are often booked for procedures and surgical follow-ups, with limited windows for the slow, iterative conversations menopause management actually requires. The result is millions of women managing a four-to-ten-year transition with fragmented advice, conflicting messages about HRT, and symptoms attributed to age or stress.</p>
        <p class="rd-serif mp-why__close">At Forward Family Medicine, menopause care isn't an add-on or a referral. It's primary care done with enough time to do it right — by a physician who trained for it.</p>
      </div>
      <div class="mp-stats" data-reveal>
        {stats.map(s => (
          <div class="mp-stat">
            <div class:list={['mp-stat__v', 'rd-serif', { 'is-muted': s.muted }]}>{s.value}</div>
            <p class:list={['mp-stat__c', { 'is-muted': s.muted }]}>{s.caption}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">The Full Scope, Not a 15-Minute Slice</h2>
        <p class="rd-copy">Menopause is not one symptom — it's a metabolic, hormonal, cardiovascular, skeletal, and cognitive transition. Treating it well requires assessing all of those systems together, over time, and acting on the ones that need attention.</p>
        <p class="rd-copy">At Forward Family Medicine, menopause care is structured around the full scope of the transition. Whether you're navigating early perimenopause, evaluating HRT, or focused on post-menopausal cardiovascular and bone health, your physician is set up to do the work — not refer it out.</p>
      </div>
      <RuledList reveal size="md" class="mp-scope">
        <li><strong>Comprehensive symptom assessment</strong> — sleep, mood, cognition, cycle changes, vasomotor symptoms, urogenital changes, libido, weight</li>
        <li><strong>Lab workup</strong> — hormone panels, lipids, thyroid, glucose, ApoB when clinically indicated</li>
        <li><strong>HRT consultation</strong> — evidence-based shared decision-making, prescribing when appropriate</li>
        <li><strong>Non-hormonal symptom management</strong> — for women who can't or prefer not to use HRT</li>
        <li><strong>Bone health</strong> — risk assessment, <a href="/wayne-dexa/">DEXA coordination</a>, osteoporosis prevention</li>
        <li><strong>Cardiovascular risk</strong> — lipids, blood pressure, advanced markers when indicated, prevention strategy</li>
        <li><strong>Sleep, mood, weight</strong> — addressed clinically, not deflected to lifestyle handouts</li>
        <li><strong>Referral coordination</strong> — direct introduction to GYN, endocrinology, or other specialists when needed</li>
      </RuledList>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--a">
      <h2 class="rd-h2 rd-sticky">Four Common Reasons Patients Find Their Way Here</h2>
      <NumberedRows rows={reasons} />
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--eq">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">A Different Kind of Family Physician</h2>
        <p class="rd-serif mp-story__lead">Most primary care visits give you fifteen minutes for symptoms that have been building for years. Dr. Landi chose direct primary care to recover the time medicine actually requires. His clinical interest in midlife women's health pushed him toward Menopause Society credentialing because the standard primary care training simply doesn't go deep enough.</p>
        <p class="rd-copy">The result is a family physician who can sit with you in the exam room for an hour, walk through the full picture of where you are in the transition, and build a plan that integrates symptoms, hormones, cardiovascular and bone health, and the lifestyle factors that compound or counteract them.</p>
      </div>
      <div class="mp-path">
        <h3 class="rd-h3">Dr. Landi's Path</h3>
        <PathTimeline steps={path} />
      </div>
    </div>
  </section>

  <section class="rd-section rd-alt" aria-label="Patient reviews">
    <div class="rd-wrap">
      <div class="mp-rev__head">
        <h2 class="rd-h2">What patients say about Dr. Landi</h2>
        <GoogleReviewsLink align="end" />
      </div>
      <div class="mp-rev__quotes"><QuotePair quotes={quotes} /></div>
    </div>
  </section>

  <!-- Library cluster: the hub's return link to the four menopause articles,
       so the cluster works in both directions. -->
  <section class="rd-section" aria-label="Menopause articles">
    <div class="rd-wrap">
      <div class="mp-rev__head">
        <h2 class="rd-h2">Read More About the Menopause Transition</h2>
        <a href="/lifestyle/menopause/" class="rd-link">See the full menopause reading guide →</a>
      </div>
      <div class="mp-reads">
        {libraryArticles.map(a => (
          <a href={a.href} class="mp-read">
            <span class="rd-serif mp-read__t">{a.title}</span>
            <span class="mp-read__d">{a.description}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="mp-faq"><FAQSection faqs={faqs} headline="Menopause Care FAQs" /></div>

  <CTABanner
    ch={16}
    headline="Schedule a Meet &amp; Greet with Dr. Landi"
    subhead="Dr. Landi is accepting new patients now. A 60-minute meet and greet, no obligation, at our Malvern office or by video."
    btnText="Schedule Now"
    btnHref="/contact/?source=menopause"
  />

  <!-- Wayfinding, not persuasion: sits below the conversion content and
       connects the /local/menopause-* pages, which had no inbound links
       anywhere on the site before the front-doors batch. -->
  <NearYouExpander
    id="menopause-near-you"
    ariaLabel="Menopause care by location"
    summary={`Menopause care in ${menopauseTowns.length} Main Line and Chester County towns`}
    links={menopauseTowns.map(t => ({ href: `/local/${t.slug}/`, label: t.label }))}
  />
</MainLayout>

<style>
  .mp-hero { background: var(--linen); padding: 80px 0 80px; }
  .mp-crumb { font-size: 13px; color: var(--text-600); margin-bottom: 40px; }
  .mp-crumb a { color: var(--text-600); }
  .mp-crumb a:hover { color: var(--forest); }
  .mp-crumb span:last-child { color: var(--text-700); }
  .mp-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 72px; align-items: start; }
  .mp-hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 24px; }
  .mp-hero__h1 { font-size: 60px; max-width: 13ch; }
  .mp-lead { margin: 0; font-size: 24px; line-height: 1.4; color: var(--sage-600); font-style: italic; max-width: 560px; }
  .mp-beat { display: inline-block; opacity: 0; transform: translateY(6px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .mp-beat--last { color: var(--forest); }
  .mp-lead.on .mp-beat { opacity: 1; transform: none; }
  .mp-lead.on .mp-beat:nth-child(1) { transition-delay: 0.15s; }
  .mp-lead.on .mp-beat:nth-child(2) { transition-delay: 0.75s; }
  .mp-lead.on .mp-beat:nth-child(3) { transition-delay: 1.7s; }
  .mp-hero__p { margin: 0; font-size: 17px; line-height: 1.7; color: var(--text-900); max-width: 580px; }
  .mp-hero__cta { margin-top: 6px; }
  .mp-card { display: grid; grid-template-columns: 150px minmax(0, 1fr); gap: 24px; align-items: start; padding-top: 8px; }
  .mp-card :global(.mp-card__photo) { display: block; width: 100%; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: 50% 20%; border-radius: 2px; }
  .mp-card__body { display: flex; flex-direction: column; gap: 10px; }
  .mp-card__body p { margin: 0; }
  .mp-card__name { margin: 2px 0 0; font-size: 28px; line-height: 1.1; color: var(--forest); }
  .mp-card__role { font-size: 14px; font-weight: 500; color: var(--sage-600); }
  .mp-card__creds { margin: 6px 0 0; padding: 0; list-style: none; font-size: 14px; line-height: 1.5; color: var(--text-700); }
  .mp-card__creds li { padding: 9px 0; border-top: 1px solid var(--hairline-strong); }
  .mp-card__creds li:last-child { border-bottom: 1px solid var(--hairline-strong); }

  .mp-why { background: var(--forest); color: var(--linen); }
  .mp-why__grid { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 72px; align-items: center; }
  .mp-why__h2 { color: var(--linen); }
  .mp-why__p { color: var(--on-forest); }
  .mp-why__close { margin: 4px 0 0; font-size: 24px; line-height: 1.4; color: var(--linen); max-width: 560px; }
  .mp-stats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
  .mp-stat {
    padding: 24px 0;
    border-top: 1px solid var(--sage);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .mp-stat:nth-last-child(-n+2) { border-bottom: 1px solid var(--sage); }
  .mp-stats.on .mp-stat { opacity: 1; transform: none; }
  .mp-stats.on .mp-stat:nth-child(2) { transition-delay: 0.2s; }
  .mp-stats.on .mp-stat:nth-child(3) { transition-delay: 0.4s; }
  .mp-stats.on .mp-stat:nth-child(4) { transition-delay: 0.6s; }
  .mp-stat__v { font-size: clamp(36px, 4vw, 52px); line-height: 1; letter-spacing: -0.02em; color: var(--linen); }
  .mp-stat__c { margin: 10px 0 0; font-size: 13px; line-height: 1.5; color: var(--on-forest); }
  .mp-stat__v.is-muted, .mp-stat__c.is-muted { color: var(--on-forest-faint); }

  .mp-scope.ruled-list > :global(li) { padding: 16px 0; font-size: 15px; line-height: 1.65; color: var(--text-900); }
  .mp-scope :global(li strong) { color: var(--forest); font-weight: 600; }
  /* The component's own scope attribute is not on the page's rules, so this must be global to reach the links. */
  :global(.mp-scope li a) { color: var(--sage-600); }
  :global(.mp-scope li a:hover) { color: var(--forest); }
  .mp-story__lead { margin: 0; font-size: 22px; line-height: 1.45; color: var(--forest); }
  .mp-path { display: flex; flex-direction: column; gap: 12px; }
  .mp-path :global(.path__step::before) { box-shadow: 0 0 0 4px var(--linen); }

  .mp-rev__head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 20px 40px; }
  .mp-rev__quotes { margin-top: 44px; }
  .mp-reads { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; margin-top: 40px; }
  .mp-read {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 24px 0;
    border-top: 1px solid var(--hairline-strong);
    color: var(--forest);
    text-decoration: none;
  }
  .mp-read:nth-last-child(-n+2) { border-bottom: 1px solid var(--hairline-strong); }
  .mp-read::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--sage-600); transform: scaleX(0); transform-origin: left; transition: transform 0.35s ease; }
  .mp-read:hover::after { transform: scaleX(1); }
  .mp-read:hover .mp-read__t { color: var(--sage-600); }
  .mp-read__t { font-size: 22px; line-height: 1.25; transition: color 0.18s; }
  .mp-read__d { font-size: 14px; line-height: 1.65; color: var(--text-700); }
  .mp-faq :global(.faq-section) { background: var(--linen-50); border-top: 1px solid var(--hairline); }

  @media (max-width: 860px) {
    .mp-hero { padding: 48px 0 64px; }
    .mp-crumb { margin-bottom: 24px; }
    .mp-hero__grid, .mp-why__grid { grid-template-columns: 1fr; gap: 36px; }
    .mp-hero__h1 { font-size: 40px; max-width: none; }
    .mp-lead { font-size: 21px; }
    .mp-card { grid-template-columns: 110px minmax(0, 1fr); gap: 16px; }
    .mp-why__close { font-size: 21px; }
    .mp-stat__v { font-size: 36px; }
    .mp-reads { grid-template-columns: 1fr; }
    .mp-read:nth-last-child(2) { border-bottom: 0; }
  }
</style>
