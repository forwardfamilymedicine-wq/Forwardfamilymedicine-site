---
import MainLayout from '../layouts/MainLayout.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import ServiceHero from '../components/shared/ServiceHero.astro';
import SageCard from '../components/shared/SageCard.astro';
import TitledGrid from '../components/shared/TitledGrid.astro';
import RuledList from '../components/shared/RuledList.astro';
import { Image } from 'astro:assets';
import landiPortrait from '../assets/staff/dr-brian-landi.jpg';

const SCRIPT_URL = import.meta.env.PUBLIC_GOOGLE_SCRIPT_URL;
const CONTACT_EMAIL = 'information@forwardfamilymedicine.com';

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "For Businesses", "item": "https://www.forwardfamilymedicine.com/for-businesses/" }
  ]
};
const problems = [
  { title: '7-minute appointments', body: 'The national average for a primary care visit. Your employees deserve better — especially for preventive care and chronic condition management.' },
  { title: 'Unpredictable costs', body: 'Premiums rise every year. High deductibles mean employees avoid the doctor until things get expensive. Then the ER visit costs everyone more.' },
  { title: '3-week wait times', body: 'The average wait for a primary care appointment. Sick employees who wait get sicker, stay home longer, and cost your business more.' },
  { title: 'Administrative burden', body: 'Claims, pre-authorizations, EOBs, in-network restrictions. Traditional insurance adds friction at every point of care.' },
];
const who = [
  { title: 'Small Businesses', body: "Can't afford full group health insurance? DPC lets you offer a real, meaningful healthcare benefit at a predictable monthly cost." },
  { title: 'Professional Firms', body: 'Law firms, accounting practices, and financial services firms who want to offer premium healthcare as a retention and recruitment tool.' },
  { title: 'Wellness-Focused Employers', body: 'Companies who value employee wellbeing and want to offer lifestyle medicine alongside primary care — as a real, board-certified service.' },
  { title: 'Companies Supplementing Insurance', body: 'Already have a high-deductible plan? DPC fills the primary care gap — employees get unlimited access without touching their deductible.' },
];
const roi = [
  { title: 'Fewer ER Visits', body: 'Same-day primary care access means employees handle problems early — before they become expensive emergency room visits.' },
  { title: 'Less Time Away', body: 'Same-day appointments, telehealth, and direct doctor access mean employees spend less time away from work managing healthcare logistics.' },
  { title: 'Wholesale Medications', body: 'Employees access medications and labs at wholesale pricing — significantly below retail and often below insurance negotiated rates.' },
  { title: 'Preventive Care That Sticks', body: "Dr. Lieberman's lifestyle medicine approach builds long-term health — reducing the chronic conditions that drive the highest healthcare costs." },
];
const gets = [
  'Unlimited primary care office visits — no copay',
  'Same-day and next-day appointments',
  'Visits: 1–2 hours (not 7 minutes)',
  'Direct phone, text &amp; email access to their doctor',
  'Preventive care and chronic disease management',
  'Board-certified Lifestyle Medicine — nutrition, sleep, stress, movement',
  'Wholesale lab pricing — significant cost savings',
  'Specialist referral coordination',
  'Telehealth visits',
];
---

<MainLayout
  title="Employee Health Benefits Wayne PA | Forward Family Medicine"
  description="DPC memberships for small businesses and employers on the Main Line. Better primary care for your team at a flat monthly cost. Wayne, PA — serving Main Line companies."
  schema={breadcrumb}
>
  <section class="biz-hero">
    <div class="rd-wrap biz-hero__grid">
      <div class="biz-hero__copy">
        <nav class="biz-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">›</span> <span>For Businesses</span>
        </nav>
        <h1 class="rd-h1 biz-h1">Better Healthcare for Your Team. Simpler Than You Think.</h1>
        <p class="biz-lede">The Main Line is home to thousands of small businesses, independent professionals, and growing companies — many offering health insurance that costs a fortune and still leaves employees with 7-minute appointments and high copays.</p>
        <p class="biz-lede">Forward Family Medicine employer memberships give your team direct, unlimited access to their primary care physician — no copays, same-day availability, and a doctor who actually knows them.</p>
        <div class="biz-ctas">
          <a href="/contact/" class="btn-forest">Inquire About Employer Memberships</a>
          <a href="mailto:information@forwardfamilymedicine.com" class="btn-ghost">Email Us Directly</a>
        </div>
      </div>
      <SageCard class="biz-card">
        <p class="rd-eyebrow">Quick Contact</p>
        <p class="rd-serif biz-card__lede">Reach us to discuss employer memberships for your team:</p>
        <dl class="biz-facts">
          <div><dt>Phone</dt><dd><a href="tel:+12156457044">(215) 645-7044</a></dd></div>
          <div><dt>Email</dt><dd><a href="mailto:information@forwardfamilymedicine.com">information@forwardfamilymedicine.com</a></dd></div>
        </dl>
        <p class="biz-card__note">We respond within 1 business day and are happy to set up a call to discuss your team's specific needs.</p>
      </SageCard>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <h2 class="rd-h2 biz-h2">Traditional Health Insurance Wasn't Built for Your Team</h2>
      <TitledGrid columns={2} reveal items={problems} />
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--eq">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">Employer Memberships at Forward Family Medicine</h2>
        <p class="rd-copy">Employer memberships at Forward Family Medicine work simply: you pay a flat monthly per-employee fee, and your team gets unlimited direct primary care. No copays when they visit. No hoops to jump through. Just a doctor who knows them, picks up the phone, and has time for them.</p>
        <p class="rd-copy">Our employer plans pair seamlessly with your existing high-deductible health plan — or as a standalone benefit for companies looking to add meaningful healthcare value without replacing full insurance.</p>
        <p class="rd-copy">Because Dr. Lieberman is board-certified in Lifestyle Medicine, your employees also gain access to evidence-based nutrition, sleep, and stress coaching — the kind of proactive care that keeps people out of the ER and off sick days.</p>
      </div>
      <div class="rd-stack">
        <h3 class="rd-serif biz-h3">What Your Employees Get</h3>
        <RuledList reveal>
          {gets.map(g => <li set:html={g}></li>)}
        </RuledList>
      </div>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <h2 class="rd-h2 biz-h2">Built for Companies Like Yours</h2>
      <TitledGrid columns={2} reveal items={who} />
    </div>
  </section>

  <section class="biz-case">
    <div class="rd-wrap">
      <h2 class="rd-h2 biz-case__h2">Better Care Means Lower Costs</h2>
      <div class="biz-case__grid" data-reveal>
        {roi.map(r => (
          <div class="biz-case__item">
            <h3 class="rd-serif">{r.title}</h3>
            <p>{r.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="rd-section rd-sage">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">Menopause Care for Your Team</h2>
        <a href="/meet-the-team/brian-landi-do/" class="biz-person">
          <Image src={landiPortrait} alt="Dr. Brian Landi, DO" width={144} height={180} class="biz-person__img" />
          <span class="biz-person__text">
            <span class="biz-person__name rd-serif">Dr. Brian Landi, DO</span>
            <span class="biz-person__role">Menopause Society Certified Practitioner · Malvern</span>
          </span>
        </a>
      </div>
      <div class="rd-stack">
        <p class="rd-copy">A significant share of every employer's workforce is women in their 40s and 50s — a demographic where perimenopause and menopause symptoms are common, often undertreated, and increasingly cited as a driver of mid-career attrition. Untreated menopause symptoms cost women in productivity, sleep, energy, and wellbeing — and cost their employers the institutional knowledge and leadership these employees represent.</p>
        <p class="rd-copy">Forward Family Medicine offers Menopause Society Certified menopause care through Dr. Brian Landi at our Malvern location — comprehensive perimenopause and menopause management, evidence-based HRT consultation, and cardiovascular and bone health monitoring, all included in employees' DPC membership. For employers in professional services, healthcare, education, financial services, and biotech — sectors with significant women workforce in their 40s and 50s — this is a meaningful retention investment, not just a benefit.</p>
        <a href="/menopause/" class="rd-link biz-more">Learn more about Menopause Care →</a>
      </div>
    </div>
  </section>

  <!-- Employer inquiry form -->
  <section class="rd-section biz-form-section" id="contact">
    <div class="rd-wrap rd-split rd-split--b">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">Let's Talk About Your Team</h2>
        <p class="rd-copy">Employer plans are priced per employee per month and scale with team size and coverage structure. Every employer situation is different — we'll build a plan that fits your team and your budget. Contact us to start the conversation.</p>
        <p class="rd-copy">Tell us a bit about your company and we'll follow up within one business day to discuss options.</p>
      </div>
      <div class="biz-form-card">
              <form id="biz-inquiry-form" novalidate aria-label="Employer inquiry form">
                <input type="hidden" name="subject" value="Business Inquiry" />
      
                <div class="biz-form-row">
                  <div class="biz-form-group">
                    <label for="biz-name">Your Name <span aria-hidden="true">*</span></label>
                    <input type="text" id="biz-name" name="name" required autocomplete="name" aria-required="true" />
                  </div>
                  <div class="biz-form-group">
                    <label for="biz-company">Company Name <span aria-hidden="true">*</span></label>
                    <input type="text" id="biz-company" name="companyName" required aria-required="true" />
                  </div>
                </div>
      
                <div class="biz-form-group">
                  <label for="biz-email">Email Address <span aria-hidden="true">*</span></label>
                  <input type="email" id="biz-email" name="email" required autocomplete="email" aria-required="true" />
                </div>
      
                <div class="biz-form-row">
                  <div class="biz-form-group">
                    <label for="biz-employees">Number of Employees <span aria-hidden="true">*</span></label>
                    <select id="biz-employees" name="employees" required aria-required="true">
                      <option value="">Select…</option>
                      <option value="1–10">1–10</option>
                      <option value="11–25">11–25</option>
                      <option value="26–50">26–50</option>
                      <option value="51–100">51–100</option>
                      <option value="100+">100+</option>
                    </select>
                  </div>
                  <div class="biz-form-group">
                    <label for="biz-coverage">Current Employee Healthcare</label>
                    <select id="biz-coverage" name="coverage">
                      <option value="">Select…</option>
                      <option value="Group health plan">Group health plan</option>
                      <option value="No current coverage">No current coverage</option>
                      <option value="Self-insured">Self-insured</option>
                      <option value="Health sharing plan">Health sharing plan</option>
                      <option value="Other">Other</option>
                    </select>
                  </div>
                </div>
      
                <div class="biz-form-group">
                  <label for="biz-message">Questions or anything you'd like us to know (optional)</label>
                  <textarea id="biz-message" name="message" rows="4" placeholder="Tell us about your team, your goals, or any specific questions you have..."></textarea>
                </div>
      
                <div id="biz-form-error" class="biz-form-message biz-error" hidden role="alert" aria-live="assertive"></div>
                <div id="biz-form-success" class="biz-form-message biz-success" hidden role="alert" aria-live="assertive"></div>
      
                <button type="submit" class="btn-forest biz-submit-btn" id="biz-submit-btn">
                  Request a Conversation
                </button>
      
                <p class="biz-form-note">We'll follow up within one business day. Your information is never shared or sold.</p>
              </form>
      </div>
    </div>
  </section>

  <CTABanner
    headline="Your Team Deserves a Doctor Who Has Time for Them"
    subhead="Contact us about employer memberships. We'll design a plan that makes sense for your company — and genuinely improves healthcare for your people."
    btnText="Contact Us About Employer Plans"
  />
</MainLayout>

<style>
  .biz-hero { background: var(--linen); padding: 80px 0 96px; }
  .biz-hero__grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 0.8fr); gap: 72px; align-items: start; }
  .biz-hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 26px; padding-top: 12px; }
  .biz-breadcrumb { font-size: 13px; color: var(--text-600); margin-bottom: 14px; }
  .biz-breadcrumb a { color: var(--text-600); }
  .biz-breadcrumb a:hover { color: var(--forest); }
  .biz-breadcrumb span:last-child { color: var(--text-700); }
  .biz-h1 { font-size: 58px; line-height: 1.04; max-width: 17ch; }
  .biz-lede { margin: 0; max-width: 640px; font-size: 17px; line-height: 1.7; color: var(--text-900); }
  .biz-ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }
  .biz-hero__grid > :global(.biz-card) { position: sticky; top: calc(var(--header-h) + 24px); }
  .biz-card__lede { font-size: 22px; line-height: 1.35; color: var(--forest); }
  .biz-facts { margin: 0; display: flex; flex-direction: column; }
  .biz-facts > div { padding: 12px 0; border-top: 1px solid var(--hairline-strong); display: flex; flex-direction: column; gap: 4px; }
  .biz-facts > div:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .biz-facts dt { font-size: 12px; font-weight: 600; color: var(--text-600); }
  .biz-facts dd { margin: 0; font-size: 15px; overflow-wrap: anywhere; }
  .biz-facts a { color: var(--sage-600); }
  .biz-card__note { font-size: 14px; line-height: 1.65; color: var(--text-700); }

  .biz-h2 { max-width: 820px; margin-bottom: 40px; }
  .biz-h3 { margin: 0; font-size: 24px; line-height: 1.2; color: var(--forest); }

  .biz-case { background: var(--forest); color: var(--linen); padding: 96px 0; }
  .biz-case__h2 { color: var(--linen); margin-bottom: 40px; }
  .biz-case__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 32px; }
  .biz-case__item {
    padding: 24px 0;
    border-top: 1px solid var(--sage);
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .biz-case__grid.on .biz-case__item { opacity: 1; transform: none; }
  .biz-case__grid.on .biz-case__item:nth-child(2) { transition-delay: 0.2s; }
  .biz-case__grid.on .biz-case__item:nth-child(3) { transition-delay: 0.4s; }
  .biz-case__grid.on .biz-case__item:nth-child(4) { transition-delay: 0.6s; }
  .biz-case__item h3 { margin: 0 0 12px; font-size: 22px; line-height: 1.2; color: var(--linen); }
  .biz-case__item p { margin: 0; font-size: 14.5px; line-height: 1.7; color: var(--on-forest); }

  .biz-person {
    display: grid; grid-template-columns: 72px minmax(0, 1fr); gap: 16px; align-items: center;
    margin-top: 8px; padding: 14px 0;
    border-top: 1px solid var(--on-forest-faint); border-bottom: 1px solid var(--on-forest-faint);
    color: var(--forest); text-decoration: none;
  }
  .biz-person :global(.biz-person__img) { display: block; width: 72px; height: auto; aspect-ratio: 4/5; object-fit: cover; object-position: 50% 20%; border-radius: 2px; }
  .biz-person__text { display: flex; flex-direction: column; gap: 3px; }
  .biz-person__name { font-size: 19px; line-height: 1.2; }
  .biz-person__role { font-size: 13px; color: var(--sage-600); }
  .biz-more { align-self: flex-start; }

  /* Form: boxed fields on lighter linen, as on the board. Markup, ids and names are unchanged. */
  .biz-form-card { padding: 36px 40px; background: var(--linen-50); border: 1px solid var(--hairline); border-top: 3px solid var(--forest); }
  .biz-form-card form { display: grid; grid-template-columns: 1fr 1fr; gap: 20px 24px; }
  .biz-form-row { display: contents; }
  .biz-form-group { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .biz-form-card form > .biz-form-group,
  .biz-form-card form > #biz-form-error,
  .biz-form-card form > #biz-form-success,
  .biz-form-card form > .biz-submit-btn,
  .biz-form-card form > .biz-form-note { grid-column: 1 / -1; }
  .biz-form-group:has(textarea), .biz-form-group:has(input[type="email"]) { grid-column: 1 / -1; }
  .biz-form-group label { font-size: 13px; font-weight: 500; color: var(--forest); }
  .biz-form-group label span[aria-hidden] { color: var(--gold-text); }
  .biz-form-group input,
  .biz-form-group select,
  .biz-form-group textarea {
    width: 100%; box-sizing: border-box;
    padding: 13px 14px; font: inherit; font-size: 15px; color: var(--forest);
    background: var(--linen-50); border: 1px solid var(--hairline-strong); border-radius: 2px;
    transition: border-color 0.18s, box-shadow 0.18s;
  }
  .biz-form-group input:focus,
  .biz-form-group select:focus,
  .biz-form-group textarea:focus { outline: none; border-color: var(--sage-600); box-shadow: 0 0 0 1px var(--sage-600); }
  .biz-form-group textarea { resize: vertical; min-height: 120px; }
  .biz-form-group ::placeholder { color: var(--text-400); }
  .biz-form-message { padding: 14px 16px; font-size: 14px; line-height: 1.6; border-left: 3px solid; }
  .biz-form-message[hidden] { display: none; }
  .biz-error { background: #FBF0EC; border-color: #A6452E; color: #6B2A1B; }
  .biz-success { background: var(--sage-50); border-color: var(--sage-600); color: var(--forest); }
  .biz-success a { color: var(--sage-600); }
  .biz-submit-btn { justify-self: start; border: 1px solid var(--sage-600); }
  .biz-submit-btn:disabled { opacity: 0.6; cursor: default; }
  .biz-form-note { margin: 0; font-size: 13px; line-height: 1.6; color: var(--text-600); }

  @media (max-width: 860px) {
    .biz-hero { padding: 56px 0 64px; }
    .biz-hero__grid { grid-template-columns: 1fr; gap: 36px; }
    .biz-hero__grid > :global(.biz-card) { position: static; }
    .biz-h1 { font-size: 40px; max-width: none; }
    .biz-case { padding: 64px 0; }
    .biz-case__grid { grid-template-columns: 1fr; }
    .biz-form-card { padding: 24px 20px; }
    .biz-form-card form { grid-template-columns: 1fr; }
  }
</style>

<script is:inline define:vars={{ SCRIPT_URL, CONTACT_EMAIL }}>
  (function () {
    const form      = document.getElementById('biz-inquiry-form');
    const errorEl   = document.getElementById('biz-form-error');
    const successEl = document.getElementById('biz-form-success');
    const submitBtn = document.getElementById('biz-submit-btn');

    const formLoadTime = Date.now();

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();

      if (errorEl)   { errorEl.hidden = true; errorEl.textContent = ''; }
      if (successEl) { successEl.hidden = true; successEl.innerHTML = ''; }

      const name       = form.querySelector('#biz-name').value.trim();
      const companyName = form.querySelector('#biz-company').value.trim();
      const email      = form.querySelector('#biz-email').value.trim();
      const employees  = form.querySelector('#biz-employees').value;
      const coverage   = form.querySelector('#biz-coverage').value;
      const message    = form.querySelector('#biz-message').value.trim();

      if (!name || !companyName || !email || !employees) {
        if (errorEl) {
          errorEl.textContent = 'Please fill in all required fields.';
          errorEl.hidden = false;
        }
        return;
      }

      submitBtn.disabled    = true;
      submitBtn.textContent = 'Sending…';

      try {
        // Fold all business fields into message so the Apps Script receives them
        const msgLines = [
          `Business inquiry from ${name} at ${companyName}.`,
          `Employees: ${employees}`,
        ];
        if (coverage) msgLines.push(`Current coverage: ${coverage}`);
        if (message)  { msgLines.push('', '---', '', message); }
        msgLines.push('', '---', `Reply-to: ${email}`);

        const res = await fetch(SCRIPT_URL, {
          method:  'POST',
          headers: { 'Content-Type': 'text/plain' },
          body: JSON.stringify({
            firstName:  name,
            lastName:   '',
            email,
            phone:      '',
            interest:   'Employer / Business membership',
            familySize: '',
            referral:   '',
            message:    msgLines.join('\n'),
            page:       window.location.href,
            referrer:   document.referrer,
            userAgent:  navigator.userAgent,
            company:    '',
            source:     'business',
            loadTime:   formLoadTime,
          }),
        });

        if (!res.ok) throw new Error(`HTTP ${res.status}`);

        const json = await res.json();
        if (!json.success) throw new Error(json.error || 'Unknown error from script');

        if (window.ffmTrack) {
          window.ffmTrack('generate_lead', {
            source: 'business',
            employees,
            coverage,
          });
        }

        if (successEl) {
          successEl.innerHTML = `
            <strong>Message received!</strong> We'll follow up within one business day to discuss your team's options.<br />
            Questions in the meantime? Email <a href="mailto:${CONTACT_EMAIL}">${CONTACT_EMAIL}</a>.
          `;
          successEl.hidden = false;
          successEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          form.reset();
        }

      } catch (err) {
        console.error('Form submission error:', err);
        if (errorEl) {
          errorEl.textContent =
            `Something went wrong — please email us directly at ${CONTACT_EMAIL}.`;
          errorEl.hidden = false;
        }
      } finally {
        submitBtn.disabled    = false;
        submitBtn.textContent = 'Request a Conversation';
      }
    });
  })();
</script>
