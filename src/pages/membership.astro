---
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import SageCard from '../components/shared/SageCard.astro';

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Membership", "item": "https://www.forwardfamilymedicine.com/membership/" }
  ]
};

const faqs = [
  {
    q: 'Is this health insurance?',
    a: "No. DPC membership is not insurance. It covers your primary care needs directly. We recommend pairing it with a high-deductible health plan or health sharing plan to cover hospitalizations, surgeries, and specialist care.",
  },
  {
    q: 'Can I use my HSA or FSA for DPC membership?',
    a: "In many cases, yes — particularly following the Primary Care Enhancement Act (effective January 1, 2026), which clarified that HSA funds may be used for DPC memberships. Please confirm eligibility with your plan administrator.",
  },
  {
    q: 'What does my membership cover?',
    a: "Unlimited office visits (no copay), same-day and next-day appointments, visits of 1–2 hours, direct phone/text/email access to your doctor, preventive care, chronic disease management, minor procedures, wholesale lab pricing, telehealth, specialist referral coordination, and integrated Lifestyle Medicine with Dr. Lieberman.",
  },
  {
    q: "Are there any additional fees for Lifestyle Medicine?",
    a: "No. Lifestyle medicine is integrated into how Dr. Lieberman practices — it's part of your membership, not an add-on service.",
  },
  {
    q: 'Can I cancel my membership?',
    a: "All memberships include a 6-month minimum commitment from your enrollment date. After that period, month-to-month plans require 30 days' written notice to cancel.",
  },
  {
    q: "What if I need a specialist or hospital care?",
    a: "Your DPC membership covers primary care. For specialist referrals, we coordinate directly — calling ahead, advocating for you, and ensuring continuity of care. For hospitalizations and surgical care, you'll need a separate insurance plan.",
  },
];

const INDIVIDUAL_ENROLLMENT_LINK = 'https://forwardfamilymedicine.sigmamd.com/signup/individual-membership';
const FAMILY_ENROLLMENT_LINK = 'https://forwardfamilymedicine.sigmamd.com/signup/family-membership';
const PATIENT_PORTAL_LINK = 'https://patient.sigmamd.com';

const individualFeatures = [
  'Unlimited office visits, no copay',
  'Same-day and next-day appointments',
  'Visits: 1–2 hours',
  'Direct phone, text &amp; email access to your doctor',
  'Preventive care and annual wellness exams',
  'Chronic disease management',
  'Minor in-office procedures',
  'Wholesale lab and medication pricing',
  'Telehealth visits',
  'Specialist referral coordination',
  'Board-certified Lifestyle Medicine (with Dr. Lieberman, dual board-certified in Family Medicine &amp; Lifestyle Medicine)',
];
const familyTiers = [
  ['2 members', '$175/person/month'],
  ['3 members', '$150/person/month'],
  ['4 members', '$125/person/month'],
  ['5+ members', '$100/person/month'],
];
const familyFeatures = [
  'Everything in Individual Membership',
  'Coverage for 2 or more family members',
  'Each member gets their own doctor relationship',
  'Coordinated family health planning',
  'Pediatric-friendly care options',
  'Wholesale lab pricing for the whole family',
  'All members access Lifestyle Medicine with Dr. Lieberman',
];
const employerFeatures = [
  'Flat per-employee monthly membership',
  'Pairs with your existing health plan',
  'Employees get unlimited primary care, no copays',
  'Direct doctor access for your whole team',
  'Fewer sick days and ER visits',
  'Access to board-certified Lifestyle Medicine',
  "Inquiry-based — we'll build a plan for your company",
];
const covers = [
  { title: 'Primary Care', items: ['Annual physicals and wellness exams', 'Sick visits and acute care', 'Preventive screenings', 'Chronic condition monitoring', 'Prescription management', 'Lab review and follow-up'] },
  { title: 'Access & Convenience', items: ['Same-day and next-day appointments', 'Visits: 1–2 hours', 'Direct phone, text, and email access', 'Telehealth included', 'After-hours communication (urgent questions)'] },
  { title: 'Lifestyle Medicine', items: ['Comprehensive lifestyle assessment', 'Personalized nutrition guidance', 'Physical activity planning', 'Sleep optimization', 'Stress management', 'Chronic disease reversal protocols'] },
  { title: 'Cost Savings', items: ['Wholesale lab pricing — CBC: $2 | CMP: $2 | Lipid panel: $3 | ApoB: $7 | Thyroid panel: $7', 'Medications dispensed at cost — no pharmacy markup', 'Reduced urgent care and ER visits through same-day access', 'Discounted imaging coordination at local centers', 'No per-visit fees, ever'] },
];
const chips = ['Prenuvo whole-body MRI', '~250 biomarker results/year', 'Gut microbiome panel', '6 weeks CGM', 'DEXA 2×/year', 'VO₂ max 2×/year', 'Full FFM membership included'];
---

<MainLayout
  title="Membership & Pricing | Forward Family Medicine Wayne PA"
  description="DPC membership plans at Forward Family Medicine in Wayne, PA. Individual and family options. Flat monthly fee. No insurance. Includes board-certified Lifestyle Medicine."
  schema={breadcrumb}
>
  <section class="mem-hero">
    <div class="rd-wrap mem-hero__grid">
      <div class="mem-hero__copy">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Home</a> <span aria-hidden="true">›</span> <span>Membership</span>
        </nav>
        <h1 class="mem-hero__title rd-serif">Membership &amp; Pricing</h1>
        <p class="mem-hero__lede">Concierge-quality care. DPC pricing. Lifestyle Medicine included. One flat monthly fee — no insurance, no copays, no surprises.</p>
      </div>
      <SageCard class="value-quote">
        <span class="value-mark rd-serif" aria-hidden="true">“</span>
        <blockquote class="value-text rd-serif">
          Your membership includes something no other DPC practice on the Main Line
          offers: integrated, in-person Lifestyle Medicine. A physician
          with a culinary arts degree, a nutrition science background, and a Lifestyle
          Medicine certification who knows your name, answers your calls, and has
          a plan for your long-term health. That's what the membership covers.
        </blockquote>
      </SageCard>
    </div>
  </section>

  <section class="rd-section rd-alt" id="plans">
    <div class="rd-wrap">
      <h2 class="rd-h2 plans-h2">Membership Options</h2>
      <div class="plans" data-reveal="0.05">
        <div class="plan plan--pop">
          <p class="plan-tag plan-tag--gold">Most Popular</p>
          <h3 class="plan-h rd-serif">Individual Membership</h3>
          <div class="plan-price rd-serif">$200<span class="plan-unit">/month</span></div>
          <p class="plan-line">Primary care plus board-certified lifestyle medicine — for you, personally.</p>
          <ul class="plan-list">{individualFeatures.map(f => <li set:html={f}></li>)}</ul>
          <div class="plan-foot">
            <a href={INDIVIDUAL_ENROLLMENT_LINK} class="btn-forest">Enroll as Individual</a>
            <a href="/contact/?source=membership" class="rd-link">Start with a free meet &amp; greet</a>
          </div>
        </div>

        <div class="plan">
          <p class="plan-tag">Family</p>
          <h3 class="plan-h rd-serif">Family Membership</h3>
          <dl class="plan-tiers">
            {familyTiers.map(([size, rate]) => <div><dt>{size}</dt><dd>{rate}</dd></div>)}
          </dl>
          <p class="plan-line">Whole-family care — every member gets direct access, real time, and genuine relationship.</p>
          <ul class="plan-list">{familyFeatures.map(f => <li>{f}</li>)}</ul>
          <div class="plan-foot">
            <a href={FAMILY_ENROLLMENT_LINK} class="btn-forest">Enroll Your Family</a>
            <a href="/contact/?source=membership" class="rd-link">Start with a free meet &amp; greet</a>
          </div>
        </div>

        <div class="plan">
          <p class="plan-tag">Employer</p>
          <h3 class="plan-h rd-serif">Employer / Business</h3>
          <div class="plan-price plan-price--custom rd-serif">Custom Plan</div>
          <p class="plan-note">Priced per employee per month — built around your team size and structure.</p>
          <p class="plan-line">Better healthcare for your team — simpler than traditional insurance and genuinely more valuable.</p>
          <ul class="plan-list">{employerFeatures.map(f => <li>{f}</li>)}</ul>
          <div class="plan-foot">
            <a href="/for-businesses/" class="btn-forest">Learn About Employer Plans</a>
            <a href="/contact/?source=membership" class="rd-link">Or contact us directly →</a>
          </div>
        </div>
      </div>

      <div class="notes">
        <div class="notes-list">
          <p><strong>Children &amp; pediatric patients:</strong> Children are welcome at all ages. Children under 26 may be added to a family membership at the applicable per-person family rate. Contact us with questions about pediatric pricing.</p>
          <p><strong>Panel size is capped at ~250 patients per physician</strong> to ensure timely access to your doctor. When a panel fills, we open a waitlist.</p>
          <p>Already a patient? <a href={PATIENT_PORTAL_LINK} target="_blank" rel="noopener noreferrer" class="rd-link">Log in to the Patient Portal →</a></p>
        </div>
        <SageCard>
          <h3 class="rd-h3 notes-h">Not sure which plan is right for you?</h3>
          <p>Start with a free, no-obligation meet and greet. Come in, meet the team, ask every question — and we'll help you figure out the best fit. No pressure, no commitment.</p>
          <a href="/contact/?source=membership" class="btn-forest notes-btn">Schedule a Free Meet &amp; Greet</a>
        </SageCard>
      </div>
    </div>
  </section>

  <section class="covers-band">
    <div class="rd-wrap">
      <h2 class="rd-h2 covers-h2">What Your Membership Covers</h2>
      <div class="covers" data-reveal="0.1">
        {covers.map(c => (
          <div class="covers-col">
            <h3 class="covers-h3 rd-serif">{c.title}</h3>
            <ul>{c.items.map(i => <li>{i}</li>)}</ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="clarity-strip rd-sage">
    <div class="rd-wrap clarity-grid">
      <div class="rd-stack">
        <h2 class="rd-h2 clarity-h2">The Clarity Program</h2>
        <p class="rd-copy clarity-desc">A physician-led longitudinal health operating system — Prenuvo whole-body MRI, advanced biomarker panels, gut microbiome, continuous glucose monitoring, DEXA, and VO₂ max, read together by a single physician across your full program year.</p>
        <div class="chips">{chips.map(c => <span>{c}</span>)}</div>
      </div>
      <div class="clarity-price">
        <p class="clarity-amount rd-serif">$9,600</p>
        <p class="clarity-period">per year · paid annually · HSA-eligible</p>
        <a href="/clarity/" class="btn-forest">See the full program</a>
        <a href="/new-patients/?source=clarity#request" class="rd-link">Schedule an inquiry call →</a>
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Membership FAQs" />
  <CTABanner
    headline="The Best Time to Start Is Now"
    subhead="Begin with a free, no-obligation meet and greet. No paperwork, no credit card, no pressure. Just a conversation with your future doctor."
    btnHref="/contact/?source=membership"
    btn2Text="Enroll Now →"
    btn2Href={INDIVIDUAL_ENROLLMENT_LINK}
  />
</MainLayout>

<style>
  .crumb { font-size: 13px; color: var(--text-500); }
  .crumb a { color: var(--text-500); }
  .crumb a:hover { color: var(--forest); }
  .crumb span:last-child { color: var(--text-700); }
  .mem-hero { background: var(--linen); padding: 80px 0 96px; }
  .mem-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 72px; align-items: center; }
  .mem-hero__copy { display: flex; flex-direction: column; gap: 22px; }
  .mem-hero__title { margin: 0; font-size: 64px; line-height: 1.02; letter-spacing: -0.018em; color: var(--forest); }
  .mem-hero__lede { margin: 0; font-size: 18px; line-height: 1.7; color: var(--text-900); max-width: 600px; }
  .crumb { margin-bottom: 18px; }
  .value-quote { gap: 6px; }
  .value-mark { font-size: 64px; line-height: 0.6; color: var(--sage); }
  .value-text { margin: 0; font-size: 18px; line-height: 1.5; color: var(--forest); }

  .plans-h2 { margin-bottom: 40px; }
  .plans { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 48px; align-items: stretch; }
  .plan {
    display: flex; flex-direction: column; gap: 12px;
    border-top: 3px solid var(--forest);
    padding-top: 22px;
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .plans.on .plan { opacity: 1; transform: none; }
  .plans.on .plan:nth-child(2) { transition-delay: 0.2s; }
  .plans.on .plan:nth-child(3) { transition-delay: 0.4s; }
  .plan-tag { margin: 0; font-size: 13px; font-weight: 500; color: var(--sage-600); }
  .plan-tag--gold { color: var(--gold); }
  .plan-h { margin: 0; font-size: 28px; line-height: 1.15; color: var(--forest); }
  .plan-price { font-size: 48px; line-height: 1; letter-spacing: -0.02em; color: var(--forest); }
  .plan-price--custom { font-size: 36px; line-height: 1.1; letter-spacing: -0.015em; }
  .plan-unit { font-size: 18px; letter-spacing: 0; color: var(--text-600); }
  .plan-line { margin: 0; font-size: 15px; line-height: 1.65; color: var(--text-700); }
  .plan-note { margin: 0; font-size: 14px; line-height: 1.6; color: var(--text-600); }
  .plan-list { margin: 6px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .plan-list li { padding: 11px 0; border-top: 1px solid var(--hairline-strong); font-size: 14.5px; line-height: 1.55; color: var(--text-900); }
  .plan-list li:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .plan-tiers { display: flex; flex-direction: column; margin: 0; }
  .plan-tiers div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-top: 1px solid var(--hairline-strong); font-size: 14.5px; }
  .plan-tiers div:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .plan-tiers dt { color: var(--text-700); }
  .plan-tiers dd { margin: 0; color: var(--forest); font-weight: 500; }
  .plan-foot { margin-top: auto; padding-top: 22px; display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }

  .notes { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; align-items: start; margin-top: 64px; }
  .notes-list { display: flex; flex-direction: column; font-size: 15px; line-height: 1.7; color: var(--text-900); }
  .notes-list p { margin: 0; padding: 16px 0; border-top: 1px solid var(--hairline-strong); }
  .notes-list p:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .notes-list strong { font-weight: 500; color: var(--forest); }
  .notes-h { font-size: 24px; }
  .notes-btn { align-self: flex-start; margin-top: 4px; }

  .covers-band { background: var(--forest); color: var(--linen); padding: 96px 0; }
  .covers-h2 { color: var(--linen); margin-bottom: 40px; }
  .covers { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 32px; }
  .covers-col { opacity: 0; transform: translateY(8px); transition: opacity 0.6s ease, transform 0.6s ease; }
  .covers.on .covers-col { opacity: 1; transform: none; }
  .covers.on .covers-col:nth-child(2) { transition-delay: 0.15s; }
  .covers.on .covers-col:nth-child(3) { transition-delay: 0.3s; }
  .covers.on .covers-col:nth-child(4) { transition-delay: 0.45s; }
  .covers-h3 { margin: 0 0 14px; font-size: 22px; color: var(--linen); }
  .covers-col ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .covers-col li { padding: 10px 0; border-top: 1px solid var(--sage); font-size: 14px; line-height: 1.5; color: var(--on-forest); }
  .covers-col li:last-child { border-bottom: 1px solid var(--sage); }

  .clarity-strip { padding: 80px 0; }
  .clarity-grid { display: grid; grid-template-columns: minmax(0, 1.3fr) auto; gap: 64px; align-items: start; }
  .clarity-h2 { font-size: 40px; }
  .clarity-desc { max-width: 640px; }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chips span { font-size: 13px; color: var(--forest); padding: 6px 12px; border: 1px solid var(--on-forest-faint); border-radius: 999px; background: var(--linen); }
  .clarity-price { display: flex; flex-direction: column; gap: 14px; align-items: flex-end; text-align: right; min-width: 260px; }
  .clarity-price p { margin: 0; }
  .clarity-amount { font-size: 56px; line-height: 1; letter-spacing: -0.02em; color: var(--forest); }
  .clarity-period { font-size: 13.5px; color: var(--sage-600); font-weight: 500; }
  .clarity-price .btn-forest { margin-top: 8px; }

  @media (max-width: 860px) {
    .mem-hero { padding: 48px 0 64px; }
    .mem-hero__grid { grid-template-columns: 1fr; gap: 36px; }
    .mem-hero__title { font-size: 40px; }
    .plans, .notes, .covers, .clarity-grid { grid-template-columns: 1fr; gap: 40px; }
    .covers { gap: 36px; }
    .covers-band { padding: 64px 0; }
    .clarity-strip { padding: 56px 0; }
    .clarity-h2 { font-size: 30px; }
    .clarity-price { align-items: flex-start; text-align: left; min-width: 0; }
    .plan-h { font-size: 24px; }
  }
</style>
