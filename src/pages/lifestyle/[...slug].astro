---
/**
 * Lifestyle Library articles and the eight section hubs, on the shared
 * article template (board LibPost): no hero image, the section as the small
 * link above the title, the "Quick answer" callout, and "More in <Section>"
 * in the rail. The body is the entry's rendered HTML with its leading H1
 * removed, so each page has one H1 (37 older entries open with a Markdown
 * H1 that repeated the title); copy and dates are unchanged.
 */
import { getCollection, render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { authorSlug } from '../../utils/authors';
import { libraryRelated } from '../../utils/related';
import { contactHrefForPath } from '../../utils/leadSource';
import { libraryCategoryLabel, libraryCategoryOf, librarySlug } from '../../data/libraryCategories';

export async function getStaticPaths() {
  const entries = await getCollection('lifestyle');
  return entries
    .filter(entry => !entry.data.draft)
    .map(entry => ({
      params: { slug: entry.id.replace(/\.mdx?$/, '').replace(/\/index$/, '') },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { headings } = await render(entry);
const slug = librarySlug(entry);
const canonicalUrl = `https://www.forwardfamilymedicine.com/lifestyle/${slug}/`;

// Body: rendered HTML, minus a leading H1, with the opening "Quick answer"
// paragraph lifted into the callout. Nothing else is touched.
const rendered = entry.rendered?.html ?? '';
let body = rendered.replace(/^\s*<h1\b[^>]*>[\s\S]*?<\/h1>\s*/, '');
let quickHtml = '';
const quick = body.match(/^\s*<p><strong>Quick answer:<\/strong>([\s\S]*?)<\/p>\s*/);
if (quick) {
  quickHtml = `<div class="art-quick"><p><strong>Quick answer:</strong>${quick[1]}</p></div>`;
  body = body.slice(quick[0].length);
}
// The H1 shows the title without the "| Forward Family Medicine" suffix some
// hub titles carry; the <title> keeps it, as before.
const heading = entry.data.title.replace(/\s*\|\s*Forward Family Medicine\s*$/, '');

const dateObj = entry.data.date ? new Date(entry.data.date) : null;
// A bare frontmatter date is a calendar date; UTC keeps it from rendering a day early in US time zones.
const dateFormatted = dateObj?.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const dateISO = dateObj?.toISOString();

const authorDisplay: Record<string, string> = {
  'Dr. Philip Lieberman': 'Dr. Philip Lieberman, MD — Board-Certified Family Medicine & Lifestyle Medicine',
  'Dr. David Bigley': 'Dr. David Bigley, DO — Board-Certified Family Medicine',
  'David Bigley, DO': 'Dr. David Bigley, DO — Board-Certified Family Medicine',
  'Dr. Brian Landi': 'Dr. Brian Landi, DO — Board-Certified Family Medicine & Menopause Society Certified Practitioner',
  'Brian Landi, DO': 'Dr. Brian Landi, DO — Board-Certified Family Medicine & Menopause Society Certified Practitioner',
};
const author = entry.data.author;
const authorLabel = author ? (authorDisplay[author] ?? author) : null;
const authorBioSlug = authorSlug(author);
const providers = await getCollection('providers');
const authorProvider = authorBioSlug ? providers.find(p => p.data.slug === authorBioSlug) : undefined;

const dir = libraryCategoryOf(entry);
const related = libraryRelated({ entry, entries: await getCollection('lifestyle') });
---

<ArticleLayout
  title={heading}
  pageTitle={entry.data.title}
  description={entry.data.description}
  canonical={canonicalUrl}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Lifestyle Medicine', href: '/lifestyle-medicine/' },
    { label: 'Library', href: '/lifestyle/' },
    { label: heading },
  ]}
  category={{ label: libraryCategoryLabel(dir), href: `/lifestyle/#${dir}` }}
  author={{
    label: authorLabel ?? 'Forward Family Medicine',
    href: authorBioSlug ? `/meet-the-team/${authorBioSlug}/` : undefined,
    photo: authorProvider?.data.photo,
    photoAlt: authorProvider?.data.photoAlt,
  }}
  authorKey={author}
  dateISO={authorLabel && dateISO ? dateISO : undefined}
  dateFormatted={authorLabel && dateISO ? dateFormatted : undefined}
  headings={headings}
  related={related}
  contactHref={contactHrefForPath(`/lifestyle/${slug}/`)}
  closing={{
    headline: 'Ready to experience medicine the way it should be?',
    subhead: 'Schedule a free, no-obligation meet and greet with one of our physicians. No pressure, no commitment — just a conversation.',
    btnText: 'Schedule a Free Meet & Greet',
  }}
>
  <Fragment set:html={quickHtml} />
  <Fragment set:html={body} />
</ArticleLayout>
