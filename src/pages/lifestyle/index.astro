---
/**
 * The Lifestyle Library index, per the Library board: title and intro beside
 * the Wayne shelf photo, a sticky section index with scroll-spy (static when it
 * does not fit under the header), each section as a two-column ruled list of
 * title and description, the Environmental Health Series card, and the closing
 * band. Copy is the page's own. Each section lists its hub page first, then
 * its articles in title order.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import CTABanner from '../../components/shared/CTABanner.astro';
import shelfPhoto from '../../assets/office/wayne-shelf.jpg';
import { LIBRARY_CATEGORY_LABELS, LIBRARY_CATEGORY_ORDER, isLibraryHub, libraryCategoryOf, librarySlug } from '../../data/libraryCategories';
import { contactHrefForPath } from '../../utils/leadSource';

// Curated cross-link block. These six posts live in the `blog` collection
// (their canonical home) and are surfaced here for discoverability.
// Edit this list by hand to add or remove entries.
const ENVIRONMENTAL_HEALTH_SERIES = [
  { title: "You Don't Need a Toxic-Free Home", url: '/blog/reducing-chemical-exposure-at-home/' },
  { title: 'PFAS: What Are Forever Chemicals?', url: '/blog/pfas-forever-chemicals-reduce-exposure/' },
  { title: 'Microplastics: 10 Everyday Sources', url: '/blog/microplastics-everyday-sources/' },
  { title: 'Is Your Cookware Working Against You?', url: '/blog/choosing-healthier-cookware/' },
  { title: 'Do You Really Need to Disinfect Your Entire House?', url: '/blog/do-you-need-to-disinfect-your-house/' },
  { title: 'The Low-Toxicity Home: 15 Simple Changes', url: '/blog/low-toxicity-home-15-changes/' },
];

const entries = await getCollection('lifestyle');
const published = entries
  .filter(e => !e.data.draft)
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const grouped: Record<string, typeof published> = {};
for (const entry of published) {
  const cat = libraryCategoryOf(entry);
  (grouped[cat] ??= []).push(entry);
}
const sections = LIBRARY_CATEGORY_ORDER
  .filter(cat => grouped[cat]?.length)
  .map(cat => ({
    id: cat,
    label: LIBRARY_CATEGORY_LABELS[cat],
    entries: [...grouped[cat].filter(isLibraryHub), ...grouped[cat].filter(e => !isLibraryHub(e))],
  }));

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Lifestyle Medicine", "item": "https://www.forwardfamilymedicine.com/lifestyle-medicine/" },
    { "@type": "ListItem", "position": 3, "name": "Lifestyle Library", "item": "https://www.forwardfamilymedicine.com/lifestyle/" }
  ]
};
---

<MainLayout
  title="Lifestyle Medicine Library | Forward Family Medicine Wayne, PA"
  description="Evidence-based articles on nutrition, physical activity, sleep, metabolic health, stress, and cardiovascular prevention — from the physicians at Forward Family Medicine."
  canonical="https://www.forwardfamilymedicine.com/lifestyle/"
  schema={breadcrumb}
>
  <section class="lib-hero">
    <div class="rd-wrap">
      <nav class="rd-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span>
        <a href="/lifestyle-medicine/">Lifestyle Medicine</a> <span aria-hidden="true">›</span>
        <span aria-current="page">Library</span>
      </nav>
      <div class="lib-hero__grid">
        <div class="lib-hero__copy">
          <h1 class="rd-h1 lib-hero__h1">Lifestyle Medicine Library</h1>
          <p class="lib-hero__intro">
            Articles written by the physicians at Forward Family Medicine covering the six pillars of
            lifestyle medicine — nutrition, physical activity, sleep, stress management, social
            connection, and avoiding risky substances.
          </p>
        </div>
        <Image
          src={shelfPhoto}
          alt="A reading shelf in the Wayne office"
          widths={[420, 640, 840]}
          sizes="(max-width: 860px) calc(100vw - 40px), 420px"
          format="webp"
          quality={82}
          loading="eager"
          fetchpriority="high"
          class="lib-hero__img"
        />
      </div>
    </div>
  </section>

  <section class="lib-body">
    <div class="rd-wrap lib-body__grid">
      <nav class="lib-idx" aria-label="Library sections" data-sticky-fit data-library-index>
        {sections.map(s => <a href={`#${s.id}`}>{s.label}</a>)}
        <a href="#environmental">Environmental Health Series</a>
      </nav>

      <div class="lib-sections">
        {sections.map(s => (
          <section id={s.id} class="lib-sec">
            <h2 class="lib-sec__h2 rd-serif">{s.label}</h2>
            <div class="lib-list" data-reveal>
              {s.entries.map((entry, i) => (
                <a
                  href={`/lifestyle/${librarySlug(entry)}/`}
                  class:list={['lib-item', { 'lib-item--wide': s.entries.length % 2 === 1 && i === s.entries.length - 1 }]}
                >
                  <span class="lib-item__title rd-serif">{entry.data.title.replace(/\s*\|\s*Forward Family Medicine\s*$/, '')}</span>
                  {entry.data.description && <span class="lib-item__desc">{entry.data.description}</span>}
                </a>
              ))}
            </div>
          </section>
        ))}

        <section id="environmental" class="lib-env">
          <div class="lib-env__head">
            <h2 class="lib-sec__h2 rd-serif">New: Environmental Health Series</h2>
            <p class="lib-env__intro">
              A six-part series by Dr. Philip Lieberman on reducing everyday chemical
              exposure — published on our blog.
            </p>
          </div>
          <div class="lib-env__grid">
            {ENVIRONMENTAL_HEALTH_SERIES.map(post => (
              <a class="lib-read" href={post.url}><span class="rd-serif">{post.title}</span></a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <CTABanner
    headline="Lifestyle Medicine as Part of Your Care"
    subhead="Forward Family Medicine is the only DPC practice on the Main Line with in-person, board-certified Lifestyle Medicine integrated into membership. No extra cost."
    btnText="Schedule a Free Meet & Greet"
    btnHref={contactHrefForPath('/lifestyle/')}
  />
</MainLayout>

<script>
  import { initScrollSpy } from '../../scripts/scrollSpy';
  initScrollSpy(
    document.querySelector('[data-library-index]'),
    Array.from(document.querySelectorAll('.lib-sec[id], .lib-env[id]')),
  );
</script>

<style>
  .lib-hero { background: var(--linen); padding: 80px 0 88px; }
  .lib-hero__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: 72px; align-items: center; }
  .lib-hero__copy { display: flex; flex-direction: column; gap: 22px; }
  .lib-hero__h1 { max-width: 12ch; }
  .lib-hero__intro { margin: 0; font-size: 18px; line-height: 1.7; color: var(--text-900); }
  .lib-hero :global(.lib-hero__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 45%;
    border-radius: 2px;
  }

  .lib-body { background: var(--linen); padding: 0 0 96px; }
  .lib-body__grid { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: 72px; align-items: start; }
  .lib-idx { display: flex; flex-direction: column; }
  .lib-idx a {
    display: block;
    padding: 12px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 14.5px;
    color: var(--forest);
    text-decoration: none;
    position: relative;
  }
  .lib-idx a:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .lib-idx a::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 2px;
    background: var(--sage);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .lib-idx a:hover::after, .lib-idx a.cur::after { transform: none; }
  .lib-idx a.cur { color: var(--sage-600); }

  .lib-sections { display: flex; flex-direction: column; min-width: 0; }
  .lib-sec { padding-top: 64px; }
  .lib-sec:first-child { padding-top: 0; }
  .lib-sec__h2 { margin: 0 0 12px; font-size: 30px; line-height: 1.15; color: var(--forest); }
  .lib-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 48px; }
  .lib-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 22px 0;
    border-top: 1px solid var(--hairline-strong);
    color: var(--forest);
    text-decoration: none;
    opacity: 0;
    transform: translateX(22px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .lib-item:nth-last-child(-n+2) { border-bottom: 1px solid var(--hairline-strong); }
  .lib-item--wide { grid-column: 1 / -1; border-bottom: 1px solid var(--hairline-strong); }
  .lib-list.on .lib-item { opacity: 1; transform: none; }
  .lib-list.on .lib-item:nth-child(1) { transition-delay: 0.1s; }
  .lib-list.on .lib-item:nth-child(2) { transition-delay: 0.22s; }
  .lib-list.on .lib-item:nth-child(3) { transition-delay: 0.34s; }
  .lib-list.on .lib-item:nth-child(4) { transition-delay: 0.46s; }
  .lib-list.on .lib-item:nth-child(5) { transition-delay: 0.58s; }
  .lib-list.on .lib-item:nth-child(n+6) { transition-delay: 0.7s; }
  .lib-item__title { font-size: 20px; line-height: 1.3; transition: color 0.18s; }
  .lib-item:hover .lib-item__title { color: var(--sage-600); }
  .lib-item__desc { font-size: 14px; line-height: 1.65; color: var(--text-700); }

  .lib-env { margin-top: 72px; padding: 36px 40px; background: var(--sage-50); border-top: 3px solid var(--forest); }
  .lib-env__head { display: flex; flex-direction: column; gap: 8px; margin-bottom: 18px; }
  .lib-env__head .lib-sec__h2 { margin: 0; }
  .lib-env__intro { margin: 0; font-size: 15px; line-height: 1.65; color: var(--text-700); }
  .lib-env__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 40px; }
  .lib-read {
    display: block;
    padding: 16px 0;
    border-top: 1px solid var(--on-forest-faint);
    color: var(--forest);
    text-decoration: none;
    font-size: 18px;
    line-height: 1.3;
    position: relative;
  }
  .lib-read:nth-last-child(-n+2) { border-bottom: 1px solid var(--on-forest-faint); }
  .lib-read::after {
    content: "";
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 2px;
    background: var(--sage);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .lib-read:hover::after { transform: none; }
  .lib-read:hover { z-index: 1; }

  @media (max-width: 860px) {
    .lib-hero { padding: 48px 0 56px; }
    .lib-hero__grid { grid-template-columns: 1fr; gap: 28px; }
    .lib-hero__h1 { max-width: none; }
    .lib-hero :global(.lib-hero__img) { max-width: 360px; }
    .lib-body { padding-bottom: 64px; }
    .lib-body__grid { grid-template-columns: 1fr; gap: 28px; }
    .lib-idx { flex-direction: row; overflow-x: auto; gap: 8px; padding-bottom: 4px; }
    .lib-idx a { border: 1px solid var(--hairline-strong) !important; border-radius: 999px; padding: 8px 14px; white-space: nowrap; font-size: 13px; }
    .lib-idx a::after { display: none; }
    .lib-sec { padding-top: 48px; }
    .lib-list { grid-template-columns: 1fr; }
    .lib-item { border-bottom: 0 !important; }
    .lib-item:last-child { border-bottom: 1px solid var(--hairline-strong) !important; }
    .lib-env { margin-top: 48px; padding: 28px 22px; }
    .lib-env__grid { grid-template-columns: 1fr; }
    .lib-read { border-bottom: 0; }
    .lib-read:last-child { border-bottom: 1px solid var(--on-forest-faint); }
  }
</style>
