---
/**
 * About, per the About board. Copy is the live page's, word for word. The
 * board's second closing-band button ("Meet the team") is board-only; the live
 * "Meet the team →" link sits under the team row instead. The team row reads
 * the collections (board order: founder first), so names and roles are the
 * live ones.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../layouts/MainLayout.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import RuledList from '../components/shared/RuledList.astro';
import SageCard from '../components/shared/SageCard.astro';
import diplomaShelf from '../assets/office/wayne-diploma-shelf.jpg';

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "About", "item": "https://www.forwardfamilymedicine.com/about/" }
  ]
};

const entries = [...(await getCollection('providers')), ...(await getCollection('team'))];
const order = ['david-bigley-do', 'philip-lieberman-md', 'brian-landi-do', 'ashley-arocho'];
const team = order
  .map(slug => entries.find(e => e.data.slug === slug))
  .filter((e): e is NonNullable<typeof e> => Boolean(e))
  .map(e => {
    const d = e.data as any;
    const physician = e.collection === 'providers';
    return {
      href: `/meet-the-team/${d.slug}/`,
      photo: d.photo as ImageMetadata | undefined,
      alt: d.photoAlt || d.name,
      name: physician ? `${d.name}, ${d.credentials}` : d.name,
      role: physician ? d.title : d.credentials,
    };
  });
---

<MainLayout
  title="About Forward Family Medicine | DPC Practice in Wayne PA"
  description="Forward Family Medicine is a Direct Primary Care practice in Wayne, PA — founded to give patients the time, attention, and relationship-based care that the insurance system can't provide."
  schema={breadcrumb}
>
  <section class="about-hero">
    <div class="rd-wrap">
      <nav class="rd-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span> <span aria-current="page">About</span>
      </nav>
      <div class="about-hero__grid">
        <div class="about-hero__copy">
          <h1 class="about-hero__title rd-serif">Why We Started Forward Family Medicine</h1>
          <p class="rd-copy">
            Dr. Bigley trained in traditional medicine and witnessed firsthand the strain the
            insurance-driven system places on patients and physicians — rushed appointments,
            fragmented care, a system that rewards volume over relationship. He chose a different
            path. Founded in September 2024, Forward Family Medicine was built as a Direct Primary Care practice, and Dr. Bigley
            committed to keeping the patient panel small, the doors open, and his attention fully
            on the people in front of him. Dr. Bigley is board-certified in Family Medicine through
            the American Osteopathic Board of Family Physicians (AOBFP). Dr. Lieberman joined the practice bringing dual board
            certification in Family Medicine and Lifestyle Medicine — deepening the clinical
            foundation Dr. Bigley built. Dr. Landi expanded the practice to Chester County in
            2026, bringing Menopause Society Certified Practitioner credentialing and a clinical
            focus on midlife women's health.
          </p>
          <p class="about-hero__line rd-serif">
            At Forward Family Medicine, <em>cura personalis</em> — the care of the whole person — isn't
            a slogan. It's how we practice every day.
          </p>
        </div>
        <div class="about-hero__aside" data-sticky-fit>
          <SageCard>
            <p class="rd-eyebrow">Our Promise</p>
            <p class="about-promise rd-serif">You will never be rushed. Your doctor will know your name, your history, and your goals. Your care will be built around your life — not a billing code.</p>
          </SageCard>
          <Image
            src={diplomaShelf}
            alt="Dr. Bigley's diploma and bookshelf in the Wayne office"
            widths={[360, 540, 720]}
            sizes="(max-width: 860px) calc(100vw - 40px), 400px"
            format="webp"
            quality={80}
            loading="eager"
            fetchpriority="high"
            class="about-hero__img"
          />
          <p class="about-hero__note">
            Forward Family Medicine is located in Wayne, Pennsylvania — serving patients across
            the Main Line, Chester County, and greater Philadelphia. We do not accept insurance.
            We accept patients.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap about-diff">
      <div class="rd-stack about-diff__copy">
        <h2 class="rd-h2">We Don't Just Treat What's Wrong. We Build What's Right.</h2>
        <p class="rd-copy">
          Most primary care practices treat symptoms. We treat causes. Every physician at Forward
          Family Medicine integrates lifestyle medicine — food, movement, sleep, stress — into
          your care as a first-line tool, not an afterthought.
        </p>
        <p class="rd-copy">
          And unlike practices that offer lifestyle medicine virtually or as an add-on service,
          ours is in-person, integrated into every visit, and included in your membership.
        </p>
      </div>
      <div class="about-diff__list">
        <h3 class="rd-h3">What Direct Primary Care means for you</h3>
        <RuledList reveal size="md">
          <li>Same-day and next-day appointments</li>
          <li>1–2 hour visits — no clock watching</li>
          <li>Direct access to your physician by phone, text, or portal</li>
          <li>Panels capped at ~250 patients per physician</li>
          <li>Wholesale lab pricing — no insurance markup</li>
        </RuledList>
      </div>
    </div>
  </section>

  <section class="rd-section about-people">
    <div class="rd-wrap">
      <div class="rd-stack about-people__intro">
        <h2 class="rd-h2">The People Behind the Practice</h2>
        <p class="rd-copy">
          Forward Family Medicine was founded in September 2024 by Dr. David Bigley. Dr. Philip
          Lieberman joined in late 2025, bringing dual board certification in Family Medicine and
          Lifestyle Medicine. Dr. Bigley and Dr. Lieberman were both named Main Line Today Top
          Doctors for 2026. Dr. Brian Landi is accepting new patients now at our Malvern
          office, expanding our capacity to serve the Main Line and Chester County. A West Chester office is planned.
        </p>
      </div>
      <ul class="about-team" data-reveal="0.1">
        {team.map(m => (
          <li>
            <a href={m.href} class="about-member">
              {m.photo && (
                <Image
                  src={m.photo}
                  alt={m.alt}
                  widths={[200, 400, 600]}
                  sizes="(max-width: 860px) calc(50vw - 30px), 270px"
                  format="webp"
                  quality={80}
                  loading="lazy"
                  class="about-member__img"
                />
              )}
              <span class="about-member__name rd-serif">{m.name}</span>
              <span class="about-member__role">{m.role}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href="/meet-the-team/" class="rd-link about-people__link">Meet the team →</a>
    </div>
  </section>

  <CTABanner btnHref="/contact/?source=about" />
</MainLayout>

<style>
  .about-hero { background: var(--linen); padding: 88px 0 96px; }
  .about-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 72px; align-items: start; }
  .about-hero__copy { display: flex; flex-direction: column; gap: 24px; }
  .about-hero__title { margin: 0; font-size: 60px; line-height: 1.04; letter-spacing: -0.015em; color: var(--forest); max-width: 14ch; }
  .about-hero__line { margin: 0; font-size: 24px; line-height: 1.45; color: var(--forest); }
  .about-hero__aside { display: flex; flex-direction: column; gap: 24px; }
  .about-promise { margin: 0; font-size: 22px; line-height: 1.4; color: var(--forest); }
  .about-hero :global(.about-hero__img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 40%; border-radius: 2px; }
  .about-hero__note { margin: 0; font-size: 14px; line-height: 1.7; color: var(--text-700); }

  .about-diff { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 72px; align-items: start; }
  .about-diff__list { display: flex; flex-direction: column; gap: 14px; padding-top: 6px; }

  .about-people__intro { max-width: 820px; }
  .about-team { margin: 48px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 32px; }
  .about-member { display: flex; flex-direction: column; gap: 12px; color: var(--forest); text-decoration: none; }
  .about-member :global(.about-member__img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: 2px; background: var(--linen-300); }
  .about-member__name { font-size: 20px; line-height: 1.2; }
  .about-member__role { font-size: 13px; line-height: 1.5; color: var(--sage-600); }
  .about-member:hover .about-member__name { color: var(--sage-600); }
  .about-people__link { margin-top: 36px; }
  .about-team li { opacity: 0; transform: translateY(10px); transition: opacity 0.55s ease, transform 0.55s ease; }
  .about-team.on li { opacity: 1; transform: none; }
  .about-team.on li:nth-child(2) { transition-delay: 0.15s; }
  .about-team.on li:nth-child(3) { transition-delay: 0.3s; }
  .about-team.on li:nth-child(4) { transition-delay: 0.45s; }

  @media (max-width: 860px) {
    .about-hero { padding: 48px 0 56px; }
    .about-hero__grid, .about-diff { grid-template-columns: 1fr; gap: 36px; }
    .about-hero__aside { max-width: 460px; }
    .about-hero__title { font-size: 40px; max-width: none; }
    .about-hero__line { font-size: 21px; }
    .about-team { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; margin-top: 32px; }
  }
</style>
