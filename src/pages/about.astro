---
import MainLayout from '../layouts/MainLayout.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import BotanicalGraphic from '../components/shared/BotanicalGraphic.astro';

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "About", "item": "https://www.forwardfamilymedicine.com/about" }
  ]
};
---

<MainLayout
  title="About Forward Family Medicine | DPC Practice in Wayne PA"
  description="Forward Family Medicine is a Direct Primary Care practice in Wayne, PA — founded to give patients the time, attention, and relationship-based care that the insurance system can't provide."
  schema={breadcrumb}
>
  <!-- Page hero -->
  <section class="about-hero section" style="position: relative; overflow: hidden;">
    <BotanicalGraphic variant="starlet" class="about-botanical" />
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span> <span>About</span>
      </nav>
      <span class="section-label">Our Story</span>
      <h1>Why We Started Forward Family Medicine</h1>
      <div class="divider"></div>
      <div class="about-intro grid-2">
        <div>
          <p>
            Dr. Bigley trained in traditional medicine and witnessed firsthand the strain the
            insurance-driven system places on patients and physicians — rushed appointments,
            fragmented care, a system that rewards volume over relationship. He chose a different
            path. Founded in September 2024, Forward Family Medicine was built as a Direct Primary Care practice, and Dr. Bigley
            committed to keeping the patient panel small, the doors open, and his attention fully
            on the people in front of him. Dr. Lieberman joined the practice bringing dual board
            eligibility in Family Medicine and Lifestyle Medicine — deepening the clinical
            foundation Dr. Bigley built. Dr. Landi expanded the practice to Chester County in
            2026, bringing Menopause Society Certified Practitioner credentialing and a clinical
            focus on midlife women's health.
          </p>
          <p>
            At Forward Family Medicine, <em>cura personalis</em> — the care of the whole person — isn't
            a slogan. It's how we practice every day.
          </p>
        </div>
        <div>
          <div class="callout callout-accent">
            <strong>Our Promise</strong>
            <p style="margin-top:0.5rem;">You will never be rushed. Your doctor will know your name, your history, and your goals. Your care will be built around your life — not a billing code.</p>
          </div>
          <p style="margin-top:1.25rem;">
            Forward Family Medicine is located in Wayne, Pennsylvania — serving patients across
            the Main Line, Chester County, and greater Philadelphia. We do not accept insurance.
            We accept patients.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Our Philosophy -->
  <section class="lm-difference section" style="background: var(--cream-200);">
    <div class="container">
      <span class="section-label">What Sets Us Apart</span>
      <h2>We Don't Just Treat What's Wrong. We Build What's Right.</h2>
      <div class="divider"></div>
      <div class="grid-2">
        <div>
          <p>
            Most primary care practices treat symptoms. We treat causes. Every physician at Forward
            Family Medicine integrates lifestyle medicine — food, movement, sleep, stress — into
            your care as a first-line tool, not an afterthought.
          </p>
          <p>
            And unlike practices that offer lifestyle medicine virtually or as an add-on service,
            ours is in-person, integrated into every visit, and included in your membership.
          </p>
        </div>
        <div>
          <div class="callout">
            <strong>What Direct Primary Care means for you</strong>
            <ul class="prose-list" style="margin-top:0.75rem;">
              <li>Same-day and next-day appointments</li>
              <li>1–2 hour visits — no clock watching</li>
              <li>Direct access to your physician by phone, text, or portal</li>
              <li>Panels capped at ~250 patients per physician</li>
              <li>Wholesale lab pricing — no insurance markup</li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Brief team mention -->
  <section class="team-mention section">
    <div class="container">
      <span class="section-label">Our Team</span>
      <h2>The People Behind the Practice</h2>
      <div class="divider"></div>
      <p>
        Forward Family Medicine was founded by Dr. David Bigley in September 2024. Dr. Philip
        Lieberman joined in late 2025, bringing dual board eligibility in Family Medicine and
        Lifestyle Medicine. Dr. Brian Landi joins in August 2026 — expanding our capacity to
        serve the Main Line and Chester County.
      </p>
      <a href="/meet-the-team/" class="btn btn-outline" style="margin-top:1.25rem; display:inline-block;">Meet the team →</a>
    </div>
  </section>

  <CTABanner />
</MainLayout>

<style>
  .about-hero {
    background: var(--cream-100);
    position: relative;
    overflow: hidden;
  }
  .about-hero .container {
    position: relative;
    z-index: 1;
  }
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--ink-300);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--green-300); text-decoration: none; }
  .breadcrumb a:hover { text-decoration: underline; }
</style>
