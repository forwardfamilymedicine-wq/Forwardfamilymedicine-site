---
import MainLayout from '../layouts/MainLayout.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import PageHero from '../components/shared/PageHero.astro';
import RuledList from '../components/shared/RuledList.astro';
---

<MainLayout
  title="Careers | Forward Family Medicine — DPC & Lifestyle Medicine"
  description="Forward Family Medicine is growing across the Main Line. We're always interested in connecting with family medicine physicians who want to practice with small panels, real relationships, and time to listen."
>
  <PageHero crumb="Careers" title="Careers at Forward Family Medicine" size={62} pt={80} pb={96} maxW={820}>
    <p>
      Forward Family Medicine is growing. We're always interested in connecting with
      physicians who want to practice medicine the way it was meant to be practiced —
      small panels, real relationships, and time to actually listen.
    </p>
  </PageHero>

  <!-- Why practice here -->
  <section class="rd-section rd-alt">
    <div class="rd-wrap car-split">
      <div class="rd-stack">
        <h2 class="rd-h2">A Different Way to Practice Medicine</h2>
        <p class="rd-copy">
          Our panels are capped at roughly 250 patients per physician — a fraction of
          the 400–600 typical of direct primary care. That difference is the whole point:
          it's what makes room for the kind of medicine most physicians trained to
          practice but rarely get to.
        </p>
        <p class="rd-copy">
          There's no insurance billing, no RVUs, and no 15-minute visits. You practice
          without the machinery that pulls attention away from the patient in front of you.
        </p>
        <p class="rd-copy">
          Lifestyle medicine is integrated into everyday primary care here — food,
          movement, sleep, and stress as first-line tools, not a service bolted on
          after the fact.
        </p>
      </div>
      <div class="car-list">
        <h3 class="rd-h3">What that looks like day to day</h3>
        <RuledList reveal size="md">
          <li>~250-patient panel cap per physician</li>
          <li>No insurance billing, no RVUs, no productivity quotas</li>
          <li>Visits with real time — not a 15-minute clock</li>
          <li>Lifestyle medicine woven into everyday care</li>
          <li>Direct, continuous relationships with your patients</li>
        </RuledList>
      </div>
    </div>
  </section>

  <!-- We're expanding -->
  <section class="car-grow">
    <div class="rd-wrap car-grow__grid">
      <h2 class="rd-h2 car-grow__h">Growing Across the Main Line — and Beyond</h2>
      <p>
        We currently practice in Wayne and Malvern on the Main Line, and
        we're actively exploring additional locations. Physicians interested in building
        a panel at a new site are encouraged to reach out — we'd genuinely like to talk.
      </p>
    </div>
  </section>

  <!-- Who we're looking for -->
  <section class="rd-section">
    <div class="rd-wrap car-split">
      <div class="rd-stack">
        <h2 class="rd-h2">The Kind of Physician Who Fits Here</h2>
        <p class="rd-copy">
          If you've been looking for a way to practice primary care that puts the
          relationship first, we'd like to hear from you. The specifics we look for:
        </p>
      </div>
      <div class="car-list">
        <h3 class="rd-h3">What we look for</h3>
        <RuledList reveal size="md">
          <li>Board-certified or board-eligible in family medicine or internal medicine</li>
          <li>Interest in lifestyle medicine a plus</li>
          <li>Active medical license, or currently completing residency</li>
        </RuledList>
      </div>
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="car-join rd-sage">
    <div class="rd-wrap car-join__inner">
      <div class="rd-stack car-join__copy">
        <h2 class="rd-h2 car-join__h">Interested in Joining Us?</h2>
        <p class="rd-copy">
          We'd love to start a conversation. Reach out and tell us a little about
          yourself and how you'd like to practice.
        </p>
      </div>
      <a href="mailto:information@forwardfamilymedicine.com" class="btn-forest">Email us at information@forwardfamilymedicine.com</a>
    </div>
  </section>

  <CTABanner btnHref="/contact/?source=careers" />
</MainLayout>

<style>
  .car-split { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr); gap: 72px; align-items: start; }
  .car-list { display: flex; flex-direction: column; gap: 12px; padding-top: 6px; }
  .car-grow { background: var(--forest); padding: 88px 0; }
  .car-grow__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr); gap: 64px; align-items: start; }
  .car-grow__h { color: var(--linen); }
  .car-grow__grid p { margin: 0; font-size: 17px; line-height: 1.75; color: var(--on-forest); }
  .car-join { padding: 80px 0; }
  .car-join__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: center; }
  .car-join__h { font-size: 36px; line-height: 1.1; letter-spacing: -0.01em; }
  .car-join__copy .rd-copy { max-width: 560px; }
  /* The live label "Email us at information@forwardfamilymedicine.com" stays on one line on a phone. */
  @media (max-width: 560px) {
    .car-join .btn-forest { white-space: nowrap; font-size: min(14px, 3.05vw); padding: 0 16px; }
  }
  @media (max-width: 860px) {
    .car-split, .car-grow__grid, .car-join__inner { grid-template-columns: 1fr; gap: 32px; }
    .car-grow { padding: 56px 0; }
    .car-join { padding: 56px 0; }
    .car-join__h { font-size: 30px; }
  }
</style>
