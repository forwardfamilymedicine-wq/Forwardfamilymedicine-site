---
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import ServiceHero from '../components/shared/ServiceHero.astro';
import TitledGrid from '../components/shared/TitledGrid.astro';
import NumberedRows from '../components/shared/NumberedRows.astro';
import windowChairs from '../assets/office/wayne-window-chairs.jpg';

const faqs = [
  {
    q: "Is the Wellness Collective an extra cost?",
    a: "No. Access to the Collective is included in your standard FFM membership. There is no separate enrollment, no additional monthly fee, and no referral charge. The only costs are what individual Collective providers charge for their services — many of which offer preferred pricing for our members.",
  },
  {
    q: "How are providers chosen for the network?",
    a: "Every Collective partner is individually vetted by our physicians — not sourced from an insurance directory. We evaluate for clinical credentials, a one-on-one care model, and alignment with a proactive, prevention-focused philosophy. High-volume or impersonal practices are not included, regardless of their general reputation.",
  },
  {
    q: "Can I still see providers outside the Collective?",
    a: "Yes, absolutely. The Collective is a benefit, not a restriction. If you have a provider you already trust, your physician will coordinate with them directly. The Collective is most useful when you don't yet have an established relationship in a given category.",
  },
  {
    q: "Do Collective providers accept insurance?",
    a: "It varies by provider. Many of the highest-quality Collective partners — particularly in physical therapy, chiropractic, nutrition, and fitness — operate on a cash-pay or hybrid model. Your physician will always clarify payment structure before making a referral. Some providers offer superbills for out-of-network reimbursement.",
  },
  {
    q: "Will the network grow over time?",
    a: "Yes. The Collective is a living resource. As FFM grows, we continue to evaluate and add partners across new categories and geographies on the Main Line. If there's a category or area you'd like to see represented, let us know — member feedback directly shapes who we recruit next.",
  },
];

const diffs = [
  'Every provider is independently vetted — not from a hospital network list',
  'Most partners are small, independent, or cash-based practices — the same model as DPC',
  'We make the introduction directly, with your clinical context included',
  'Many partners offer priority scheduling and preferred rates for FFM members',
  'Access is reserved for members — this is not a public directory',
  'Your physician stays informed as your care progresses',
];

const why = [
  { title: 'Vetted, not random', body: "Every Collective partner has been personally evaluated — so your first appointment doesn't begin with uncertainty about who you're seeing." },
  { title: 'No time wasted', body: 'Priority scheduling and direct physician communication mean less time waiting and re-explaining — more time on recovery and progress.' },
  { title: 'A team around you', body: 'Rather than separate providers working in silos, the Collective functions as a coordinated team — all connected through your physician at the center.' },
];

const receive = [
  { title: 'Physician-curated referrals', body: 'Your physician personally identifies the right partner based on your clinical needs — not a general search.' },
  { title: 'Priority scheduling', body: 'Collective partners hold availability for FFM members, so you get in faster than a general patient would.' },
  { title: 'Preferred member rates', body: 'Many partners — especially cash-based and independent practices — offer preferred pricing for our members.' },
  { title: 'Direct physician communication', body: 'We contact Collective providers directly — sharing your history and goals before your first appointment.' },
  { title: 'Closed-loop follow-up', body: "After your appointment, we follow up and review progress at your next visit. Your care doesn't get handed off." },
];

const areas = [
  { title: 'Movement & Rehabilitation', sub: 'Restoring and protecting function', tags: ['Physical Therapy', 'Chiropractic Care', 'Manual Therapy'] },
  { title: 'Performance & Vitality', sub: 'Strength, fitness, and metabolic health', tags: ['Personal Training', 'Fitness Coaching', 'Registered Dietitians', 'Nutrition Therapy'] },
  { title: 'Mind & Recovery', sub: 'Sleep, mental health, and restoration', tags: ['Mental Health Therapy', 'Sleep Medicine', 'Acupuncture', 'Detox & Recovery'] },
  { title: 'Skin & Integrative Health', sub: 'Specialized skin and aesthetic care', tags: ['Dermatology', 'Cosmetic Dermatology', 'Aesthetics'] },
  { title: "Women's Health", sub: 'Reproductive, hormonal, and perinatal care', tags: ['Midwifery / OB-GYN', 'Pelvic Floor PT', 'Postpartum Doulas', 'Perinatal Mood Disorder Therapists', 'Menopause / Hormone Specialists'] },
  { title: 'Children & Family', sub: 'Development, nutrition, and family wellbeing', tags: ['Speech-Language Pathology', 'Pediatric Dietitian', 'Lactation Consultants', 'Family / Child Therapists'] },
  { title: 'Restore & Recharge', sub: 'Recovery, relaxation, and cellular renewal', tags: ['Massage Therapy', 'Infrared Sauna', 'Acupuncture', 'Breathwork / Meditation Instructor', 'Red Light Therapy'] },
  { title: 'Metabolic Health & Longevity', sub: 'Physician-interpreted diagnostics for a longer, stronger life', tags: ['Body Composition & Bone Density', 'VO₂ Max Testing', 'Advanced Lipid Panels', 'Coronary Artery Calcium Scoring', 'Continuous Glucose Monitoring', 'Multi-Cancer Early Detection'] },
];

const steps = [
  { title: 'Discuss with your physician', body: 'Mention a concern, a goal, or something you want addressed outside primary care. Your physician assesses what kind of partner makes sense.' },
  { title: 'Get matched and connected', body: 'We identify the right Collective partner for your situation and make a direct introduction — with your clinical context shared upfront.' },
  { title: 'Receive coordinated care', body: 'Your physician stays informed throughout. Progress is reviewed at your next visit. Nothing gets lost between providers.' },
];

const center = [
  { lead: 'Direct communication.', body: "When we refer you to a Collective provider, we communicate directly — clinician to clinician — ensuring your care goals and clinical history are understood from day one." },
  { lead: 'Closed-loop follow-up.', body: "After your appointment, we follow up with your Collective provider and review progress at your next visit. Your care is not handed off — it's coordinated." },
  { lead: 'An evolving network.', body: 'As the Collective grows and your needs change, your physician continuously refines referral recommendations. Member feedback directly shapes who we recruit next.' },
];
---

<MainLayout
  title="The Main Line Wellness Collective | Forward Family Medicine"
  description="A physician-curated network of best-in-class wellness and specialty providers on the Main Line — included in every Forward Family Medicine membership."
>

  <ServiceHero
    title="Care that extends beyond our walls"
    titleCh={12}
    image={windowChairs}
    alt="Two armchairs by a sunlit window in the Wayne office"
    position="60% 50%"
  >
    <nav slot="before" class="wc-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">›</span> <a href="/services/">Services</a> <span aria-hidden="true">›</span> <span>Wellness Collective</span>
    </nav>
    <p slot="lede">The Main Line Wellness Collective is a physician-curated network of best-in-class wellness and specialty providers — personally vetted by your doctor and available exclusively to Forward Family Medicine members, at no extra cost.</p>
    <a href="/contact/?source=wellness-collective" class="btn-forest">Schedule a Free Meet &amp; Greet</a>
    <a href="#what-it-is" class="btn-ghost">Learn how it works</a>
  </ServiceHero>

  <section class="rd-section rd-alt" id="what-it-is">
    <div class="rd-wrap">
      <div class="rd-split rd-split--a">
        <h2 class="rd-h2 rd-sticky">A referral network built differently.</h2>
        <div class="rd-stack">
          <p class="rd-copy">Most referrals work the same way: your doctor prints a name and a phone number, and you're on your own. The Wellness Collective is the opposite of that.</p>
          <p class="rd-copy">Every provider in the network has been personally evaluated by our physicians — not sourced from an insurance directory or recommendation platform. We selected for clinical depth, a one-on-one care model, and a philosophy that aligns with how we practice: preventive, personalized, unhurried.</p>
          <p class="rd-copy">When you need care beyond our office, we identify the right partner for your specific situation, make a direct introduction, and share your clinical context — so your new provider understands you before you walk in the door.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="diff-band">
    <div class="rd-wrap">
      <h2 class="rd-h2 diff-h2">What makes this different</h2>
      <ul class="diff-grid" data-reveal>
        {diffs.map(d => <li class="rd-serif">{d}</li>)}
      </ul>
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-stack why-head">
        <h2 class="rd-h2">Better coordination. Better outcomes.</h2>
        <p class="rd-copy">Integrated, coordinated care produces meaningfully better health outcomes than fragmented care. The Collective is our practical response to that evidence.</p>
      </div>
      <TitledGrid columns={3} reveal items={why} />
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">What members receive.</h2>
        <p class="rd-copy">Access to the Wellness Collective is part of your Forward Family Medicine membership. There is no enrollment, no additional fee, and no separate sign-up.</p>
        <p class="included">Included with every FFM membership</p>
      </div>
      <NumberedRows rows={receive} />
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-stack areas-head">
        <h2 class="rd-h2">Eight categories. One physician-led network.</h2>
        <p class="rd-copy">The Collective spans the full range of wellness and specialty care — organized around how your health actually works.</p>
      </div>
      <div class="areas" data-reveal>
        {areas.map(a => (
          <div class="area">
            <h3 class="rd-h3">{a.title}</h3>
            <p class="area-sub">{a.sub}</p>
            <ul class="area-tags">
              {a.tags.map(t => <li>{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <h2 class="rd-h2 steps-h2">Three steps. No guesswork.</h2>
      <NumberedRows rows={steps} />
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--a">
      <h2 class="rd-h2 rd-sticky">Your physician remains at the center.</h2>
      <div class="center-list">
        {center.map(c => (
          <p class="rd-copy center-item"><strong>{c.lead}</strong> {c.body}</p>
        ))}
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Frequently Asked Questions" />

  <CTABanner
    headline="One membership. A whole network of care."
    subhead="Start with a free, no-obligation meet and greet — meet the team, see the office, and ask every question you have. No pressure."
    btnText="Schedule a Free Meet & Greet"
    btnHref="/contact/?source=wellness-collective"
    btn2Text="View membership details"
    btn2Href="/membership/"
  />

</MainLayout>

<style>
  .wc-breadcrumb { font-size: 13px; color: var(--text-600); margin-bottom: 18px; }
  .wc-breadcrumb a { color: var(--text-600); }
  .wc-breadcrumb a:hover { color: var(--forest); }
  .wc-breadcrumb span:last-child { color: var(--text-700); }

  .diff-band { background: var(--forest); color: var(--linen); padding: 96px 0; }
  .diff-h2 { color: var(--linen); margin-bottom: 40px; }
  .diff-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; }
  .diff-grid li {
    padding: 26px 0;
    border-top: 1px solid var(--sage);
    font-size: 21px;
    line-height: 1.35;
    color: var(--linen);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .diff-grid.on li { opacity: 1; transform: none; }
  .diff-grid.on li:nth-child(2) { transition-delay: 0.15s; }
  .diff-grid.on li:nth-child(3) { transition-delay: 0.3s; }
  .diff-grid.on li:nth-child(4) { transition-delay: 0.45s; }
  .diff-grid.on li:nth-child(5) { transition-delay: 0.6s; }
  .diff-grid.on li:nth-child(6) { transition-delay: 0.75s; }

  .why-head, .areas-head { max-width: 680px; margin-bottom: 44px; }
  .included { margin: 6px 0 0; font-size: 13px; font-weight: 600; color: var(--gold-text); }

  .areas { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 56px; }
  .area {
    display: flex; flex-direction: column; gap: 8px;
    padding: 24px 0 28px;
    border-top: 1px solid var(--hairline-strong);
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .areas.on .area { opacity: 1; transform: none; }
  .areas.on .area:nth-child(even) { transition-delay: 0.15s; }
  .area-sub { margin: 0; font-size: 14px; color: var(--text-600); }
  .area-tags { list-style: none; margin: 8px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 8px; }
  .area-tags li { padding: 5px 12px; border: 1px solid var(--hairline-strong); border-radius: 999px; font-size: 13px; color: var(--text-700); background: var(--linen-50); }

  .steps-h2 { margin-bottom: 40px; }
  .center-list { display: flex; flex-direction: column; }
  .center-item { padding: 22px 0; border-top: 1px solid var(--hairline-strong); }
  .center-item:last-child { border-bottom: 1px solid var(--hairline-strong); }

  @media (max-width: 860px) {
    .diff-band { padding: 64px 0; }
    .diff-grid { grid-template-columns: 1fr; }
    .areas { grid-template-columns: 1fr; }
  }
</style>
