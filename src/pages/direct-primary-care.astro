---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import NearYouExpander from '../components/shared/NearYouExpander.astro';
import MembershipRates from '../components/shared/MembershipRates.astro';
import HowToJoin from '../components/shared/HowToJoin.astro';
import RelatedReading from '../components/shared/RelatedReading.astro';
import ServiceHero from '../components/shared/ServiceHero.astro';
import StatsBand from '../components/shared/StatsBand.astro';
import CompareTable from '../components/shared/CompareTable.astro';
import TitledGrid from '../components/shared/TitledGrid.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import roomLight from '../assets/office/wayne-room-light.jpg';

// Town list is derived from the local collection, never hardcoded, so a new
// /local/direct-primary-care-*.md file appears here the moment it is added.
const dpcTowns = (await getCollection('local'))
  .map(e => ({ slug: e.id.replace(/\.mdx?$/, ''), label: e.data.location ?? '' }))
  .filter(t => t.slug.startsWith('direct-primary-care-') && t.label)
  .sort((a, b) => a.label.localeCompare(b.label));

// Related reading, in order. Titles come from the blog collection, never
// retyped, and a slug with no entry fails the build.
const RELATED_POSTS = [
  'what-is-direct-primary-care',
  'direct-primary-care-vs-insurance',
  'how-dpc-saves-money',
];
const blogEntries = await getCollection('blog');
const relatedPosts = RELATED_POSTS.map(slug => {
  const entry = blogEntries.find(e => e.id.replace(/\.mdx?$/, '') === slug);
  if (!entry) throw new Error(`[direct-primary-care] no blog entry at ${slug}.`);
  return { href: `/blog/${slug}/`, title: entry.data.title };
});

const faqs = [
  {
    q: 'What does "direct" mean in Direct Primary Care?',
    a: '"Direct" refers to the direct financial relationship between patient and physician: you pay your doctor directly, without an insurance company in the middle. This removes administrative overhead and aligns incentives around your health, not billing volume.',
  },
  {
    q: 'Is DPC covered by Medicare or Medicaid?',
    a: 'DPC membership fees are not covered by Medicare or Medicaid. Medicare and Medicaid beneficiaries can still join as members paying directly. Our physicians have opted out of Medicare, so Medicare patients sign a short private contract when they enroll. Specialty and hospital services are still billed through Medicare or Medicaid as applicable.',
  },
  {
    q: 'How is DPC different from concierge medicine?',
    a: 'The distinction most practices draw between DPC and concierge medicine doesn\'t apply at Forward Family Medicine. Every member receives what the industry calls a "concierge experience," delivered through the DPC financial model: no insurance billing, predictable monthly pricing. <a href="/concierge-medicine/">Learn more about our concierge features →</a> For members who want to layer comprehensive imaging, advanced biomarker testing, and longitudinal physician guidance on top of their DPC membership, the <a href="/clarity/">Clarity Program</a> is our integrated executive health offering.',
  },
  {
    q: 'Does the monthly fee really cover everything in primary care?',
    a: 'It covers the vast majority of what most people need from a primary care physician. You only pay extra for labs, medications, and immunizations, and even then, at cost. No per-visit fees, ever.',
  },
  {
    q: 'How do I know if this practice is a good fit before joining?',
    a: 'That\'s exactly what our free Meet &amp; Greet is for. <a href="/contact/?source=direct-primary-care">Schedule one here →</a> It\'s a 60-minute conversation, in person or by video, with no pressure and no commitment.',
  },
];
const stats = [
  { value: '≤250', caption: 'patients per physician, capped' },
  { value: '1–2 hr', caption: 'typical visit length' },
  { value: '$200<small>/mo</small>', caption: 'individual membership' },
  { value: '$0', caption: 'copays, ever' },
];

const included = [
  'Unlimited office visits (in-person, phone, video)',
  'Same-day or next-day scheduling',
  'Direct physician access: call, text, message',
  'Annual physicals and preventive screenings',
  'Acute illness care (infections, injuries, etc.)',
  'Chronic disease management',
  'Prescription refills and medication management',
  'Lifestyle medicine and health coaching',
  'Minor in-office procedures',
];
const addOns = [
  'Lab work at wholesale/near-cost pricing',
  'Medications dispensed at cost, no pharmacy markup',
  'Immunizations at cost',
];
const notCovered = [
  'Specialist visits (billed through your insurance)',
  'Hospital care and emergency services',
  'Imaging: we help coordinate and advocate for you',
];

const labs = [
  { price: '$2', name: 'CBC', full: 'Complete Blood Count' },
  { price: '$2', name: 'CMP', full: 'Comprehensive Metabolic Panel' },
  { price: '$3', name: 'Lipid Panel', full: 'Total cholesterol, LDL, HDL, triglycerides' },
  { price: '$7', name: 'ApoB', full: 'Advanced cardiovascular risk marker' },
  { price: '$7', name: 'Thyroid Panel', full: 'TSH + additional thyroid markers' },
];

const who = [
  { title: 'Families & Individuals', body: 'Without employer-sponsored insurance who want excellent primary care at a predictable monthly cost.' },
  { title: 'Chronic Condition Management', body: 'Diabetes, hypertension, thyroid disorders: conditions that need ongoing, attentive management, not a 10-minute slot every 3 months.' },
  { title: 'Prevention-Focused Patients', body: 'Who want real time with their doctor to work on root causes, lifestyle changes, and long-term health goals.' },
  { title: 'Self-Employed & Small Business', body: 'Looking for a cost-effective health benefit that delivers concierge-quality care without the concierge price tag.' },
];

---

<MainLayout
  title="Direct Primary Care near Philadelphia | Forward Family Medicine"
  description="Direct primary care in Wayne and Malvern, near Philadelphia: one flat monthly fee, unlimited visits, no copays or insurance billing. $200/month individual."
>

  <ServiceHero
    title="Direct Primary Care on the Main Line"
    image={roomLight}
    alt="The Wayne waiting room in afternoon light"
    position="50% 70%"
  >
    <p slot="lede">Direct primary care is primary care you pay for with a flat monthly membership, with no insurance billing and no copays. We offer it at our offices in Wayne and Malvern.</p>
    <p slot="after" class="hero-press">
      Cited as a real-world example of this model in <em>Slate</em>:
      &ldquo;<a href="https://slate.com/technology/2026/08/health-care-appointment-short-wait-solution-shortage.html" target="_blank" rel="noopener noreferrer">Membership Fees Are Coming for Your Doctor's Office</a>,&rdquo; August 2026.
    </p>
    <a href="/contact/?source=direct-primary-care" class="btn-forest">Schedule a Free Meet &amp; Greet</a>
    <a href="/membership/" class="btn-ghost">See Membership Pricing</a>
  </ServiceHero>

  <StatsBand stats={stats} size={56} />

  <section class="rd-section">
    <div class="rd-wrap">
      <h2 class="rd-h2 h2-gap">What DPC Covers at Forward Family Medicine</h2>
      <div class="covers" data-reveal>
        <div>
          <h3 class="cov-h">Included in Membership</h3>
          <ul class="cov-list">{included.map(i => <li>{i}</li>)}</ul>
        </div>
        <div>
          <h3 class="cov-h">At-Cost Add-Ons</h3>
          <ul class="cov-list">{addOns.map(i => <li>{i}</li>)}</ul>
        </div>
        <div>
          <h3 class="cov-h">Not Covered by DPC</h3>
          <ul class="cov-list">{notCovered.map(i => <li>{i}</li>)}</ul>
          <p class="cov-more"><a href="/services/" class="rd-link">See the full services list →</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--b">
      <div class="rd-stack">
        <h2 class="rd-h2">What Membership Costs</h2>
        <p class="rd-copy">Individual membership is $200 a month, with no enrollment fee. Families pay less per person as the family grows, and children under 26 can be added at the family rate. See our <a href="/membership/">membership page</a> for details.</p>
      </div>
      <MembershipRates />
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-stack lab-intro">
        <h2 class="rd-h2">Wholesale Lab Pricing: What You Actually Pay</h2>
        <p class="rd-copy">These are the prices you pay. Not an insurance "negotiated" rate. Not a facility fee. Just the lab cost, passed directly to you.</p>
      </div>
      <div class="labs" data-reveal>
        {labs.map(l => (
          <div class="lab">
            <div class="lab-price rd-serif">{l.price}</div>
            <div class="lab-name">{l.name}</div>
            <div class="lab-full">{l.full}</div>
          </div>
        ))}
        <div class="lab">
          <div class="lab-price rd-serif">+ more</div>
          <div class="lab-name">Full menu available at your visit</div>
        </div>
      </div>
      <p class="lab-foot">Medications are also dispensed at cost through direct supplier relationships. No pharmacy markup.</p>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <h2 class="rd-h2 h2-gap">How DPC Is Different from Traditional Primary Care</h2>
      <CompareTable
        variant="plain"
        caption="Traditional primary care compared with Forward Family Medicine"
        columns={['Feature', 'Traditional Primary Care', 'Forward Family Medicine (DPC)']}
        rows={[
          ['Payment', 'Insurance + copays + deductibles', 'Flat monthly membership fee'],
          ['Visit length', '7–12 minutes (typical)', '1–2 hours'],
          ['Doctor access', 'Via scheduling + nurse line', 'Direct: call, text, message'],
          ['Wait for appointment', 'Days to weeks', 'Same or next day'],
          ['Patient panel size', '2,000–3,000 patients', '~250 patients per physician'],
          ['After-hours access', 'Answering service / urgent care', 'Your own doctor (for true clinical urgency)'],
          ['Preventive focus', 'Often squeezed out', 'Central to every visit'],
        ]}
      />
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-stack lab-intro">
        <h2 class="rd-h2">What Does DPC Actually Cost You?</h2>
        <p class="rd-copy">Most DPC members pair their membership with a high-deductible health plan (HDHP) for specialist and hospital coverage. A rough comparison for a healthy adult:</p>
      </div>
      <div class="cost" data-reveal>
        <div class="cost-card cost-card--ppo">
          <p class="cost-tag">Traditional PPO Only</p>
          <p class="cost-amount rd-serif">$400–600+<span>/mo</span></p>
          <ul>
            <li>7–12 minute visits</li>
            <li>Wait days to weeks</li>
            <li>Still paying copays on top</li>
            <li>2,000–3,000 patient panel</li>
          </ul>
        </div>
        <div class="cost-card cost-card--ffm">
          <p class="cost-tag cost-tag--gold">Better Value &middot; FFM Membership + HDHP</p>
          <p class="cost-amount rd-serif">$300–400<span>/mo combined (est.)</span></p>
          <ul>
            <li>1–2 hour visits</li>
            <li>Same-day access</li>
            <li>No copays on primary care</li>
            <li>≤250 patient panel</li>
          </ul>
        </div>
      </div>
      <p class="cost-note">Estimates vary widely by age, employer, and plan. Your total annual healthcare spend can go down, depending on your plan and how you use care. Consult a benefits advisor for your specific situation.</p>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <h2 class="rd-h2 h2-gap">Is DPC Right for You?</h2>
      <TitledGrid reveal columns={2} items={who} />
    </div>
  </section>

  <HowToJoin source="direct-primary-care" />

  <RelatedReading layout="list" headline="More on Direct Primary Care" posts={relatedPosts} />

  <FAQSection faqs={faqs}>
    <p class="faq-more">More questions? <a href="/faq/" class="rd-link">See our full FAQ →</a></p>
  </FAQSection>

  <CTABanner
    headline="Take the Next Step"
    subhead="See the practice, meet our physicians, and ask every DPC question you have. No obligation, no pressure."
    btnText="Schedule a Free Meet & Greet"
    btnHref="/contact/?source=direct-primary-care"
    btn2Text="Explore Membership Plans →"
    btn2Href="/membership/"
  />

  <!-- Wayfinding, not persuasion: sits below the conversion content and
       links the /local/direct-primary-care-* town pages. -->
  <NearYouExpander
    id="dpc-near-you"
    ariaLabel="Direct primary care by location"
    summary={`Direct primary care in ${dpcTowns.length} towns near our offices`}
    links={dpcTowns.map(t => ({ href: `/local/${t.slug}/`, label: t.label }))}
  />

</MainLayout>

<style>
  .h2-gap { margin-bottom: 40px; }
  .hero-press {
    margin: 0;
    padding-top: 16px;
    border-top: 1px solid var(--hairline-strong);
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-600);
    max-width: 600px;
  }
  .hero-press a { color: var(--sage-600); border-bottom: 1px solid var(--sage); }
  .hero-press a:hover { color: var(--forest); border-color: var(--forest); }

  .covers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 48px; align-items: start; }
  .cov-h { margin: 0 0 6px; font-size: 14px; font-weight: 600; color: var(--sage-600); }
  .cov-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .cov-list li {
    padding: 11px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--text-900);
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.4s ease, transform 0.4s ease;
  }
  .cov-list li:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .covers.on .cov-list li { opacity: 1; transform: none; }
  .covers.on .cov-list li:nth-child(2) { transition-delay: 0.1s; }
  .covers.on .cov-list li:nth-child(3) { transition-delay: 0.2s; }
  .covers.on .cov-list li:nth-child(4) { transition-delay: 0.3s; }
  .covers.on .cov-list li:nth-child(5) { transition-delay: 0.4s; }
  .covers.on .cov-list li:nth-child(6) { transition-delay: 0.5s; }
  .covers.on .cov-list li:nth-child(7) { transition-delay: 0.6s; }
  .covers.on .cov-list li:nth-child(8) { transition-delay: 0.7s; }
  .covers.on .cov-list li:nth-child(n+9) { transition-delay: 0.8s; }
  .cov-more { margin: 20px 0 0; }

  .lab-intro { max-width: 760px; margin-bottom: 40px; }
  .labs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; }
  .lab {
    padding: 24px 0;
    border-top: 1px solid var(--hairline-strong);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.5s ease, transform 0.5s ease;
  }
  .lab:nth-child(n+4) { border-bottom: 1px solid var(--hairline-strong); }
  .labs.on .lab { opacity: 1; transform: none; }
  .labs.on .lab:nth-child(2) { transition-delay: 0.12s; }
  .labs.on .lab:nth-child(3) { transition-delay: 0.24s; }
  .labs.on .lab:nth-child(4) { transition-delay: 0.36s; }
  .labs.on .lab:nth-child(5) { transition-delay: 0.48s; }
  .labs.on .lab:nth-child(6) { transition-delay: 0.6s; }
  .lab-price { font-size: 52px; line-height: 1; letter-spacing: -0.02em; color: var(--forest); }
  .lab-name { margin-top: 12px; font-size: 16px; font-weight: 500; color: var(--forest); }
  .lab-full { margin-top: 4px; font-size: 13.5px; color: var(--text-600); }
  .lab-foot { margin: 24px 0 0; font-size: 14px; color: var(--text-600); }

  .cost { display: grid; grid-template-columns: 1fr 1fr; }
  .cost-card {
    padding: 30px 34px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cost.on .cost-card { opacity: 1; transform: none; }
  .cost.on .cost-card--ffm { transition-delay: 0.3s; }
  .cost-card--ppo { border-top: 3px solid var(--hairline-strong); }
  .cost-card--ffm { background: var(--sage-50); border-top: 3px solid var(--forest); }
  .cost-tag { margin: 0; font-size: 13px; font-weight: 500; color: var(--text-600); }
  .cost-tag--gold { color: var(--gold); }
  .cost-amount { margin: 8px 0 0; font-size: 40px; line-height: 1.05; letter-spacing: -0.015em; color: var(--forest); }
  .cost-card--ppo .cost-amount { color: var(--text-600); }
  .cost-amount span { font-size: 18px; letter-spacing: 0; }
  .cost-card--ffm .cost-amount span { font-size: 16px; color: var(--text-600); }
  .cost-card ul { margin: 14px 0 0; padding: 0; list-style: none; }
  .cost-card li { padding: 10px 0; border-top: 1px solid var(--hairline-strong); font-size: 15px; line-height: 1.5; }
  .cost-card li:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .cost-card--ppo li { color: var(--text-600); }
  .cost-card--ffm li { border-color: var(--on-forest-faint); color: var(--forest); }
  .cost-note { margin: 24px 0 0; font-size: 13.5px; line-height: 1.65; color: var(--text-600); }

  .faq-more { margin: 28px 0 0; font-size: 14px; color: var(--text-600); }

  @media (max-width: 860px) {
    .covers, .labs, .cost { grid-template-columns: 1fr; gap: 28px; }
    .labs { gap: 0; }
    .lab:nth-child(n+4) { border-bottom: 0; }
    .lab:last-child { border-bottom: 1px solid var(--hairline-strong); }
    .lab-price { font-size: 40px; }
    .cost-card { padding: 24px 20px; }
    .cost-amount { font-size: 32px; }
  }
</style>
