---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import NearYouExpander from '../components/shared/NearYouExpander.astro';
import MembershipRates from '../components/shared/MembershipRates.astro';
import HowToJoin from '../components/shared/HowToJoin.astro';
import RelatedReading from '../components/shared/RelatedReading.astro';
import { joinAnd } from '../utils/physicianRouting';

// The eyebrow names only offices a patient can go to today, in display order,
// so a planned office joins it the moment its locations entry flips to "open".
const openOffices = (await getCollection('locations'))
  .filter(l => l.data.status === 'open')
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder)
  .map(l => l.data.name);
const eyebrow = `${joinAnd(openOffices)}, near Philadelphia`;

// Town list is derived from the local collection, never hardcoded, so a new
// /local/direct-primary-care-*.md file appears here the moment it is added.
const dpcTowns = (await getCollection('local'))
  .map(e => ({ slug: e.id.replace(/\.mdx?$/, ''), label: e.data.location ?? '' }))
  .filter(t => t.slug.startsWith('direct-primary-care-') && t.label)
  .sort((a, b) => a.label.localeCompare(b.label));

// Related reading, in order. Titles come from the blog collection, never
// retyped, and a slug with no entry fails the build.
const RELATED_POSTS = [
  'what-is-direct-primary-care',
  'direct-primary-care-vs-insurance',
  'how-dpc-saves-money',
];
const blogEntries = await getCollection('blog');
const relatedPosts = RELATED_POSTS.map(slug => {
  const entry = blogEntries.find(e => e.id.replace(/\.mdx?$/, '') === slug);
  if (!entry) throw new Error(`[direct-primary-care] no blog entry at ${slug}.`);
  return { href: `/blog/${slug}/`, title: entry.data.title };
});

const faqs = [
  {
    q: 'What does "direct" mean in Direct Primary Care?',
    a: '"Direct" refers to the direct financial relationship between patient and physician: you pay your doctor directly, without an insurance company in the middle. This removes administrative overhead and aligns incentives around your health, not billing volume.',
  },
  {
    q: 'Is DPC covered by Medicare or Medicaid?',
    a: 'DPC membership fees are not covered by Medicare or Medicaid. Medicare and Medicaid beneficiaries can still join as members paying directly. Our physicians have opted out of Medicare, so Medicare patients sign a short private contract when they enroll. Specialty and hospital services are still billed through Medicare or Medicaid as applicable.',
  },
  {
    q: 'How is DPC different from concierge medicine?',
    a: 'The distinction most practices draw between DPC and concierge medicine doesn\'t apply at Forward Family Medicine. Every member receives what the industry calls a "concierge experience," delivered through the DPC financial model: no insurance billing, predictable monthly pricing. <a href="/concierge-medicine/">Learn more about our concierge features →</a> For members who want to layer comprehensive imaging, advanced biomarker testing, and longitudinal physician guidance on top of their DPC membership, the <a href="/clarity/">Clarity Program</a> is our integrated executive health offering.',
  },
  {
    q: 'Does the monthly fee really cover everything in primary care?',
    a: 'It covers the vast majority of what most people need from a primary care physician. You only pay extra for labs, medications, and immunizations, and even then, at cost. No per-visit fees, ever.',
  },
  {
    q: 'How do I know if this practice is a good fit before joining?',
    a: 'That\'s exactly what our free Meet &amp; Greet is for. <a href="/contact/?source=direct-primary-care">Schedule one here →</a> It\'s a 60-minute conversation, in person or by video, with no pressure and no commitment.',
  },
];
---

<MainLayout
  title="Direct Primary Care near Philadelphia | Forward Family Medicine"
  description="Direct primary care in Wayne and Malvern, near Philadelphia: one flat monthly fee, unlimited visits, no copays or insurance billing. $200/month individual."
>

  <!-- ─── Hero ──────────────────────────────────────────────────── -->
  <section class="page-hero">
    <div class="container">
      <p class="hero-eyebrow">{eyebrow}</p>
      <h1>Direct Primary Care on the Main Line</h1>
      <p class="hero-desc">Direct primary care is primary care you pay for with a flat monthly membership, with no insurance billing and no copays. We offer it at our offices in Wayne and Malvern.</p>
      <p class="hero-press">
        Cited as a real-world example of this model in Slate:
        &ldquo;<a href="https://slate.com/technology/2026/08/health-care-appointment-short-wait-solution-shortage.html" target="_blank" rel="noopener noreferrer">Membership Fees Are Coming for Your Doctor's Office</a>,&rdquo; August 2026.
      </p>
    </div>
  </section>

  <!-- ─── Stats ─────────────────────────────────────────────────── -->
  <section class="section stats-section">
    <div class="container">
      <div class="stat-row">
        <div class="stat-card">
          <strong class="stat-number">≤250</strong>
          <span class="stat-label">patients per physician, capped</span>
        </div>
        <div class="stat-card">
          <strong class="stat-number">1–2 hr</strong>
          <span class="stat-label">typical visit length</span>
        </div>
        <div class="stat-card">
          <strong class="stat-number">$200<span class="stat-unit">/mo</span></strong>
          <span class="stat-label">individual membership</span>
        </div>
        <div class="stat-card">
          <strong class="stat-number">$0</strong>
          <span class="stat-label">copays, ever</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── What DPC Covers ───────────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <span class="section-label">Membership Benefits</span>
      <h2 class="section-title">What DPC Covers at Forward Family Medicine</h2>
      <div class="coverage-grid">
        <div class="coverage-col">
          <p class="coverage-heading included">✓ Included in Membership</p>
          <ul class="prose-list">
            <li>Unlimited office visits (in-person, phone, video)</li>
            <li>Same-day or next-day scheduling</li>
            <li>Direct physician access: call, text, message</li>
            <li>Annual physicals and preventive screenings</li>
            <li>Acute illness care (infections, injuries, etc.)</li>
            <li>Chronic disease management</li>
            <li>Prescription refills and medication management</li>
            <li>Lifestyle medicine and health coaching</li>
            <li>Minor in-office procedures</li>
          </ul>
        </div>
        <div class="coverage-col">
          <p class="coverage-heading addon">+ At-Cost Add-Ons</p>
          <ul class="prose-list">
            <li>Lab work at wholesale/near-cost pricing</li>
            <li>Medications dispensed at cost, no pharmacy markup</li>
            <li>Immunizations at cost</li>
          </ul>
          <p class="coverage-heading notcovered" style="margin-top:2rem;">✕ Not Covered by DPC</p>
          <ul class="prose-list" style="--check-color: var(--ink-300);">
            <li>Specialist visits (billed through your insurance)</li>
            <li>Hospital care and emergency services</li>
            <li>Imaging: we help coordinate and advocate for you</li>
          </ul>
          <p style="font-size:0.85rem; color:var(--ink-500); margin-top:1.25rem;"><a href="/services/">See the full services list →</a></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── Pricing ───────────────────────────────────────────────── -->
  <section class="section pricing-section">
    <div class="container">
      <span class="section-label">Membership Pricing</span>
      <h2 class="section-title">What Membership Costs</h2>
      <p class="section-intro">Individual membership is $200 a month, with no enrollment fee. Families pay less per person as the family grows, and children under 26 can be added at the family rate. See our <a href="/membership/">membership page</a> for details.</p>
      <MembershipRates />
    </div>
  </section>

  <!-- ─── Lab Pricing ───────────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <span class="section-label">Transparent Pricing</span>
      <h2 class="section-title">Wholesale Lab Pricing: What You Actually Pay</h2>
      <p class="section-intro" style="margin-bottom:2.5rem;">These are the prices you pay. Not an insurance "negotiated" rate. Not a facility fee. Just the lab cost, passed directly to you.</p>
      <div class="lab-grid">
        <div class="lab-item">
          <strong class="lab-price">$2</strong>
          <span class="lab-name">CBC</span>
          <span class="lab-full">Complete Blood Count</span>
        </div>
        <div class="lab-item">
          <strong class="lab-price">$2</strong>
          <span class="lab-name">CMP</span>
          <span class="lab-full">Comprehensive Metabolic Panel</span>
        </div>
        <div class="lab-item">
          <strong class="lab-price">$3</strong>
          <span class="lab-name">Lipid Panel</span>
          <span class="lab-full">Total cholesterol, LDL, HDL, triglycerides</span>
        </div>
        <div class="lab-item">
          <strong class="lab-price">$7</strong>
          <span class="lab-name">ApoB</span>
          <span class="lab-full">Advanced cardiovascular risk marker</span>
        </div>
        <div class="lab-item">
          <strong class="lab-price">$7</strong>
          <span class="lab-name">Thyroid Panel</span>
          <span class="lab-full">TSH + additional thyroid markers</span>
        </div>
        <div class="lab-item lab-item-more">
          <strong class="lab-price-more">+ more</strong>
          <span class="lab-full">Full menu available at your visit</span>
        </div>
      </div>
      <p class="lab-footnote">Medications are also dispensed at cost through direct supplier relationships. No pharmacy markup.</p>
    </div>
  </section>

  <!-- ─── DPC vs Traditional Comparison Table ───────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <span class="section-label">The Comparison</span>
      <h2 class="section-title">How DPC Is Different from Traditional Primary Care</h2>
      <div class="table-wrap">
        <table class="compare-table">
          <thead>
            <tr>
              <th>Feature</th>
              <th class="col-trad">Traditional Primary Care</th>
              <th class="col-ffm">Forward Family Medicine (DPC)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td class="row-feature">Payment</td>
              <td class="col-trad">Insurance + copays + deductibles</td>
              <td class="col-ffm">Flat monthly membership fee</td>
            </tr>
            <tr>
              <td class="row-feature">Visit length</td>
              <td class="col-trad">7–12 minutes (typical)</td>
              <td class="col-ffm">1–2 hours</td>
            </tr>
            <tr>
              <td class="row-feature">Doctor access</td>
              <td class="col-trad">Via scheduling + nurse line</td>
              <td class="col-ffm">Direct: call, text, message</td>
            </tr>
            <tr>
              <td class="row-feature">Wait for appointment</td>
              <td class="col-trad">Days to weeks</td>
              <td class="col-ffm">Same or next day</td>
            </tr>
            <tr>
              <td class="row-feature">Patient panel size</td>
              <td class="col-trad">2,000–3,000 patients</td>
              <td class="col-ffm">~250 patients per physician</td>
            </tr>
            <tr>
              <td class="row-feature">After-hours access</td>
              <td class="col-trad">Answering service / urgent care</td>
              <td class="col-ffm">Your own doctor (for true clinical urgency)</td>
            </tr>
            <tr>
              <td class="row-feature">Preventive focus</td>
              <td class="col-trad">Often squeezed out</td>
              <td class="col-ffm">Central to every visit</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ─── Cost Comparison ───────────────────────────────────────── -->
  <section class="section">
    <div class="container">
      <span class="section-label">Real Numbers</span>
      <h2 class="section-title">What Does DPC Actually Cost You?</h2>
      <p class="section-intro" style="margin-bottom:2.5rem;">Most DPC members pair their membership with a high-deductible health plan (HDHP) for specialist and hospital coverage. A rough comparison for a healthy adult:</p>
      <div class="cost-compare">
        <div class="cost-card cost-card-trad">
          <h3>Traditional PPO Only</h3>
          <p class="cost-amount">$400–600+<span>/mo</span></p>
          <ul>
            <li>7–12 minute visits</li>
            <li>Wait days to weeks</li>
            <li>Still paying copays on top</li>
            <li>2,000–3,000 patient panel</li>
          </ul>
        </div>
        <div class="cost-card cost-card-dpc">
          <span class="cost-badge">Better Value</span>
          <h3>FFM Membership + HDHP</h3>
          <p class="cost-amount">$300–400<span>/mo combined (est.)</span></p>
          <ul>
            <li>1–2 hour visits</li>
            <li>Same-day access</li>
            <li>No copays on primary care</li>
            <li>≤250 patient panel</li>
          </ul>
        </div>
      </div>
      <p class="cost-note">Estimates vary widely by age, employer, and plan. Your total annual healthcare spend can go down, depending on your plan and how you use care. Consult a benefits advisor for your specific situation.</p>
    </div>
  </section>

  <!-- ─── Is DPC Right for You ──────────────────────────────────── -->
  <section class="section section-alt">
    <div class="container">
      <span class="section-label">Who It's For</span>
      <h2 class="section-title">Is DPC Right for You?</h2>
      <div class="persona-grid">
        <div class="persona-card">
          <span class="persona-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg></span>
          <h3>Families &amp; Individuals</h3>
          <p>Without employer-sponsored insurance who want excellent primary care at a predictable monthly cost.</p>
        </div>
        <div class="persona-card">
          <span class="persona-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg></span>
          <h3>Chronic Condition Management</h3>
          <p>Diabetes, hypertension, thyroid disorders: conditions that need ongoing, attentive management, not a 10-minute slot every 3 months.</p>
        </div>
        <div class="persona-card">
          <span class="persona-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg></span>
          <h3>Prevention-Focused Patients</h3>
          <p>Who want real time with their doctor to work on root causes, lifestyle changes, and long-term health goals.</p>
        </div>
        <div class="persona-card">
          <span class="persona-icon"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg></span>
          <h3>Self-Employed &amp; Small Business</h3>
          <p>Looking for a cost-effective health benefit that delivers concierge-quality care without the concierge price tag.</p>
        </div>
      </div>
    </div>
  </section>

  <HowToJoin source="direct-primary-care" />

  <RelatedReading label="Related Reading" headline="More on Direct Primary Care" posts={relatedPosts} />

  <FAQSection faqs={faqs} label="Common Questions">
    <div class="faq-after">
      <p style="margin-top:2rem; font-size:0.9rem; color:var(--ink-500);">More questions? <a href="/faq/">See our full FAQ →</a></p>
    </div>
  </FAQSection>

  <!-- ─── Bottom CTA ────────────────────────────────────────────── -->
  <section class="bottom-cta">
    <div class="container bottom-cta-inner">
      <div class="bottom-cta-text">
        <h2>Take the Next Step</h2>
        <p>See the practice, meet our physicians, and ask every DPC question you have. No obligation, no pressure.</p>
      </div>
      <div class="bottom-cta-btns">
        <a href="/contact/?source=direct-primary-care" class="btn btn-accent">Schedule a Free Meet &amp; Greet</a>
        <a href="/membership/" class="btn btn-outline-white">Explore Membership Plans →</a>
      </div>
    </div>
  </section>

  <!-- Wayfinding, not persuasion: sits below the conversion content and
       links the /local/direct-primary-care-* town pages. -->
  <NearYouExpander
    id="dpc-near-you"
    ariaLabel="Direct primary care by location"
    summary={`Direct primary care in ${dpcTowns.length} towns near our offices`}
    links={dpcTowns.map(t => ({ href: `/local/${t.slug}/`, label: t.label }))}
  />

</MainLayout>

<style>
  /* ─── Hero ─────────────────────────────────── */
  .page-hero {
    background: var(--green-500);
    padding: clamp(48px, 8vw, 80px) 0;
  }
  .hero-eyebrow {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--green-200);
    margin-bottom: 0.75rem;
  }
  .page-hero h1 {
    color: #ffffff;
    margin-bottom: 0.75rem;
  }
  .hero-desc {
    color: var(--green-100);
    font-size: clamp(1rem, 2vw, 1.15rem);
    max-width: 700px;
    line-height: 1.7;
    margin: 0;
  }
  /* Press mention: a citation, not an endorsement — kept quiet on the dark hero. */
  .hero-press {
    color: var(--green-200);
    font-size: 0.85rem;
    max-width: 700px;
    margin-top: 1rem;
  }
  .hero-press a {
    color: var(--green-100);
  }

  /* ─── Stats ─────────────────────────────────── */
  .stats-section { background: var(--cream-100); }
  .stat-row {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.25rem;
  }
  .stat-card {
    background: var(--green-50);
    border: 1px solid var(--green-100);
    border-radius: 16px;
    padding: 1.5rem;
    text-align: center;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .stat-number {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    color: var(--green-500);
    line-height: 1;
  }
  .stat-unit {
    font-size: 1.25rem;
  }
  .stat-label {
    font-size: 0.82rem;
    color: var(--ink-500);
    line-height: 1.4;
  }

  /* ─── Section alternates ──────────────────── */
  .section-alt { background: var(--cream-200); }

  /* ─── Coverage ──────────────────────────────── */
  .coverage-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    margin-top: 2rem;
  }
  .coverage-heading {
    font-size: 0.82rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 1rem;
  }
  .coverage-heading.included { color: var(--green-500); }
  .coverage-heading.addon { color: var(--green-400); }
  .coverage-heading.notcovered { color: var(--ink-500); }

  /* ─── Lab pricing ──────────────────────────── */
  .lab-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }
  .lab-item {
    background: var(--green-50);
    border: 1px solid var(--green-100);
    border-radius: 16px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
  }
  .lab-price {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    color: var(--green-500);
    line-height: 1;
  }
  .lab-name {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink-900);
  }
  .lab-full {
    font-size: 0.8rem;
    color: var(--ink-500);
  }
  .lab-item-more {
    background: var(--warm-50);
    border-color: var(--warm-200);
    justify-content: center;
    align-items: center;
    text-align: center;
  }
  .lab-price-more {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    color: var(--ink-500);
  }
  .lab-footnote {
    margin-top: 1.5rem;
    font-size: 0.85rem;
    color: var(--ink-500);
  }

  /* ─── Comparison table ──────────────────────── */
  .table-wrap {
    overflow-x: auto;
    border-radius: 16px;
    border: 1px solid var(--cream-300);
    margin-top: 2rem;
    box-shadow: var(--shadow-sm);
  }
  .compare-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.93rem;
    margin: 0;
  }
  .compare-table thead th {
    padding: 1rem 1.25rem;
    text-align: left;
    font-weight: 600;
    border: none;
    background: var(--green-500);
    color: #ffffff;
  }
  .compare-table thead th.col-trad {
    background: var(--warm-200);
    color: var(--ink-900);
  }
  .compare-table thead th.col-ffm {
    background: var(--green-300);
    color: #ffffff;
  }
  .compare-table tbody tr { border-bottom: 1px solid var(--cream-300); }
  .compare-table tbody tr:last-child { border-bottom: none; }
  .compare-table td {
    padding: 0.85rem 1.25rem;
    border: none;
    border-right: 1px solid var(--cream-300);
  }
  .compare-table td:last-child { border-right: none; }
  .compare-table tbody tr:nth-child(even) { background: var(--warm-100); }
  .compare-table tbody tr td.col-ffm { background: var(--green-50); }
  .row-feature { font-weight: 600; color: var(--ink-900); }
  .col-trad { color: var(--ink-500); }
  .col-ffm { color: var(--green-500); font-weight: 500; }

  /* ─── Cost comparison ──────────────────────── */
  .cost-compare {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    max-width: 680px;
  }
  .cost-card {
    border-radius: 16px;
    padding: 2rem;
    position: relative;
  }
  .cost-card-trad {
    background: var(--warm-50);
    border: 1px solid var(--warm-200);
  }
  .cost-card-dpc {
    background: var(--green-50);
    border: 2px solid var(--green-300);
  }
  .cost-card h3 {
    font-size: 1rem;
    margin-bottom: 0.75rem;
    color: var(--ink-900);
  }
  .cost-amount {
    font-family: var(--font-heading);
    font-size: 2rem;
    color: var(--ink-900);
    margin-bottom: 1.25rem;
    line-height: 1.1;
  }
  .cost-amount span {
    font-family: var(--font-body);
    font-size: 0.88rem;
    color: var(--ink-500);
  }
  .cost-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
    font-size: 0.88rem;
    color: var(--ink-700);
  }
  .cost-card li {
    padding: 0.3rem 0 0.3rem 1.4rem;
    position: relative;
  }
  .cost-card-dpc li::before {
    content: '✓';
    position: absolute;
    left: 0;
    color: var(--green-400);
    font-weight: 700;
  }
  .cost-card-trad li::before {
    content: '–';
    position: absolute;
    left: 0;
    color: var(--ink-300);
  }
  .cost-badge {
