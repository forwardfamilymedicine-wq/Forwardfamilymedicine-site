---
import MainLayout from '../layouts/MainLayout.astro';
import MeetGreetForm from '../components/shared/MeetGreetForm.astro';
import { getCollection } from 'astro:content';

const locations = (await getCollection('locations'))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.forwardfamilymedicine.com/contact" }
  ]
};
---

<MainLayout
  title="Schedule a Meet & Greet | Forward Family Medicine Wayne PA"
  description="Schedule a free meet and greet at Forward Family Medicine. No obligation, no commitment. Meet our physicians in Wayne, West Chester, or Malvern, PA and see if we're the right fit for you."
  schema={breadcrumb}
>
  <!-- Hero -->
  <section class="contact-hero section" style="background: linear-gradient(160deg, var(--green-50) 0%, var(--cream-100) 100%);">
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span> <span>Contact</span>
      </nav>
      <span class="section-label">Free &amp; No Obligation</span>
      <h1>Schedule a Meet &amp; Greet</h1>
      <div class="divider"></div>
      <p class="section-intro">
        The best way to decide if Forward Family Medicine is right for you is to come in
        and meet us. Ask everything. See the office. It's free. No pressure. No commitment.
        Just a conversation. Prefer to connect remotely? We also offer video meet &amp; greets — just let us know in the form below.
      </p>
    </div>
  </section>

  <!-- Contact content -->
  <section class="contact-section section">
    <div class="container contact-grid">

      <!-- Form -->
      <div class="contact-form-col">
        <MeetGreetForm />
        <div class="card contact-info-card" style="margin-top:1.25rem;">
          <h3>What Happens After You Submit</h3>
          <ol style="padding-left:1.25rem; font-size:0.9rem; color:var(--ink-700); line-height:1.8;">
            <li>We review your request</li>
            <li>We reach out within 24 hours to schedule</li>
            <li>You come in for your free meet &amp; greet</li>
            <li>You decide — no pressure, no obligation</li>
          </ol>
        </div>
      </div>

      <!-- Info -->
      <div class="contact-info-col">

        <div class="card contact-info-card">
          <h3>Practice Information</h3>

          <div class="info-item">
            <svg class="info-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <strong>Wayne</strong>
              <address style="font-style:normal;">
                295 Old Eagle School Road<br />
                Wayne, PA 19087
              </address>
            </div>
          </div>

          <div class="info-item">
            <svg class="info-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <strong>West Chester</strong>
              <address style="font-style:normal;">
                West Chester, PA 19380
              </address>
              <span style="font-size:0.8rem; font-style:italic; color:var(--ink-500);">Coming August 2026</span>
            </div>
          </div>

          <div class="info-item">
            <svg class="info-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            <div>
              <strong>Malvern</strong>
              <address style="font-style:normal;">
                301 Lindenwood Dr Ste 206<br />
                Malvern, PA 19355
              </address>
              <span style="font-size:0.8rem; font-style:italic; color:var(--ink-500);">Coming August 2026</span>
            </div>
          </div>

          <div class="info-item">
            <svg class="info-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.5a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.62 3h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            <div>
              <strong>Phone</strong>
              <a href="tel:+12156457044">(215) 645-7044</a>
            </div>
          </div>

          <div class="info-item">
            <svg class="info-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect width="12" height="8" x="6" y="14"/></svg>
            <div>
              <strong>Fax</strong>
              <a href="tel:+12154498854">(215) 449-8854</a>
            </div>
          </div>

          <div class="info-item">
            <svg class="info-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
            <div>
              <strong>Email</strong>
              <a href="mailto:information@forwardfamilymedicine.com">information@forwardfamilymedicine.com</a>
            </div>
          </div>

          <div class="info-item">
            <svg class="info-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--green-500)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 12"/></svg>
            <div>
              <strong>Office Hours</strong>
              <span>Monday–Friday: 7:30 AM – 5:30 PM</span>
            </div>
          </div>
        </div>

        <div class="card contact-info-card" style="margin-top:1.25rem; background: linear-gradient(135deg, var(--green-50), var(--cream-200)); border: 2px solid var(--green-300);">
          <h3>Serving the Main Line</h3>
          <p>We see patients from across the Main Line and greater Philadelphia area, including:</p>
          <ul style="list-style:none; padding:0; font-size:0.9rem; color:var(--ink-700);">
            <li style="padding:0.2rem 0;">Wayne, PA</li>
            <li style="padding:0.2rem 0;">Berwyn &amp; Devon</li>
            <li style="padding:0.2rem 0;">Paoli &amp; Malvern</li>
            <li style="padding:0.2rem 0;">Radnor &amp; Villanova</li>
            <li style="padding:0.2rem 0;">Chester County</li>
            <li style="padding:0.2rem 0;">Greater Philadelphia</li>
          </ul>
        </div>

        <div class="card contact-info-card" style="margin-top:1.25rem;">
          <h3>Ready to Enroll?</h3>
          <p style="font-size:0.9rem; color:var(--ink-700); margin-bottom:1rem;">If you've already met with us and are ready to join, enroll directly online:</p>
          <div style="display:flex; flex-direction:column; gap:0.75rem;">
            <a href="https://forwardfamilymedicine.sigmamd.com/signup/individual-membership" class="btn btn-primary" target="_blank" rel="noopener noreferrer" style="text-align:center;">Enroll as Individual</a>
            <a href="https://forwardfamilymedicine.sigmamd.com/signup/family-membership" class="btn btn-accent" target="_blank" rel="noopener noreferrer" style="text-align:center;">Enroll Your Family</a>
            <a href="https://patient.sigmamd.com" class="btn btn-outline" target="_blank" rel="noopener noreferrer" style="text-align:center;">Patient Portal Login</a>
          </div>
        </div>
      </div>

    </div>
  </section>

  <section class="contact-locations section">
    <div class="container">
      <span class="section-label">Visit Us</span>
      <h2>Our Locations</h2>
      <div class="divider"></div>
      <p class="section-intro" style="margin-bottom:2.5rem;">
        Wayne (open) and Chester County (West Chester and Malvern, opening August 2026). Each location offers the same Forward Family Medicine experience.
      </p>

      <div class="locations-cards-grid">
        {locations.map(loc => {
          const d = loc.data;
          const isOpen = d.status === 'open';
          const isFuture = !isOpen && d.openingDate;
          const openingLabel = isFuture
            ? (() => { const [y, m] = d.openingDate.split('-').map(Number); return new Date(y, m - 1, 1).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }); })()
            : null;
          return (
            <article class={`location-card${isOpen ? '' : ' coming-soon'}`}>
              {isOpen ? (
                <span class="location-card-badge open">Now Open</span>
              ) : (
                <span class="location-card-badge future">Opening {openingLabel}</span>
              )}
              <h3>{d.name}</h3>
              <address class="location-card-address">
                {d.addressStreet}<br />
                {d.addressCity}, {d.addressState} {d.addressZip}
              </address>
              {d.phone && (
                <p class="location-card-phone">
                  <a href={`tel:${d.phone.replace(/\D/g, '')}`}>{d.phone}</a>
                </p>
              )}
              {d.mapEmbedUrl && (
                <div class="location-card-map">
                  <iframe
                    src={d.mapEmbedUrl}
                    title={`Map showing ${d.name} location`}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                  ></iframe>
                </div>
              )}
              <a href={`/locations/${d.slug}/`} class="location-card-link">
                View {d.name} location →
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--ink-300);
    margin-bottom: 1.5rem;
  }
  .breadcrumb a { color: var(--green-300); text-decoration: none; }

  .contact-section {
    background: var(--cream-100);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 380px;
    gap: 3rem;
    align-items: start;
  }

  .contact-info-card {
    padding: 1.75rem;
  }
  .contact-info-card h3 {
    font-size: 1.1rem;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid var(--ink-100);
    padding-bottom: 0.75rem;
  }
  .info-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--ink-100);
  }
  .info-item:last-child { border-bottom: none; }
  .info-icon { font-size: 1.1rem; flex-shrink: 0; margin-top: 0.1rem; }
  .info-item strong {
    display: block;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-300);
    margin-bottom: 0.25rem;
  }
  .info-item a {
    color: var(--green-300);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    transition: color 0.15s;
  }
  .info-item a:hover { color: var(--green-400); }
  .info-item address, .info-item span {
    font-size: 0.95rem;
    color: var(--ink-700);
    line-height: 1.5;
  }

  /* Locations grid */
  .contact-locations {
    background: var(--cream-100);
  }

  .locations-cards-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    margin-top: 1rem;
  }

  .location-card {
    flex: 0 1 calc(33.333% - 1.334rem);
    min-width: 280px;
    max-width: 360px;
    display: flex;
    flex-direction: column;
    background: var(--cream-50);
    border: 1px solid var(--cream-300);
    border-radius: var(--radius);
    padding: 1.5rem;
    box-shadow: var(--shadow-sm);
  }

  .location-card.coming-soon {
    opacity: 0.92;
  }

  .location-card-badge {
    align-self: flex-start;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.2rem 0.7rem;
    border-radius: 999px;
    margin-bottom: 1rem;
  }
  .location-card-badge.open {
    background: var(--green-100);
    color: var(--green-500);
  }
  .location-card-badge.future {
    background: var(--cream-200);
    color: var(--ink-700);
  }

  .location-card h3 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem 0;
    color: var(--ink-900);
  }

  .location-card-address {
    font-style: normal;
    color: var(--ink-700);
    margin: 0 0 0.5rem 0;
    line-height: 1.5;
    font-size: 0.92rem;
  }

  .location-card-phone {
    margin: 0 0 1rem 0;
    font-size: 0.92rem;
  }
  .location-card-phone a {
    color: var(--green-400);
    text-decoration: none;
    font-weight: 500;
  }
  .location-card-phone a:hover {
    color: var(--green-500);
    text-decoration: underline;
  }

  .location-card-map {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-sm);
    overflow: hidden;
    margin-bottom: 1rem;
    box-shadow: var(--shadow-sm);
  }
  .location-card-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  .location-card-link {
    margin-top: auto;
    color: var(--green-400);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
  }
  .location-card-link:hover {
    color: var(--green-500);
    text-decoration: underline;
  }

  @media (max-width: 900px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 860px) {
    .location-card { flex: 0 1 calc(50% - 1rem); }
  }
  @media (max-width: 540px) {
    .location-card { flex-basis: 100%; max-width: 100%; }
  }
</style>
