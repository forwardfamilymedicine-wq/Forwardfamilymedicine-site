---
import MainLayout from '../layouts/MainLayout.astro';
import { Image } from 'astro:assets';
import PageHero from '../components/shared/PageHero.astro';
import MeetGreetForm from '../components/shared/MeetGreetForm.astro';
import figMirror from '../assets/office/wayne-fig-mirror.jpg';
import { getCollection } from 'astro:content';
import SageCard from '../components/shared/SageCard.astro';
import { isPlanned, openOfficesFor } from '../utils/physicianRouting';
import { formatMonthYear } from '../utils/availability';
import { keepUnit } from '../utils/address';

const locations = (await getCollection('locations'))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);
const providers = await getCollection('providers');

// A Google Maps embed for a place search, written the way the locations'
// own mapEmbedUrl values are: spaces as +, commas kept.
const mapEmbed = (query: string) =>
  `https://www.google.com/maps?q=${encodeURIComponent(query).replace(/%20/g, '+').replace(/%2C/g, ',')}&output=embed`;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Contact", "item": "https://www.forwardfamilymedicine.com/contact/" }
  ]
};
---

<MainLayout
  title="Schedule a Meet & Greet | Forward Family Medicine Wayne PA"
  description="Schedule a free meet and greet at Forward Family Medicine. No obligation, no commitment. Meet our physicians in Wayne or Malvern, PA and see if we're the right fit for you."
  schema={breadcrumb}
>
  <PageHero crumb="Contact" title="Schedule a Meet & Greet" pt={80} pb={64} cols="1.3fr .7fr" maxW={640}>
    <p>
      The best way to decide if Forward Family Medicine is right for you is to come in
      and meet us. Ask everything. See the office. It's free. No pressure. No commitment.
      Just a conversation. Prefer to connect remotely? We also offer video meet &amp; greets — just let us know in the form below.
    </p>
    <Image
      slot="aside"
      src={figMirror}
      alt="The waiting room at our Wayne office, reflected in the entry mirror"
      widths={[320, 480, 640]}
      sizes="(max-width: 860px) calc(100vw - 40px), 320px"
      format="webp"
      quality={80}
      loading="eager"
      fetchpriority="high"
      class="contact-photo"
    />
  </PageHero>

  <section class="contact-sec">
    <div class="rd-wrap contact-grid">
      <!-- Form -->
      <div class="contact-form-col">
        <MeetGreetForm />
        <div class="after">
          <h2 class="after__h rd-serif">What Happens After You Submit</h2>
          <ol class="steps">
            <li>We review your request</li>
            <li>We reach out within 24 hours to schedule</li>
            <li>You come in for your free meet &amp; greet</li>
            <li>You decide — no pressure, no obligation</li>
          </ol>
        </div>
      </div>

      <!-- Info -->
      <aside class="contact-info" data-sticky-fit>
        <div class="info-block">
          <h2 class="info-h rd-serif">Practice Information</h2>
          <dl class="facts">
            <div class="fact">
              <dt>Wayne</dt>
              <dd><address>295 Old Eagle School Road, STE&nbsp;2<br />Wayne, PA 19087</address></dd>
            </div>
            <div class="fact">
              <dt>Malvern</dt>
              <dd><address>301 Lindenwood Dr #206<br />Malvern, PA 19355</address></dd>
            </div>
            <div class="fact">
              <dt>Phone</dt>
              <dd><a href="tel:+12156457044">(215) 645-7044</a></dd>
            </div>
            <div class="fact">
              <dt>Fax</dt>
              <dd><a href="tel:+12154498854">(215) 449-8854</a></dd>
            </div>
            <div class="fact fact--stack">
              <dt>Email</dt>
              <dd class="fact__email"><a href="mailto:information@forwardfamilymedicine.com">information@forwardfamilymedicine.com</a></dd>
            </div>
            <div class="fact">
              <dt>Office Hours</dt>
              <dd>Monday–Friday: 7:30 AM – 5:30 PM</dd>
            </div>
          </dl>
        </div>

        <div class="info-block info-block--serving">
          <h3 class="rd-h3">Serving the Main Line</h3>
          <p>We see patients from across the Main Line and greater Philadelphia area, including:</p>
          <ul class="serving">
            <li>Wayne, PA</li>
            <li>Berwyn &amp; Devon</li>
            <li>Paoli &amp; Malvern</li>
            <li>Radnor &amp; Villanova</li>
            <li>Chester County</li>
            <li>Greater Philadelphia</li>
          </ul>
        </div>

        <SageCard class="enroll">
          <h3 class="rd-h3">Ready to Enroll?</h3>
          <p>If you've already met with us and are ready to join, enroll directly online:</p>
          <div class="enroll__btns">
            <a href="https://forwardfamilymedicine.sigmamd.com/signup/individual-membership" class="btn-forest" target="_blank" rel="noopener noreferrer">Enroll as Individual</a>
            <a href="https://forwardfamilymedicine.sigmamd.com/signup/family-membership" class="btn-ghost" target="_blank" rel="noopener noreferrer">Enroll Your Family</a>
            <a href="https://patient.sigmamd.com" class="rd-link enroll__portal" target="_blank" rel="noopener noreferrer">Patient Portal Login</a>
          </div>
        </SageCard>
      </aside>
    </div>
  </section>

  <section class="locs-sec rd-alt">
    <div class="rd-wrap">
      <div class="rd-stack locs-intro">
        <h2 class="rd-h2">Our Locations</h2>
        <p class="rd-copy">
          Wayne and Malvern are open, and a West Chester office is planned. Each location offers the same Forward Family Medicine experience.
        </p>
      </div>

      <div class="locs" data-reveal="0.05">
        {locations.map(loc => {
          const d = loc.data;
          const isOpen = d.status === 'open';
          // Coming soon with no opening date is a planned office: the badge
          // says so and never shows a month, and it has no address or phone.
          // In their place it shows its town, the open offices where its
          // physicians see patients now, and a map of the town with no pin.
          const planned = isPlanned(loc);
          const town = `${d.addressCity}, ${d.addressState}`;
          const seenAt = planned ? openOfficesFor(loc, providers, locations) : [];
          // An office with a street but no mapEmbedUrl still gets its map.
          const map = planned
            ? { src: mapEmbed(town), title: `Map of ${town}` }
            : d.mapEmbedUrl || d.addressStreet
              ? { src: d.mapEmbedUrl ?? mapEmbed(`${d.addressStreet}, ${town} ${d.addressZip}`), title: `Map showing ${d.name} location` }
              : null;
          return (
            <article class:list={['loc', { 'loc--planned': !isOpen }]}>
              {map && (
                <div class="loc__map">
                  <iframe
                    src={map.src}
                    title={map.title}
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                  ></iframe>
                </div>
              )}
              <p class:list={['loc__status', { 'loc__status--muted': !isOpen }]}>
                {isOpen ? 'Now Open' : planned ? 'Planned' : `Opening ${formatMonthYear(d.openingDate!)}`}
              </p>
              <h3 class="loc__name rd-serif">{d.name}</h3>
              {planned ? (
                <p class="loc__addr">{town}<br />Address and opening date to come</p>
              ) : (
                <address class="loc__addr">
                  {d.addressStreet && <Fragment>{keepUnit(d.addressStreet)}<br /></Fragment>}
                  {d.addressCity}, {d.addressState} {d.addressZip}
                </address>
              )}
              {planned ? seenAt.length > 0 && (
                <p class="loc__line">Seeing patients now in {seenAt.map((o, i) => <Fragment>{i === 0 ? '' : i === seenAt.length - 1 ? ' and ' : ', '}<a href={`/locations/${o.data.slug}/`}>{o.data.name}</a></Fragment>)}</p>
              ) : d.phone && (
                <p class="loc__line">
                  <a href={`tel:${d.phone.replace(/\D/g, '')}`}>{d.phone}</a>
                </p>
              )}
              <a href={`/locations/${d.slug}/`} class="rd-link loc__link">
                View {d.name} location →
              </a>
            </article>
          );
        })}
      </div>
    </div>
  </section>
</MainLayout>

<style>
  :global(.contact-photo) { aspect-ratio: 4 / 5; object-position: 50% 50%; }

  .contact-sec { background: var(--linen); padding: 0 0 96px; }
  .contact-grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: 64px; align-items: start; }
  .contact-form-col { display: flex; flex-direction: column; gap: 40px; min-width: 0; }
  .after { display: flex; flex-direction: column; gap: 14px; max-width: 620px; }
  .after__h { margin: 0; font-size: 28px; line-height: 1.15; color: var(--forest); }
  .steps { counter-reset: s; margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; }
  .steps li {
    counter-increment: s;
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    gap: 14px;
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 15px;
    line-height: 1.6;
    color: var(--text-900);
  }
  .steps li:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .steps li::before { content: counter(s); font-family: var(--font-heading); font-size: 24px; color: var(--sage-600); line-height: 1; }

  .contact-info { display: flex; flex-direction: column; gap: 28px; }
  .info-block { display: flex; flex-direction: column; gap: 10px; }
  .info-block > :global(p) { margin: 0; }
  .info-h { margin: 0 0 8px; font-size: 26px; line-height: 1.15; color: var(--forest); }
  .facts { margin: 0; display: flex; flex-direction: column; }
  .fact {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 14px;
    line-height: 1.6;
  }
  .fact:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .fact dt { color: var(--text-600); margin: 0; }
  .fact dd { margin: 0; color: var(--forest); }
  .fact address { font-style: normal; }
  .fact a { color: var(--sage-600); }
  .fact a:hover { color: var(--forest); }
  /* The email address gets the full width under its label, so it never breaks mid-word. */
  .fact--stack { grid-template-columns: minmax(0, 1fr); gap: 2px; }
  .fact__email { overflow-wrap: anywhere; }
  .info-block--serving > :global(p:first-of-type) { font-size: 14px; line-height: 1.65; color: var(--text-700); }
  .serving { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; font-size: 14px; line-height: 1.9; color: var(--forest); }
  /* The separator trails its item: it can end a wrapped line, never start one. */
  .serving li:not(:last-child)::after { content: '·'; margin: 0 8px; color: var(--hairline-dot); }
  .contact-info :global(.enroll) { gap: 14px; }
  .contact-info :global(.enroll) > :global(p) { font-size: 14px; line-height: 1.65; color: var(--text-700); }
  .enroll__btns { display: flex; flex-direction: column; gap: 10px; }
  .enroll__btns :global(.btn-forest), .enroll__btns :global(.btn-ghost) { min-height: 44px; font-size: 13.5px; }
  .enroll__portal { align-self: center; margin-top: 4px; }

  .locs-sec { padding: 96px 0; border-bottom: 0; }
  .locs-intro { max-width: 760px; margin-bottom: 40px; }
  .locs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; }
  .loc {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 0;
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline-strong);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .locs.on .loc { opacity: 1; transform: none; }
  .locs.on .loc:nth-child(2) { transition-delay: 0.2s; }
  .locs.on .loc:nth-child(3) { transition-delay: 0.4s; }
  .loc__map {
    position: relative;
    aspect-ratio: 4 / 3;
    margin-bottom: 8px;
    overflow: hidden;
    background: var(--linen-300);
    border: 1px solid var(--hairline-strong);
    border-radius: 2px;
  }
  .loc__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .loc--planned .loc__map iframe { filter: grayscale(1); opacity: 0.85; }
  .loc > :global(p), .loc > :global(address) { margin: 0; }
  .loc__status { font-size: 13px; font-weight: 500; color: var(--gold-text); }
  .loc__status--muted { color: var(--text-600); }
  .loc__name { margin: 0; font-size: 30px; line-height: 1.1; color: var(--forest); }
  .loc--planned .loc__name { color: var(--text-600); }
  .loc__addr { font-style: normal; font-size: 15px; line-height: 1.65; color: var(--text-900); }
  .loc--planned .loc__addr { color: var(--text-600); }
  .loc__line { font-size: 15px; color: var(--text-600); }
  .loc__line a { color: var(--sage-600); }
  .loc__link { align-self: flex-start; margin-top: 8px; }

  @media (max-width: 860px) {
    .contact-sec { padding-bottom: 64px; }
    .contact-grid { grid-template-columns: 1fr; gap: 48px; }
    .locs-sec { padding: 64px 0; }
    .locs { grid-template-columns: 1fr; gap: 28px; }
    .loc { max-width: 560px; }
  }
</style>
