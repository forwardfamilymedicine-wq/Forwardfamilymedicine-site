---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
import CTABanner from '../components/shared/CTABanner.astro';

const faqGroups = [
  {
    id: 'about',
    title: 'About Forward Family Medicine',
    faqs: [
      {
        q: 'What is Forward Family Medicine?',
        a: 'Forward Family Medicine is a Direct Primary Care (DPC) practice in Wayne, PA. We provide comprehensive primary care on a membership model: you pay a flat monthly fee, and in return you receive unlimited primary care visits, direct access to your physician, longer appointments, and wholesale lab pricing — with no copays or insurance billing for covered services. <a href="/about/">Learn more about our practice →</a>',
      },
      {
        q: 'Where are you located?',
        a: 'Our flagship office is located in Wayne, Pennsylvania, on the Philadelphia Main Line at 295 Old Eagle School Road, STE 2, Wayne, PA 19087. Our second office is in Malvern, Chester County (301 Lindenwood Dr #206). A West Chester office is planned. <a href="/contact/">See our locations and contact info →</a>',
      },
      {
        q: 'Who are the physicians at Forward Family Medicine?',
        a: 'Dr. David Bigley is the founder of Forward Family Medicine, a board-certified Family Medicine physician, and a Doctor of Osteopathic Medicine (DO). Dr. Philip Lieberman is dual board-certified in Family Medicine and Lifestyle Medicine, with a culinary arts background that makes nutrition advice actually practical. Dr. Brian Landi is board-certified in Family Medicine and a Menopause Society Certified Practitioner, seeing patients at our Malvern location. <a href="/meet-the-team/">Meet the team →</a>',
      },
      {
        q: 'Are you currently accepting new patients?',
        a: 'Our panel is intentionally capped at ~250 patients per physician, so we encourage you to <a href="/contact/">schedule a free Meet & Greet →</a> before spots fill.',
      },
    ],
  },
  {
    id: 'dpc',
    title: 'About Direct Primary Care',
    faqs: [
      {
        q: 'What is Direct Primary Care (DPC)?',
        a: 'Direct Primary Care is a membership-based model of primary care in which patients pay a flat monthly fee directly to their physician — bypassing insurance for primary care services. In exchange, members receive unlimited visits, direct physician access, and longer appointments. At Forward Family Medicine, our panel is capped at 250 patients per physician — versus 2,000–3,000 in traditional practices. <a href="/direct-primary-care/">Full DPC explainer →</a>',
      },
      {
        q: 'How is DPC different from concierge medicine?',
        a: 'Both models offer smaller panels, direct access, and longer visits. The key difference: traditional concierge medicine typically charges a higher annual retainer and may still bill insurance. DPC does not bill insurance for primary care and charges a lower flat monthly fee — making it more accessible. <a href="/concierge-medicine/">See the full comparison →</a>',
      },
      {
        q: 'Is DPC legal?',
        a: 'Yes. DPC is legal in all 50 states. Many states have passed legislation explicitly affirming that DPC membership agreements are not insurance products and do not require an insurance license to operate.',
      },
      {
        q: 'How many patients do your physicians see per day?',
        a: 'We schedule based on need, not volume. On a typical day, each of our physicians may see 6–12 patients — compared to 20–30 in a traditional practice. This is what enables longer appointments, same-day access, and real follow-through on care.',
      },
    ],
  },
  {
    id: 'pricing',
    title: 'Membership & Pricing',
    faqs: [
      {
        q: 'What does a membership cost?',
        a: 'Individual membership is $200/month. Family membership starts at $175/person/month for two members and scales to $100/person/month for five or more. There is no enrollment fee. <a href="/membership/">See full membership details and pricing →</a>',
      },
      {
        q: 'What does the monthly membership include?',
        a: 'Your membership covers unlimited primary care visits (in-person, video, and phone), direct physician access, preventive care, chronic disease management, lifestyle medicine counseling, same-day/next-day scheduling, and minor in-office procedures. Labs and medications are available at wholesale/near-cost pricing as separate add-ons. <a href="/services/">See full service list →</a>',
      },
      {
        q: 'Are there any copays or per-visit fees?',
        a: 'No. Once you are a member, there are no additional fees for covered visits. The only charges beyond your membership are for labs, medications, and immunizations — all priced at cost.',
      },
      {
        q: 'Is there a long-term commitment?',
        a: 'We offer both month-to-month and annual membership options. All memberships include a 6-month minimum commitment from your enrollment date. After that period, month-to-month plans require 30 days\' written notice to cancel.',
      },
      {
        q: 'Is there an enrollment fee?',
        a: 'At Forward Family Medicine, there is no enrollment fee.',
      },
      {
        q: 'Can I use my HSA or FSA for membership fees?',
        a: 'HSA rules for Direct Primary Care changed in 2026, and the answer depends on your specific plan and how your membership is structured. We\'re happy to walk through the details with you at a <a href="/contact/">Meet & Greet</a>. Labs, medications, and in-office procedures at our practice are HSA- and FSA-eligible regardless of membership treatment.',
      },
      {
        q: 'Do you offer employer group memberships?',
        a: 'Yes. We work with small and mid-size employers to offer DPC memberships as a health benefit. <a href="/for-businesses/">Contact us to discuss employer options →</a>',
      },
    ],
  },
  {
    id: 'insurance',
    title: 'Insurance',
    faqs: [
      {
        q: 'Do I still need health insurance if I join a DPC practice?',
        a: 'Yes — we recommend it. Your DPC membership provides comprehensive primary care but does not cover hospital stays, emergency care, specialist visits, surgery, or imaging. We strongly recommend maintaining a health insurance plan — ideally a high-deductible health plan (HDHP) paired with an HSA — for these scenarios.',
      },
      {
        q: 'Will you bill my insurance for visits?',
        a: 'No. We do not bill insurance for primary care services. Your membership fee is the only charge for covered visits. Some members choose to submit their own claims for out-of-network reimbursement — check with your insurer.',
      },
      {
        q: 'Is DPC covered by Medicare or Medicaid?',
        a: 'DPC membership fees are not reimbursed by Medicare or Medicaid. Medicare and Medicaid beneficiaries are welcome to join as self-pay members. Specialist and hospital services would still be billed through Medicare or Medicaid as appropriate.',
      },
      {
        q: 'Can I use my insurance for labs and imaging ordered by your practice?',
        a: 'If you have insurance, you can choose to use it for labs and imaging. However, our wholesale lab pricing is often lower than your insurance-adjusted rate — we\'ll help you compare and choose.',
      },
    ],
  },
  {
    id: 'appointments',
    title: 'Appointments & Access',
    faqs: [
      {
        q: 'How quickly can I get an appointment?',
        a: 'Members typically get same-day or next-day appointments for acute concerns. Routine visits can be scheduled within 24–48 hours. Many concerns are resolved by phone or message without any in-person visit.',
      },
      {
        q: 'Can I contact my doctor between visits?',
        a: 'Yes. Members have direct access to their physician via phone, text, and secure messaging. You will not reach an answering service or a nurse line.',
      },
      {
        q: 'What are your office hours?',
        a: 'Monday–Friday, 7:30 AM – 5:30 PM. For urgent matters, members have after-hours contact access for true clinical urgency — not prescription refills or routine requests.',
      },
      {
        q: 'What if I have a medical emergency?',
        a: 'Always call 911 or go to the nearest emergency room for life-threatening emergencies. Your DPC membership is for primary care — not emergency or hospital care.',
      },
      {
        q: 'Do you offer telehealth visits?',
        a: 'Yes. Phone and video visits are included in your membership. Many concerns — prescription refills, minor illness, result review, follow-up — can be handled without coming in. Video visits are conducted through SigmaMD, our patient portal platform.',
      },
      {
        q: 'What happens if my physician is unavailable?',
        a: 'Forward Family Medicine physicians share a care model built for continuity. Each physician is familiar with all members at their location and has access to your full health history. If your primary physician is unavailable, coverage is in place. For planned absences, we communicate proactively so your care is uninterrupted.',
      },
    ],
  },
  {
    id: 'services',
    title: 'Services & Scope',
    faqs: [
      {
        q: 'Do you see children?',
        a: 'Yes. We provide care for patients of all ages, from newborns through older adults. Children can be added to a family membership. <a href="/membership/">See membership options →</a>',
      },
      {
        q: 'Can you manage my chronic conditions?',
        a: 'Yes. Chronic disease management — diabetes, hypertension, thyroid disease, cholesterol, asthma, and more — is a core part of what we do. The DPC model is particularly well-suited for chronic disease management because it provides the time and continuity these conditions require.',
      },
      {
        q: 'Do you provide mental health care?',
        a: 'We screen for and treat common mental health conditions including depression and anxiety, and provide medication management. For therapy and psychiatric care, we maintain strong referral relationships and help coordinate access.',
      },
      {
        q: 'Can you be my primary care physician even if I have specialists?',
        a: 'Absolutely. We work alongside your specialists and serve as the coordinating physician for your overall care — reviewing specialist notes, reconciling medications, and keeping your care integrated.',
      },
      {
        q: 'Do you do physicals and well-woman exams?',
        a: 'Yes. Annual physicals, well-woman exams, and preventive health screenings are core services included in your membership.',
      },
      {
        q: 'What procedures can you do in-office?',
        a: 'We perform a range of minor procedures: EKGs, ear lavage, wound care, joint injections, skin tag removal, suturing, spirometry, and more. <a href="/services/">View our services overview</a>',
      },
    ],
  },
  {
    id: 'lifestyle',
    title: 'Lifestyle Medicine',
    faqs: [
      {
        q: 'What is lifestyle medicine and is it included in my membership?',
        a: 'Lifestyle medicine uses evidence-based behavioral interventions — nutrition, physical activity, sleep, stress management — to prevent and treat chronic disease. It is provided by Dr. Lieberman, who is dual board-certified in Family Medicine and Lifestyle Medicine, and is integrated into every membership at no additional cost. <a href="/lifestyle-medicine/">Learn more →</a>',
      },
      {
        q: 'Do you have a specific diet you recommend?',
        a: 'We don\'t prescribe one-size-fits-all diets. We use evidence-based guidance — drawing on Mediterranean, DASH, whole-food plant-based, and other well-studied approaches — tailored to your health goals and preferences.',
      },
    ],
  },
  {
    id: 'getting-started',
    title: 'Getting Started',
    faqs: [
      {
        q: 'How do I become a patient?',
        a: 'The first step is a free, no-obligation Meet &amp; Greet with one of our physicians. <a href="/contact/">Schedule yours here →</a>',
      },
      {
        q: 'What happens at the Meet & Greet?',
        a: 'It\'s a 60-minute conversation, in person or by video, where you can ask questions, learn about the office, meet the doctors, and decide whether Forward Family Medicine is right for you. No pressure, no commitment.',
      },
      {
        q: 'How long does enrollment take?',
        a: 'Online enrollment takes about 10 minutes. Your first comprehensive visit is typically scheduled within the first week or two of enrollment.',
      },
      {
        q: 'What do I need to bring to my first appointment?',
        a: 'A list of your current medications, any recent lab results or medical records, and any questions or concerns you\'d like to address. We\'ll have reviewed your submitted health history before you arrive.',
      },
    ],
  },
];
---

<MainLayout
  title="Frequently Asked Questions | Forward Family Medicine Wayne, PA"
  description="Answers to the most common questions about Direct Primary Care, DPC membership, what's included, insurance, pricing, and how Forward Family Medicine works in Wayne, PA."
>
  <PageHero crumb="FAQ" title="Frequently Asked Questions" pt={80} pb={72} maxW={800}>
    <p>Everything you want to know about Forward Family Medicine and Direct Primary Care — answered plainly. If you don't see your question here, <a href="/contact/" class="rd-link">reach out directly →</a></p>
  </PageHero>

  <section class="faq-sec">
    <div class="rd-wrap faq-grid">
      <nav class="faq-idx" id="faq-idx" aria-label="Jump to FAQ section" data-sticky-fit>
        {faqGroups.map(g => <a href={`#${g.id}`}>{g.title}</a>)}
      </nav>
      <div class="faq-groups">
        {faqGroups.map(group => (
          <section id={group.id} class="faq-group">
            <h2 class="faq-group__h rd-serif">{group.title}</h2>
            <div class="faq-list" data-reveal="0.1">
              {group.faqs.map(faq => (
                <details class="faq-item">
                  <summary>
                    <span class="faq-q">{faq.q}</span>
                    <span class="faq-mark" aria-hidden="true">+</span>
                  </summary>
                  <div class="faq-answer">
                    <p set:html={faq.a} />
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="still rd-sage">
    <div class="rd-wrap still__inner">
      <div class="rd-stack still__copy">
        <h2 class="rd-h2 still__h">Still Have Questions?</h2>
        <p class="rd-copy">We're happy to help. Reach out directly or schedule a Meet &amp; Greet and ask in person — that's what it's for.</p>
      </div>
      <a href="/contact/" class="btn-ghost">Contact Us →</a>
    </div>
  </section>

  <CTABanner
    headline="Ready to Take the Next Step?"
    subhead="Start with a free, no-obligation meet and greet. No pressure. No commitment."
    btnText="Schedule a Free Meet & Greet"
    btnHref="/contact/?source=faq"
    btn2Text="Explore Membership Plans →"
    btn2Href="/membership/"
  />
</MainLayout>

<style>
  .faq-sec { background: var(--linen); padding: 0 0 96px; }
  .faq-grid { display: grid; grid-template-columns: 280px minmax(0, 1fr); gap: 72px; align-items: start; }

  /* Sticky category index. Pinning is left to stickyFit (top is --header-h + 24px
     once it fits); the current section is marked by scrollSpy. */
  .faq-idx { display: flex; flex-direction: column; }
  .faq-idx a {
    position: relative;
    display: block;
    padding: 12px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 14.5px;
    color: var(--forest);
    text-decoration: none;
  }
  .faq-idx a:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .faq-idx a::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: -1px;
    height: 2px;
    background: var(--sage);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .faq-idx a:hover::after, .faq-idx a.cur::after { transform: none; }
  .faq-idx a.cur { color: var(--sage-600); }

  .faq-group { padding-top: 56px; }
  .faq-group:first-child { padding-top: 0; }
  .faq-group__h { margin: 0 0 10px; font-size: 30px; line-height: 1.15; color: var(--forest); }
  .faq-item { border-bottom: 1px solid var(--hairline-strong); }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 18px 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--forest);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover .faq-q { color: var(--sage-600); }
  .faq-mark { color: var(--sage-600); font-weight: 400; font-size: 20px; line-height: 1; flex-shrink: 0; transition: transform 0.2s; }
  .faq-item[open] .faq-mark { transform: rotate(45deg); }
  .faq-answer { padding: 0 0 18px; }
  .faq-answer p { margin: 0; max-width: 68ch; font-size: 15px; line-height: 1.7; color: var(--text-700); }
  .faq-answer :global(a) { color: var(--sage-600); }
  .faq-answer :global(a:hover) { color: var(--forest); }
  .faq-list:first-of-type { border-top: 1px solid var(--hairline-strong); }
  .faq-list .faq-item { opacity: 0; transform: translateX(16px); transition: opacity 0.5s ease, transform 0.5s ease; }
  .faq-list.on .faq-item { opacity: 1; transform: none; }
  .faq-list.on .faq-item:nth-child(2) { transition-delay: 0.08s; }
  .faq-list.on .faq-item:nth-child(3) { transition-delay: 0.16s; }
  .faq-list.on .faq-item:nth-child(4) { transition-delay: 0.24s; }
  .faq-list.on .faq-item:nth-child(5) { transition-delay: 0.32s; }
  .faq-list.on .faq-item:nth-child(6) { transition-delay: 0.4s; }
  .faq-list.on .faq-item:nth-child(n+7) { transition-delay: 0.48s; }

  .still { padding: 72px 0; }
  .still__inner { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: center; }
  .still__h { font-size: 36px; line-height: 1.1; letter-spacing: -0.01em; }
  .still__copy .rd-copy { max-width: 560px; }

  @media (max-width: 860px) {
    .faq-sec { padding-bottom: 64px; }
    .faq-grid { grid-template-columns: 1fr; gap: 32px; }
    .faq-idx { flex-direction: row; gap: 8px; overflow-x: auto; padding-bottom: 4px; }
    .faq-idx a { flex: none; border: 1px solid var(--hairline-strong); border-radius: 999px; padding: 8px 14px; white-space: nowrap; font-size: 13px; }
    .faq-idx a:last-child { border-bottom: 1px solid var(--hairline-strong); }
    .faq-idx a::after { display: none; }
    .faq-idx a.cur { border-color: var(--sage-600); }
    .faq-group { padding-top: 44px; }
    .faq-group__h { font-size: 26px; }
    .still { padding: 56px 0; }
    .still__inner { grid-template-columns: 1fr; gap: 24px; }
    .still__h { font-size: 30px; }
  }
</style>

<script>
  import { initScrollSpy } from '../scripts/scrollSpy';
  initScrollSpy(
    document.getElementById('faq-idx'),
    Array.from(document.querySelectorAll('.faq-group')),
  );
</script>
