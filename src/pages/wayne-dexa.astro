---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import ServiceHero from '../components/shared/ServiceHero.astro';
import TitledGrid from '../components/shared/TitledGrid.astro';
import RuledList from '../components/shared/RuledList.astro';

// Wayne DEXA is in Forward Family Medicine's Wayne building, so it takes that
// building's coordinates from the locations collection rather than its own copy.
const wayne = (await getCollection('locations')).find(l => l.data.slug === 'wayne');
if (wayne?.data.latitude == null || wayne.data.longitude == null) {
  throw new Error('[wayne-dexa] locations/wayne has no latitude/longitude.');
}

const siteUrl = 'https://www.forwardfamilymedicine.com';
const pageUrl = `${siteUrl}/wayne-dexa/`;
const externalUrl = 'https://www.dexabodycomposition.com';

const pageTitle = 'DEXA Scan in Wayne, PA | Body Composition & Bone Density | Wayne DEXA';
const pageDescription =
  'DEXA body composition and bone density scans in Wayne, PA — $250 per scan. Measure lean mass, visceral fat, and bone mineral density. Open to everyone.';

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Wayne DEXA", "item": pageUrl }
  ]
};

// Wayne DEXA is a separate, co-located business at the same street address as
// Forward Family Medicine (distinct suite). It carries its own @id and its own
// canonical site (sameAs) so search engines do not conflate it with the FFM
// entity. The layout's org schema is suppressed on this page for the same reason.
const wayneDexaSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "@id": `${pageUrl}#business`,
  "name": "Wayne DEXA",
  "alternateName": "Wayne DEXA Body Composition",
  "description": "DEXA body composition and bone density scanning in Wayne, PA. $250 per scan, open to the public — no membership, referral, or insurance required.",
  "url": pageUrl,
  "sameAs": [externalUrl],
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "295 Old Eagle School Road, STE 2",
    "addressLocality": "Wayne",
    "addressRegion": "PA",
    "postalCode": "19087",
    "addressCountry": "US"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": wayne.data.latitude,
    "longitude": wayne.data.longitude
  },
  "priceRange": "$$",
  "currenciesAccepted": "USD",
  "paymentAccepted": "Cash, credit card",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "DEXA Scanning",
    "itemListElement": [
      {
        "@type": "Offer",
        "name": "DEXA body composition and bone density scan",
        "price": "250",
        "priceCurrency": "USD",
        "availability": "https://schema.org/InStock",
        "url": externalUrl,
        "itemOffered": {
          "@type": "Service",
          "name": "Dual-energy X-ray absorptiometry (DEXA) scan"
        }
      }
    ]
  }
};

const faqs = [
  {
    q: 'Do I need to be a Forward Family Medicine patient?',
    a: 'No. Wayne DEXA is open to the public. Anyone can book a scan, with no membership or referral required.',
  },
  {
    q: 'How much does a scan cost?',
    a: "$250 per scan, a founding rate available for a limited time. It's a cash-pay service with no insurance billing and no hidden fees; payment is collected in full at booking.",
  },
  {
    q: 'What does a DEXA scan measure?',
    a: "Body fat and where it's distributed, lean muscle mass, an estimate of visceral fat, and bone mineral density: a fuller picture of your health than weight or BMI alone.",
  },
  {
    q: 'How long does the scan take?',
    a: 'The scan itself takes about ten minutes. Plan for roughly twenty to thirty minutes total for your visit.',
  },
  {
    q: 'Is a DEXA scan safe?',
    a: "Yes. A DEXA scan on the GE Lunar Prodigy delivers a very low effective dose of roughly 1 to 5 µSv. That is about the same as 3 to 15 hours of ordinary background radiation, and a small fraction of a chest X-ray or a transatlantic flight. As a precaution, scans aren't performed during pregnancy.",
  },
  {
    q: 'Where is it located?',
    a: 'At 295 Old Eagle School Road, STE 2, Wayne, PA, the same location as Forward Family Medicine.',
  },
];

const measures = [
  { title: 'Body composition', body: 'Lean muscle mass, fat mass, and how each is distributed across your body.' },
  { title: 'Visceral fat', body: 'The metabolically active fat around your organs that drives cardiovascular and metabolic risk.' },
  { title: 'Bone mineral density', body: 'The standard used to assess bone strength and screen for osteopenia and osteoporosis.' },
];

---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  schema={[breadcrumb, wayneDexaSchema]}
  suppressOrgSchema={true}
>
  <ServiceHero title="Wayne DEXA Body Composition and Bone Density" titleCh={15}>
    <nav slot="before" class="wd-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">›</span> <a href="/services/">Services</a> <span aria-hidden="true">›</span> <span>Wayne DEXA</span>
    </nav>
    <p slot="lede">Precise body composition and bone density scanning in Wayne, PA.</p>
    <a href={externalUrl} class="btn-forest" target="_blank" rel="noopener noreferrer">Book a scan at dexabodycomposition.com →</a>
    <a href="#what" class="rd-link wd-link">What a scan measures</a>
  </ServiceHero>

  <section class="rd-section rd-alt" id="what">
    <div class="rd-wrap">
      <p class="wd-lede rd-serif">Wayne DEXA offers gold-standard DEXA (dual-energy X-ray absorptiometry) scanning for anyone who wants an accurate, objective picture of their body, not the rough estimate a scale or BMI provides. A complete scan takes about ten minutes.</p>
      <h2 class="rd-h2 wd-h2">A DEXA scan measures three things with clinical precision.</h2>
      <TitledGrid columns={3} reveal items={measures} />
      <p class="rd-copy wd-after">Whether you're building strength, tracking a metabolic or weight-management goal, or monitoring bone health as you age, DEXA is the tool that tells you whether what you're doing is actually working, and in which direction you're trending over time.</p>
    </div>
  </section>

  <section class="wd-band">
    <div class="rd-wrap wd-band__inner">
      <p class="wd-price rd-serif">$250 <span>per scan</span></p>
      <div class="wd-band__copy">
        <p>A founding rate available for a limited time. You don't need to be a Forward Family Medicine patient to book. It's a straightforward cash-pay service with transparent pricing and no insurance or referral required. Wayne DEXA measures and explains your results plainly; any decisions about your care remain yours to make with your own physician.</p>
        <a href={externalUrl} class="btn-sage" target="_blank" rel="noopener noreferrer">Book a scan at dexabodycomposition.com →</a>
      </div>
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--b">
      <h2 class="rd-h2 rd-sticky">Who it's for</h2>
      <RuledList size="md" reveal class="wd-who">
        <li><strong>People training seriously:</strong> strength, endurance, or physique athletes who want to track lean mass and fat changes accurately rather than guessing from the scale</li>
        <li><strong>Anyone managing weight or metabolic health:</strong> to confirm you're losing fat and preserving muscle, not the reverse</li>
        <li><strong>Adults monitoring bone health:</strong> postmenopausal women, older adults, and anyone with risk factors for osteoporosis who wants a baseline or ongoing tracking</li>
        <li><strong>Longevity-minded patients:</strong> those who want objective, repeatable data to measure how their body is changing over time</li>
      </RuledList>
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--b">
      <h2 class="rd-h2">Why it's here</h2>
      <p class="rd-copy wd-why">Wayne DEXA and Forward Family Medicine are co-located and affiliated, sharing an address at 295 Old Eagle School Road, STE 2, in Wayne. For Forward Family Medicine members, that means body-composition and bone-density data can inform the care your physician provides. For everyone else, it's simple access to a scan that's often hard to find and overpriced elsewhere.</p>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Frequently Asked Questions" />

  <!-- External booking: this closing band links out, not to /contact/. -->
  <section class="wd-close">
    <div class="rd-wrap wd-close__inner">
      <div class="wd-close__copy">
        <h2 class="wd-close__h2 rd-serif">Precise body composition and bone density scanning in Wayne, PA.</h2>
        <p>A complete scan takes about ten minutes. You don't need to be a Forward Family Medicine patient to book.</p>
      </div>
      <a href={externalUrl} class="btn-sage" target="_blank" rel="noopener noreferrer">Book a scan at dexabodycomposition.com →</a>
    </div>
  </section>
</MainLayout>

<style>
  .wd-breadcrumb { font-size: 13px; color: var(--text-500); margin-bottom: 18px; }
  .wd-breadcrumb a { color: var(--text-500); }
  .wd-breadcrumb a:hover { color: var(--forest); }
  .wd-breadcrumb span:last-child { color: var(--text-700); }
  .wd-link { align-self: center; }
  .wd-lede { margin: 0 0 56px; max-width: 880px; font-size: 26px; line-height: 1.45; color: var(--forest); }
  .wd-h2 { max-width: 20ch; margin-bottom: 36px; }
  .wd-after { margin-top: 40px; max-width: 760px; }
  .wd-who :global(strong) { font-weight: 500; }
  .wd-who :global(li) { font-size: 16px; color: var(--text-900); }
  .wd-why { font-size: 17px; }

  .wd-band { background: var(--forest); color: var(--linen); padding: 96px 0; }
  .wd-band__inner { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 72px; align-items: start; }
  .wd-price { margin: 0; font-size: 96px; line-height: 1; letter-spacing: -0.025em; color: var(--linen); }
  .wd-price span { font-family: var(--font-body); font-size: 16px; letter-spacing: 0; color: var(--on-forest-faint); }
  .wd-band__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 26px; padding-top: 34px; }
  .wd-band__copy p { margin: 0; max-width: 640px; font-size: 17px; line-height: 1.75; color: var(--on-forest); }

  .wd-close { background: var(--forest); color: var(--linen); padding: 104px 0; }
  .wd-close__inner { display: grid; grid-template-columns: minmax(0, 1.3fr) auto; gap: 48px; align-items: center; }
  .wd-close__copy { display: flex; flex-direction: column; gap: 18px; }
  .wd-close__h2 { margin: 0; max-width: 18ch; font-size: 52px; line-height: 1.06; letter-spacing: -0.015em; color: var(--linen); }
  .wd-close__copy p { margin: 0; max-width: 560px; font-size: 17px; line-height: 1.7; color: var(--on-forest-muted); }

  @media (max-width: 860px) {
    .wd-lede { font-size: 21px; margin-bottom: 36px; }
    .wd-band { padding: 64px 0; }
    .wd-band__inner { grid-template-columns: 1fr; gap: 24px; }
    .wd-price { font-size: 64px; }
    .wd-band__copy { padding-top: 0; }
    .wd-close { padding: 64px 0; }
    .wd-close__inner { grid-template-columns: 1fr; gap: 28px; }
    .wd-close__h2 { font-size: 34px; max-width: none; }
  }
</style>
