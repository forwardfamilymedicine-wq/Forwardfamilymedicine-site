---
/**
 * Privacy Policy. The text is counsel's, as supplied on 2026-11-23, with
 * three changes David asked for the same day: the "Restricted Analytics
 * Measurement" sub-section is removed (the site runs no analytics before
 * consent), one sentence on the first-party attribution record is added
 * under Campaign Attribution, and the text-message sentences are removed
 * (the practice does not text prospects), with section 7's heading and one
 * list item shortened to match. The links on the email address and the website
 * address are the only other additions. Change the wording here only from an
 * updated policy text. The typographic pattern (serif headings, a 720px reading column on
 * lighter linen) is the one the 404 page and the forms' inline success
 * states follow. Section headings carry ids so a link can point into the
 * policy (for example #managing-your-preferences).
 */
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/shared/PageHero.astro';
---

<MainLayout
  title="Privacy Policy | Forward Family Medicine"
  description="How Forward Family Medicine collects, uses, shares, and protects information from website visitors and membership inquiries, including your analytics and advertising choices."
>
  <PageHero crumb="Privacy Policy" title="Privacy Policy" size={60} pt={80} pb={64} maxW={760}>
    <p class="effective-date">Effective Date: January 1, 2026</p>
    <p class="effective-date">Last Updated: November 23, 2026</p>
  </PageHero>

  <section class="pol-sec">
    <div class="rd-wrap">
      <div class="pol">

        <p>Forward Family Medicine ("FFM," "we," "our," or "us") is a physician-owned direct primary care practice operated by Bigley Venture One LLC. We are committed to protecting the privacy and confidentiality of individuals who visit our website, inquire about membership, and receive care through our practice.</p>
        <p>This Privacy Policy explains how we collect, use, maintain, and disclose information through our website, <a href="https://www.forwardfamilymedicine.com">https://www.forwardfamilymedicine.com</a>, and our related inquiry and scheduling processes.</p>

        <h2 id="information-we-collect">1. Information We Collect</h2>
        <p>We may collect the following categories of information.</p>
        <h3 id="information-you-provide">Information You Provide</h3>
        <p>When you submit a contact form, request a meet-and-greet, inquire about membership, or communicate with our practice, we may collect:</p>
        <ul>
          <li>Name</li>
          <li>Email address</li>
          <li>Phone number</li>
          <li>Date of birth</li>
          <li>Preferred office location</li>
          <li>General area of interest or service requested</li>
          <li>Number of individuals interested in membership</li>
          <li>How you heard about our practice</li>
          <li>Any additional information you voluntarily provide</li>
        </ul>
        <p>We use date of birth when requested to help manage prospective membership inquiries and related administrative processes.</p>
        <p>Our general website inquiry forms are intended for administrative and membership inquiries, not the collection of medical histories or clinical information. Please do not include diagnoses, symptoms, medications, laboratory results, or other sensitive medical details in these forms.</p>
        <p>Information necessary to establish a physician-patient relationship and support medical care is collected separately through our designated enrollment and clinical systems.</p>
        <h3 id="automatically-collected-information">Automatically Collected Information</h3>
        <p>When you visit our website, we and our service providers may automatically collect certain technical information, including:</p>
        <ul>
          <li>IP address</li>
          <li>Browser and device type</li>
          <li>Operating system</li>
          <li>Pages visited and links clicked</li>
          <li>Date and time of visits</li>
          <li>Referring website</li>
          <li>General website interaction information</li>
          <li>Cookie and similar technology identifiers, where applicable</li>
        </ul>
        <p>This information helps us maintain website functionality, monitor security, understand website performance, and evaluate the effectiveness of our outreach.</p>

        <h2 id="how-we-use-your-information">2. How We Use Your Information</h2>
        <p>We use information collected through our website and inquiry processes to:</p>
        <ul>
          <li>Respond to questions and membership inquiries.</li>
          <li>Schedule meet-and-greets and consultations.</li>
          <li>Provide information about our membership options and services.</li>
          <li>Follow up regarding an inquiry or requested information.</li>
          <li>Coordinate prospective member communications.</li>
          <li>Improve our website and visitor experience.</li>
          <li>Understand general website traffic and marketing campaign performance.</li>
          <li>Maintain website security and prevent fraudulent activity.</li>
          <li>Comply with applicable legal obligations.</li>
        </ul>
        <p>We do not use information submitted through our website forms to create advertising audiences based on an individual's medical conditions, diagnoses, treatment history, or other sensitive health information.</p>

        <h2 id="how-your-information-is-transmitted">3. How Your Information Is Transmitted</h2>
        <p>Website form submissions are transmitted through a Google Apps Script endpoint to systems designated by Forward Family Medicine for review and follow-up.</p>
        <p>Submitted information is not stored directly on our website. However, information may be processed or stored by the third-party services used to transmit, manage, and maintain those submissions.</p>
        <p>We take reasonable steps to limit access to submitted information and use appropriate safeguards to protect it.</p>

        <h2 id="cookies-analytics-and-advertising-technologies">4. Cookies, Analytics, and Advertising Technologies</h2>
        <p>Our website may use cookies and similar technologies to support functionality, understand website usage, and evaluate the effectiveness of our marketing efforts.</p>
        <h3 id="necessary-website-technologies">Necessary Website Technologies</h3>
        <p>Certain technologies are necessary for website functionality, security, and remembering your privacy preferences. These technologies may operate without optional analytics or advertising consent.</p>
        <h3 id="optional-analytics">Optional Analytics</h3>
        <p>If you affirmatively accept analytics, we may enable additional Google Analytics functionality to better understand website traffic, visitor interactions, and page performance.</p>
        <p>Analytics information may include pages visited, browser and device information, referring websites, and general website interactions.</p>
        <p>You may decline optional analytics without affecting your ability to use our website or contact our practice.</p>
        <h3 id="advertising-technologies">Advertising Technologies</h3>
        <p>We advertise Forward Family Medicine through third-party platforms, including Meta (Facebook and Instagram).</p>
        <p>On designated advertising landing pages, we may use the Meta Pixel to measure website visits and the general effectiveness of our advertising campaigns.</p>
        <p>The Meta Pixel will remain disabled unless you affirmatively consent to advertising tracking through our website privacy settings. It will not load merely because you visit an advertising landing page or submit a contact form.</p>
        <p>When enabled, the Pixel is intended to transmit only limited, generic events, such as a page view or a general inquiry completion event. We do not intentionally transmit:</p>
        <ul>
          <li>Information entered into website forms.</li>
          <li>Names, email addresses, phone numbers, or dates of birth.</li>
          <li>Diagnoses, symptoms, medications, or medical history.</li>
          <li>Specific medical conditions or treatment interests.</li>
          <li>Physician selections or other details identifying the subject of an inquiry.</li>
        </ul>
        <p>We also do not upload patient lists, membership lists, or individual contact information to Meta for audience matching.</p>
        <p>Meta may receive technical information associated with these events, such as IP address, browser and device information, cookies, and other online identifiers. Meta may be able to associate this information with a Meta account or other information it maintains and process it under its own privacy policies.</p>
        <p>We do not use the Pixel to build audiences based on individual medical interests or to retarget visitors based on sensitive health-related browsing activity.</p>
        <p>You may decline advertising tracking without affecting your ability to use our website or contact our practice.</p>
        <h3 id="campaign-attribution">Campaign Attribution</h3>
        <p>We may use first-party campaign identifiers, including UTM parameters, to understand which advertising campaigns and landing pages generate website visits and membership inquiries.</p>
        <p>When you arrive from one of our advertisements, your browser may retain the campaign identifiers from the link, including UTM parameters and advertising click identifiers, together with the landing page path and the referring website, for up to 30 days; if you submit an inquiry during that time, this information is kept with your inquiry record and is not transmitted back to the advertising platform.</p>
        <p>These identifiers help us evaluate marketing performance internally. We seek to avoid including names, contact information, medical information, or other sensitive personal details in campaign parameters or URLs.</p>
        <h3 id="managing-your-preferences">Managing Your Preferences</h3>
        <p>You may review or change your optional analytics and advertising preferences at any time using the "Manage Cookie Choices" link in our website footer.</p>
        <p>Declining optional analytics or advertising technologies does not prevent you from using our website or contacting our practice.</p>

        <h2 id="how-your-information-is-shared">5. How Your Information Is Shared</h2>
        <p>We do not sell your personal information for monetary consideration.</p>
        <p>We may share information with third-party service providers that help us operate our website and practice. These providers may process information on our behalf for purposes such as:</p>
        <ul>
          <li>Website hosting and infrastructure.</li>
          <li>Website form processing and data management.</li>
          <li>Business communications and scheduling.</li>
          <li>Email communications.</li>
          <li>Patient management and electronic health records.</li>
          <li>Website analytics, as described in this policy.</li>
          <li>Advertising measurement, if you consent to the applicable advertising technologies.</li>
        </ul>
        <p>These providers may include Google, our website hosting providers, Meta, SigmaMD, Spruce, and other service providers we use in our operations.</p>
        <p>When you become a patient, your clinical information is maintained within our designated electronic health record and patient communication systems, including SigmaMD.</p>
        <p>We seek to limit the information shared with service providers to what is reasonably necessary for their services. Where required, we maintain appropriate contractual and privacy protections.</p>
        <p>We may also disclose information when required by law, regulation, court order, or when reasonably necessary to protect the rights, property, or security of our practice and others.</p>
        <p>We do not authorize service providers acting on our behalf to use personal information obtained through our website for their own independent marketing purposes. This does not restrict third-party platforms from processing information they independently receive through technologies you have consented to, subject to their own policies.</p>

        <h2 id="medical-records-and-patient-privacy">6. Medical Records and Patient Privacy</h2>
        <p>This website Privacy Policy primarily addresses website visitors, prospective members, and general inquiry information.</p>
        <p>Once you establish a physician-patient relationship, your medical information is handled through our clinical systems and governed by applicable medical privacy and confidentiality requirements.</p>
        <p>If Forward Family Medicine is subject to the Health Insurance Portability and Accountability Act (HIPAA), our separate Notice of Privacy Practices describes how protected health information may be used and disclosed and explains your rights under HIPAA.</p>
        <p>Nothing in this website Privacy Policy replaces or limits any privacy protections or rights that apply to your medical records.</p>

        <h2 id="phone-and-email-communications">7. Phone and Email Communications</h2>
        <p>If you provide your contact information, we may contact you regarding your inquiry, requested information, membership, or scheduling.</p>
        <p>Promotional or recurring marketing communications, if offered, will be subject to separate consent requirements and applicable federal and state laws.</p>
        <p>We do not share mobile phone numbers with third parties for their own independent marketing purposes.</p>

        <h2 id="data-retention">8. Data Retention</h2>
        <p>We retain personal information for as long as reasonably necessary to fulfill the purposes described in this policy, respond to inquiries, manage prospective membership relationships, maintain appropriate business records, and comply with applicable legal obligations.</p>
        <p>Website campaign attribution information and analytics data may be retained for limited periods consistent with their intended purposes.</p>
        <p>Medical records are maintained according to applicable medical record retention requirements and our clinical recordkeeping policies.</p>

        <h2 id="information-security">9. Information Security</h2>
        <p>We use reasonable administrative, technical, and organizational safeguards designed to protect information maintained by our practice.</p>
        <p>These safeguards may include access controls, account security measures, appropriate encryption, and limiting employee access based on job responsibilities.</p>
        <p>No method of electronic transmission or storage is completely secure. We cannot guarantee absolute security.</p>
        <p>If a security incident involving personal information occurs, we will investigate and provide notifications when required by applicable law.</p>

        <h2 id="your-privacy-choices-and-rights">10. Your Privacy Choices and Rights</h2>
        <p>You may contact us to request access to, correction of, or deletion of personal information collected through our website, subject to applicable legal requirements and record retention obligations.</p>
        <p>You may also:</p>
        <ul>
          <li>Decline optional analytics functionality.</li>
          <li>Decline advertising tracking.</li>
          <li>Change your website privacy preferences.</li>
          <li>Request that we stop contacting you regarding a prospective membership inquiry.</li>
        </ul>
        <p>Certain information may need to be retained for legal, regulatory, business, or medical recordkeeping purposes.</p>
        <p>To submit a privacy-related request, please contact us using the information below.</p>

        <h2 id="childrens-privacy">11. Children's Privacy</h2>
        <p>Our public-facing website is intended primarily for adults.</p>
        <p>We do not knowingly collect personal information directly from children through general website inquiry forms.</p>
        <p>Parents and legal guardians may contact us regarding pediatric care. Information relating to a child's medical care is collected through our appropriate clinical enrollment and patient communication processes.</p>

        <h2 id="third-party-websites">12. Third-Party Websites</h2>
        <p>Our website may contain links to third-party websites, including our patient portal, scheduling platforms, and other healthcare resources.</p>
        <p>These websites operate under their own privacy policies and practices. We encourage visitors to review those policies before submitting personal information.</p>

        <h2 id="changes-to-this-policy">13. Changes to This Policy</h2>
        <p>We may update this Privacy Policy as our practice, website technologies, or legal obligations change.</p>
        <p>The effective date and last updated date will be revised when changes are made.</p>
        <p>Material changes to how we collect, use, or disclose personal information will be reflected in an updated policy and, where required, an updated consent process.</p>

        <h2 id="contact-us">14. Contact Us</h2>
        <p>If you have questions about this Privacy Policy or how your information is handled, please contact:</p>
        <p class="pol__contact">
          Forward Family Medicine<br />
          295 Old Eagle School Road, Suite 2<br />
          Wayne, PA 19087<br />
          Phone: (215) 645-7044<br />
          Email: <a href="mailto:information@forwardfamilymedicine.com">information@forwardfamilymedicine.com</a><br />
          Website: <a href="https://www.forwardfamilymedicine.com">https://www.forwardfamilymedicine.com</a>
        </p>

      </div>
    </div>
  </section>
</MainLayout>

<style>
  .effective-date { color: var(--text-600) !important; font-size: 15px !important; line-height: 1.6 !important; }
  .effective-date + .effective-date { margin-top: 2px !important; }
  .pol-sec { background: var(--linen-50); border-top: 1px solid var(--hairline); padding: 64px 0 96px; }
  .pol { max-width: 720px; }
  .pol h2 {
    margin: 44px 0 10px;
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 26px;
    line-height: 1.2;
    color: var(--forest);
  }
  .pol h3 {
    margin: 26px 0 8px;
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
    color: var(--forest);
  }
  .pol p { margin: 0 0 18px; font-size: 16.5px; line-height: 1.8; color: var(--text-900); }
  .pol ul { margin: 0 0 18px; padding-left: 22px; }
  .pol li { margin: 0 0 6px; font-size: 16.5px; line-height: 1.7; color: var(--text-900); }
  .pol li::marker { color: var(--sage-600); }
  .pol__contact { line-height: 1.9; }
  .pol a { color: var(--sage-600); text-decoration: none; border-bottom: 1px solid var(--sage); }
  .pol a:hover { color: var(--forest); border-color: var(--forest); }
  @media (max-width: 860px) {
    .pol-sec { padding: 40px 0 64px; }
    .pol h2 { font-size: 23px; margin-top: 36px; }
    .pol h3 { font-size: 16px; }
  }
</style>
