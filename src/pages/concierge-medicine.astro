---
import { getCollection } from 'astro:content';
import MainLayout from '../layouts/MainLayout.astro';
import ServiceHero from '../components/shared/ServiceHero.astro';
import CompareTable from '../components/shared/CompareTable.astro';
import NumberedRows from '../components/shared/NumberedRows.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import { Picture } from 'astro:assets';
import roomLight from '../assets/office/wayne-room-light.jpg';
import creamChairs from '../assets/office/wayne-cream-chairs.jpg';
import FAQSection from '../components/shared/FAQSection.astro';
import NearYouExpander from '../components/shared/NearYouExpander.astro';
import MembershipRates from '../components/shared/MembershipRates.astro';
import HowToJoin from '../components/shared/HowToJoin.astro';
import RelatedReading from '../components/shared/RelatedReading.astro';
import { joinAnd } from '../utils/physicianRouting';
import TitledGrid from '../components/shared/TitledGrid.astro';

// The eyebrow names only offices a patient can go to today, in display order,
// so a planned office joins it the moment its locations entry flips to "open".
const openOffices = (await getCollection('locations'))
  .filter(l => l.data.status === 'open')
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder)
  .map(l => l.data.name);
const eyebrow = `${joinAnd(openOffices)}, near Philadelphia`;

// Town list is derived from the local collection, never hardcoded, so a new
// /local/concierge-doctor-*.md file appears here the moment it is added.
const conciergeTowns = (await getCollection('local'))
  .map(e => ({ slug: e.id.replace(/\.mdx?$/, ''), label: e.data.location ?? '' }))
  .filter(t => t.slug.startsWith('concierge-doctor-') && t.label)
  .sort((a, b) => a.label.localeCompare(b.label));

// Related reading, in order. Titles come from the blog collection, never
// retyped, and a slug with no entry fails the build.
const RELATED_POSTS = [
  'concierge-medicine-cost',
  'concierge-medicine-vs-direct-primary-care',
  'concierge-medicine-main-line',
];
const blogEntries = await getCollection('blog');
const relatedPosts = RELATED_POSTS.map(slug => {
  const entry = blogEntries.find(e => e.id.replace(/\.mdx?$/, '') === slug);
  if (!entry) throw new Error(`[concierge-medicine] no blog entry at ${slug}.`);
  return { href: `/blog/${slug}/`, title: entry.data.title };
});

const faqs = [
  {
    q: 'Is concierge medicine worth it?',
    a: 'That depends on how you use healthcare. Compare the membership with what you now spend on copays and deductibles, and with the value of your time. Our DPC model keeps the fee well below what traditional concierge practices charge.',
  },
  {
    q: 'Does Forward Family Medicine bill insurance?',
    a: 'We do not bill insurance for primary care services. Your monthly membership fee covers all included services. You should maintain health insurance for specialist, hospital, and emergency care.',
  },
  {
    q: 'How small is the patient panel really?',
    a: 'Each physician\'s panel is capped at about 250 patients, so your doctor has time for you. When a panel fills, we open a waitlist. If you\'re interested, <a href="/contact/?source=concierge-medicine">contact us</a> to check current availability.',
  },
  {
    q: 'Can I keep my current insurance and add this membership?',
    a: 'Yes. Most members combine our DPC membership with their existing insurance (or switch to a high-deductible plan) for specialist and hospital coverage.',
  },
  {
    q: 'What if I want to keep my relationships with my current specialists?',
    a: 'We work collaboratively with specialist physicians and large health systems. You do not need to abandon those relationships; you simply add a primary care physician who is far more accessible and engaged.',
  },
];
const means = [
  { title: 'Small Patient Panel', body: 'Your doctor knows you by name and history. At FFM, we cap our panel at 250 patients per physician, less than half the size of most DPC practices.' },
  { title: 'Same-Day Access', body: 'Same-day availability for acute issues. Routine visits within 24 hours. Many questions resolved by phone or message, no visit required.' },
  { title: 'Direct Physician Contact', body: 'Call or text your doctor directly. You will not reach an answering service, a nurse line, or a portal message that takes three days to answer.' },
  { title: 'Visits Without a Clock', body: 'Appointments are scheduled to fit the conversation, not to hit a billing threshold. Complex visits get the time they need.' },
  { title: 'Proactive Prevention', body: "We don't wait for you to get sick. We schedule preventive reviews, track labs over time, and follow up on recommendations proactively." },
  { title: 'Actively Lowers Your Costs', body: 'Wholesale lab pricing, medications at cost, and fewer urgent care visits. The goal: your total healthcare spend goes down as an FFM member.' },
];

const who = [
  { title: 'Busy Professionals', body: "When you can't afford to spend three hours waiting at urgent care, having same-day access to your own doctor, by phone, video, or in-person, changes everything." },
  { title: 'Families with Children', body: "One membership covers a family. Having a physician who knows your children's history, and yours, makes routine and urgent care far simpler and more reassuring." },
  { title: 'Adults with Chronic Conditions', body: 'Diabetes, hypertension, and thyroid disease require consistent, attentive management. The DPC model gives your doctor the time and continuity to manage these well.' },
  { title: "Anyone Who's Felt Rushed", body: "If you've ever left a doctor's appointment feeling like your questions weren't answered, or like the visit ended before you could say everything, this practice was built for you." },
];

---

<MainLayout
  title="Concierge Family Medicine near Philadelphia | Forward Family Medicine"
  description="Concierge family medicine in Wayne and Malvern, near Philadelphia: same-day access, your doctor's direct number, 1 to 2 hour visits. $200/month individual."
>

  <ServiceHero
    tone="dark"
    eyebrow={eyebrow}
    title="Concierge Family Medicine on the Main Line"
    titleCh={14}
    image={roomLight}
    alt="The Wayne waiting room in afternoon light: four armchairs, a plant, and a window onto the street"
    position="50% 70%"
  >
    <p slot="lede">Concierge family medicine at Forward Family Medicine means same-day or next-day appointments, visits of one to two hours, and your doctor's direct number, all through a direct primary care membership at our Wayne and Malvern offices.</p>
    <a href="/contact/?source=concierge-medicine" class="btn-sage">Schedule a Free Meet &amp; Greet</a>
    <a href="/membership/" class="btn-ghost-light">See Membership Pricing →</a>
  </ServiceHero>

  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">What Is Concierge Medicine?</h2>
        <p class="rd-copy">Concierge medicine (also called boutique medicine or retainer medicine) is an approach to primary care where patients pay a membership fee in exchange for enhanced access and a deeper relationship with their physician. The core promise is simple: <strong>a doctor with time for you.</strong></p>
      </div>
      <TitledGrid reveal columns={2} items={means} />
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <div class="rd-stack intro-narrow">
        <h2 class="rd-h2">How Forward Family Medicine Compares</h2>
        <p class="rd-copy">Traditional concierge medicine charges a premium retainer on top of, or instead of, insurance billing. DPC removes the insurance overhead entirely, which is what allows FFM to deliver the same concierge experience at a fraction of the cost.</p>
      </div>
      <div class="cmp-gap">
        <CompareTable
          caption="Traditional concierge medicine compared with Forward Family Medicine"
          columns={['Feature', 'Traditional Concierge', 'Forward Family Medicine']}
          widths={[22, 34, 44]}
          rows={[
            ['Patient panel size', '400–600 patients', '~250 patients per physician'],
            ['Monthly cost', '$400+/month', '<span class="cmp-num">$200</span>/mo individual; family from $175 down to $100/person'],
            ['Insurance billing', 'Often still billed', 'Never: no insurance billing for primary care'],
            ['Visit length', '30–60 minutes', '1–2 hours'],
            ['Direct doctor access', 'Yes', 'Yes: phone, text, email directly'],
            ['Lifestyle Medicine', 'Rarely included', 'Included; board-certified with Dr. Lieberman in Wayne'],
          ]}
        />
      </div>
      <p class="table-foot"><span class="rd-serif">Same experience. Lower overhead. Better medicine.</span> <a href="/direct-primary-care/" class="rd-link">Learn more about how DPC works →</a></p>
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--b">
      <div class="rd-stack">
        <h2 class="rd-h2">What It Costs Here</h2>
        <p class="rd-copy">Membership is $200 a month for an individual, with no enrollment fee, and families pay less per person as the family grows. Traditional concierge practices often charge more and may still bill your insurance. Our post on <a href="/blog/concierge-medicine-cost/" class="rd-link">what concierge medicine costs</a> walks through the numbers.</p>
      </div>
      <MembershipRates />
    </div>
  </section>

  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <h2 class="rd-h2 exp-h2">The Concierge Experience at Forward Family Medicine</h2>
      <div class="rd-split rd-split--b">
        <Picture
          src={creamChairs}
          alt="Two cream armchairs beneath an abstract painting in the Wayne office"
          widths={[400, 640, 800]}
          sizes="(max-width: 860px) calc(100vw - 40px), 420px"
          formats={['avif', 'webp']}
          loading="lazy"
          class="exp-img"
          style="aspect-ratio:4/5;object-position:40% 50%"
        />
        <div class="exp-items">
          <div class="exp-item">
            <h3 class="rd-h3 exp-h3">Your Doctor's Personal Attention</h3>
            <p>Our physicians maintain a purposefully small panel of members. That means every patient receives the kind of attention that simply isn't possible in a practice seeing 20–30 patients a day.</p>
            <p>When you call, you speak directly with your doctor or a team member who knows your name. When you send a message, you receive a thoughtful response, not a portal notification pointing you back to schedule an appointment.</p>
          </div>
          <div class="exp-item exp-item--ruled">
            <h3 class="rd-h3 exp-h3">A Practice That Actively Lowers Your Costs</h3>
            <p>Concierge medicine has a reputation for being expensive. We think it should be the opposite. Because we know you well and you can reach us directly, we help you avoid the urgent care visits, redundant tests, and reactive ER trips that quietly inflate the cost of traditional care.</p>
            <p>We dispense medications at cost and order labs at wholesale pricing, so when something is needed, it's not a financial event.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--a">
      <h2 class="rd-h2 rd-sticky">Who Benefits Most from Concierge-Style DPC?</h2>
      <NumberedRows rows={who} />
    </div>
  </section>

  <HowToJoin source="concierge-medicine" />

  <RelatedReading headline="More on Concierge Medicine" posts={relatedPosts} />

  <!-- The Clarity cross-link sits inside the FAQ band, directly under the
       questions, as it did when the FAQ was hand-built on this page. -->
  <FAQSection faqs={faqs}>
    <div class="faq-after">
      <p class="faq-more">More questions? <a href="/faq/" class="rd-link">See our full FAQ →</a></p>
      <p class="faq-clarity">Looking for something more comprehensive? <a href="/clarity/" class="rd-link">The Clarity Program</a> combines concierge DPC with whole-body MRI, advanced diagnostics, and longitudinal physician oversight, all in one annual membership.</p>
    </div>
  </FAQSection>

  <CTABanner
    headline="Ready to Experience Medicine the Way It Should Be?"
    subhead="No commitment, just a conversation to see if it's the right fit."
    btnText="Schedule a Free Meet & Greet"
    btnHref="/contact/?source=concierge-medicine"
    btn2Text="See Membership Plans →"
    btn2Href="/membership/"
  />

  <!-- Wayfinding, not persuasion: sits below the conversion content and
       links the /local/concierge-doctor-* town pages. -->
  <NearYouExpander
    id="concierge-near-you"
    ariaLabel="Concierge family medicine by location"
    summary={`Concierge family medicine in ${conciergeTowns.length} towns near our offices`}
    links={conciergeTowns.map(t => ({ href: `/local/${t.slug}/`, label: t.label }))}
  />

</MainLayout>

<style>
  .intro-narrow { max-width: 640px; }
  .cmp-gap { margin-top: 44px; }
  .table-foot { display: flex; flex-wrap: wrap; gap: 8px 20px; align-items: baseline; margin: 24px 0 0; }
  .table-foot span { font-size: 20px; color: var(--forest); }
  .exp-h2 { margin-bottom: 44px; }
  .exp-items { display: flex; flex-direction: column; gap: 40px; }
  .exp-item { display: flex; flex-direction: column; gap: 14px; }
  .exp-item--ruled { padding-top: 22px; border-top: 1px solid var(--forest); }
  .exp-h3 { font-size: 26px; line-height: 1.2; }
  .exp-item p { margin: 0; font-size: 15px; line-height: 1.75; color: var(--text-700); }
  .rd-split :global(.exp-img) { display: block; width: 100%; height: auto; object-fit: cover; border-radius: 2px; }
  .faq-after { display: flex; flex-direction: column; gap: 28px; margin-top: 28px; }
  .faq-after p { margin: 0; }
  .faq-more { font-size: 14px; color: var(--text-600); }
  .faq-clarity { padding-top: 24px; border-top: 1px solid var(--hairline-strong); font-size: 15px; line-height: 1.7; color: var(--text-700); }
</style>
