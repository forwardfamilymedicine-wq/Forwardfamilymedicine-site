---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import ProviderCard from '../../components/shared/ProviderCard.astro';
import { openOfficeName } from '../../utils/credentialRows';
import { isPlanned } from '../../utils/physicianRouting';
import { formatMonthYear, getAvailability } from '../../utils/availability';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const allProviders = await getCollection('providers');
const locationProviders = (data.providers || [])
  .map((slug: string) => allProviders.find(p => p.data.slug === slug))
  .filter(Boolean)
  .sort((a: any, b: any) => a.data.displayOrder - b.data.displayOrder);

const siteUrl = 'https://www.forwardfamilymedicine.com';
const canonicalUrl = `${siteUrl}/locations/${data.slug}/`;

// A coming-soon office either has an opening date or is planned (no lease, no
// date). There is no fallback month: a planned office is never given one.
const planned = isPlanned(entry);
const openingLabel = data.status === 'coming-soon' && data.openingDate ? formatMonthYear(data.openingDate) : null;

// Title and H1. An office that is not open says so in the label itself, since
// a search result shows the title without the status badge.
const officeLabel = planned
  ? `${data.name} Office (Planned)`
  : openingLabel ? `${data.name} Office (Opening ${openingLabel})` : `${data.name} Office`;
const pageTitle = `${officeLabel} | Forward Family Medicine`;
const pageDescription = planned
  ? `Forward Family Medicine plans a Direct Primary Care office in ${data.name}, PA. No opening date has been set. Dr. Landi is accepting new patients now.`
  : data.status === 'coming-soon'
    ? `Forward Family Medicine is opening a new Direct Primary Care location in ${data.name}, PA in ${openingLabel}. Dr. Landi is accepting new patients now.`
    : `Visit Forward Family Medicine in ${data.name}, PA. ${data.description}`;

// Where this office's physicians can be seen while it is only planned: their
// other offices, open ones first, otherwise the first one with a date.
const allLocations = await getCollection('locations');
const otherOffices = planned
  ? [...new Set(locationProviders.flatMap((p: any) => p.data.locations as string[]))]
      .filter(slug => slug !== data.slug)
      .map(slug => allLocations.find(l => l.data.slug === slug))
      .filter((l): l is NonNullable<typeof l> => Boolean(l) && !isPlanned(l!))
  : [];
const openOthers = otherOffices.filter(l => l.data.status === 'open');
const datedOther = otherOffices.find(l => l.data.status !== 'open');
const joinAnd = (items: string[]) => items.length <= 2 ? items.join(' and ') : `${items.slice(0, -1).join(', ')}, and ${items[items.length - 1]}`;
const plannedVisits = openOthers.length
  ? `Visits are at our ${joinAnd(openOthers.map(l => l.data.name))} ${openOthers.length > 1 ? 'offices' : 'office'} or by phone and video.`
  : datedOther
    ? `Our ${datedOther.data.name} office opens in ${formatMonthYear(datedOther.data.openingDate!)}, so early visits happen by telehealth.`
    : 'Visits are by phone and video.';

// A planned office has no address or phone to show. In their place the hero
// names who is accepting new patients now, and at which open office.
const plannedIntro = 'We will post the address and opening date here once they are confirmed.';
const plannedAccepting = locationProviders
  .filter((p: any) => getAvailability(p.data).status === 'accepting')
  .map((p: any) => `Dr. ${p.data.name.trim().split(/\s+/).pop()}`);
const plannedLine = planned && openOthers.length > 0 ? {
  lead: plannedAccepting.length > 0
    ? ` Until then, ${joinAnd(plannedAccepting)} ${plannedAccepting.length > 1 ? 'are' : 'is'} accepting new patients at our `
    : ' Until then, visits are at our ',
  offices: openOthers.map((l, i) => ({
    sep: i === 0 ? '' : i === openOthers.length - 1 ? ' and ' : ', ',
    href: `/locations/${l.data.slug}/`,
    label: openOthers.length === 1 ? `${l.data.name} office` : l.data.name,
  })),
  tail: openOthers.length > 1 ? ' offices.' : '.',
} : null;

const hasAddress = data.addressZip;

// Directions only to an open office with a street address: a planned office
// has nowhere to go, and a bare city sends people somewhere we never said.
// The practice name makes Google open our listing rather than a bare address.
const destination = `${data.addressStreet}, ${data.addressCity}, ${data.addressState} ${data.addressZip}`;
const directions = data.status === 'open' && data.addressStreet ? {
  google: `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(`Forward Family Medicine, ${destination}`)}`,
  apple: `https://maps.apple.com/?daddr=${encodeURIComponent(destination)}`,
} : null;

// The office's own structured data is in the site-wide graph (MainLayout,
// utils/practiceSchema), the same on every page, so this page adds only its
// breadcrumb.
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": `${siteUrl}/locations/` },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": canonicalUrl },
  ],
};
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schema={[breadcrumb]}
>
  <!-- Hero -->
  <section class="loc-hero">
    <div class="rd-wrap">
      <nav class="rd-crumb" aria-label="Breadcrumb">
        <a href="/">Home</a> <span aria-hidden="true">›</span>
        <a href="/locations/">Locations</a> <span aria-hidden="true">›</span>
        <span aria-current="page">{data.name}</span>
      </nav>

      <div class="loc-hero__grid">
        <div class="loc-hero__copy">
          {data.status === 'coming-soon' && (
            <p class="rd-eyebrow rd-eyebrow--muted">{planned ? 'Planned' : `Coming ${openingLabel}`}</p>
          )}
          {data.status === 'open' && (
            <p class="rd-eyebrow rd-eyebrow--gold">Now Open</p>
          )}
          <h1 class="loc-hero__title rd-serif">{officeLabel}</h1>
          <p class="loc-hero__desc">{data.description}</p>

          {!planned && (hasAddress || data.phone) && (
            <dl class="facts">
              {hasAddress && (
                <div class="fact">
                  <dt>Address</dt>
                  <dd>
                    <address>
                      {data.addressStreet && <Fragment>{data.addressStreet}<br /></Fragment>}
                      {data.addressCity}, {data.addressState} {data.addressZip}
                    </address>
                    {directions && (
                      <p class="fact__links"><a href={directions.google} target="_blank" rel="noopener noreferrer">Get directions</a> <small><span aria-hidden="true">·</span> <a href={directions.apple} target="_blank" rel="noopener noreferrer">Apple Maps</a></small></p>
                    )}
                  </dd>
                </div>
              )}
              {data.phone && (
                <div class="fact">
                  <dt>Phone</dt>
                  <dd><a href={`tel:${data.phone.replace(/\D/g,'').replace(/^/,'+1')}`}>{data.phone}</a></dd>
                </div>
              )}
            </dl>
          )}{planned && (
            <p class="loc-hero__desc">{plannedIntro}{plannedLine && <Fragment>{plannedLine.lead}{plannedLine.offices.map(o => <Fragment>{o.sep}<a href={o.href}>{o.label}</a></Fragment>)}{plannedLine.tail}</Fragment>}</p>
          )}
        </div>

        <div class="loc-hero__cta">
          {/* Availability, not office status. The opening date is context in the
              status line above, never the premise of the action. */}
          <a
            href={`/contact/?source=locations-${data.slug}`}
            class="btn-forest"
          >Schedule a Meet &amp; Greet →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Visit Us: address, hours, and map. Never for a planned office: there is nowhere to visit. -->
  {!planned && (hasAddress || (data.hours && data.hours.length > 0) || data.mapEmbedUrl) && (
    <section class="loc-visit rd-alt">
      <div class="rd-wrap">
        <div class="loc-visit__grid">
          <div class="loc-visit__info">
            <h2 class="rd-h2 loc-h2">Visit Us</h2>
            {hasAddress && (
              <div class="loc-visit__address">
                <p class="loc-visit__name rd-serif">{data.name}</p>
                <address>
                  {data.addressStreet && <Fragment>{data.addressStreet}<br /></Fragment>}
                  {data.addressCity}, {data.addressState} {data.addressZip}
                </address>
                {data.phone && <p><a href={`tel:${data.phone.replace(/\D/g,'').replace(/^/,'+1')}`}>{data.phone}</a></p>}
                {directions && (
                  <p><a href={directions.google} target="_blank" rel="noopener noreferrer">Get directions</a> <small><span aria-hidden="true">·</span> <a href={directions.apple} target="_blank" rel="noopener noreferrer">Apple Maps</a></small></p>
                )}
                {data.status === 'open' && data.arrivalNote && <p>{data.arrivalNote}</p>}
              </div>
            )}

            {data.hours && data.hours.length > 0 && (
              <Fragment>
                <h3 class="rd-h3 loc-hours-h">Office Hours</h3>
                <table class="hours-table">
                  <tbody>
                    {data.hours.map((h: any) => (
                      <tr>
                        <td>{h.day}</td>
                        <td>{h.open} – {h.close}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </Fragment>
            )}
          </div>

          {data.mapEmbedUrl && (
            <div class="loc-visit__map">
              <iframe
                src={data.mapEmbedUrl}
                title={`Map showing ${data.name} location`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Physicians: not for a planned office, where nobody is seen -->
  {!planned && locationProviders.length > 0 && (
    <section class="loc-phys rd-section">
      <div class="rd-wrap">
        <h2 class="rd-h2 loc-h2">Physicians at This Location</h2>
        <div class="loc-phys__grid" data-reveal="0.1">
          {locationProviders.map((p: any) => <ProviderCard provider={p} as="h3" office={openOfficeName(p.data, allLocations)} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Main content (body from markdown), suppressed when body is empty -->
  {((entry.body?.trim().length ?? 0) > 0 || data.status === 'coming-soon') && (
    <section class="loc-content rd-alt">
      <div class="rd-wrap">
        {(entry.body?.trim().length ?? 0) > 0 && (
          <div class="location-prose">
            <Content />
          </div>
        )}

        {data.status === 'coming-soon' && (
          <div class="opening-note" id="opening">
            <div class="sage-note">
              <h3 class="rd-h3">Accepting new patients now</h3>
              <p>
                {planned
                  ? `Dr. Landi is taking new patients today. A ${data.name} office is planned, and no opening date has been set. ${plannedVisits}`
                  : `Dr. Landi is taking new patients today. Our ${data.name} office opens in ${openingLabel}, so early visits happen by telehealth.`}
                Schedule a meet and greet whenever you are
                ready and we will sort out the details together.
              </p>
              <a
                href={`/contact/?source=locations-${data.slug}`}
                class="btn-forest"
              >Schedule a Meet &amp; Greet →</a>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Photos (if any) -->
  {!planned && data.photos && data.photos.length > 0 && (
    <section class="loc-photos rd-section">
      <div class="rd-wrap">
        <h2 class="rd-h3 loc-photos__h">Our Space</h2>
        <div class="photos-grid">
          {data.photos.map((src: string, i: number) => (
            <img
              src={src}
              alt={data.photoAlts[i] || `${data.name} office photo ${i + 1}`}
              class="location-photo"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>
  )}
</MainLayout>

<style>
  .loc-hero { background: var(--linen); padding: 88px 0 80px; }
  .loc-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 48px; align-items: center; }
  .loc-hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; max-width: 720px; }
  .loc-hero__copy > :global(p) { margin: 0; }
  .loc-hero__title { margin: 0; font-size: 60px; line-height: 1.03; letter-spacing: -0.018em; color: var(--forest); }
  .loc-hero__desc { font-size: 17px; line-height: 1.7; color: var(--text-900); max-width: 600px; }
  .loc-hero__desc :global(a), .loc-visit__address :global(a), .fact a { color: var(--sage-600); }
  .loc-hero__desc :global(a:hover), .loc-visit__address :global(a:hover), .fact a:hover { color: var(--forest); }
  .facts { margin: 4px 0 0; display: flex; flex-direction: column; align-self: stretch; max-width: 560px; }
  .fact {
    display: grid;
    grid-template-columns: 110px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 15px;
    line-height: 1.6;
  }
  .fact:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .fact dt { color: var(--text-600); font-size: 14px; margin: 0; }
  .fact dd { margin: 0; color: var(--forest); }
  .fact address { font-style: normal; }
  .fact__links { margin: 4px 0 0; font-size: 14px; }

  .loc-h2 { font-size: 40px; margin-bottom: 28px; }
  .loc-visit { padding: 80px 0; }
  .loc-visit__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: 72px; align-items: start; }
  .loc-visit__address { font-size: 15px; line-height: 1.7; color: var(--text-900); }
  .loc-visit__address p { margin: 0 0 8px; }
  .loc-visit__address address { font-style: normal; margin: 0 0 8px; }
  .loc-visit__name { font-size: 22px; line-height: 1.25; color: var(--forest); margin: 0 0 6px; }
  .loc-hours-h { margin: 36px 0 12px; }
  .hours-table { width: 100%; margin: 0; border-collapse: collapse; font-size: 15px; background: transparent; display: table; overflow: visible; }
  .hours-table tr, .hours-table tbody tr:nth-child(even), .hours-table tbody tr:hover { background: transparent; }
  .hours-table tr { border-top: 1px solid var(--hairline-strong); }
  .hours-table tr:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .hours-table td { padding: 11px 0; border: 0; color: var(--text-900); }
  .hours-table td:first-child { width: 8rem; color: var(--forest); font-weight: 500; }
  .loc-visit__map {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid var(--hairline-strong);
    border-radius: 2px;
    overflow: hidden;
    background: var(--linen-300);
  }
  .loc-visit__map iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }

  .loc-phys__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px 48px; }
  .loc-phys__grid :global(.pcard) { opacity: 0; transform: translateY(10px); transition: opacity 0.55s ease, transform 0.55s ease; }
  .loc-phys__grid.on :global(.pcard) { opacity: 1; transform: none; }
  .loc-phys__grid.on :global(.pcard:nth-child(2)) { transition-delay: 0.2s; }

  .loc-content { padding: 80px 0; }
  .location-prose { max-width: 720px; font-size: 16px; line-height: 1.8; color: var(--text-900); }
  .location-prose :global(h2) { font-family: var(--font-heading); font-weight: 400; font-size: 30px; line-height: 1.15; color: var(--forest); margin: 40px 0 12px; }
  .location-prose :global(h2:first-child) { margin-top: 0; }
  .location-prose :global(h3) { font-family: var(--font-heading); font-weight: 400; font-size: 22px; color: var(--forest); margin: 28px 0 8px; }
  .location-prose :global(p) { color: var(--text-900); line-height: 1.8; margin-bottom: 1rem; }
  .location-prose :global(a) { color: var(--sage-600); }
  .opening-note { margin-top: 40px; max-width: 720px; }
  .location-prose + .opening-note { margin-top: 48px; }
  .sage-note { background: var(--sage-50); border-top: 3px solid var(--forest); padding: 28px 30px; display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .sage-note :global(h3), .sage-note p { margin: 0; }
  .sage-note p { font-size: 15px; line-height: 1.7; color: var(--text-700); max-width: 560px; }

  .loc-photos__h { margin-bottom: 24px; }
  .photos-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 16px; }
  .location-photo { width: 100%; height: 220px; object-fit: cover; border-radius: 2px; }

  @media (max-width: 860px) {
    .loc-hero { padding: 48px 0 56px; }
    .loc-hero__grid { grid-template-columns: 1fr; gap: 28px; }
    .loc-hero__title { font-size: 38px; }
    .loc-h2 { font-size: 30px; }
    .loc-visit, .loc-content { padding: 56px 0; }
    .loc-visit__grid { grid-template-columns: 1fr; gap: 32px; }
    .loc-visit__map { aspect-ratio: 16 / 10; }
    .loc-phys__grid { grid-template-columns: 1fr; gap: 44px; }
    .fact { grid-template-columns: 90px minmax(0, 1fr); }
  }
</style>
