---
import { getCollection, render } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import ProviderCard from '../../components/shared/ProviderCard.astro';

export async function getStaticPaths() {
  const locations = await getCollection('locations');
  return locations.map((entry) => ({
    params: { slug: entry.data.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);

const allProviders = await getCollection('providers');
const locationProviders = (data.providers || [])
  .map((slug: string) => allProviders.find(p => p.data.slug === slug))
  .filter(Boolean)
  .sort((a: any, b: any) => a.data.displayOrder - b.data.displayOrder);

const siteUrl = 'https://www.forwardfamilymedicine.com';
const canonicalUrl = `${siteUrl}/locations/${data.slug}/`;

const locationName = `Forward Family Medicine — ${data.name}`;
const pageTitle = `${locationName} | Wayne PA DPC Practice`;
const pageDescription = data.status === 'coming-soon'
  ? `Forward Family Medicine is opening a new Direct Primary Care location in ${data.name}, PA in ${data.openingDate ? new Date(data.openingDate).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : '2026'}. Join the patient list.`
  : `Visit Forward Family Medicine in ${data.name}, PA. ${data.description}`;

const hasAddress = data.addressStreet && data.addressZip;

const locationSchema = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  "name": locationName,
  "url": canonicalUrl,
  "branchOf": {
    "@type": "MedicalBusiness",
    "name": "Forward Family Medicine",
    "url": siteUrl,
  },
  ...(hasAddress ? {
    "address": {
      "@type": "PostalAddress",
      "streetAddress": data.addressStreet,
      "addressLocality": data.addressCity,
      "addressRegion": data.addressState,
      "postalCode": data.addressZip,
      "addressCountry": "US",
    }
  } : {}),
  ...(data.phone ? { "telephone": data.phone } : {}),
  ...(data.latitude && data.longitude ? {
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": data.latitude,
      "longitude": data.longitude,
    }
  } : {}),
  ...(data.hours && data.hours.length > 0 ? {
    "openingHoursSpecification": data.hours.map((h: any) => ({
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": `https://schema.org/${h.day}`,
      "opens": h.open,
      "closes": h.close,
    }))
  } : {}),
};

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": `${siteUrl}/locations/` },
    { "@type": "ListItem", "position": 3, "name": data.name, "item": canonicalUrl },
  ],
};

// Build opening date label
const openingLabel = data.openingDate
  ? new Date(data.openingDate).toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
  : 'August 2026';
---

<MainLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  schema={[locationSchema, breadcrumb]}
>
  <!-- Hero -->
  <section class="location-hero section" style={`background: linear-gradient(160deg, ${data.status === 'coming-soon' ? 'var(--cream-200)' : 'var(--green-50)'} 0%, var(--cream-100) 100%);`}>
    <div class="container">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href="/locations/">Locations</a>
        <span aria-hidden="true">›</span>
        <span>{data.name}</span>
      </nav>

      <div class="location-hero-inner">
        <div>
          {data.status === 'coming-soon' && (
            <span class="status-badge coming-soon">Coming {openingLabel}</span>
          )}
          {data.status === 'open' && (
            <span class="status-badge open">Now Open</span>
          )}
          <h1>{locationName}</h1>
          <div class="divider"></div>
          <p class="location-desc">{data.description}</p>

          {hasAddress && (
            <div class="address-block">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <address style="font-style:normal;">
                {data.addressStreet}<br />
                {data.addressCity}, {data.addressState} {data.addressZip}
              </address>
            </div>
          )}

          {data.phone && (
            <div class="phone-block">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13.1 19.79 19.79 0 0 1 1.58 4.5 2 2 0 0 1 3.55 2.34h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 9.91a16 16 0 0 0 6.06 6.06l.94-.94a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 17z"/></svg>
              <a href={`tel:${data.phone.replace(/\D/g,'').replace(/^/,'+1')}`}>{data.phone}</a>
            </div>
          )}
        </div>

        <div class="hero-cta-block">
          {data.status === 'open' ? (
            <a href="/contact/" class="btn btn-accent">Schedule a Meet &amp; Greet →</a>
          ) : (
            <a
              href={`/contact/?subject=${encodeURIComponent(`Join the ${data.name} Patient List`)}`}
              class="btn btn-accent"
            >Join the {data.name} Patient List →</a>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- Visit Us: address, hours, and map — shown whenever any location data exists -->
  {(data.addressStreet || (data.hours && data.hours.length > 0) || data.mapEmbedUrl) && (
    <section class="location-visit section" style="background: var(--cream-100);">
      <div class="container">
        <div class="visit-grid">
          <div class="visit-info">
            <h2>Visit Us</h2>
            {data.addressStreet && (
              <div class="visit-address">
                <strong>{data.name}</strong>
                <address>
                  {data.addressStreet}<br />
                  {data.addressCity}, {data.addressState} {data.addressZip}
                </address>
                {data.phone && <p><a href={`tel:${data.phone.replace(/\D/g,'').replace(/^/,'+1')}`}>{data.phone}</a></p>}
              </div>
            )}

            {data.hours && data.hours.length > 0 && (
              <Fragment>
                <h3>Office Hours</h3>
                <table class="hours-table">
                  <tbody>
                    {data.hours.map((h: any) => (
                      <tr>
                        <td>{h.day}</td>
                        <td>{h.open} – {h.close}</td>
                      </tr>
                    ))}
                  </tbody>
                </table>
              </Fragment>
            )}
          </div>

          {data.mapEmbedUrl && (
            <div class="visit-map">
              <iframe
                src={data.mapEmbedUrl}
                title={`Map showing ${data.name} location`}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                allowfullscreen
              ></iframe>
            </div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- Physicians -->
  {locationProviders.length > 0 && (
    <section class="providers-section section" style="background: var(--cream-100);">
      <div class="container">
        <span class="section-label">Care Team</span>
        <h2 class="section-title">Physicians at This Location</h2>
        <div class="provider-cards-grid">
          {locationProviders.map((p: any) => <ProviderCard provider={p} />)}
        </div>
      </div>
    </section>
  )}

  <!-- Main content (body from markdown) — suppressed when body is empty -->
  {(entry.body?.trim().length > 0 || data.status === 'coming-soon') && (
    <section class="location-content section" style="background: var(--cream-50);">
      <div class="container">
        {entry.body?.trim().length > 0 && (
          <div class="prose location-prose">
            <Content />
          </div>
        )}

        {data.status === 'coming-soon' && (
          <div class="waitlist-placeholder" id="waitlist">
            <div class="callout" style="border: 2px dashed var(--cream-300); background: var(--cream-100); padding: 2rem; border-radius: var(--radius); text-align: center; margin-top: 2rem;">
              <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">Join the Patient List</h3>
              <p style="color: var(--ink-500); max-width: 420px; margin: 0 auto 1rem;">
                Be the first to know when scheduling opens. We'll email you with
                early-access details before the location is open to the public.
              </p>
              <a
                href={`/contact/?subject=${encodeURIComponent(`Join the ${data.name} Patient List`)}`}
                class="btn btn-accent"
              >Join the {data.name} Patient List →</a>
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- Photos (if any) -->
  {data.photos && data.photos.length > 0 && (
    <section class="photos-section section" style="background: var(--cream-200); padding-top: 3rem; padding-bottom: 3rem;">
      <div class="container">
        <h2 class="section-title" style="font-size:1.4rem;">Our Space</h2>
        <div class="photos-grid">
          {data.photos.map((src: string, i: number) => (
            <img
              src={src}
              alt={data.photoAlts[i] || `${data.name} office photo ${i + 1}`}
              class="location-photo"
              loading="lazy"
            />
          ))}
        </div>
      </div>
    </section>
  )}
</MainLayout>

<style>
  .breadcrumb {
    font-size: 0.85rem;
    color: var(--ink-300);
    margin-bottom: 2rem;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .breadcrumb a { color: var(--green-300); text-decoration: none; }
  .breadcrumb a:hover { color: var(--green-400); }

  .location-hero-inner {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 2rem;
    align-items: center;
  }

  .status-badge {
    display: inline-block;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border-radius: 999px;
    padding: 0.25rem 0.85rem;
    margin-bottom: 0.75rem;
  }
  .status-badge.open {
    background: var(--green-100);
    color: var(--green-500);
  }
  .status-badge.coming-soon {
    background: var(--cream-300);
    color: var(--ink-700);
  }

  .divider {
    width: 48px;
    height: 3px;
    background: var(--green-300);
    border-radius: 2px;
    margin: 1.25rem 0;
  }

  .location-desc {
    font-size: 1.05rem;
    color: var(--ink-700);
    max-width: 560px;
    margin-bottom: 1.25rem;
  }

  .address-block, .phone-block {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    font-size: 0.95rem;
    color: var(--ink-700);
    margin-bottom: 0.75rem;
  }
  .address-block svg, .phone-block svg {
    color: var(--green-400);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }
  .phone-block a {
    color: var(--green-400);
    text-decoration: none;
    font-weight: 600;
  }
  .phone-block a:hover { color: var(--green-500); }

  .hero-cta-block {
    align-self: center;
  }

  /* Visit Us */
  .location-visit {
    padding-top: 2.5rem;
    padding-bottom: 2.5rem;
  }
  .visit-grid {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 2.5rem;
    align-items: start;
  }
  .visit-info h2 {
    font-size: 1.6rem;
    margin: 0 0 1rem 0;
  }
  .visit-info h3 {
    font-size: 1.15rem;
    color: var(--ink-900);
    margin: 1.75rem 0 0.75rem 0;
    font-weight: 700;
  }
  .visit-address {
    line-height: 1.6;
    color: var(--ink-700);
  }
  .visit-address address {
    font-style: normal;
    margin: 0.5rem 0;
  }
  .visit-address a {
    color: var(--green-400);
    text-decoration: none;
    font-weight: 500;
  }
  .visit-address a:hover {
    color: var(--green-500);
    text-decoration: underline;
  }
  .hours-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9rem;
  }
  .hours-table tr { border-bottom: 1px solid var(--cream-300); }
  .hours-table tr:last-child { border-bottom: 0; }
  .hours-table td { padding: 0.55rem 0; }
  .hours-table td:first-child { font-weight: 600; color: var(--ink-900); width: 6rem; padding-right: 0.75rem; }
  .hours-table td:last-child { text-align: left; color: var(--ink-700); }
  .visit-map {
    aspect-ratio: 4 / 3;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .visit-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Provider cards grid */
  .provider-cards-grid {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 2rem;
    margin-top: 1rem;
  }

  /* Prose */
  .location-prose :global(h2) {
    font-size: clamp(1.2rem, 3vw, 1.5rem);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    color: var(--ink-900);
  }
  .location-prose :global(h3) {
    font-size: 1.1rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
    color: var(--ink-900);
  }
  .location-prose :global(p) {
    color: var(--ink-700);
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  /* Photos grid */
  .photos-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }
  .location-photo {
    width: 100%;
    height: 220px;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }

  @media (max-width: 768px) {
    .visit-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .visit-map { aspect-ratio: 16 / 9; }
  }

  @media (max-width: 700px) {
    .location-hero-inner { grid-template-columns: 1fr; }
  }
</style>
