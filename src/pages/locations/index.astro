---
/**
 * Locations, per the Locations board: hero, the existing My Maps embed in a
 * hairline frame, open offices side by side, any office that is not open as a
 * single ruled row. Copy is the live page's (the office descriptions come from
 * the locations collection). No photos in this section. The board's closing
 * band is board-only copy and not built.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/shared/PageHero.astro';
import { isPlanned, openOfficesFor } from '../../utils/physicianRouting';
import { formatMonthYear } from '../../utils/availability';

const allLocations = await getCollection('locations');
const locations = allLocations.sort((a, b) => a.data.displayOrder - b.data.displayOrder);
const allProviders = await getCollection('providers');
// Each portrait is the providers collection's own, so it is optimized like
// every other headshot and a missing photo fails the build.
const photoOf = (slug: string) => {
  const photo = allProviders.find(p => p.data.slug === slug)?.data.photo;
  if (!photo) throw new Error(`[locations] providers/${slug} has no photo.`);
  return photo;
};

// Hand-maintained: names and titles must match src/content/providers/*.md and
// src/content/team/*.md. Order mirrors displayOrder, so the physician accepting
// new patients leads each location.
const providersBySlug: Record<string, { name: string; title: string; href: string; photo: ImageMetadata }[]> = {
  'wayne': [
    { name: 'Dr. Philip Lieberman, MD',   title: 'Family Medicine & Lifestyle Medicine Physician', href: '/meet-the-team/philip-lieberman-md/', photo: photoOf('philip-lieberman-md') },
    { name: 'Dr. David Bigley, DO',       title: 'Founder & Family Medicine Physician',            href: '/meet-the-team/david-bigley-do/',     photo: photoOf('david-bigley-do') },
  ],
  'malvern': [
    { name: 'Dr. Brian Landi, DO',        title: 'Family Medicine Physician',      href: '/meet-the-team/brian-landi-do/',    photo: photoOf('brian-landi-do') },
  ],
};

const neighborhoodsBySlug: Record<string, string[]> = {
  'wayne':        ['Wayne', 'Radnor', 'Villanova', 'Bryn Mawr', 'Devon', 'Berwyn', 'Paoli', 'Strafford', 'Haverford', 'Ardmore'],
  'malvern':      ['Malvern', 'Paoli', 'Berwyn', 'Chester Springs', 'Exton', 'Phoenixville', 'Lionville', 'Glen Mills'],
};

// Approved copy change (BUILD_PROMPT, "Locations"): the Malvern intro line.
// Applied here only; the collection's description also feeds the office page's
// meta description, which is not part of the approved change.
const descriptionFor = (slug: string, fallback: string) =>
  slug === 'malvern' ? 'Our Chester County location, serving Malvern, Paoli, Exton, Chester Springs, and the western Main Line.' : fallback;

const openOffices = locations.filter(l => l.data.status === 'open');
const otherOffices = locations.filter(l => l.data.status !== 'open');

const siteUrl      = 'https://www.forwardfamilymedicine.com';
const canonicalUrl = `${siteUrl}/locations/`;

const mapsEmbedId  = '1aRjs-zprTfSvCx30Nr8CY8__vwDsakQ';

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home",      "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Locations", "item": canonicalUrl },
  ],
};
---

<MainLayout
  title="Our Locations | Forward Family Medicine"
  description="Forward Family Medicine serves Wayne and Malvern, PA, with a West Chester office planned. Direct Primary Care on the Main Line and in Chester County."
  canonical={canonicalUrl}
  schema={breadcrumb}
>
  <PageHero crumb="Locations" title="Our Locations" pt={88} pb={64} maxW={720} lede={17}>
    <p>
      Forward Family Medicine is rooted in Wayne, PA, with a second office in Malvern and a West Chester office planned.
      Every location delivers the same small-panel, relationship-based Direct Primary Care.
    </p>
  </PageHero>

  <!-- Multi-location map (David's Google My Maps: all three pins) -->
  <section class="map-sec" aria-label="Office locations map">
    <div class="rd-wrap">
      <div class="map-frame">
        <iframe
          src={`https://www.google.com/maps/d/embed?mid=${mapsEmbedId}`}
          loading="lazy"
          title="Forward Family Medicine locations in Wayne and Malvern"
        ></iframe>
      </div>
      <p class="map-link">
        <a
          href={`https://www.google.com/maps/d/viewer?mid=${mapsEmbedId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="rd-link"
        >
          View larger map →
        </a>
      </p>
    </div>
  </section>

  <section class="offices-sec">
    <div class="rd-wrap">
      <div class="offices" data-reveal="0.1">
        {openOffices.map(location => {
          const d = location.data;
          const providers = providersBySlug[d.slug] ?? [];
          const neighborhoods = neighborhoodsBySlug[d.slug] ?? [];
          return (
            <article class="office" id={d.slug}>
              <p class="rd-eyebrow rd-eyebrow--gold">Now Open</p>
              <h2 class="office__name rd-serif">{d.name}</h2>
              <p class="office__desc">{descriptionFor(d.slug, d.description)}</p>

              <dl class="facts">
                {d.addressStreet && (
                  <div class="fact">
                    <dt>Address</dt>
                    <dd><address>{d.addressStreet}<br />{d.addressCity}, {d.addressState} {d.addressZip}</address></dd>
                  </div>
                )}
                {d.phone && (
                  <div class="fact">
                    <dt>Phone</dt>
                    <dd><a href={`tel:${d.phone.replace(/\D/g, '')}`}>{d.phone}</a></dd>
                  </div>
                )}
                <div class="fact">
                  <dt>Hours</dt>
                  <dd>Mon–Fri &nbsp;7:30 AM – 5:30 PM</dd>
                </div>
                {neighborhoods.length > 0 && (
                  <div class="fact">
                    <dt>Areas Served</dt>
                    <dd>
                      <ul class="areas" aria-label={`Neighborhoods served by ${d.name} office`}>
                        {neighborhoods.map(n => <li>{n}</li>)}
                      </ul>
                    </dd>
                  </div>
                )}
              </dl>

              {providers.length > 0 && (
                <div class="people-wrap">
                  <p class="people-label rd-eyebrow">Our Physicians</p>
                  <ul class="people" aria-label={`Providers at ${d.name}`}>
                    {providers.map(p => (
                      <li>
                        <a href={p.href} class="person">
                          <Image src={p.photo} alt={p.name} width={72} widths={[72, 144, 216]} sizes="72px" format="webp" quality={82} loading="lazy" />
                          <span class="person__info">
                            <span class="person__name rd-serif">{p.name}</span>
                            <span class="person__title">{p.title}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}

              <div class="office__actions">
                <a href={`/contact/?source=locations-${d.slug}`} class="btn-forest">Schedule a Meet &amp; Greet →</a>
                <a href={`/locations/${d.slug}/`} class="rd-link">View Details →</a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  {otherOffices.map(location => {
    const d = location.data;
    const planned = isPlanned(location);
    const seenAt = planned ? openOfficesFor(location, allProviders, allLocations) : [];
    return (
      <section class="row-sec">
        <div class="rd-wrap">
          <article class="orow" id={d.slug}>
            <div class="orow__head">
              <p class="rd-eyebrow rd-eyebrow--muted">{planned ? 'Planned' : `Opening ${formatMonthYear(d.openingDate!)}`}</p>
              <h2 class="orow__name rd-serif">{d.name}</h2>
            </div>
            <div class="orow__body">
              {planned ? (
                <p>{d.addressCity}, {d.addressState}<br />Address and opening date to come</p>
              ) : (
                <p>{d.addressStreet && <Fragment>{d.addressStreet}<br /></Fragment>}{d.addressCity}, {d.addressState} {d.addressZip}</p>
              )}
              <p class="orow__desc">{descriptionFor(d.slug, d.description)}</p>
            </div>
            <div class="orow__side">
              {seenAt.length > 0 && (
                <p>Seeing patients now in {seenAt.map((o, i) => <Fragment>{i === 0 ? '' : i === seenAt.length - 1 ? ' and ' : ', '}<a href={`/locations/${o.data.slug}/`} class="rd-link">{o.data.name}</a></Fragment>)}</p>
              )}
              <a href={`/contact/?source=locations-${d.slug}`} class="rd-link">Schedule a Meet &amp; Greet →</a>
              <a href={`/locations/${d.slug}/`} class="rd-link">View Details →</a>
            </div>
          </article>
        </div>
      </section>
    );
  })}
</MainLayout>

<style>
  .map-sec { background: var(--linen); padding: 0 0 24px; }
  .map-frame {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: 300px;
    border: 1px solid var(--hairline-strong);
    border-radius: 2px;
    overflow: hidden;
    background: var(--linen-300);
  }
  .map-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; display: block; }
  .map-link { display: flex; justify-content: flex-end; margin: 10px 0 0; }

  .offices-sec { background: var(--linen); padding: 72px 0 96px; }
  .offices { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 72px; align-items: start; }
  .office { display: flex; flex-direction: column; gap: 20px; min-width: 0; scroll-margin-top: var(--header-h); }
  .office:first-child:not(:last-child) { padding-right: 72px; border-right: 1px solid var(--hairline-strong); margin-right: -36px; }
  .office > :global(p) { margin: 0; }
  .office__name { margin: 0; font-size: 48px; line-height: 1.05; letter-spacing: -0.015em; color: var(--forest); }
  .office__desc { font-size: 16px; line-height: 1.75; color: var(--text-900); max-width: 560px; min-height: 56px; }
  .facts { margin: 0; display: flex; flex-direction: column; }
  .fact {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 14px;
    line-height: 1.6;
  }
  .fact:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .fact dt { color: var(--text-600); margin: 0; }
  .fact dd { margin: 0; color: var(--forest); }
  .fact address { font-style: normal; }
  .fact a { color: var(--sage-600); }
  .areas { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; }
  /* The separator trails its item, so it can end a wrapped line but never start one. */
  .areas li:not(:last-child)::after { content: '·'; margin: 0 8px; color: var(--hairline-dot); }

  .people-wrap { margin-top: 8px; }
  .people-label { margin: 0 0 6px; }
  .people { margin: 0; padding: 0; list-style: none; border-bottom: 1px solid var(--hairline-strong); }
  .person {
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    gap: 16px;
    align-items: center;
    padding: 14px 0;
    border-top: 1px solid var(--hairline-strong);
    color: var(--forest);
    text-decoration: none;
    transition: padding-left 0.25s ease;
  }
  .person:hover { padding-left: 6px; color: var(--forest); }
  .person :global(img) { display: block; width: 72px; height: auto; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 20%; border-radius: 2px; }
  .person__info { display: flex; flex-direction: column; gap: 3px; }
  .person__name { font-size: 19px; line-height: 1.2; }
  .person__title { font-size: 13px; color: var(--sage-600); }
  .office__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 22px; margin-top: 8px; }

  .row-sec { background: var(--linen); padding: 0 0 96px; }
  .row-sec + .row-sec { padding-top: 0; margin-top: -64px; }
  .orow {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr) auto;
    gap: 32px;
    align-items: start;
    padding: 32px 0;
    border-top: 1px solid var(--hairline-strong);
    border-bottom: 1px solid var(--hairline-strong);
  }
  .orow__head { display: flex; flex-direction: column; gap: 8px; }
  .orow__head > :global(p) { margin: 0; }
  .orow__name { margin: 0; font-size: 34px; line-height: 1.1; color: var(--forest); }
  .orow__body { display: flex; flex-direction: column; gap: 10px; font-size: 15px; line-height: 1.7; color: var(--text-700); }
  .orow__body p, .orow__side p { margin: 0; }
  .orow__side { display: flex; flex-direction: column; align-items: flex-start; gap: 10px; align-self: center; font-size: 15px; color: var(--text-700); }

  /* Reveal: office columns slide in from the right, then the physician rows. */
  .offices .office, .offices .person {
    opacity: 0;
    transform: translateX(22px);
    transition: opacity 0.6s ease, transform 0.6s ease, padding-left 0.25s ease;
  }
  .offices.on .office, .offices.on .person { opacity: 1; transform: none; }
  .offices.on .office:nth-child(2) { transition-delay: 0.22s; }
  .offices.on .person { transition-delay: 0.35s; }

  @media (max-width: 860px) {
    .offices-sec { padding: 40px 0 64px; }
    .offices { grid-template-columns: 1fr; gap: 56px; }
    .office:first-child:not(:last-child) { padding-right: 0; border-right: 0; margin-right: 0; }
    .office__name { font-size: 36px; }
    .fact { grid-template-columns: 110px minmax(0, 1fr); }
    .row-sec { padding-bottom: 64px; }
    .orow { grid-template-columns: 1fr; gap: 18px; }
    .orow__side { align-self: start; }
    .map-frame { aspect-ratio: 4 / 3; min-height: 0; }
  }
</style>
