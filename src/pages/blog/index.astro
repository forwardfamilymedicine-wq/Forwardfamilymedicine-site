---
import { getCollection } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import BlogListing from '../../components/blog/BlogListing.astro';
import { contactHrefForPath } from '../../utils/leadSource';

const entries = await getCollection('blog');
const posts = entries
  .filter(e => !e.data.draft)
  .sort((a, b) => {
    const aDate = a.data.date ? new Date(a.data.date).getTime() : 0;
    const bDate = b.data.date ? new Date(b.data.date).getTime() : 0;
    return bDate - aDate;
  });

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.forwardfamilymedicine.com/blog/" }
  ]
};
---

<MainLayout
  title="Direct Primary Care & Lifestyle Medicine Blog | Forward Family Medicine Wayne PA"
  description="Evidence-based articles on direct primary care, lifestyle medicine, and women's health from the physicians at Forward Family Medicine in Wayne and Malvern, PA."
  schema={breadcrumb}
>
  <BlogListing
    posts={posts}
    h1="Health & Wellness Blog"
    intro="Evidence-based articles from our physicians — on Direct Primary Care, Lifestyle Medicine, nutrition, sleep, chronic disease, and living well on the Main Line."
    countLabel={`${posts.length} articles`}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog' }]}
    contactHref={contactHrefForPath('/blog/')}
  />
</MainLayout>
