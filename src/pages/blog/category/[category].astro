---
import { getCollection } from 'astro:content';
import MainLayout from '../../../layouts/MainLayout.astro';
import BlogListing from '../../../components/blog/BlogListing.astro';
import { blogCategoryLabel } from '../../../data/blogCategories';
import { contactHrefForPath } from '../../../utils/leadSource';

export async function getStaticPaths() {
  const entries = await getCollection('blog');
  const categories = [...new Set(
    entries
      .filter(e => !e.data.draft && e.data.category)
      .map(e => e.data.category as string)
  )];

  return categories.map(cat => ({
    params: { category: cat },
    props: {
      posts: entries
        .filter(e => !e.data.draft && e.data.category === cat)
        .sort((a, b) => {
          const aDate = a.data.date ? new Date(a.data.date).getTime() : 0;
          const bDate = b.data.date ? new Date(b.data.date).getTime() : 0;
          return bDate - aDate;
        }),
    },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
const label = blogCategoryLabel(category) ?? category;

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": "https://www.forwardfamilymedicine.com/blog/" },
    { "@type": "ListItem", "position": 3, "name": label, "item": `https://www.forwardfamilymedicine.com/blog/category/${category}/` },
  ],
};
---

<MainLayout
  title={`${label} Articles | Forward Family Medicine Blog`}
  description={`Evidence-based ${label.toLowerCase()} articles from the physicians at Forward Family Medicine in Wayne and Malvern, PA.`}
  schema={breadcrumb}
>
  <BlogListing
    posts={posts}
    active={category}
    h1={label}
    countLabel={`${posts.length} article${posts.length !== 1 ? 's' : ''}`}
    crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label }]}
    contactHref={contactHrefForPath(`/blog/category/${category}/`)}
  />
</MainLayout>
