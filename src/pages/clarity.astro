---
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import SageCard from '../components/shared/SageCard.astro';
import TitledGrid from '../components/shared/TitledGrid.astro';
import { ORG_ID } from '../utils/practiceSchema';

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "The Clarity Program", "item": "https://www.forwardfamilymedicine.com/clarity/" }
  ]
};

// A program the practice provides, not a place: no address or phone of its
// own. The provider is the practice node in the site-wide graph on this page.
const claritySchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "The Clarity Program",
  "description": "A physician-led longitudinal health operating system for the Main Line. Prenuvo whole-body MRI, advanced biomarker panels, DEXA, VO₂ max, CGM, and gut microbiome — with physician interpretation at every step. $9,600/year.",
  "url": "https://www.forwardfamilymedicine.com/clarity/",
  "provider": { "@id": ORG_ID },
  "areaServed": [
    { "@type": "City", "name": "Wayne, PA" },
    { "@type": "AdministrativeArea", "name": "Philadelphia Main Line" },
    { "@type": "City", "name": "Philadelphia, PA" }
  ]
};

const faqs = [
  {
    q: 'Is this in addition to a standard FFM membership?',
    a: 'No. The Clarity Program includes your full FFM membership. One annual fee, paid upfront, covers everything — advanced diagnostics and standard DPC access alike. There is no monthly payment option.',
  },
  {
    q: 'Do I need to be an existing FFM patient?',
    a: 'No. You can join directly. Your enrollment appointment is the introduction — we build your health picture from the ground up at that first visit.',
  },
  {
    q: 'Who interprets the imaging and labs?',
    a: 'Prenuvo provides board-certified radiologist reports. Dr. Bigley reviews all results with you directly, connects them to your full clinical picture, and coordinates any follow-through.',
  },
  {
    q: 'Where does testing take place?',
    a: 'Prenuvo is 0.5 miles from our Wayne office. DEXA body composition scans take place at <a href="/wayne-dexa/">Wayne DEXA</a>, our on-site facility at the same Wayne address. VO₂ max testing takes place at partner facilities nearby. Lab draws occur at LabCorp locations or can be coordinated in-office. We handle scheduling and all referrals.',
  },
  {
    q: 'What if something is found?',
    a: "That's exactly what the physician relationship is for. We coordinate follow-up directly — calling ahead to specialists, providing clinical context, and ensuring nothing falls through the gap between a result and a plan.",
  },
  {
    q: 'Can I use my HSA?',
    a: 'The membership component is HSA-eligible following the Primary Care Enhancement Act (effective January 1, 2026). For imaging and testing components, confirm with your plan administrator.',
  },
  {
    q: "Why does Clarity's lab program feel different from consumer testing platforms?",
    a: "Consumer platforms are built around biomarker volume. Clarity is built around physician interpretation and longitudinal tracking. Across your four draws per year you'll receive nearly 250 individual results — but every one connects to a clinical question, a trend line, and a physician who tells you exactly what it means and what we're doing about it.",
  },
  {
    q: 'Why is the Month 3 panel smaller than Month 6?',
    a: "Month 3's job is to confirm your interventions are working and safe — early treatment response and medication safety checks. Vitamin D, Omega-3 Index, and NMR particle scores haven't had enough time to meaningfully move at 90 days. We run those at Month 6 when there's real signal to measure.",
  },
  {
    q: 'Why measure Lipoprotein(a) only once?',
    a: "Lp(a) is approximately 90% genetic. Your number was set at conception and doesn't change meaningfully through life. We measure it once to know it forever, and calibrate your cardiovascular plan around it.",
  },
  {
    q: 'Why only check Vitamin D two or three times a year?',
    a: 'Vitamin D has a 3-week half-life and takes 8–12 weeks to stabilize after a dose change. Testing it every 3 months is expensive noise. We time your draws seasonally to capture your real year-round pattern.',
  },
  {
    q: 'What does physician-interpreted actually mean in practice?',
    a: 'Your Clarity physician reviews every result before it reaches you. Your baseline draw delivers 85+ individual results. Each follow-up adds 43 to 63 more — reviewed in context of every prior draw, with a clear narrative and a specific plan attached to every result.',
  },
  {
    q: 'Is this an annual program? What happens at 12 months?',
    a: 'Yes — Clarity is an annual program paid upfront. Your program runs from enrollment through Month 9, where you receive your 12-month health blueprint and have a renewal conversation. If you renew, Year 2 begins with a full re-enrollment draw — everything from Month 0 except the one-time lifetime markers, which are already in your record permanently.',
  },
];

const CTA = '/new-patients/?source=clarity#request';

const included = [
  'Prenuvo whole-body MRI at enrollment',
  '4 advanced biomarker draws — 85–63 results each',
  'Gut microbiome panel at enrollment',
  '6 weeks CGM monitoring across the year',
  'DEXA body composition, 2×/year',
  'VO₂ max testing, 2×/year',
  'Coronary calcium score, every 3 years',
  'Full FFM membership included',
];

const shortfalls = [
  { label: 'Executive physicals', title: 'A full day of testing. Then silence for twelve months.', body: "Valuable data, no follow-through. A results binder doesn't adjust your protocol when your biomarkers shift. A physician who knows your history does." },
  { label: 'DIY testing platforms', title: '160 biomarkers and a dashboard. But no one to call.', body: 'Function Health, InsideTracker, and similar services surface data efficiently. Without clinical interpretation, a number outside the reference range produces anxiety, not action.' },
  { label: 'Traditional primary care', title: 'Twenty minutes a year with a doctor you rarely see.', body: 'A physician seeing 25 patients a day cannot read your VO₂ trends, review your imaging, and connect it to your bloodwork. The structure of standard care makes that impossible.' },
];

const inputs = [
  { title: 'Structural imaging — what bloodwork cannot see', body: "The Prenuvo whole-body MRI screens 500+ conditions across 33 organ systems — brain, spine, organs, vasculature — before symptoms appear. Dr. Bigley reviews findings with you directly and coordinates any follow-through. This is the only input that reveals what's structurally happening inside your body right now.", stat: "14% of first-time Prenuvo members discover a clinically significant finding they didn't know existed." },
  { title: 'Biomarkers and gut health — interpreted in context, four times a year', body: 'Over 60 blood markers across cardiovascular risk, hormones, metabolic health, inflammation, and organ function — reviewed at enrollment, month 3, and month 9. Paired with a gut microbiome panel at enrollment that maps your bacterial diversity, inflammatory species, and digestive function.', stat: 'CGM data is read alongside bloodwork at each check-in — real-time glucose and bloodwork together tell a far more complete metabolic story.' },
  { title: 'Continuous glucose monitoring — metabolic data between visits', body: 'Six weeks of CGM data distributed across three 2-week windows, timed to align with your lab check-ins. While bloodwork captures a single moment, CGM tracks how your glucose actually behaves — across meals, sleep, stress, and exercise — over days.', stat: 'Insulin resistance is detectable by CGM years before it appears on standard diabetes screening.' },
  { title: 'Physical performance — measured as a clinical vital sign', body: 'VO₂ max is the strongest independent predictor of all-cause mortality in the medical literature — stronger than blood pressure, cholesterol, or smoking status. DEXA body composition tracks lean mass, visceral fat, and bone density with the precision BMI was never designed to provide. Both tested twice yearly.', stat: 'Cardiorespiratory fitness is more predictive of longevity than any single biomarker we measure.' },
];

// Filled dots are things done; `o` items (hollow dots) are outcomes confirmed.
const milestones = [
  { when: 'Month 0 — Enrollment', name: 'Foundation', now: true, items: [
    ['3-hour new patient visit'], ['Prenuvo whole-body MRI'], ['Full biomarker panel (~85 results)'], ['Gut microbiome panel'],
    ['2-week CGM baseline period'], ['DEXA body composition'], ['VO₂ max baseline'], ['Coronary calcium score if due', true] ] },
  { when: 'Month 3', name: 'Response check', items: [
    ['2-week CGM period'], ['Lab check-in (~43 results)'], ['Intervention response confirmed', true], ['Medication safety reviewed', true], ['Physician review visit'] ] },
  { when: 'Month 6', name: 'Semi-annual expansion', items: [
    ['DEXA — second scan'], ['VO₂ max — follow-up test'], ['Lab check-in (~63 results)'], ['Body comp vs. baseline', true], ['Physician review visit'] ] },
  { when: 'Month 9', name: 'Drift check', items: [
    ['2-week CGM period'], ['Lab check-in (~55 results)'], ['CGM + bloodwork read together', true], ['Physician review visit'], ['12-month health blueprint'], ['Year 2 renewal conversation'] ] },
  { when: 'Upon renewal', name: 'Year 2 begins', items: [
    ['Prenuvo MRI — repeated'], ['Full lab draw (~80+ results)'], ['Gut microbiome — repeated'], ['DEXA + VO₂ max baseline'], ['2-week CGM baseline'], ['One-time markers excluded — already in your record', true] ] },
];

// The five target values and the rules above them were removed in the redesign.
const anchors = [
  { marker: 'ApoB', title: 'The atherogenic particle count', body: 'More accurate than cholesterol. Counts every particle capable of causing arterial disease — this is the number we treat to, not LDL-C.' },
  { marker: 'Fasting Insulin', title: 'The metabolic early-warning system', body: 'Detects insulin resistance 5–10 years before HbA1c moves. The single biggest early-detection delta between Clarity and standard primary care.' },
  { marker: 'HbA1c', title: 'Your 3-month blood sugar memory', body: 'A rolling average of glucose control over 90 days — held to a tighter standard than conventional medicine considers normal.' },
  { marker: 'hs-CRP', title: 'The whole-body inflammation thermostat', body: 'Chronic low-grade inflammation is the shared mechanism behind cardiovascular disease, cognitive decline, and accelerated aging.' },
  { marker: 'Vitamin D', title: 'The nutrient with the highest response-to-intervention ratio', body: "Almost everyone can move this number meaningfully within 90 days. Tested at seasonal intervals — not quarterly, when it's mostly noise." },
];

const draws = [
  { month: 'Month 0', name: 'Baseline', meta: '~85+ results · One-time lifetime markers · Prenuvo MRI',
    lede: "Your comprehensive enrollment visit. Every longitudinal reference point for your Clarity program, your Prenuvo whole-body MRI, gut microbiome baseline, and the lifetime genetic markers you'll know forever — all at the start.",
    cats: [
      ['Metabolic & Organ Reserve', 'A comprehensive window into how your liver, kidneys, blood, and blood sugar are performing — including markers most panels skip that predict metabolic risk years before disease appears.'],
      ['Advanced Cardiovascular', 'Beyond standard cholesterol — particle counts, atherogenic particle burden, inflammation markers, and a one-time genetic cardiovascular risk marker that most physicians have never ordered.'],
      ['Hormones', 'A complete hormonal baseline — thyroid (including active and inactive forms), sex hormones with gold-standard assay methodology, adrenal markers, and growth factors. Tailored by sex and age.'],
      ['Nutritional Status', 'Key micronutrients that affect energy, immune function, cardiovascular risk, and cognitive performance — measured at levels optimized for performance, not just above the clinical floor.'],
      ['One-Time Genetic Markers', "Blood typing and an optional cardiovascular and cognitive risk genotype — measured once, known forever."],
    ] },
  { month: 'Month 3', name: 'Response check', meta: '~43 results · Intervention and safety focus',
    lede: 'Ninety days is the ideal window to answer: is what we started working, and is it safe? Every result here is time-sensitive.',
    cats: [["What We're Checking", 'Metabolic response to any interventions started at enrollment. Cardiovascular markers confirming treatment targets are moving. Organ safety. Blood sugar trajectory at the first meaningful checkpoint.']],
    note: 'Nutritional markers and advanced lipid particle counts are intentionally held until Month 6 — they require more time to reflect real change. Testing them at 90 days produces noise, not signal.' },
  { month: 'Month 6', name: 'Semi-annual expansion', meta: '~63 results · Richest mid-year draw',
    lede: 'The most comprehensive follow-up draw of the year. Slow-turnover markers have finally stabilized enough to be meaningful.',
    cats: [["What We're Checking", 'Full cardiovascular panel including advanced particle analysis. Metabolic markers with trend context from Month 3. Nutritional status — particularly Vitamin D timed to seasonal low and Omega-3 index which requires 120 days to reflect dietary changes.']],
    addl: 'Hormone panel added for members on active therapy or with Month 0 abnormals being treated.' },
  { month: 'Month 9', name: 'Drift check', meta: '~55 results · Pre-annual trajectory lock',
    lede: 'A focused pre-annual checkpoint. We confirm the trajectory from Month 6 holds, catch any drift, and adjust anything heading in the wrong direction.',
    cats: [["What We're Checking", "Core metabolic and cardiovascular markers with three-draw trend context. Advanced lipid particle analysis. Organ function and inflammation. Additional markers added on clinical indication — nothing routine that hasn't earned its place by this point."]] },
];

const markers = [
  { cat: 'Cardiovascular', tone: 'cardio', title: 'Lipoprotein(a)', tag: 'The genetic risk factor most doctors still miss.', body: 'Measured once in your lifetime. About 90% genetic. Roughly 1 in 5 adults has an elevated level that dramatically increases cardiovascular risk independent of LDL cholesterol.', note: 'New targeted therapies are in late-stage trials. We measure it now so your care plan is ready when they arrive.' },
  { cat: 'Cardiovascular', tone: 'cardio', title: 'NMR LipoProfile', tag: "We don't just measure your cholesterol. We count the particles.", body: 'Two people with identical LDL cholesterol can have completely different heart disease risk depending on particle size and number. NMR also gives us LP-IR score (insulin resistance at the lipoprotein level) and GlycA, a next-generation inflammation marker more stable than CRP.', note: 'Standard panels measure the amount of cholesterol carried. NMR measures the number of vehicles carrying it.' },
  { cat: 'Cardiovascular', tone: 'cardio', title: 'ApoB', tag: 'One number that supersedes traditional cholesterol.', body: 'Counts every atherogenic particle in your blood. The National Lipid Association (2024) and ACC/AHA (2022) both identify ApoB as the preferred cardiovascular target over LDL-C. This is the number we treat to.', note: 'Your LDL-C can look fine while your ApoB is elevated. We track both, but we act on ApoB.' },
  { cat: 'Metabolic', tone: 'metabolic', title: 'Fasting Insulin', tag: 'The number your previous doctor never checked.', body: 'Insulin resistance develops silently for years before HbA1c moves. Fasting insulin is the earliest detectable signal — it can flag a metabolic problem a decade before standard diabetes screening would catch it.', note: 'The single biggest early-detection delta between Clarity and a standard primary care panel.' },
  { cat: 'Performance', tone: 'performance', title: 'Omega-3 Index', tag: 'The fatty acid composition of your red blood cell membranes.', body: 'A target above 8% is cardiovascularly protective. Below 4% carries the same cardiac risk as smoking. Most people land between 4 and 6%. Responds to diet or supplementation within 120 days — which is why we test it at Month 6, not Month 3.', note: 'Your omega-3 index reflects actual membrane incorporation — not what you ate last week.' },
  { cat: 'Kidney function', tone: 'kidney', title: 'Cystatin C with eGFR', tag: 'We measure kidney function two ways.', body: "Standard creatinine-based eGFR systematically misleads in lean, muscular patients and endurance athletes. Cystatin C gives an independent confirmation that doesn't depend on muscle mass.", note: 'For active, health-optimizing patients, this matters more than most physicians realize.' },
  { cat: 'Opt-in · With counseling', tone: 'optin', title: 'APOE Genotype', tag: 'How your brain ages, and how you respond to dietary fat.', body: 'Your APOE variant affects how you metabolize dietary fat, how we think about cardiovascular management, and how we approach dementia prevention. APOE ε4 carriers require meaningfully different strategies.', note: 'GINA protects employment and health insurance. It does NOT protect life, long-term care, or disability insurance. We discuss this before testing.' },
  { cat: 'Inflammation', tone: 'inflammation', title: 'GlycA', tag: 'A more stable inflammation signal than CRP.', body: 'Measured as part of the NMR LipoProfile, GlycA reflects a longer-term inflammation signal less susceptible to acute spikes from recent illness or intense training that can temporarily distort hs-CRP.', note: 'Provides a cleaner trend line across the year.' },
];

const outcomes = [
  { title: 'Your true cardiovascular risk — not a surrogate', body: "Coronary calcium, NMR particle counts, ApoB, and Lp(a) together give a far more accurate cardiovascular picture than any standard lipid panel. You'll know your actual risk and have a clear protocol for managing it." },
  { title: 'A full-body structural baseline before symptoms arise', body: "The Prenuvo MRI creates a longitudinal record of your internal anatomy. If something changes, you have a reference point. Most of what's found in first-time scans would otherwise remain undetected until symptomatic." },
  { title: 'Objective fitness benchmarks that compound over years', body: "VO₂ max and DEXA body composition measured consistently tell you whether your training, nutrition, and recovery are actually working — and in which direction you're trending over time." },
  { title: 'A hormonal picture aligned with how you perform', body: "Not just whether you're 'in range' — but whether your full hormonal environment is optimized for energy, body composition, sleep quality, cognitive performance, and libido." },
  { title: "Real-time metabolic insight — and what's driving it", body: 'Six weeks of continuous glucose data across three periods, read alongside fasting insulin and metabolic bloodwork, paired with a gut microbiome panel. The combination surfaces dysfunction years before standard screening flags anything.' },
  { title: 'A physician who operates the whole system', body: 'The value of the Clarity Program is not any individual test — it is a physician who reads your MRI, labs, CGM patterns, DEXA, and VO₂ together, across time, and tells you what it means for you specifically.' },
];

const lifestyleCards = [
  { title: 'Lifestyle as first-line medicine', body: "Nutrition, exercise prescription, sleep optimization, and stress physiology aren't adjuncts — they're the intervention. We build them into your plan with the same specificity we apply to lab targets." },
  { title: 'Medication when the evidence is clear', body: "Some conditions respond best or most safely to pharmacological treatment. We don't avoid medication ideologically. We use it judiciously, explain the reasoning, and monitor it at every draw." },
  { title: 'Active deprescribing as health improves', body: "If you start the program on medications that were prescribed reactively, we actively evaluate whether they're still necessary as your biomarkers improve. Reducing a medication when it's no longer needed is a clinical goal, not an afterthought." },
];

const forList = [
  'People who take their health seriously and want a physician program structured around prevention — more signal, real follow-through, a doctor who stays with you',
  "Anyone who's done a one-time physical or ordered their own labs and found the data valuable but disconnected from an ongoing care relationship",
  'Those who already track sleep, nutrition, or fitness with wearables and want a physician who can read that data in full clinical context',
  "People with family history of cardiovascular disease, cancer, or metabolic conditions who want to be working a decade ahead of what's coming",
  'Anyone who values a primary care relationship built around prevention — not acute visits when something goes wrong',
];
const notList = [
  'People primarily looking for a convenient annual check-in — the standard FFM membership is a better fit',
  'Those who prefer to receive test results and interpret them independently, without physician guidance',
  "Anyone not ready to engage meaningfully across the program's five structured milestones throughout the year",
];

const comparisons = [
  { title: 'vs. Executive physicals', sub: 'Mayo / Cleveland / Penn', body: '$4,000–$8,000 for a two-day program. Outstanding diagnostics, followed by a flight home and no ongoing physician relationship. You get a report. We give you a year.', quote: '"The best single-day assessment money can buy — and then you\'re on your own."' },
  { title: 'vs. Longevity clinics', sub: 'Fountain Life / Human Longevity / Next Health', body: '$10,500–$85,000/year for advanced diagnostics and specialist access. Clinically impressive. No primary care relationship. No physician who knows you across acute and chronic care.', quote: '"World-class technology. No one to call when you\'re actually sick."' },
  { title: 'vs. DIY testing', sub: 'Function Health / InsideTracker / Lifeforce', body: '$365–$2,000/year for biomarker panels with algorithm-generated guidance. No imaging. No physician oversight. No ability to prescribe, refer, or follow through when something surfaces.', quote: '"Great data. No one accountable for what you do with it."' },
];

---

<MainLayout
  title="The Clarity Program | Executive Health | Forward Family Medicine Wayne PA"
  description="A physician-led longitudinal health operating system for the Main Line. Prenuvo whole-body MRI, advanced biomarker panels, DEXA, VO₂ max, CGM, and gut microbiome — with physician interpretation at every step. $9,600/year."
  canonical="https://www.forwardfamilymedicine.com/clarity/"
  schema={[breadcrumb, claritySchema]}
>
  <!-- Hero: copy left, annual-membership card right -->
  <section class="cl-hero">
    <div class="rd-wrap cl-hero__grid">
      <div class="cl-hero__copy">
        <h1 class="cl-hero__h1 rd-serif">Your health needs a system, not a schedule.</h1>
        <p class="cl-hero__sub">The Clarity Program is a physician-led longitudinal health operating system — continuous monitoring, structured diagnostics, and a physician who reads everything together, tracks how it changes over time, and acts on what it finds. Not a one-time event. Not a dashboard. A system running on your behalf, all year.</p>
        <div class="cl-ctas">
          <a href={CTA} class="btn-forest">Schedule an inquiry call</a>
          <a href="#how" class="rd-link">See how it works →</a>
        </div>
      </div>
      <SageCard class="cl-card">
        <p class="rd-eyebrow">Annual membership</p>
        <p class="cl-card__price rd-serif">$9,600</p>
        <p class="cl-card__period">Paid annually · HSA-eligible</p>
        <ul class="cl-card__list">
          {included.map(i => <li>{i}</li>)}
        </ul>
        <a href={CTA} class="btn-forest cl-card__btn">Schedule an inquiry call</a>
        <a href="#how" class="rd-link cl-card__link">See what's included →</a>
      </SageCard>
    </div>
  </section>

  <!-- Problem -->
  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">The problem isn't access to data. It's that nothing connects.</h2>
        <p class="rd-copy">You've probably pieced together a health routine that's better than most. But piecing things together is the problem. When your physician, your labs, your imaging, your CGM, and your fitness data don't connect — and no one is accountable for reading them as a system — you're not getting a picture. You're getting fragments.</p>
      </div>
      <div class="cl-short" data-reveal>
        {shortfalls.map(s => (
          <div class="cl-short__row">
            <p class="rd-eyebrow cl-short__label">{s.label}</p>
            <div>
              <h3 class="cl-short__h3 rd-serif">{s.title}</h3>
              <p class="cl-small">{s.body}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Four inputs -->
  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-stack cl-intro">
        <h2 class="rd-h2">Four inputs. One operating system. One physician accountable for all of it.</h2>
        <p class="rd-copy">The Clarity Program isn't a menu of diagnostics. It's a closed-loop system — each data source is read in the context of the others, by the same physician, across time. That's what turns measurement into medicine.</p>
      </div>
      <div class="cl-cards cl-cards--2" data-reveal>
        {inputs.map(i => (
          <div class="cl-card-item">
            <h3 class="cl-card-item__h3 rd-serif">{i.title}</h3>
            <p class="cl-small">{i.body}</p>
            <p class="cl-note cl-note--gold">{i.stat}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline band -->
  <section class="cl-band" id="how">
    <div class="rd-wrap">
      <h2 class="rd-h2 cl-band__h2">Four structured milestones. Continuous monitoring between them.</h2>
      <div class="cl-tl" data-reveal>
        {milestones.map(m => (
          <div class:list={['cl-ms', { 'is-now': m.now }]}>
            <p class="rd-eyebrow cl-ms__when">{m.when}</p>
            <p class="cl-ms__name rd-serif">{m.name}</p>
            <ul class="cl-ms__list">
              {m.items.map(([t, o]) => <li class:list={{ o }}>{t}</li>)}
            </ul>
          </div>
        ))}
      </div>
      <p class="cl-band__foot">Between every milestone: unlimited same-day visits, direct physician contact, specialist coordination, in-office procedures, and wholesale medications — included in your membership.</p>
    </div>
  </section>

  <!-- Anchor biomarkers (no target values) -->
  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-stack cl-intro">
        <h2 class="rd-h2">Five anchor biomarkers. Tracked at every draw, trended every year.</h2>
        <p class="rd-copy">These are your longitudinal health record — the first numbers your physician reviews at every visit, with trend context from every prior draw in your program.</p>
      </div>
      <div class="cl-anch" data-reveal>
        {anchors.map(a => (
          <div class="cl-anch__item">
            <h3 class="cl-anch__marker rd-serif">{a.marker}</h3>
            <p class="cl-anch__title">{a.title}</p>
            <p class="cl-small">{a.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 12-month draw cadence -->
  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <div class="rd-stack cl-intro">
        <h2 class="rd-h2">Timed to biology, not the calendar.</h2>
        <p class="rd-copy">Each draw is purposeful — every result answers a specific clinical question, and every number your physician reviews has a clear 'because of this, we will…' attached. Across your first year, that's nearly 250 individual biomarker results — with physician interpretation on every one.</p>
      </div>
      <div class="cl-cad">
        {draws.map(d => (
          <div class="cl-cad__row" data-reveal>
            <div class="cl-cad__head">
              <p class="cl-cad__month rd-serif">{d.month}</p>
              <p class="cl-cad__name">{d.name}</p>
              <p class="cl-cad__meta">{d.meta}</p>
            </div>
            <p class="cl-cad__lede">{d.lede}</p>
            <div class="cl-cad__sub">
              {d.cats.map(([label, text]) => (
                <div>
                  <h4 class="cl-label">{label}</h4>
                  <p>{text}</p>
                </div>
              ))}
              {d.note && <p class="cl-note cl-note--gold">{d.note}</p>}
              {d.addl && <p class="cl-cad__addl">{d.addl}</p>}
            </div>
          </div>
        ))}
        <div class="cl-cad__row" data-reveal>
          <div class="cl-cad__head">
            <p class="cl-cad__month rd-serif">Upon renewal</p>
            <p class="cl-cad__name">Year 2 begins</p>
            <p class="cl-cad__meta">Year 2 enrollment · ~80+ results</p>
          </div>
          <div class="cl-cad__renew">
            <h3 class="rd-h3">The renewal draw — everything from Month 0, minus what's already known</h3>
            <p>Renewing members start Year 2 with a full enrollment draw — Prenuvo MRI, comprehensive labs, gut microbiome, DEXA, VO₂ max, and CGM baseline. The difference from Year 1: the one-time lifetime markers don't need repeating. Everything else resets as a new longitudinal anchor, now read against Year 1 data.</p>
            <p>The 12-month health blueprint delivered at your Month 9 visit makes the case for renewal.</p>
          </div>
          <div class="cl-cad__renew">
            <h3 class="rd-h3">Why the data compounds</h3>
            <p>A single year of Clarity data tells you where you are. Two years tells you which direction you're moving and how fast. The longitudinal record doesn't reset on renewal — it deepens.</p>
            <p>Members who renew move from establishing baselines to tracking trajectories. That shift is where the program's real diagnostic power comes from.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Markers most physicians don't order -->
  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-stack cl-intro">
        <h2 class="rd-h2">The markers most physicians still don't order.</h2>
        <p class="rd-copy">Each of these represents a significant gap between what standard primary care tests and what advanced cardiovascular and metabolic medicine requires.</p>
      </div>
      <div class="cl-cards cl-cards--2" data-reveal>
        {markers.map(m => (
          <div class="cl-card-item">
            <p class="cl-label">{m.cat}</p>
            <h3 class="cl-card-item__h3 rd-serif">{m.title}</h3>
            <p class="cl-tag">{m.tag}</p>
            <p class="cl-small">{m.body}</p>
            <p class="cl-note">{m.note}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Outcomes -->
  <section class="rd-section rd-alt">
    <div class="rd-wrap">
      <h2 class="rd-h2 cl-outcomes__h2">Not just data. A continuously updated picture of your health.</h2>
      <TitledGrid reveal columns={3} items={outcomes} />
    </div>
  </section>

  <!-- Lifestyle first -->
  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-split rd-split--eq cl-life">
        <h2 class="rd-h2">Lifestyle changes first. Medication when genuinely necessary. Less over time, not more.</h2>
        <div class="rd-stack">
          <p class="rd-copy">Most medical systems are optimized for prescribing. Clarity is optimized for not needing to. When your labs surface something worth acting on, the first question we ask is what lifestyle change — in nutrition, movement, sleep, or stress — could move this number before we consider a prescription.</p>
          <p class="rd-copy">This is where Dr. Lieberman's dual board certification in Lifestyle Medicine and culinary background become clinically meaningful. Behavioral interventions are not a consolation prize — they are the primary tool, with evidence that rivals or exceeds pharmacological options for many of the conditions we're tracking.</p>
          <p class="rd-copy">When medication is the right answer — and sometimes it clearly is — we use it at the lowest effective dose, monitor it at every draw, and revisit whether it's still necessary as your health improves. Deprescribing is as deliberate a clinical act as prescribing.</p>
        </div>
      </div>
      <TitledGrid reveal columns={3} items={lifestyleCards} class="cl-life__cards" />
      <SageCard class="cl-meno">
        <p>For midlife women navigating perimenopause and menopause, our <a href="/menopause/">Menopause Care program</a> complements Clarity's longitudinal health framework — evidence-based HRT consultation, symptom assessment, and cardiovascular risk management, integrated directly into your primary care.</p>
      </SageCard>
    </div>
  </section>

  <!-- Who it is for -->
  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--eq cl-who">
      <div class="cl-who__col">
        <p class="rd-eyebrow">This program is designed for</p>
        <h3 class="cl-who__h rd-serif">People who want to stay ahead of their health — not just manage it.</h3>
        <ul class="cl-who__list cl-who__list--for">
          {forList.map(t => <li><span aria-hidden="true">→</span>{t}</li>)}
        </ul>
      </div>
      <div class="cl-who__col">
        <p class="rd-eyebrow rd-eyebrow--muted">This program is not for</p>
        <h3 class="cl-who__h cl-who__h--muted rd-serif">And what it isn't.</h3>
        <ul class="cl-who__list">
          {notList.map(t => <li><span aria-hidden="true">✕</span>{t}</li>)}
        </ul>
        <div class="cl-callout">
          <p>If the standard membership is a better fit for where you are right now, that's a conversation worth having.</p>
          <a href={CTA} class="rd-link">Schedule a free meet and greet →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Positioning and pricing -->
  <section class="rd-section">
    <div class="rd-wrap">
      <div class="rd-stack cl-intro">
        <h2 class="rd-h2">What this replaces. And what it costs.</h2>
        <p class="rd-copy">The Clarity Program sits between fragmented self-directed testing and the ultra-premium longevity clinics — delivering clinical rigor and a physician relationship at a price that reflects the Main Line, not Manhattan or Scottsdale.</p>
      </div>
      <div class="cl-cmp" data-reveal>
        {comparisons.map(c => (
          <div class="cl-cmp__item">
            <h3 class="rd-h3">{c.title}</h3>
            <p class="cl-cmp__sub">{c.sub}</p>
            <p class="cl-small">{c.body}</p>
            <p class="cl-cmp__quote rd-serif">{c.quote}</p>
          </div>
        ))}
      </div>
      <SageCard class="cl-price">
        <div class="cl-price__left">
          <p class="cl-price__n rd-serif">$9,600</p>
          <p class="cl-card__period">Paid annually · No enrollment fee</p>
        </div>
        <div class="cl-price__tags">
          <span>Paid annually</span><span>HSA-eligible</span><span>No enrollment fee</span><span class="is-strong">Full FFM membership included</span>
        </div>
        <div class="cl-price__ctas">
          <a href={CTA} class="btn-forest">Schedule an inquiry call</a>
          <a href="#how" class="rd-link">See what's included →</a>
        </div>
      </SageCard>
    </div>
  </section>

  <!-- Promise -->
  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--a">
      <h2 class="rd-h2">Every result ends with a sentence that starts: <em>"Because of this, we will…"</em></h2>
      <div class="rd-stack">
        <p class="rd-copy">Your comprehensive baseline delivers 85+ individual biomarker results. Each follow-up draw adds 43 to 63 more. Over your first year in Clarity, that's nearly 250 data points tracked longitudinally — with physician interpretation on every single one.</p>
        <p class="rd-copy">The number isn't the point. Every result ends with a sentence that starts: "Because of this, we will…" That sentence — and the physician behind it — is what makes Clarity different from every testing platform, every executive physical, and every annual lab panel you've had before.</p>
      </div>
    </div>
  </section>

  <FAQSection faqs={faqs} headline="A few things worth clarifying." />

  <CTABanner
    headline="Start with a 60-minute meet and greet."
    subhead="No paperwork. No commitment. A conversation with one of our physicians to determine whether this program fits what you're looking for — and what it would look like in practice."
    btnText="Schedule an inquiry call"
    btnHref={CTA}
    btn2Text="Prefer to start with the standard membership? See all plans →"
    btn2Href="/membership/"
  />
</MainLayout>

<style>
  .cl-small { margin: 0; font-size: 14px; line-height: 1.7; color: var(--text-700); }
  .cl-intro { max-width: 820px; margin-bottom: 44px; }
  .cl-label { margin: 0; font-size: 11px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: var(--sage-600); }
  .cl-note {
    margin: 0;
    padding-top: 14px;
    border-top: 1px solid var(--hairline-strong);
    font-size: 13px;
    line-height: 1.7;
    font-style: italic;
    color: var(--text-700);
  }
  .cl-note--gold { border-top: 2px solid var(--gold); }

  /* Hero */
  .cl-hero { background: var(--linen); padding: 80px 0 96px; }
  .cl-hero__grid { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr); gap: 72px; align-items: start; }
  .cl-hero__copy { display: flex; flex-direction: column; gap: 26px; padding-top: 12px; align-items: flex-start; }
  .cl-hero__h1 { margin: 0; font-size: 66px; line-height: 1.02; letter-spacing: -0.018em; color: var(--forest); max-width: 12ch; }
  .cl-hero__sub { margin: 0; font-size: 18px; line-height: 1.7; color: var(--text-900); max-width: 600px; }
  .cl-ctas { display: flex; flex-wrap: wrap; gap: 14px 20px; align-items: center; margin-top: 6px; }
  :global(.cl-card) { padding: 32px 34px 30px; gap: 0; align-items: flex-start; }
  :global(.cl-card) > * { width: 100%; }
  .cl-card__price { margin: 14px 0 4px; font-size: 64px; line-height: 1; letter-spacing: -0.02em; color: var(--forest); }
  .cl-card__period { margin: 0 0 22px; font-size: 13.5px; font-weight: 500; color: var(--sage-600); }
  .cl-card__list { list-style: none; margin: 0 0 26px; padding: 0; }
  .cl-card__list li { padding: 14px 0; border-top: 1px solid var(--hairline-strong); font-size: 14px; line-height: 1.6; color: var(--text-900); }
  .cl-card__list li:last-child { border-bottom: 1px solid var(--hairline-strong); }
  :global(.cl-card) .cl-card__btn { width: auto; align-self: flex-start; }
  :global(.cl-card) .cl-card__link { width: auto; align-self: flex-start; margin-top: 18px; }

  /* Problem */
  .cl-short { display: flex; flex-direction: column; }
  .cl-short__row {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 32px;
    padding: 26px 0;
    border-top: 1px solid var(--hairline-strong);
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cl-short__row:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .cl-short.on .cl-short__row { opacity: 1; transform: none; }
  .cl-short.on .cl-short__row:nth-child(2) { transition-delay: 0.2s; }
  .cl-short.on .cl-short__row:nth-child(3) { transition-delay: 0.4s; }
  .cl-short__label { padding-top: 6px; }
  .cl-short__h3 { margin: 0 0 10px; font-size: 24px; line-height: 1.2; color: var(--forest); }
  .cl-short__row .cl-small { font-size: 15px; }

  /* Two-column card grids (inputs, markers) */
  .cl-cards { display: grid; gap: 0 56px; }
  .cl-cards--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .cl-card-item {
    display: flex; flex-direction: column; gap: 12px;
    padding: 32px 0 32px;
    border-top: 1px solid var(--hairline-strong);
    opacity: 0; transform: translateY(8px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cl-card-item:nth-last-child(-n+2) { border-bottom: 1px solid var(--hairline-strong); }
  .cl-cards.on .cl-card-item { opacity: 1; transform: none; }
  .cl-cards.on .cl-card-item:nth-child(2) { transition-delay: 0.15s; }
  .cl-cards.on .cl-card-item:nth-child(3) { transition-delay: 0.3s; }
  .cl-cards.on .cl-card-item:nth-child(4) { transition-delay: 0.45s; }
  .cl-cards.on .cl-card-item:nth-child(n+5) { transition-delay: 0.6s; }
  .cl-card-item__h3 { margin: 0; font-size: 26px; line-height: 1.2; color: var(--forest); }
  .cl-card-item .cl-note { margin-top: 8px; }
  .cl-tag { margin: 0; font-size: 15px; font-weight: 600; color: var(--forest); }

  /* Timeline band */
  .cl-band { background: var(--forest); color: var(--linen); padding: 96px 0 104px; }
  .cl-band__h2 { color: var(--linen); max-width: 760px; margin-bottom: 56px; }
  .cl-tl {
    position: relative;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0 28px;
    padding-top: 30px;
  }
  .cl-tl::before {
    content: ""; position: absolute; left: 0; right: 0; top: 5px; height: 1px;
    background: var(--sage);
    transform: scaleX(0); transform-origin: left;
    transition: transform 1.4s ease 0.1s;
  }
  .cl-tl.on::before { transform: none; }
  .cl-ms {
    position: relative; display: flex; flex-direction: column; gap: 14px;
    opacity: 0; transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cl-ms::before {
    content: ""; position: absolute; left: 0; top: -30px; width: 11px; height: 11px; box-sizing: border-box;
    border-radius: 50%; background: var(--forest); border: 1.5px solid var(--sage);
  }
  .cl-ms.is-now::before { background: var(--sage); }
  .cl-tl.on .cl-ms { opacity: 1; transform: none; }
  .cl-tl.on .cl-ms:nth-child(1) { transition-delay: 0.25s; }
  .cl-tl.on .cl-ms:nth-child(2) { transition-delay: 0.5s; }
  .cl-tl.on .cl-ms:nth-child(3) { transition-delay: 0.75s; }
  .cl-tl.on .cl-ms:nth-child(4) { transition-delay: 1s; }
  .cl-tl.on .cl-ms:nth-child(5) { transition-delay: 1.25s; }
  .cl-ms__when { color: var(--sage); }
  .cl-ms__name { margin: 0; font-size: 22px; line-height: 1.2; color: var(--linen); }
  .cl-ms__list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 9px; font-size: 13.5px; line-height: 1.5; color: var(--on-forest); }
  .cl-ms__list li { position: relative; padding-left: 18px; }
  .cl-ms__list li::before { content: ""; position: absolute; left: 0; top: 7px; width: 7px; height: 7px; border-radius: 50%; background: var(--sage); }
  .cl-ms__list li.o { color: var(--on-forest-faint); }
  .cl-ms__list li.o::before { background: transparent; border: 1px solid var(--sage); width: 5px; height: 5px; }
  .cl-band__foot { margin: 56px 0 0; padding-top: 22px; border-top: 1px solid var(--sage); font-size: 15px; line-height: 1.7; color: var(--on-forest); max-width: 900px; }

  /* Anchors */
  .cl-anch { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 0 28px; }
  .cl-anch__item {
    padding: 24px 0; border-top: 1px solid var(--hairline-strong); border-bottom: 1px solid var(--hairline-strong);
    display: flex; flex-direction: column; gap: 10px;
    opacity: 0; transform: translateY(8px); transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cl-anch.on .cl-anch__item { opacity: 1; transform: none; }
  .cl-anch.on .cl-anch__item:nth-child(2) { transition-delay: 0.15s; }
  .cl-anch.on .cl-anch__item:nth-child(3) { transition-delay: 0.3s; }
  .cl-anch.on .cl-anch__item:nth-child(4) { transition-delay: 0.45s; }
  .cl-anch.on .cl-anch__item:nth-child(5) { transition-delay: 0.6s; }
  .cl-anch__marker { margin: 0; font-size: 28px; line-height: 1.1; color: var(--forest); }
  .cl-anch__title { margin: 0; font-size: 13.5px; font-weight: 500; line-height: 1.4; color: var(--sage-600); }

  /* Draw cadence rows */
  .cl-cad { margin-top: 24px; }
  .cl-cad__row {
    display: grid; grid-template-columns: 250px minmax(0, 1fr) minmax(0, 1fr); gap: 40px;
    padding: 36px 0; border-top: 1px solid var(--hairline-strong);
    opacity: 0; transform: translateY(8px); transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cl-cad__row:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .cl-cad__row.on { opacity: 1; transform: none; }
  .cl-cad__head { display: flex; flex-direction: column; gap: 8px; }
  .cl-cad__month { margin: 0; font-size: 30px; line-height: 1.1; color: var(--forest); }
  .cl-cad__name { margin: 0; font-size: 15px; font-weight: 500; color: var(--sage-600); }
  .cl-cad__meta { margin: 4px 0 0; font-size: 13.5px; line-height: 1.6; color: var(--text-600); }
  .cl-cad__lede { margin: 0; font-size: 16px; line-height: 1.75; color: var(--text-900); }
  .cl-cad__sub { display: flex; flex-direction: column; gap: 14px; }
  .cl-cad__sub p { margin: 0; font-size: 14px; line-height: 1.65; color: var(--text-700); }
  .cl-cad__sub h4 { margin: 0 0 4px; font-family: var(--font-body); font-size: 11px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--sage-600); }
  .cl-cad__sub .cl-note { padding-top: 14px; }
  .cl-cad__renew { display: flex; flex-direction: column; gap: 12px; }
  .cl-cad__renew h3 { font-size: 20px; }
  .cl-cad__renew p { margin: 0; font-size: 14px; line-height: 1.7; color: var(--text-700); }

  .cl-outcomes__h2 { max-width: 20ch; margin-bottom: 44px; }

  /* Lifestyle first */
  .cl-life { align-items: start; margin-bottom: 56px; }
  :global(.cl-life__cards) { margin-bottom: 48px; }
  :global(.cl-meno) { max-width: 952px; }

  /* Who it is for */
  .cl-who { gap: 72px; }
  .cl-who__col { display: flex; flex-direction: column; gap: 14px; }
  .cl-who__h { margin: 0 0 10px; font-size: 32px; line-height: 1.2; color: var(--forest); font-weight: 400; }
  .cl-who__h--muted { color: var(--text-600); }
  .cl-who__list { list-style: none; margin: 0; padding: 0; }
  .cl-who__list li { display: grid; grid-template-columns: 24px minmax(0, 1fr); padding: 16px 0; border-top: 1px solid var(--hairline-strong); font-size: 14px; line-height: 1.65; color: var(--text-900); }
  .cl-who__list li:last-child { border-bottom: 1px solid var(--hairline-strong); }
  .cl-who__list li span { color: var(--sage-600); font-size: 13px; }
  .cl-who__list:not(.cl-who__list--for) li span { color: var(--text-400); }
  .cl-callout { margin-top: 10px; padding: 22px 26px; background: var(--linen); border-top: 3px solid var(--gold); display: flex; flex-direction: column; gap: 12px; align-items: flex-start; }
  .cl-callout p { margin: 0; font-size: 15px; line-height: 1.7; color: var(--text-900); }

  /* Pricing */
  .cl-cmp { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 40px; margin-bottom: 56px; }
  .cl-cmp__item {
    display: flex; flex-direction: column; gap: 10px; padding: 32px 0;
    border-top: 1px solid var(--hairline-strong); border-bottom: 1px solid var(--hairline-strong);
    opacity: 0; transform: translateY(8px); transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .cl-cmp.on .cl-cmp__item { opacity: 1; transform: none; }
  .cl-cmp.on .cl-cmp__item:nth-child(2) { transition-delay: 0.2s; }
  .cl-cmp.on .cl-cmp__item:nth-child(3) { transition-delay: 0.4s; }
  .cl-cmp__sub { margin: 0; font-size: 13px; font-weight: 500; color: var(--sage-600); }
  .cl-cmp__quote { margin: 8px 0 0; font-size: 19px; line-height: 1.4; font-style: italic; color: var(--forest); }
  :global(.sage-card.cl-price) { display: grid; flex-direction: row; grid-template-columns: auto minmax(0, 1fr) auto; gap: 40px; align-items: center; padding: 40px 44px; }
  .cl-price__n { margin: 0; font-size: 64px; line-height: 1; letter-spacing: -0.02em; color: var(--forest); }
  .cl-price__left .cl-card__period { margin: 4px 0 0; }
  .cl-price__tags { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 14px; color: var(--text-900); }
  .cl-price__tags .is-strong { font-weight: 500; color: var(--forest); }
  .cl-price__ctas { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }

  @media (max-width: 860px) {
    .cl-hero { padding: 48px 0 64px; }
    .cl-hero__grid { grid-template-columns: 1fr; gap: 40px; }
    .cl-hero__h1 { font-size: 40px; max-width: none; }
    .cl-hero__sub { font-size: 17px; }
    :global(.cl-card) { padding: 26px 22px; }
    .cl-card__price { font-size: 52px; }
    .cl-short__row { grid-template-columns: 1fr; gap: 10px; }
    .cl-cards--2 { grid-template-columns: 1fr; }
    .cl-card-item:nth-last-child(2) { border-bottom: 0; }
    .cl-card-item__h3 { font-size: 22px; }
    .cl-band { padding: 64px 0; }
    .cl-band__h2 { margin-bottom: 40px; }
    .cl-tl { grid-template-columns: 1fr; gap: 36px; padding-top: 0; padding-left: 28px; }
    .cl-tl::before { left: 5px; right: auto; top: 0; bottom: 0; width: 1px; height: auto; transform: scaleY(0); transform-origin: top; }
    .cl-tl.on::before { transform: none; }
    .cl-ms::before { left: -28px; top: 4px; }
    .cl-anch { grid-template-columns: 1fr; }
    .cl-anch__item + .cl-anch__item { border-top: 0; }
    .cl-cad__row { grid-template-columns: 1fr; gap: 20px; padding: 28px 0; }
    .cl-who { gap: 40px; }
    .cl-who__h { font-size: 26px; }
    .cl-cmp { grid-template-columns: 1fr; }
    .cl-cmp__item + .cl-cmp__item { border-top: 0; }
    :global(.sage-card.cl-price) { grid-template-columns: 1fr; gap: 24px; padding: 28px 22px; }
    .cl-price__n { font-size: 48px; }
    .cl-price__ctas { align-items: flex-start; }
  }
</style>
