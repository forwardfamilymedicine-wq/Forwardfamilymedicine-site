---
/**
 * Hand-built (.mdx) local pages. Every markdown /local/ entry renders through
 * [composed].astro; this route serves only .mdx entries, which compose their
 * own layout from the editorial components and receive the data this route
 * derives (location, hero physician, locations entry) as props on <Content />.
 * The two routes generate disjoint slugs.
 */
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { resolveHeroPhysician } from '../../utils/physicianRouting';
import { secondaryExtras } from '../../utils/localCompose';
import { findTown } from '../../data/towns';

export async function getStaticPaths() {
  const entries = await getCollection('local');
  const allProviders = await getCollection('providers');
  const allLocations = await getCollection('locations');
  return entries
    .filter(entry => !entry.data.draft && (entry.filePath ?? '').endsWith('.mdx'))
    .map(entry => ({
      params: { slug: entry.id.replace(/\.mdx$/, '') },
      props: { entry, allProviders, allLocations },
    }));
}

interface Props {
  entry: CollectionEntry<'local'>;
  allProviders: CollectionEntry<'providers'>[];
  allLocations: CollectionEntry<'locations'>[];
}

const { entry, allProviders, allLocations } = Astro.props;
const { Content } = await render(entry);
const slug = entry.id.replace(/\.mdx$/, '');
const siteUrl = 'https://www.forwardfamilymedicine.com';
// Canonical is always derived from the real built path — never from frontmatter.
// Trailing slash matches the sitemap's /local/ <loc> entries exactly.
const canonicalUrl = `${siteUrl}/local/${slug}/`;

// Derive location slug ("Malvern, PA" → "malvern", "King of Prussia, PA" → "king-of-prussia")
const locationSlug = entry.data.location
  ? entry.data.location.toLowerCase().replace(/,\s*pa$/, '').trim().replace(/\s+/g, '-')
  : '';

// Which physician fronts this page: src/utils/physicianRouting.ts. Specialty
// pages route by credential, general-care pages by location, full panels never
// front a page, and 0 or 2+ eligible physicians fall back to the team card.
const hero = resolveHeroPhysician({
  category: entry.data.category,
  locationSlug,
  providers: allProviders,
  locations: allLocations,
  warn: (m) => console.warn(m),
});

// MDX pages compose their own practical-information block from the
// `locations` collection instead of hand-typed lines in the body.
const locationEntry = locationSlug ? (allLocations.find(l => l.data.slug === locationSlug) ?? null) : null;
// Rows for the town's other offices come from the town map, the same source
// the composed pages use, so a figure changes in one place.
const town = findTown(locationSlug);
const extraOffices = town ? secondaryExtras(town, allLocations) : [];

// FAQPage JSON-LD comes from the FAQSection component. No Article schema:
// `date` is a placeholder on every local entry.
const pageName = entry.data.title.replace(/\s*\|\s*Forward Family Medicine\s*$/, '');
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": entry.data.location ?? pageName, "item": canonicalUrl },
  ],
};
---

<MainLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonicalUrl}
  schema={[breadcrumbSchema]}
>
  <div class="local-page local-page--composed">
    <Content
      location={entry.data.location}
      locationSlug={locationSlug}
      hero={hero}
      locationEntry={locationEntry}
      extraOffices={extraOffices}
    />
  </div>
</MainLayout>
