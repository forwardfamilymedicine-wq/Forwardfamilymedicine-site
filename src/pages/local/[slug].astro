---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import { getAvailability } from '../../utils/availability';

export async function getStaticPaths() {
  const entries = await getCollection('local');
  const allProviders = await getCollection('providers');
  return entries
    .filter(entry => !entry.data.draft)
    .map(entry => ({
      params: { slug: entry.id.replace(/\.mdx?$/, '') },
      props: { entry, allProviders },
    }));
}

interface Props {
  entry: CollectionEntry<'local'>;
  allProviders: CollectionEntry<'providers'>[];
}

const { entry, allProviders } = Astro.props;
const { Content, headings } = await render(entry);
const slug = entry.id.replace(/\.mdx?$/, '');
const siteUrl = 'https://www.forwardfamilymedicine.com';
// Canonical is always derived from the real built path — never from frontmatter.
// Trailing slash matches the sitemap's /local/ <loc> entries exactly.
const canonicalUrl = `${siteUrl}/local/${slug}/`;

// ── Two-path dispatch ───────────────────────────────────────────────────────
// .md entries flow through the generic server-rendered path below: the
// pre-rendered markdown is cut into <h2>-delimited sections and wrapped in the
// same markup the old client-side script used to build in the browser.
// .mdx entries compose their own layout from components and receive the data
// this route derives (location, hero provider) as props on <Content />.
const isMdx = (entry.filePath ?? '').endsWith('.mdx');

// Derive location slug ("Malvern, PA" → "malvern", "King of Prussia, PA" → "king-of-prussia")
const locationSlug = entry.data.location
  ? entry.data.location.toLowerCase().replace(/,\s*pa$/, '').trim().replace(/\s+/g, '-')
  : '';

// Provider image: slug → /images/staff/dr-{base}.jpg
// All three headshots omit the credential suffix and use a dr- prefix.
// e.g. "brian-landi-do" → "/images/staff/dr-brian-landi.jpg"
function providerPhoto(provSlug: string) {
  return `/images/staff/dr-${provSlug.replace(/-(?:do|md|pa|np|rn)$/i, '')}.jpg`;
}

// Find providers whose locations array includes this page's location slug
const matchedProviders = locationSlug
  ? allProviders.filter(p => p.data.locations.includes(locationSlug))
  : [];

// Markdown pages keep the original rule: an individual card only when exactly
// one provider lists this location, otherwise the team card. MDX pages first
// drop physicians whose panel is full (Dr. Bigley in Wayne) so an accepting
// physician can front the page. Gated to MDX in this batch so the 85 markdown
// pages render exactly as before.
const heroCandidates = isMdx
  ? matchedProviders.filter(p => getAvailability(p.data).status !== 'full')
  : matchedProviders;

// Build hero card data — always defined (team fallback for 0 or 2+ provider matches)
const heroProvider = heroCandidates.length === 1
  ? (() => {
      const p = heroCandidates[0];
      const cred = p.data.slug === 'brian-landi-do'
        ? 'DO — board-certified family physician & Menopause Society Certified Practitioner'
        : `${p.data.credentials} — ${p.data.boardStatus === 'board-certified' ? 'board-certified' : 'board-eligible'} ${(p.data.boardSpecialties[0] ?? 'family medicine').toLowerCase()} physician`;
      return {
        isTeam: false,
        name: `Dr. ${p.data.name}`,
        cred,
        photo: providerPhoto(p.data.slug),
        href: `/meet-the-team/${p.data.slug}/`,
        linkLabel: 'Full bio →',
      };
    })()
  : {
      isTeam: true,
      name: 'Our Physicians',
      cred: 'Direct Primary Care · Wayne · Malvern · West Chester',
      photo: '/images/staff/ffm-team.jpg',
      href: '/meet-the-team/',
      linkLabel: 'Meet the Team →',
    };

// ── Section classifier (ported verbatim from the former client-side script) ──
// Keys on the <h2> wording. Classifies on decoded heading text, which is what
// the browser's textContent gave the old script; "Contact & Practice
// Information" renders as "Contact &#x26; Practice Information" in HTML, so
// classifying raw markup would misroute it.
type SectionKind =
  | 'section-about' | 'section-why' | 'section-services' | 'section-info'
  | 'section-faq' | 'section-cta' | 'section-explainer';

function classify(text: string): SectionKind {
  const t = text.toLowerCase().trim();
  if (t.startsWith('about '))                                              return 'section-about';
  if (t.startsWith('why '))                                                return 'section-why';
  if (t.includes('service'))                                               return 'section-services';
  if (t.includes('practical') || t.includes('contact & practice') || t === 'contact') return 'section-info';
  if (t.includes('frequently asked') || t === 'faq')                      return 'section-faq';
  if (t.includes('get started') || t.includes('ready to') ||
      t.includes('take the first') || t.includes('start living') ||
      /^experience /.test(t))                                              return 'section-cta';
  return 'section-explainer';
}

// ── Markdown path: segment the pre-rendered HTML at <h2> boundaries ─────────
// The glob loader renders every .md entry once at sync time and stores the
// result on entry.rendered.html; <Content /> emits that string verbatim. Every
// <h2> carries an id equal to its heading slug (rehypeHeadingIds), so cutting
// the string at `<h2 id="{slug}">` reproduces the old script's grouping of
// "everything between two h2s" without re-rendering any markdown.
interface Section {
  kind: SectionKind;
  text: string;
  headingHtml: string;
  bodyHtml: string;
}

function stripTags(s: string) { return s.replace(/<[^>]+>/g, ''); }
function decodeEntities(s: string) {
  return s
    .replace(/&#x([0-9a-f]+);/gi, (_, h) => String.fromCodePoint(parseInt(h, 16)))
    .replace(/&#(\d+);/g, (_, d) => String.fromCodePoint(Number(d)))
    .replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>')
    .replace(/&quot;/g, '"').replace(/&apos;/g, "'");
}
function escapeHtml(s: string) {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

let heroHtml = '';
let sections: Section[] = [];
const faqPairs: { q: string; a: string }[] = [];

if (!isMdx) {
  const html = entry.rendered?.html ?? '';
  const h2s = headings.filter(h => h.depth === 2);

  const h2Count = (html.match(/<h2[\s>]/g) ?? []).length;
  if (h2Count !== h2s.length) {
    throw new Error(`[local/${slug}] ${h2Count} <h2> elements in HTML but ${h2s.length} depth-2 headings; a heading is nested or unslugged and the page cannot be segmented safely.`);
  }

  const cuts: number[] = [];
  let from = 0;
  for (const h of h2s) {
    const idx = html.indexOf(`<h2 id="${h.slug}">`, from);
    if (idx === -1) {
      throw new Error(`[local/${slug}] heading "${h.text}" (#${h.slug}) not found in rendered HTML; cannot segment.`);
    }
    cuts.push(idx);
    from = idx + 1;
  }

  heroHtml = html.slice(0, cuts[0] ?? html.length);
  sections = h2s.map((h, i) => {
    const seg = html.slice(cuts[i], cuts[i + 1] ?? html.length);
    const close = seg.indexOf('</h2>');
    return {
      kind: classify(h.text),
      text: h.text,
      headingHtml: seg.slice(0, close + 5),
      bodyHtml: seg.slice(close + 5),
    };
  });
}

// Old script: add the CTA button only if the hero (breadcrumb excluded) has no link.
const heroHasLink = /<a[\s>]/.test(heroHtml);

// Old script: #local-extra (localNote + nearby) moves into the first CTA
// section; if none exists it lands in the last section instead.
const hasExtra = Boolean(entry.data.localNote || entry.data.nearbyNeighborhoods);
const firstCta = sections.findIndex(s => s.kind === 'section-cta');
const extraIndex = hasExtra ? (firstCta !== -1 ? firstCta : sections.length - 1) : -1;

// FAQ: each <p> whose first element child is <strong>…?</strong> becomes an
// accordion item. Same test and same leading-whitespace trim as the old script.
// Collects question/answer pairs for FAQPage JSON-LD as a side effect.
function enhanceFaq(bodyHtml: string): string {
  return bodyHtml.replace(/<p>([\s\S]*?)<\/p>/g, (full, inner: string) => {
    const m = inner.match(/^([^<]*)<strong>([\s\S]*?)<\/strong>([\s\S]*)$/);
    if (!m) return full;
    const qText = decodeEntities(stripTags(m[2])).trim();
    if (!qText.endsWith('?')) return full;
    const answerHtml = (m[1] + m[3]).replace(/^\s*\n?\s*/, '');
    faqPairs.push({ q: qText, a: decodeEntities(stripTags(answerHtml)).replace(/\s+/g, ' ').trim() });
    return (
      '<div class="faq-item-local">' +
        '<button class="faq-q-btn" aria-expanded="false">' +
          `<span>${escapeHtml(qText)}</span>` +
          '<span class="faq-toggle" aria-hidden="true">+</span>' +
        '</button>' +
        `<div class="faq-a" hidden><p>${answerHtml}</p></div>` +
      '</div>'
    );
  });
}

const renderedSections = sections.map(s => ({
  ...s,
  bodyHtml: s.kind === 'section-faq' ? enhanceFaq(s.bodyHtml) : s.bodyHtml,
}));

// ── JSON-LD ─────────────────────────────────────────────────────────────────
// No Article schema: `date` is a placeholder on every local entry.
const pageName = entry.data.title.replace(/\s*\|\s*Forward Family Medicine\s*$/, '');
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": pageName, "item": canonicalUrl },
  ],
};
// MDX pages emit FAQPage from the FAQSection component instead.
const faqSchema = !isMdx && faqPairs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqPairs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
} : null;
const schemas = faqSchema ? [breadcrumbSchema, faqSchema] : [breadcrumbSchema];
---

<MainLayout
  title={entry.data.title}
  description={entry.data.description}
  canonical={canonicalUrl}
  schema={schemas}
>
  {isMdx ? (
    <div class="local-page local-page--composed">
      <Content
        location={entry.data.location}
        locationSlug={locationSlug}
        heroProvider={heroProvider}
        provider={heroCandidates.length === 1 ? heroCandidates[0] : null}
      />
    </div>
  ) : (
    <div class="local-page">
      <div class="local-content">
        <div class="section-hero">
          <div class="lp-container hero-grid">
            <div class="hero-left">
              <nav class="local-breadcrumb" aria-label="Breadcrumb">
                <a href="/">Home</a> <span aria-hidden="true">›</span>
                <span>{entry.data.location ?? 'Nearby'}</span>
              </nav>
              <Fragment set:html={heroHtml} />
              {!heroHasLink && (
                <a href="/contact/?source=local-page" class="hero-cta-btn">Schedule a Meet &amp; Greet →</a>
              )}
            </div>
            <div
              id="hero-provider-card"
              class={heroProvider.isTeam ? 'hero-card hero-card--team' : 'hero-card hero-card--individual'}
            >
              <img
                src={heroProvider.photo}
                alt={heroProvider.isTeam
                  ? 'Forward Family Medicine physician team'
                  : `${heroProvider.name} — Forward Family Medicine`}
                class="hero-card-photo"
                width={heroProvider.isTeam ? 280 : 140}
                height={heroProvider.isTeam ? 160 : 140}
                loading="eager"
              />
              <div class="hero-card-body">
                <p class="hero-card-name">{heroProvider.name}</p>
                <p class="hero-card-cred">{heroProvider.cred}</p>
                <a href={heroProvider.href} class="hero-card-link">{heroProvider.linkLabel}</a>
              </div>
            </div>
          </div>
        </div>

        {renderedSections.map((s, i) => (
          <Fragment>
            <section class={`local-section ${s.kind}`}>
              <div class="lp-container">
                {s.kind === 'section-info' ? (
                  <Fragment>
                    <Fragment set:html={s.headingHtml} />
                    <div class="info-card"><Fragment set:html={s.bodyHtml} /></div>
                  </Fragment>
                ) : (
                  <Fragment set:html={s.headingHtml + s.bodyHtml} />
                )}
                {i === extraIndex && (
                  <Fragment>
                    {entry.data.localNote && <p class="local-note">{entry.data.localNote}</p>}
                    {entry.data.nearbyNeighborhoods && (
                      <p class="nearby-text">Also serving patients from {entry.data.nearbyNeighborhoods}.</p>
                    )}
                  </Fragment>
                )}
              </div>
            </section>

            {s.kind === 'section-about' && (
              <Fragment>
                <div class="local-stats-strip">
                  <div class="lp-container">
                    <div class="local-stats-grid">
                      <div class="local-stat">
                        <span class="local-stat-num">~250</span>
                        <span class="local-stat-label">Max patients per physician</span>
                      </div>
                      <div class="local-stat">
                        <span class="local-stat-num">1–2 hr</span>
                        <span class="local-stat-label">Visit length</span>
                      </div>
                      <div class="local-stat">
                        <span class="local-stat-num">$200/mo</span>
                        <span class="local-stat-label">Individual membership</span>
                      </div>
                    </div>
                  </div>
                </div>
                {entry.data.mapEmbedUrl && (
                  <section class="local-section section-map">
                    <div class="lp-container">
                      <div id="local-map">
                        <iframe
                          src={entry.data.mapEmbedUrl}
                          width="100%"
                          height="380"
                          style="border:0;border-radius:12px;display:block;"
                          loading="lazy"
                          title={`Forward Family Medicine — ${entry.data.location ?? 'office'} map`}
                        ></iframe>
                        <div class="map-info-card">
                          <p class="map-info-location">{entry.data.location}</p>
                          {locationSlug && (
                            <a class="map-info-link" href={`/locations/${locationSlug}/`}>Office details →</a>
                          )}
                        </div>
                      </div>
                    </div>
                  </section>
                )}
              </Fragment>
            )}
          </Fragment>
        ))}
      </div>
    </div>
  )}
</MainLayout>

<!-- Progressive enhancement only: the accordion markup is static and every
     answer is in the HTML. Without JavaScript the answers stay hidden via the
     `hidden` attribute, exactly as the old DOM-built version behaved. -->
<script>
  document.querySelectorAll<HTMLButtonElement>('.faq-q-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      const answer = btn.nextElementSibling as HTMLElement | null;
      if (answer) answer.hidden = isExpanded;
      const toggle = btn.querySelector('.faq-toggle');
      if (toggle) toggle.textContent = isExpanded ? '+' : '×';
    });
  });
</script>

<style is:global>
  /* ── Shared container ──────────────────────────────────────────── */
  .lp-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
  }

  /* ── Shared section padding ────────────────────────────────────── */
  .local-section {
    padding: clamp(48px, 7vw, 72px) 0;
  }

  /* ════════════════════════════════════════════════════════════════
     HERO  ─ two-column: text left, provider/team card right
     ════════════════════════════════════════════════════════════════ */
  .section-hero {
    background: var(--cream-100);
    padding: clamp(40px, 6vw, 64px) 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1fr minmax(260px, 340px);
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }
  .hero-left {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .local-breadcrumb {
    display: block;
    font-size: 0.85rem;
    color: var(--ink-300);
    text-decoration: none;
  }
  .local-breadcrumb a {
    color: var(--green-300);
    text-decoration: none;
  }
  .local-breadcrumb a:hover { text-decoration: underline; }
  .section-hero h1 {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 4.5vw, 3.2rem);
    font-weight: 700;
    line-height: 1.15;
    color: var(--ink-900);
    margin: 0;
  }
  .hero-cta-btn {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    margin-top: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: var(--green-400);
    color: #fff;
    border-radius: 8px;
    font-weight: 600;
    font-size: 0.95rem;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.2s;
  }
  .hero-cta-btn:hover { background: var(--green-500); }

  /* ── Hero provider / team card ─────────────────────────────────── */
  .hero-card {
    background: #fff;
    border: 1px solid var(--cream-300);
    border-radius: 16px;
    padding: 1.75rem 1.5rem;
    box-shadow: var(--shadow-md);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.65rem;
  }
  .hero-card--individual .hero-card-photo {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    object-position: top;
  }
  .hero-card--team .hero-card-photo {
    width: 100%;
    max-width: 280px;
    height: 160px;
    border-radius: 10px;
    object-fit: cover;
  }
  .hero-card-body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
  }
  .hero-card-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--ink-900);
    margin: 0;
    line-height: 1.2;
  }
  .hero-card-cred {
    font-size: 0.82rem;
    color: var(--ink-700);
    line-height: 1.5;
    margin: 0;
    max-width: 280px;
  }
  .hero-card-link {
    display: inline-block;
    font-size: 0.88rem;
    color: var(--green-300);
    font-weight: 600;
    text-decoration: underline;
    margin-top: 0.25rem;
  }

  @media (max-width: 820px) {
    .hero-grid {
      grid-template-columns: 1fr;
    }
    .hero-card {
      max-width: 360px;
      margin: 0 auto;
    }
  }

  /* ════════════════════════════════════════════════════════════════
     ABOUT  ─ cream bg
     ════════════════════════════════════════════════════════════════ */
  .section-about {
    background: var(--cream-100);
  }
  .section-about .lp-container { max-width: 820px; }
  .section-about h2 {
    font-family: var(--font-body);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-400);
    margin-bottom: 1rem;
  }
  .section-about p {
    color: var(--ink-700);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .section-about p:last-child { margin-bottom: 0; }

  /* ════════════════════════════════════════════════════════════════
     STATS STRIP  ─ sage green
     ════════════════════════════════════════════════════════════════ */
  .local-stats-strip {
    background: var(--green-300);
    padding: clamp(28px, 4vw, 44px) 0;
  }
  .local-stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
  }
  .local-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 0.75rem 1rem;
    border-right: 1px solid rgba(255, 255, 255, 0.22);
  }
  .local-stat:last-child { border-right: none; }
  .local-stat-num {
    font-family: var(--font-heading);
    font-size: clamp(1.75rem, 3.5vw, 2.4rem);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }
  .local-stat-label {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.4;
  }
  @media (max-width: 420px) {
    .local-stat { padding: 0.6rem 0.4rem; }
    .local-stat-num { font-size: 1.4rem; }
    .local-stat-label { font-size: 0.7rem; }
  }

  /* ════════════════════════════════════════════════════════════════
     MAP BAND  ─ cream, two-column: iframe + info card
     ════════════════════════════════════════════════════════════════ */
  .section-map {
    background: var(--cream-200);
    padding: clamp(40px, 6vw, 60px) 0;
  }
  #local-map {
    display: grid;
    grid-template-columns: 1fr minmax(200px, 260px);
    gap: 2rem;
    align-items: start;
  }
  #local-map iframe {
    display: block;
    width: 100%;
    min-height: 360px;
    border-radius: 12px;
    box-shadow: var(--shadow-md);
  }
  .map-info-card {
    background: #fff;
    border: 1px solid var(--cream-300);
    border-radius: 12px;
    padding: 1.5rem 1.25rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }
  .map-info-location {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--ink-900);
    margin: 0 0 0.75rem;
    line-height: 1.25;
  }
  .map-info-link {
    display: inline-block;
    color: var(--green-300);
    font-weight: 600;
    text-decoration: underline;
    font-size: 0.9rem;
  }
  @media (max-width: 700px) {
    #local-map {
      grid-template-columns: 1fr;
    }
    #local-map iframe {
      min-height: 280px;
    }
  }

  /* ════════════════════════════════════════════════════════════════
     EXPLAINER  (What Is / Concierge-Style)  ─ white
     ════════════════════════════════════════════════════════════════ */
  .section-explainer {
    background: #ffffff;
  }
  .section-explainer .lp-container { max-width: 820px; }
  .section-explainer h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    color: var(--ink-900);
    padding-left: 1rem;
    border-left: 4px solid var(--green-300);
    margin-bottom: 1.25rem;
    line-height: 1.25;
  }
  .section-explainer p {
    color: var(--ink-700);
    line-height: 1.75;
    margin-bottom: 1rem;
  }
  .section-explainer p:last-child { margin-bottom: 0; }
  .section-explainer a {
    color: var(--green-300);
    font-weight: 600;
    text-decoration: underline;
  }
  .section-explainer strong { color: var(--ink-900); }

  /* ════════════════════════════════════════════════════════════════
     WHY SECTION  ─ cream
     ════════════════════════════════════════════════════════════════ */
  .section-why {
    background: var(--cream-200);
  }
  .section-why .lp-container { max-width: 820px; }
  .section-why h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.5rem, 3.5vw, 2.2rem);
    color: var(--ink-900);
    margin-bottom: 1.5rem;
    line-height: 1.25;
  }
  .section-why ul {
    list-style: none;
    padding: 0;
