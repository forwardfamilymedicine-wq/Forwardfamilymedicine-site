---
import MainLayout from '../layouts/MainLayout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ProblemSection from '../components/home/ProblemSection.astro';
import DifferenceSection from '../components/home/DifferenceSection.astro';
import TeamTeaser from '../components/home/TeamTeaser.astro';
import CareExperience from '../components/home/CareExperience.astro';
import LifestyleMedTeaser from '../components/home/LifestyleMedTeaser.astro';
import ProofSection from '../components/home/ProofSection.astro';
import MembershipHowItWorks from '../components/home/MembershipHowItWorks.astro';
import PricingSection from '../components/home/PricingSection.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import CTABanner from '../components/shared/CTABanner.astro';

// Ordered objections first — insurance, insurance-substitution, payment — before
// the definitional questions. Someone who has already decided to read this far
// is weighing a reason not to join, not looking for a definition of DPC.
const faqs = [
  {
    q: 'Do you accept insurance?',
    a: 'We do not bill insurance. Our membership model is precisely what allows us to keep our patient panel capped at ~250 patients per physician and spend real time with each patient. No insurance means no compromises.',
  },
  {
    q: 'Is this the same as insurance?',
    a: 'No. Direct Primary Care covers your day-to-day primary care needs. We recommend pairing it with a high-deductible health plan for hospital stays, surgeries, and specialist care.',
  },
  {
    q: 'Can I use my HSA or FSA?',
    a: 'In many cases, yes — especially following the Primary Care Enhancement Act (effective January 1, 2026), which clarified that HSA funds can be used for DPC memberships. Confirm eligibility with your plan administrator.',
  },
  {
    q: 'What is Direct Primary Care?',
    a: 'DPC is a membership model where you pay a flat monthly fee directly to your doctor — no insurance involved. You get unlimited primary care access, longer appointments, same-day availability, and a genuine care relationship. Think of it as your primary care doctor, always available, always on your side.',
  },
  {
    q: 'What is Lifestyle Medicine and is it included?',
    a: "Lifestyle medicine is an evidence-based specialty using therapeutic changes in nutrition, activity, sleep, and stress to prevent, treat, and even reverse chronic disease. Dr. Lieberman is board-certified in it — and it's fully integrated into your membership. No extra fee.",
  },
  {
    q: 'Do I need the Clarity Program to get great care here?',
    a: 'No. Standard membership is the practice\'s foundation — long visits, same-day access, direct physician contact, and Lifestyle Medicine are all included. The Clarity Program is an optional, separate annual program for members who want a structured year-long diagnostic and prevention system on top of their membership. Most members do not enroll in Clarity, and the standard of care is the same either way.',
  },
  {
    q: 'How do I get started?',
    a: 'Schedule a free, no-obligation meet and greet. Come in, meet our physicians, see the office, and ask everything. No commitment required. Fill out the form on our contact page or call (215) 645-7044.',
  },
];

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" }
  ]
};
---

<MainLayout
  title="Direct Primary Care Wayne PA | Forward Family Medicine"
  description="One to two hour visits, your doctor's direct number, and panels capped near 250 patients. Membership primary care in Wayne, PA, Lifestyle Medicine included."
  canonical="https://www.forwardfamilymedicine.com/"
  schema={breadcrumb}
>
  <!-- 1 Hero — the desired experience -->
  <HeroSection />

  <!-- 2 The problem -->
  <ProblemSection />

  <!-- 3 The FFM difference -->
  <DifferenceSection />

  <!-- 4 Meet your doctor — availability-led; target of the hero's secondary CTA -->
  <div id="meet-your-doctor" class="anchor-target">
    <TeamTeaser />
  </div>

  <!-- 5 What care feels like -->
  <CareExperience />

  <!-- 6 Beyond traditional primary care -->
  <LifestyleMedTeaser />

  <!-- 7 Proof -->
  <ProofSection />

  <!-- 8 How membership works -->
  <MembershipHowItWorks />

  <!-- 9 Pricing -->
  <PricingSection />

  <!-- Clarity Program teaser — deliberately below pricing so it does not
       introduce a second, larger number before the membership price. -->
  <section class="clarity-teaser-section">
    <div class="clarity-teaser-container">
      <p class="clarity-teaser-eyebrow">For Members Who Want to Go Deeper</p>
      <h2 class="clarity-teaser-h2">The Clarity Program</h2>
      <p class="clarity-teaser-body">Some of our members want more than excellent primary care — they want a structured, year-long diagnostic program built around prevention: whole-body imaging, advanced biomarkers, continuous metabolic and performance data, all read by a physician who tracks how everything moves over time.</p>
      <p class="clarity-teaser-body">We built The Clarity Program for those members. It's an optional, separate program — not a required upgrade, and not the standard of care here. Standard membership remains the foundation, and it remains complete on its own.</p>
      <a href="/clarity/" class="clarity-teaser-link">Learn about the Clarity Program →</a>
    </div>
  </section>

  <!-- 10 FAQ — objections first -->
  <FAQSection faqs={faqs} />

  <!-- 11 Final CTA — homepage-specific props; the component's defaults are
       shared with eight other routes and must not be edited here. -->
  <CTABanner
    headline="Start with a conversation, not a commitment."
    subhead="A free meet and greet is exactly what it sounds like. Come in, meet the physician taking new patients, see the office, and ask every question you have. Nothing is signed that day."
    btnText="Schedule My Free Meet & Greet"
    btnHref="/contact"
    btn2Text="See membership details"
    btn2Href="/membership"
  />
</MainLayout>

<style>
  /* The header is sticky, so an in-page anchor needs clearance or the section
     heading lands underneath it. */
  .anchor-target {
    scroll-margin-top: 120px;
  }

  /* Clarity teaser */
  .clarity-teaser-section {
    background: var(--cream-100);
    padding: calc(var(--section-pad) * 0.5) 0;
  }
  .clarity-teaser-container {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 clamp(20px, 5vw, 48px);
    text-align: center;
  }
  .clarity-teaser-eyebrow {
    font-size: 0.625rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--green-500);
    margin: 0 0 0.65rem;
  }
  .clarity-teaser-h2 {
    font-family: var(--font-heading);
    font-size: clamp(1.35rem, 2.5vw, 1.75rem);
    font-weight: 300;
    color: var(--ink-900);
    margin: 0 0 1.25rem;
    line-height: 1.25;
  }
  .clarity-teaser-body {
    font-size: 0.95rem;
    font-weight: 300;
    line-height: 1.75;
    color: var(--ink-500);
    max-width: 540px;
    margin: 0 auto 0.85rem;
  }
  .clarity-teaser-link {
    display: inline-block;
    margin-top: 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--green-500);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: transparent;
    transition: text-decoration-color 0.2s, color 0.15s;
  }
  .clarity-teaser-link:hover {
    color: #3D6B55;
    text-decoration-color: currentColor;
  }
</style>
