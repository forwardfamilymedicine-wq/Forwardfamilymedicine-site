---
import MainLayout from '../layouts/MainLayout.astro';
import FAQSection from '../components/shared/FAQSection.astro';
import CTABanner from '../components/shared/CTABanner.astro';
import ServiceHero from '../components/shared/ServiceHero.astro';
import StatsBand from '../components/shared/StatsBand.astro';
import RuledList from '../components/shared/RuledList.astro';
import TitledGrid from '../components/shared/TitledGrid.astro';
import SageCard from '../components/shared/SageCard.astro';
import { Picture } from 'astro:assets';
import creamChairs from '../assets/office/wayne-cream-chairs.jpg';
import windowChairs from '../assets/office/wayne-window-chairs.jpg';

const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.forwardfamilymedicine.com" },
    { "@type": "ListItem", "position": 2, "name": "Services", "item": "https://www.forwardfamilymedicine.com/services/" }
  ]
};

const faqs = [
  {
    q: 'Do I need insurance to be a patient?',
    a: 'No. Our DPC membership covers your primary care needs directly — no insurance required. We recommend pairing it with a high-deductible health plan or health sharing plan for hospitalizations and specialist care.',
  },
  {
    q: 'What does a DPC membership actually include?',
    a: 'Unlimited office visits with no copay, same-day and next-day appointments, visits of 1–2 hours, direct phone/text/email access to your doctor, preventive care, chronic disease management, minor in-office procedures, wholesale lab pricing, telehealth, and specialist referral coordination.',
  },
  {
    q: 'Is Lifestyle Medicine a separate service or add-on?',
    a: "Lifestyle medicine is fully integrated into Dr. Lieberman's practice — not a separate fee or add-on. It's part of what your membership covers. Dr. Lieberman is dual board-certified in Family Medicine and Lifestyle Medicine.",
  },
  {
    q: 'What is Concierge Medicine vs DPC?',
    a: 'At Forward Family Medicine, there is no separate concierge tier. Every member receives the full concierge experience — small panel, direct doctor access, unhurried visits — through the DPC membership. It is the standard, not an upgrade.',
  },
];

const stats = [
  { label: 'Forward Family Medicine', value: '1–2 hr', caption: 'visits' },
  { label: 'Traditional care', value: '7 min', caption: 'visits', muted: true },
  { label: 'Forward Family Medicine', value: '~250', caption: 'patients per doctor' },
  { label: 'Traditional care', value: '2,000–3,000', caption: 'patients per doctor', muted: true },
];

const dpcIncluded = [
  'Unlimited office visits — no copay, no per-visit fees',
  'Same-day and next-day appointments',
  'Visits: 1–2 hours',
  'Direct access to your doctor: phone, text, and email',
  'Preventive care and annual wellness exams',
  'Chronic disease management (diabetes, hypertension, thyroid, etc.)',
  'Minor in-office procedures',
  'Wholesale lab and medication pricing',
  'Telehealth visits included',
  'Specialist referral coordination',
  'Integrated Lifestyle Medicine (with Dr. Lieberman)',
];

const lmList = [
  'Comprehensive lifestyle assessment',
  'Personalized nutrition guidance — culinary-informed, practical',
  'Physical activity planning',
  'Sleep optimization protocols',
  'Stress and mental wellness support',
  'Evidence-based protocols for diabetes, hypertension, heart health, obesity',
  'Ongoing accountability built into your membership',
];

const menoList = [
  'Comprehensive perimenopause and menopause symptom assessment',
  'HRT consultation — evidence-based, individualized to your history',
  'Bone health monitoring and osteoporosis risk reduction',
  'Cardiovascular risk management tailored to midlife hormonal shifts',
  'Menopause Society Certified Practitioner credentialing',
  'Integrated with your DPC membership — no separate referral',
  'Malvern location, with a West Chester location planned',
];

const wcItems = [
  { title: 'Physician-vetted', body: 'Every partner is individually reviewed — not sourced from a database.' },
  { title: 'Priority access', body: 'Collective partners reserve availability for FFM members.' },
  { title: 'Coordinated care', body: 'Your physician communicates directly with every referral partner.' },
  { title: 'Member pricing', body: 'Many partners offer preferred rates exclusively for our members.' },
];

const clItems = [
  { title: 'Whole-body imaging', body: 'Annual Prenuvo MRI, DEXA twice yearly, and coronary calcium scoring on the right cadence.' },
  { title: 'Advanced biomarkers', body: 'Three physician-curated lab panels per year — built around what changes management.' },
  { title: 'Performance metrics', body: 'VO₂ max, body composition, and continuous glucose data integrated into your plan.' },
  { title: 'Physician-led synthesis', body: 'Every result is interpreted by your physician — not handed back as raw data.' },
];

---

<MainLayout
  title="DPC + Lifestyle Medicine Services | Forward Family Medicine Wayne PA"
  description="Direct Primary Care, board-certified Lifestyle Medicine, and Concierge Medicine in Wayne PA. Flat monthly membership. No insurance. Serving the Main Line and Chester County."
  schema={[breadcrumb]}
>
  <ServiceHero
    title="Services Designed Around You, Not Your Insurance"
    image={creamChairs}
    alt="Two cream armchairs beneath an abstract painting in the Wayne office"
    aspect="5/4"
    position="50% 60%"
  >
    <nav slot="before" class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">›</span> <span>Services</span>
    </nav>
    <p slot="lede">
      At Forward Family Medicine, every membership includes three things at once: the financial
      transparency of Direct Primary Care, the personal attention of concierge medicine, and the
      clinical depth of board-certified Lifestyle Medicine. These aren't separate services or tiers.
      They're three dimensions of the same practice — and every member gets all three.
    </p>
  </ServiceHero>

  <StatsBand heading="DPC vs. Traditional Care" stats={stats} foot="10× fewer patients per doctor" size={52} />

  <!-- DPC -->
  <section class="rd-section" id="dpc">
    <div class="rd-wrap rd-split rd-split--c">
      <div class="rd-stack">
        <h2 class="rd-h2">Direct Primary Care</h2>
        <p class="rd-copy">
          Direct Primary Care is the financial model that makes everything else possible. No
          insurance billing. No copays. No per-visit fees. Your membership covers unlimited
          primary care, and because we don't bill insurance, our overhead is low — which means
          we can pass real savings to you. Labs at wholesale. Medications at cost. Same-day
          access that keeps you out of urgent care. This is primary care that is actively trying
          to lower what healthcare costs you.
        </p>
        <p class="rd-copy">
          At Forward Family Medicine, your DPC membership means unlimited primary care with
          no copay, same-day appointments, and direct access to your doctor via phone, text,
          or email. Not through a nurse line. Your doctor.
        </p>
        <h3 class="rd-h3 incl-h3">What's Included</h3>
        <RuledList size="sm" reveal class="dpc-list">
          {dpcIncluded.map(i => <li>{i}</li>)}
        </RuledList>
        <p class="important"><strong>Important:</strong> DPC membership is not insurance. It covers your
          day-to-day primary care. We recommend pairing it with a high-deductible health
          plan or health sharing plan for hospitalizations, surgeries, and specialist care.</p>
        <div class="ctas">
          <a href="/membership/" class="btn-forest">See Membership Options</a>
          <a href="/contact/?source=services" class="btn-ghost">Schedule a Free Meet &amp; Greet</a>
        </div>
      </div>
      <div class="rd-stack rd-sticky aside">
        <SageCard>
          <p class="rd-eyebrow">Lifestyle Medicine Included</p>
          <p class="rd-lede">Every DPC membership includes access to Dr. Lieberman's Lifestyle Medicine practice. Nutrition, movement, sleep, and stress — treated as medicine.</p>
          <a href="/lifestyle-medicine/" class="rd-link aside-link">Learn More →</a>
        </SageCard>
        <Picture
          src={windowChairs}
          alt="Two green armchairs by a sunlit window in the Wayne office"
          widths={[400, 640, 800]}
          sizes="(max-width: 860px) calc(100vw - 40px), 420px"
          formats={['avif', 'webp']}
          loading="lazy"
          class="aside-img"
          style="aspect-ratio:4/5;object-position:60% 50%"
        />
      </div>
    </div>
  </section>

  <!-- Lifestyle Medicine -->
  <section class="rd-section rd-alt" id="lifestyle-medicine">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">Lifestyle Medicine</h2>
        <p class="rd-copy">
          Forward Family Medicine is the only DPC practice on the Main Line offering
          in-person, board-certified Lifestyle Medicine. Dr. Lieberman is dual board-certified
          in Family Medicine and Lifestyle Medicine, with pre-medical training in culinary
          arts and nutrition science.
        </p>
        <p class="rd-copy">
          Lifestyle medicine treats chronic disease at its root — through evidence-based
          changes in nutrition, physical activity, sleep, stress management, and social
          connection. At FFM, it's not a handout at the end of your visit. It's integrated
          into how we practice.
        </p>
        <a href="/lifestyle-medicine/" class="btn-forest self-start">View Full Lifestyle Medicine Page →</a>
      </div>
      <RuledList size="sm" reveal class="svc-rows">
        {lmList.map(i => <li>{i}</li>)}
      </RuledList>
    </div>
  </section>

  <!-- Menopause Care -->
  <section class="rd-section" id="menopause-care">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <h2 class="rd-h2">Menopause Care</h2>
        <p class="rd-copy">
          Comprehensive perimenopause and menopause care from Dr. Brian Landi, DO — a Menopause
          Society Certified Practitioner. Symptom assessment, HRT consultation, and integrated
          cardiovascular and bone health risk management, all within your DPC membership.
        </p>
        <p class="rd-copy">
          Dr. Landi is accepting new patients now at our Malvern office. A West Chester office is planned.
          No referral required — menopause care is built into your primary care relationship, not
          siloed into a specialist appointment.
        </p>
        <a href="/menopause/" class="btn-forest self-start">View Full Menopause Care Page →</a>
      </div>
      <RuledList size="sm" reveal class="svc-rows">
        {menoList.map(i => <li>{i}</li>)}
      </RuledList>
    </div>
  </section>

  <!-- Concierge -->
  <section class="rd-section rd-alt" id="concierge">
    <div class="rd-wrap rd-split rd-split--a">
      <h2 class="rd-h2">Concierge Medicine</h2>
      <div class="rd-stack">
        <p class="rd-lede conc-lede">
          There is no separate concierge tier at Forward Family Medicine. Every member receives
          what the industry calls a concierge experience — a physician whose panel is capped at
          250 patients, who picks up the phone, who runs 1–2 hour visits, and who
          follows up without being asked. This is not a premium add-on. It is the standard.
        </p>
        <a href="/concierge-medicine/" class="rd-link self-start">Learn more about the concierge experience at FFM →</a>
      </div>
    </div>
  </section>

  <!-- Wellness Collective teaser -->
  <section class="rd-section">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <p class="rd-eyebrow">Included in every membership</p>
        <h2 class="rd-h2">Care that extends beyond our office.</h2>
        <p class="rd-copy">
          Membership at Forward Family Medicine includes access to the
          Main Line Wellness Collective — a curated network of best-in-class
          local providers across physical therapy, nutrition, fitness, mental
          health, dermatology, sleep medicine, and more.
        </p>
        <p class="rd-copy">
          Every provider has been personally vetted by your physician. When
          you need a referral, we match you, make the connection, and
          coordinate your care — so nothing falls through the cracks.
        </p>
        <a href="/wellness-collective/" class="rd-link self-start">See the full Collective →</a>
      </div>
      <TitledGrid columns={2} reveal items={wcItems} />
    </div>
  </section>

  <!-- Clarity teaser -->
  <section class="rd-section rd-alt">
    <div class="rd-wrap rd-split rd-split--a">
      <div class="rd-stack rd-sticky">
        <p class="rd-eyebrow rd-eyebrow--gold">Premium executive health program</p>
        <h2 class="rd-h2">An operating system for your health.</h2>
        <p class="rd-copy">
          Clarity is our integrated executive health program — built for members who want the full picture. It combines whole-body imaging, advanced biomarker testing, fitness and body composition analysis, and longitudinal physician guidance into a single, coordinated program.
        </p>
        <p class="rd-copy">
          Where most executive physicals end with a thick PDF and a handshake, Clarity is a year-round relationship. We measure what matters, track it over time, and translate every result into action.
        </p>
        <a href="/clarity/" class="rd-link self-start">Explore the Clarity Program →</a>
      </div>
      <TitledGrid columns={2} reveal items={clItems} />
    </div>
  </section>

  <FAQSection faqs={faqs} headline="Questions About Our Services" />
  <CTABanner ch={16} btnHref="/contact/?source=services" />
</MainLayout>

<style>
  .crumbs { font-size: 13px; color: var(--text-600); margin-bottom: 18px; }
  .crumbs a { color: var(--text-600); }
  .crumbs a:hover { color: var(--forest); }
  .crumbs span:last-child { color: var(--text-700); }
  .self-start { align-self: flex-start; }
  /* Board rows are 14px padding (about 53px for one line), not the lg 26px. */
  :global(.ruled-list.ruled-list--sm.svc-rows > li) { padding: 14px 0; font-size: 15px; line-height: 1.6; }
  .incl-h3 { font-size: 24px; margin-top: 16px; }
  .rd-stack :global(.dpc-list) { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 32px; }
  .rd-stack :global(.dpc-list) > :global(li) { font-size: 14px; color: var(--text-900); }
  .rd-stack :global(.dpc-list) > :global(li:nth-last-child(2):nth-child(odd)) { border-bottom: 0; }
  .important {
    margin: 8px 0 0;
    padding: 16px 20px;
    border-top: 2px solid var(--gold);
    background: var(--linen-50);
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-700);
  }
  .important strong { color: var(--forest); }
  .ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }
  .aside { gap: 24px; }
  .aside-link { align-self: flex-start; }
  .aside :global(.aside-img) { display: block; width: 100%; height: auto; object-fit: cover; border-radius: 2px; }
  .conc-lede { font-size: 24px; line-height: 1.45; }
  @media (max-width: 860px) {
    .rd-stack :global(.dpc-list) { grid-template-columns: 1fr; }
    .conc-lede { font-size: 20px; }
  }
</style>
