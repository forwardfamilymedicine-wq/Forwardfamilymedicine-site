---
/**
 * A blog post: resolves the byline, the author's portrait and bio link, the
 * og:image and Article structured data, and the related-reading rail, then
 * renders the shared article template (ArticleLayout, boards Post and Post2).
 */
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import ArticleLayout from './ArticleLayout.astro';
import type { ArticleHeading } from './ArticleLayout.astro';
import { authorSlug } from '../utils/authors';
import { blogCategoryLabel } from '../data/blogCategories';
import { blogRelated, postSlug } from '../utils/related';
import { contactHrefForPath } from '../utils/leadSource';

export interface Props {
  entry: CollectionEntry<'blog'>;
  headings: ArticleHeading[];
  readingTime?: number;
}

const { entry, headings, readingTime } = Astro.props;
const { title, description, category } = entry.data;
const author = entry.data.author ?? 'Forward Family Medicine';
const date = entry.data.date ?? new Date().toISOString();
const featuredImage = entry.data.image;
const slug = postSlug(entry);
const categoryLabel = blogCategoryLabel(category);

const authorDisplay: Record<string, string> = {
  'Dr. Philip Lieberman': 'Dr. Philip Lieberman, MD — Board-Certified Family Medicine & Lifestyle Medicine',
  'Dr. David Bigley': 'Dr. David Bigley, DO — Board-Certified Family Medicine',
  'David Bigley, DO': 'Dr. David Bigley, DO — Board-Certified Family Medicine',
  'Dr. Brian Landi': 'Dr. Brian Landi, DO — Board-Certified Family Medicine & Menopause Society Certified Practitioner',
  'Brian Landi, DO': 'Dr. Brian Landi, DO — Board-Certified Family Medicine & Menopause Society Certified Practitioner',
};
const authorLabel = authorDisplay[author] ?? author;

const siteUrl = 'https://www.forwardfamilymedicine.com';
const canonicalUrl = `${siteUrl}/blog/${slug}/`;
// og:image and the Article image: an absolute URL to a 1200px-wide JPEG at the
// image's own aspect ratio (never cropped here), declared at its real size.
const og = featuredImage ? await getImage({ src: featuredImage, width: 1200, format: 'jpg', quality: 82 }) : null;
const ogImage = og ? `${siteUrl}${og.src}` : `${siteUrl}/images/og-image.png`;
const ogImageWidth = og ? Number(og.attributes.width) : 1200;
const ogImageHeight = og ? Number(og.attributes.height) : 630;

// The author's bio and portrait, when the author is one of our physicians.
const providers = await getCollection('providers');
const authorBioSlug = authorSlug(author);
const authorProvider = authorBioSlug ? providers.find(p => p.data.slug === authorBioSlug) : undefined;

const dateObj = new Date(date);
// A bare frontmatter date is a calendar date; UTC keeps it from rendering a day early in US time zones.
const dateFormatted = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const dateISO = dateObj.toISOString();

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "author": {
    "@type": "Person",
    "name": author,
    ...(authorBioSlug ? { "url": `${siteUrl}/meet-the-team/${authorBioSlug}/` } : {})
  },
  "datePublished": dateISO,
  "image": ogImage,
  "publisher": {
    "@type": "Organization",
    "name": "Forward Family Medicine",
    "url": siteUrl
  },
  "url": canonicalUrl
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Home", "item": siteUrl },
    { "@type": "ListItem", "position": 2, "name": "Blog", "item": `${siteUrl}/blog/` },
    { "@type": "ListItem", "position": 3, "name": title, "item": canonicalUrl }
  ]
};

const related = blogRelated({
  entry,
  posts: await getCollection('blog'),
  providers,
  library: await getCollection('lifestyle'),
});
---

<ArticleLayout
  title={title}
  pageTitle={`${title} | Forward Family Medicine`}
  description={description}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogImageWidth={ogImageWidth}
  ogImageHeight={ogImageHeight}
  ogType="article"
  schema={[articleSchema, breadcrumbSchema]}
  crumbs={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog/' }, { label: title }]}
  category={categoryLabel && category ? { label: categoryLabel, href: `/blog/category/${category}/` } : undefined}
  author={{
    label: authorLabel,
    href: authorBioSlug ? `/meet-the-team/${authorBioSlug}/` : undefined,
    photo: authorProvider?.data.photo,
    photoAlt: authorProvider?.data.photoAlt,
  }}
  authorKey={author}
  dateISO={dateISO}
  dateFormatted={dateFormatted}
  readingTime={readingTime}
  heroImage={featuredImage}
  heroAlt={entry.data.imageAlt ?? ''}
  headings={headings}
  related={related}
  contactHref={contactHrefForPath(`/blog/${slug}/`)}
  closing={{
    headline: 'Ready to experience medicine the way it should be?',
    subhead: 'Schedule a free, no-obligation meet and greet with one of our physicians. No pressure, no commitment — just a conversation.',
    btnText: 'Schedule a Free Meet & Greet',
  }}
>
  <slot />
</ArticleLayout>
