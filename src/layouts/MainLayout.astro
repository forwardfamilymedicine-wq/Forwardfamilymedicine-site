---
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import { sitePracticeGraph } from '../utils/practiceSchema';
import '../styles/global.css';

export interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  schema?: object | object[];
  noindex?: boolean;
  suppressOrgSchema?: boolean;
}

const {
  title,
  description,
  canonical,
  ogImage = 'https://www.forwardfamilymedicine.com/images/og-image.png',
  ogType = 'website',
  schema,
  noindex = false,
  suppressOrgSchema = false,
} = Astro.props;

const siteUrl = 'https://www.forwardfamilymedicine.com';
const canonicalUrl = canonical || `${siteUrl}${Astro.url.pathname}`;

// The practice and its open offices, built from the locations collection.
const orgSchema = await sitePracticeGraph();

const schemas = [
  ...(suppressOrgSchema ? [] : [orgSchema]),
  ...(Array.isArray(schema) ? schema : schema ? [schema] : []),
];
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta http-equiv="X-Content-Type-Options" content="nosniff" />
  <meta http-equiv="Referrer-Policy" content="strict-origin-when-cross-origin" />
  <meta http-equiv="Permissions-Policy" content="camera=(), microphone=(), geolocation=()" />

  <!-- Primary Meta -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalUrl} />
  {noindex && <meta name="robots" content="noindex, follow" />}

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:site_name" content="Forward Family Medicine" />
  <meta property="og:locale" content="en_US" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- JSON-LD Schema -->
  {schemas.map(s => (
    <script type="application/ld+json" set:html={JSON.stringify(s)} />
  ))}
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main-content">
    <slot />
  </main>
  <Footer />
  <ConsentBanner />
  <script is:inline>
    // Single delegated listener covers every SigmaMD enrollment link
    // site-wide (Header, membership, contact, new-patients) without
    // instrumenting each page individually.
    document.addEventListener('click', function (e) {
      var link = e.target.closest('a[href*="sigmamd.com/signup"]');
      if (!link) return;
      var plan = link.href.indexOf('/family-membership') !== -1
        ? 'family'
        : link.href.indexOf('/individual-membership') !== -1
          ? 'individual'
          : 'unknown';
      if (window.ffmTrack) {
        window.ffmTrack('outbound_enrollment_click', { plan });
      }
    });
  </script>
</body>
</html>
