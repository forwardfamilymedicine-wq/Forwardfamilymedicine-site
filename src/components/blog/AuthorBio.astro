---
/**
 * Author card at the foot of an article, per the article boards: a small 4:5
 * portrait beside "About the author", the serif name, title, a sentence and
 * the bio link. Profile copy is unchanged from before the redesign.
 */
import { Image } from 'astro:assets';
import drBigleyPhoto from '../../assets/staff/dr-david-bigley.jpg';
import drLiebermanPhoto from '../../assets/staff/dr-philip-lieberman.jpg';
import drLandiPhoto from '../../assets/staff/dr-brian-landi.jpg';
import { authorSlug } from '../../utils/authors';

export interface Props {
  author?: string;
}

const { author } = Astro.props;

// Keyed by the physician's slug; utils/authors.ts maps frontmatter author
// strings (and their aliases) to it.
const AUTHOR_PROFILES = {
  'david-bigley-do': {
    photo: drBigleyPhoto,
    photoAlt: 'Dr. David Bigley, DO — Founder & Physician, Forward Family Medicine',
    name: 'David Bigley, DO',
    title: 'Founder & Physician, Forward Family Medicine',
    desc: 'Dr. Bigley founded Forward Family Medicine to practice medicine the way it was meant to be — with time, trust, and a genuine relationship with every patient.',
    href: '/meet-the-team/david-bigley-do/',
  },
  'philip-lieberman-md': {
    photo: drLiebermanPhoto,
    photoAlt: 'Dr. Philip Lieberman, MD — Family Medicine & Lifestyle Medicine, Forward Family Medicine',
    name: 'Philip Lieberman, MD',
    title: 'Physician, Forward Family Medicine',
    desc: 'Dr. Lieberman is dual board-certified in Family Medicine and Lifestyle Medicine, with pre-medical training in nutrition and culinary arts. He helps patients use food, movement, sleep, and stress management to prevent and treat chronic disease.',
    href: '/meet-the-team/philip-lieberman-md/',
  },
  'brian-landi-do': {
    photo: drLandiPhoto,
    photoAlt: 'Dr. Brian Landi, DO — Family Medicine & Menopause Care, Forward Family Medicine',
    name: 'Brian Landi, DO',
    title: 'Physician, Forward Family Medicine',
    desc: 'Dr. Landi is a board-certified family physician and a Menopause Society Certified Practitioner. He cares for patients at our Malvern office, with a clinical focus on perimenopause, menopause, and midlife health.',
    href: '/meet-the-team/brian-landi-do/',
  },
};

// Unknown or absent author (for example the practice-authored lifestyle
// library, written as "Forward Family Medicine") falls back to Dr. Lieberman,
// whose Lifestyle Medicine board certification matches that material.
const profileKey = authorSlug(author) ?? 'philip-lieberman-md';
const profile = AUTHOR_PROFILES[profileKey as keyof typeof AUTHOR_PROFILES];
---

<aside class="author-bio" aria-label="About the author">
  <Image
    src={profile.photo}
    alt={profile.photoAlt}
    class="author-photo"
    width={176}
    height={220}
    widths={[88, 176, 264]}
    sizes="88px"
    format="webp"
    quality={82}
    loading="lazy"
  />
  <div class="author-bio-text">
    <p class="author-bio-label">About the author</p>
    <p class="author-bio-name rd-serif">{profile.name}</p>
    <p class="author-bio-title">{profile.title}</p>
    <p class="author-bio-desc">{profile.desc}</p>
    <a href={profile.href} class="rd-link author-bio-link">Read full bio →</a>
  </div>
</aside>

<style>
  .author-bio {
    margin-top: 48px;
    padding: 28px 30px;
    background: var(--linen);
    border-top: 3px solid var(--forest);
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: 22px;
    align-items: start;
  }
  .author-bio :global(.author-photo) {
    display: block;
    width: 88px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 2px;
  }
  .author-bio-text { display: flex; flex-direction: column; gap: 8px; }
  .author-bio-text p { margin: 0 !important; }
  .author-bio-label { font-size: 13px !important; line-height: 1.5 !important; color: var(--text-600) !important; }
  .author-bio-name { font-size: 24px !important; line-height: 1.15 !important; color: var(--forest) !important; }
  .author-bio-title { font-size: 14px !important; line-height: 1.5 !important; font-weight: 500; color: var(--sage-600) !important; }
  .author-bio-desc { margin-top: 6px !important; font-size: 15px !important; line-height: 1.7 !important; color: var(--text-700) !important; }
  .author-bio-link { align-self: flex-start; }
  @media (max-width: 480px) {
    .author-bio { grid-template-columns: 1fr; padding: 24px 22px; }
  }
</style>
