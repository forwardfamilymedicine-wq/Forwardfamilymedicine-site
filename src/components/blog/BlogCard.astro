---
/**
 * A post in the blog index grid, per the Blog board: a ruled text item with
 * the category link, serif title, description and "author · date". The
 * category and title keep the same two hrefs as before. `hidden` marks an
 * item past the first page of the index ("Load more articles" reveals it).
 */
import type { ImageMetadata } from 'astro';
import { blogCategoryLabel } from '../../data/blogCategories';

export interface Props {
  title: string;
  description: string;
  author: string;
  date: string;
  slug: string;
  category?: string;
  /** Accepted for existing callers; the index grid is text-only now. */
  featuredImage?: ImageMetadata;
  priority?: boolean;
  hidden?: boolean;
}

const { title, description, author, date, slug, category, hidden = false } = Astro.props;
const categoryLabel = blogCategoryLabel(category);

const dateObj = new Date(date);
// A bare frontmatter date is a calendar date; UTC keeps it from rendering a day early in US time zones.
const dateFormatted = dateObj.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' });
const dateISO = dateObj.toISOString();
---

<article class="post-item" hidden={hidden || undefined}>
  {categoryLabel && <a href={`/blog/category/${category}/`} class="post-item__cat">{categoryLabel}</a>}
  <h3 class="post-item__title rd-serif"><a href={`/blog/${slug}/`}>{title}</a></h3>
  <p class="post-item__desc">{description}</p>
  <p class="post-item__meta">
    <span>{author}</span>
    <span class="post-item__dot" aria-hidden="true">·</span>
    <time datetime={dateISO}>{dateFormatted}</time>
  </p>
</article>

<style>
  .post-item {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 26px 0;
    border-top: 1px solid var(--hairline-strong);
    color: var(--forest);
    opacity: 0;
    transform: translateX(22px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .post-item[hidden] { display: none; }
  :global(.on) > .post-item { opacity: 1; transform: none; }
  :global(.on) > .post-item:nth-child(1) { transition-delay: 0.1s; }
  :global(.on) > .post-item:nth-child(2) { transition-delay: 0.22s; }
  :global(.on) > .post-item:nth-child(3) { transition-delay: 0.34s; }
  :global(.on) > .post-item:nth-child(4) { transition-delay: 0.46s; }
  :global(.on) > .post-item:nth-child(5) { transition-delay: 0.58s; }
  :global(.on) > .post-item:nth-child(6) { transition-delay: 0.7s; }
  :global(.on) > .post-item:nth-child(7) { transition-delay: 0.82s; }
  :global(.on) > .post-item:nth-child(8) { transition-delay: 0.94s; }
  :global(.on) > .post-item:nth-child(9) { transition-delay: 1.06s; }
  :global(.on) > .post-item:nth-child(n+10) { transition-delay: 1.18s; }
  .post-item__cat { font-size: 13px; font-weight: 500; color: var(--sage-600); text-decoration: none; align-self: flex-start; }
  .post-item__cat:hover { color: var(--forest); }
  .post-item__title { margin: 0; font-size: 22px; line-height: 1.25; color: var(--forest); }
  .post-item__title a { color: inherit; text-decoration: none; transition: color 0.18s; }
  .post-item__title a:hover { color: var(--sage-600); }
  .post-item__desc { margin: 0; font-size: 14px; line-height: 1.65; color: var(--text-700); }
  .post-item__meta { margin: auto 0 0; padding-top: 8px; font-size: 13px; color: var(--text-600); }
  .post-item__dot { color: var(--hairline-dot); margin: 0 8px; }
</style>
