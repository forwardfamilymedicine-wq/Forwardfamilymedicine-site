---
// src/components/ConsentBanner.astro
//
// Opt-in analytics consent banner for Forward Family Medicine.
//
// BEHAVIOR (opt-in — stricter, PA-safer):
//   - No choice yet -> banner shows, NO trackers load.
//   - "Accept"      -> cookie set (1 year), GA4 loads now and on every page load.
//   - "Decline"     -> cookie set (1 year), trackers never load.
//   - "Manage choices" footer link (<a data-consent-reset>) re-opens the banner.
//   - Every choice is announced as a document event, ffm:consent, with
//     detail.choice "accepted", "declined" or "reset", for scripts that must
//     wait for it (src/components/Attribution.astro under Option B).
//
// CLARITY: not installed. Load path dormant unless CLARITY_ID is set.
// ATTORNEY ITEMS (flagged, not blocking): (a) opt-in vs opt-out for GA4 in PA —
// this does opt-in; (b) cookie lifetime (365 days).

const GA4_ID = "G-8Z3EP3H07B";
const CLARITY_ID = ""; // dormant — leave empty unless Clarity is added later
---

<div
  id="consent-banner"
  class="consent"
  hidden
  role="dialog"
  aria-live="polite"
  aria-label="Cookie and analytics consent"
>
  <div class="consent__inner">
    <p class="consent__text">
      We use analytics to understand how visitors use our site. These tools don't
      load unless you accept. See our <a href="/privacy-policy/">Privacy Policy</a>.
    </p>
    <div class="consent__actions">
      <button type="button" id="consent-decline" class="consent__btn consent__btn--ghost">
        Decline
      </button>
      <button type="button" id="consent-accept" class="consent__btn consent__btn--solid">
        Accept
      </button>
    </div>
  </div>
</div>

<script define:vars={{ GA4_ID, CLARITY_ID }}>
  (function () {
    var COOKIE = "ffm_consent";
    var banner = document.getElementById("consent-banner");
    var acceptBtn = document.getElementById("consent-accept");
    var declineBtn = document.getElementById("consent-decline");

    function getCookie(name) {
      var m = document.cookie.match(new RegExp("(?:^|; )" + name + "=([^;]*)"));
      return m ? decodeURIComponent(m[1]) : null;
    }

    function setCookie(name, value, days) {
      var d = new Date();
      d.setTime(d.getTime() + days * 24 * 60 * 60 * 1000);
      document.cookie =
        name + "=" + encodeURIComponent(value) + ";expires=" + d.toUTCString() +
        ";path=/;SameSite=Lax";
    }

    // Testing aid: ?ga_debug=1 turns on GA4 debug_mode for this browser
    // session (so DebugView shows the events), ?ga_debug=0 turns it off.
    // Does nothing unless the visitor has accepted analytics.
    function gaDebug() {
      try {
        var m = location.search.match(/[?&]ga_debug=([01])(?:&|$)/);
        if (m) sessionStorage.setItem("ffm_ga_debug", m[1]);
        return sessionStorage.getItem("ffm_ga_debug") === "1";
      } catch (e) {
        return /[?&]ga_debug=1(?:&|$)/.test(location.search);
      }
    }

    function loadGA4() {
      if (!GA4_ID) return;
      var s = document.createElement("script");
      s.async = true;
      s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA4_ID;
      document.head.appendChild(s);
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;
      gtag("js", new Date());
      gtag("config", GA4_ID, gaDebug() ? { debug_mode: true } : {});
    }

    function loadClarity() {
      if (!CLARITY_ID) return; // dormant unless a real ID is set
      (function (c, l, a, r, i, t, y) {
        c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
        t = l.createElement(r); t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", CLARITY_ID);
    }

    function loadTrackers() {
      loadGA4();
      loadClarity();
    }

    function hideBanner() { if (banner) banner.hidden = true; }
    function showBanner() { if (banner) banner.hidden = false; }
    function announce(choice) {
      try { document.dispatchEvent(new CustomEvent("ffm:consent", { detail: { choice: choice } })); } catch (e) {}
    }

    // Consent-safe, queue-safe event tracking.
    //
    // Lives here (not a separate script file) because this is the one place
    // that already knows, synchronously, both the consent state and the exact
    // moment gtag becomes ready — avoiding any cross-script load-order race.
    // ConsentBanner's script is is:inline and runs during initial page parse,
    // before any user interaction is possible, so window.ffmTrack is always
    // defined by the time a click/submit/focus handler elsewhere calls it.
    //
    // - Consent already accepted / gtag ready -> send immediately.
    // - Consent not yet decided (banner still showing) -> queue; flushed if
    //   the visitor accepts during this page view.
    // - Consent declined -> drop permanently, never queued, never retried.
    var trackQueue = [];

    function ffmTrack(eventName, params) {
      if (typeof window.gtag === "function") {
        window.gtag("event", eventName, params || {});
        return;
      }
      if (getCookie(COOKIE) === "declined") return;
      trackQueue.push([eventName, params || {}]);
    }

    function flushTrackQueue() {
      while (trackQueue.length) {
        var item = trackQueue.shift();
        if (typeof window.gtag === "function") {
          window.gtag("event", item[0], item[1]);
        }
      }
    }

    window.ffmTrack = ffmTrack;

    var choice = getCookie(COOKIE);
    if (choice === "accepted") {
      loadTrackers();
      flushTrackQueue();
      hideBanner();
    } else if (choice === "declined") {
      hideBanner();
    } else {
      showBanner();
    }

    if (acceptBtn) {
      acceptBtn.addEventListener("click", function () {
        setCookie(COOKIE, "accepted", 365);
        loadTrackers();
        flushTrackQueue();
        hideBanner();
        announce("accepted");
      });
    }
    if (declineBtn) {
      declineBtn.addEventListener("click", function () {
        setCookie(COOKIE, "declined", 365);
        hideBanner();
        announce("declined");
      });
    }

    document.addEventListener("click", function (e) {
      var t = e.target;
      if (t && t.closest && t.closest("[data-consent-reset]")) {
        e.preventDefault();
        document.cookie = COOKIE + "=;expires=Thu, 01 Jan 1970 00:00:00 GMT;path=/";
        showBanner();
        announce("reset");
      }
    });
  })();
</script>

<style>
  /* A compact full-width bar along the bottom edge. Fixed, so it never shifts
     the page; short, so it does not cover the hero's headline and buttons. */
  .consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 9999;
    background: var(--cream-50);
    border-top: 1px solid var(--green-200);
    box-shadow: 0 -4px 16px rgba(0, 0, 0, 0.10);
    padding: 0.625rem clamp(16px, 4vw, 40px) calc(0.625rem + env(safe-area-inset-bottom));
    max-height: 40vh;
    overflow-y: auto;
  }

  .consent__inner {
    display: flex;
    align-items: center;
    gap: 0.5rem 1.25rem;
    justify-content: space-between;
    max-width: var(--max-w);
    margin: 0 auto;
  }

  .consent__text {
    margin: 0;
    flex: 1 1 auto;
    color: var(--ink-900);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .consent__text a {
    color: var(--green-500);
    text-decoration: underline;
  }

  .consent__actions {
    display: flex;
    gap: 0.5rem;
    flex: 0 0 auto;
  }

  .consent__btn {
    font: inherit;
    font-size: 0.875rem;
    font-weight: 600;
    padding: 0.45rem 1rem;
    border-radius: 8px;
    cursor: pointer;
    border: 1px solid transparent;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  /* Accept: the site's CTA green. The former --green-400 fill was 4.09:1 against the white label. */
  .consent__btn--solid { background: var(--sage-600); color: #fff; }
  .consent__btn--solid:hover { background: var(--forest); }

  .consent__btn--ghost {
    background: transparent;
    color: var(--ink-700);
    border-color: var(--ink-300);
  }
  .consent__btn--ghost:hover { border-color: var(--ink-500); }

  .consent__btn:focus-visible {
    outline: 2px solid var(--green-500);
    outline-offset: 2px;
  }

  /* Phones: text above the buttons. The text's flex basis is auto here: a
     fixed basis in a column becomes a minimum height and leaves the bar tall
     and mostly empty. */
  @media (max-width: 640px) {
    .consent__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 0.5rem;
      justify-content: flex-start;
    }
    .consent__text { flex: 0 0 auto; font-size: 0.8125rem; }
    .consent__actions { justify-content: flex-end; }
  }

  @media (prefers-reduced-motion: reduce) {
    .consent__btn { transition: none; }
  }
</style>
