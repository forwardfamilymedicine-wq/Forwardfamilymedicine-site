---
/**
 * Landing-page footer, on forest (the same deep green as the email footer):
 * the light logo, the office the page sends people to (name, address, a
 * "Get directions" link, the phone number, the office hours when the
 * locations entry has them), the Privacy Policy link and "Manage Cookie
 * Choices" (ConsentBanner opens its dialog from [data-consent-reset]) and
 * "Visit our full website" (the homepage, with the lp_nav_click hook, label
 * "site"), then, under a hairline, the practice's standing copyright and
 * Direct Primary Care line. No other navigation, by decision. Every office
 * detail is the entry's location data, passed in by the route; nothing here
 * names an office.
 *
 * A page that sends people to more than one office (the two-physician
 * variant) passes every open office: each gets its name, address and
 * directions link, side by side at desktop and stacked on a phone; the phone
 * number and the hours are printed once when every office shares them, and
 * under each office otherwise. With one office the markup is as it was.
 *
 * Colours are tokens only: forest behind, linen for text and links (13:1),
 * sage for the quieter lines and the link rules (5.8:1), the 8% linen
 * hairline. On a phone everything stacks (logo, address, directions, the
 * phone number as a full-width tap target, hours, the two links, the legal
 * line) and the bottom padding leaves room for the consent bar.
 */
import { Image } from 'astro:assets';
import logoLight from '../../assets/logo/ffm-logo-light.png';
import { officePhone, hoursLines as collapseHours } from '../../utils/officeLines';

export interface FooterHours { day: string; open: string; close: string }
export interface FooterOffice {
  name: string;
  street: string;
  city: string;
  state: string;
  zip: string;
  /** The office's own number from the locations entry; the practice number when empty. */
  phone?: string;
  /** The office's directions link, built by the route from the same entry. */
  directionsUrl?: string;
  /** The entry's hours, in the entry's order; rendered only when present. */
  hours?: FooterHours[];
}
export interface Props {
  /** The offices the page sends people to, in order; at least one. */
  offices: FooterOffice[];
}
const { offices } = Astro.props;
if (offices.length === 0) throw new Error('[LpFooter] a landing page names at least one office.');
const year = new Date().getFullYear();

// The number and the hours as src/utils/officeLines.ts writes them (the
// offices block on a landing page uses the same helpers).
const phoneOf = (office: FooterOffice) => officePhone(office.phone);
const hoursLinesOf = (office: FooterOffice) => collapseHours(office.hours);

// One number and one set of hours for the whole footer when every office
// shares them (one office always does); otherwise each office prints its own.
const details = offices.map((o) => ({ office: o, phone: phoneOf(o), hoursLines: hoursLinesOf(o) }));
const shared = details.every((d) => d.phone.href === details[0].phone.href && d.hoursLines.join('|') === details[0].hoursLines.join('|'));
const phone = details[0].phone;
const hoursLines = details[0].hoursLines;
---

<footer class="lp-footer" role="contentinfo">
  <div class="rd-wrap">
    <div class="lp-footer__grid">
      <div class="lp-footer__office">
        <Image src={logoLight} alt="Forward Family Medicine" width={248} height={90} format="webp" quality={90} class="lp-footer__logo" />
        {details.length === 1 ? (
          <Fragment><address class="lp-footer__addr">
              <strong>Forward Family Medicine, {details[0].office.name}</strong>
              <span>{details[0].office.street}</span>
              <span>{details[0].office.city}, {details[0].office.state} {details[0].office.zip}</span>
            </address>
            {details[0].office.directionsUrl && (
              <a href={details[0].office.directionsUrl} class="lp-footer__link" target="_blank" rel="noopener noreferrer">Get directions</a>
            )}</Fragment>
        ) : (
          <div class="lp-footer__sites">
            {details.map((d) => (
              <div class="lp-footer__site">
                <address class="lp-footer__addr">
                  <strong>Forward Family Medicine, {d.office.name}</strong>
                  <span>{d.office.street}</span>
                  <span>{d.office.city}, {d.office.state} {d.office.zip}</span>
                </address>
                {d.office.directionsUrl && (
                  <a href={d.office.directionsUrl} class="lp-footer__link" target="_blank" rel="noopener noreferrer">Get directions</a>
                )}
                {!shared && (
                  <Fragment>
                    <a href={d.phone.href} class="lp-footer__phone" data-lp-tel="footer">{d.phone.text}</a>
                    {d.hoursLines.length > 0 && (
                      <p class="lp-footer__hours">{d.hoursLines.map((line) => <span>{line}</span>)}</p>
                    )}
                  </Fragment>
                )}
              </div>
            ))}
          </div>
        )}
        {shared && (
          <Fragment><a href={phone.href} class="lp-footer__phone" data-lp-tel="footer">{phone.text}</a>
            {hoursLines.length > 0 && (
              <p class="lp-footer__hours">{hoursLines.map((line) => <span>{line}</span>)}</p>
            )}</Fragment>
        )}
      </div>
      <ul class="lp-footer__links" aria-label="Privacy">
        <li><a href="/privacy-policy/">Privacy Policy</a></li>
        <li><a href="#" data-consent-reset>Manage Cookie Choices</a></li>
        <li><a href="/" data-lp-nav="site">Visit our full website</a></li>
      </ul>
    </div>
    <p class="lp-footer__fine">
      &copy; {year} Forward Family Medicine. All rights reserved.
      Forward Family Medicine is a Direct Primary Care practice. Membership is not insurance.
    </p>
  </div>
</footer>

<style>
  .lp-footer {
    background: var(--forest);
    color: var(--linen);
    padding: 56px 0 48px;
    font-size: 15px;
    line-height: 1.6;
  }
  .lp-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px 48px;
    align-items: start;
  }
  .lp-footer__office { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  /* Two or more offices: side by side, each its own column, parted by a 48px gap. */
  .lp-footer__sites { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(0, max-content); gap: 14px 48px; align-self: stretch; }
  .lp-footer__site { display: flex; flex-direction: column; align-items: flex-start; gap: 14px; }
  .lp-footer :global(.lp-footer__logo) { display: block; height: 45px; width: auto; }
  .lp-footer__addr { font-style: normal; margin: 0; }
  .lp-footer__addr strong { display: block; font-weight: 600; color: var(--linen); }
  .lp-footer__addr span { display: block; }
  .lp-footer__link,
  .lp-footer__links a {
    color: var(--linen);
    text-decoration: none;
    border-bottom: 1px solid var(--sage);
    padding-bottom: 1px;
  }
  .lp-footer__link:hover, .lp-footer__links a:hover, .lp-footer__phone:hover { border-color: var(--linen); }
  .lp-footer__phone {
    font-size: 18px;
    font-weight: 600;
    color: var(--linen);
    text-decoration: none;
    border-bottom: 1px solid var(--sage);
    padding-bottom: 1px;
  }
  .lp-footer__hours { margin: 0; font-size: 14px; color: var(--sage); }
  .lp-footer__hours span { display: block; }
  .lp-footer__links { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 12px; justify-self: end; }
  .lp-footer__fine {
    margin: 40px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--linen-08);
    font-size: 12px;
    line-height: 1.6;
    color: var(--sage);
    max-width: 68ch;
  }
  /* Keyboard focus, visible on forest. */
  .lp-footer a:focus-visible { outline: 2px solid var(--linen); outline-offset: 3px; border-radius: 2px; }

  /* A phone: one column in the order logo, address, directions, the phone
     number as a full-width tap target, hours, the two links, the legal line.
     The bottom padding clears the consent bar (about 105px at 390px). */
  @media (max-width: 640px) {
    .lp-footer { padding: 44px 0 calc(128px + env(safe-area-inset-bottom)); }
    .lp-footer__grid { grid-template-columns: 1fr; gap: 24px; }
    .lp-footer__office { gap: 16px; }
    .lp-footer__sites { grid-auto-flow: row; grid-auto-columns: auto; gap: 20px; align-self: auto; }
    .lp-footer__site { gap: 16px; }
    .lp-footer__phone {
      display: block;
      width: 100%;
      box-sizing: border-box;
      padding: 14px 16px;
      border: 1px solid var(--sage);
      border-radius: 8px;
      text-align: center;
      font-size: 20px;
    }
    .lp-footer__links { justify-self: start; gap: 2px; }
    /* Tap targets of at least 44px on a phone: the three links and the directions link. */
    .lp-footer__links a { display: inline-block; padding: 11px 0 10px; font-size: 16px; }
    .lp-footer__link { display: inline-block; padding: 10px 0 9px; }
    .lp-footer__fine { margin-top: 32px; }
  }
</style>
