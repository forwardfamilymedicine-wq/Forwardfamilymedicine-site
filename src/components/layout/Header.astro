---
/**
 * Site header, per design/boards/Header.dc.html.
 *
 * Utility bar: phone and "Wayne & Malvern" left; Blog · FAQ · New Patients ·
 * Patient Portal · Enroll right. Main bar: About · Meet the Team · Services ·
 * Locations · Membership · Contact, then the meet-and-greet button. The
 * Services panel opens on hover and on keyboard focus-within with CSS alone;
 * its links are plain anchors in the markup at all times, and the trigger is
 * the /services/ link itself. Esc closes it. Under 860px the bar collapses to
 * the logo and a hamburger, and the sheet carries the same destinations.
 *
 * The set of linked destinations is exactly today's: nothing was removed. The
 * family Enroll link lives in the footer and on the Membership and New
 * Patients pages. Every SigmaMD signup link is tracked by the delegated
 * listener in MainLayout (outbound_enrollment_click); nothing to add here.
 */
import { Image } from 'astro:assets';
import logo from '../../assets/logo/ffm-logo.png';
import { contactHrefForPath } from '../../utils/leadSource';

const PORTAL_URL = 'https://patient.sigmamd.com';
const ENROLL_URL = 'https://forwardfamilymedicine.sigmamd.com/signup/individual-membership';
const PHONE_HREF = 'tel:+12156457044';
const PHONE_TEXT = '(215) 645-7044';

const careLinks = [
  { href: '/direct-primary-care/', label: 'Direct Primary Care' },
  { href: '/lifestyle-medicine/', label: 'Lifestyle Medicine' },
  { href: '/menopause/', label: 'Menopause Care' },
  { href: '/concierge-medicine/', label: 'Concierge Medicine' },
];
const programLinks = [
  { href: '/clarity/', label: 'The Clarity Program' },
  { href: '/wellness-collective/', label: 'Wellness Collective' },
  { href: '/wayne-dexa/', label: 'Wayne DEXA (Body Composition)' },
  { href: '/for-businesses/', label: 'For Businesses' },
];
const servicesChildren = [...careLinks, ...programLinks];

const utilityLinks = [
  { href: '/blog/', label: 'Blog' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/new-patients/', label: 'New Patients' },
  { href: PORTAL_URL, label: 'Patient Portal', external: true },
];

const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href);
const isServicesActive = ['/services/', ...servicesChildren.map(c => c.href)].some(h => currentPath.startsWith(h));
const cardHref = contactHrefForPath(currentPath);

const primaryBefore = [
  { href: '/about/', label: 'About' },
  { href: '/meet-the-team/', label: 'Meet the Team' },
];
const primaryAfter = [
  { href: '/locations/', label: 'Locations' },
  { href: '/membership/', label: 'Membership' },
  { href: '/contact/', label: 'Contact' },
];
---

<header class="site-header" role="banner">

  <!-- Utility bar -->
  <div class="util">
    <div class="rd-wrap util-inner">
      <div class="util-left">
        <a href={PHONE_HREF}>{PHONE_TEXT}</a>
        <span class="sep hide-m" aria-hidden="true">·</span>
        <span class="hide-m">Wayne &amp; Malvern</span>
      </div>
      <div class="util-right">
        <span class="hide-m">
          {utilityLinks.map(l => (
            <>
              <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>{l.label}</a>
              <span class="sep" aria-hidden="true">·</span>
            </>
          ))}
        </span>
        <a href={ENROLL_URL} target="_blank" rel="noopener noreferrer">Enroll</a>
      </div>
    </div>
  </div>

  <!-- Main bar -->
  <div class="bar">
    <div class="rd-wrap bar-inner">
      <a href="/" class="logo" aria-label="Forward Family Medicine — Home">
        <Image
          src={logo}
          alt="Forward Family Medicine logo"
          class="logo-img"
          height={84}
          widths={[116, 232, 348]}
          sizes="(max-width: 860px) 94px, 116px"
          format="webp"
          quality={90}
          loading="eager"
        />
      </a>

      <nav class="nav" aria-label="Main navigation">
        {primaryBefore.map(l => (
          <a href={l.href} class={isActive(l.href) ? 'active' : undefined} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}

        <div class="hasmenu">
          <a href="/services/" class={`menu-trigger${isServicesActive ? ' active' : ''}`} aria-current={isServicesActive ? 'page' : undefined}>
            Services
            <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg>
          </a>
          <div class="panel">
            <div class="rd-wrap panel-inner">
              <div>
                <p class="rd-eyebrow panel-head">Care</p>
                <ul>
                  {careLinks.map(c => <li><a href={c.href} class={isActive(c.href) ? 'active' : undefined}>{c.label}</a></li>)}
                </ul>
              </div>
              <div>
                <p class="rd-eyebrow panel-head">Programs &amp; partners</p>
                <ul>
                  {programLinks.map(c => <li><a href={c.href} class={isActive(c.href) ? 'active' : undefined}>{c.label}</a></li>)}
                </ul>
              </div>
              <div class="panel-card">
                <p class="panel-card-title rd-serif">Start with a conversation, not a commitment.</p>
                <p class="panel-card-text">A free meet and greet is exactly what it sounds like. Come in, meet the physician taking new patients, see the office, and ask every question you have. Nothing is signed that day.</p>
                <a class="btn-forest btn-sm" href={cardHref}>Schedule a Free Meet &amp; Greet</a>
                <a class="panel-card-link" href="/services/">All services →</a>
              </div>
            </div>
          </div>
        </div>

        {primaryAfter.map(l => (
          <a href={l.href} class={isActive(l.href) ? 'active' : undefined} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>

      <a href="/contact/" class="btn-forest btn-sm nav-cta">Schedule Meet &amp; Greet</a>

      <button
        class="burger"
        id="mobile-menu-btn"
        type="button"
        aria-controls="mobile-nav"
        aria-expanded="false"
        aria-label="Open navigation menu"
      >
        <svg viewBox="0 0 20 20" width="22" height="22" aria-hidden="true"><path d="M2 5h16M2 10h16M2 15h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile sheet -->
  <div class="sheet" id="mobile-nav" hidden>
    <div class="sheet-bar">
      <a href="/" aria-label="Forward Family Medicine — Home">
        <Image
          src={logo}
          alt="Forward Family Medicine logo"
          class="sheet-logo"
          height={68}
          widths={[94, 188]}
          sizes="94px"
          format="webp"
          quality={90}
          loading="lazy"
        />
      </a>
      <button class="sheet-close" id="mobile-menu-close" type="button" aria-label="Close menu">
        <svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16"/></svg>
      </button>
    </div>
    <nav class="sheet-nav" aria-label="Mobile navigation">
      {primaryBefore.map(l => (
        <a href={l.href} class={`sheet-link${isActive(l.href) ? ' active' : ''}`}>{l.label}</a>
      ))}
      <div class="sheet-group">
        <a href="/services/" class={`sheet-link sheet-group-head${isServicesActive ? ' active' : ''}`}>
          Services
          <svg class="chev open" viewBox="0 0 12 12" aria-hidden="true"><path d="M2 4l4 4 4-4"/></svg>
        </a>
        <div class="sheet-sub">
          <p class="rd-eyebrow sheet-sub-head">Care</p>
          {careLinks.map(c => <a href={c.href} class={isActive(c.href) ? 'active' : undefined}>{c.label}</a>)}
          <p class="rd-eyebrow sheet-sub-head sheet-sub-head--gap">Programs &amp; partners</p>
          {programLinks.map(c => <a href={c.href} class={isActive(c.href) ? 'active' : undefined}>{c.label}</a>)}
        </div>
      </div>
      {primaryAfter.map(l => (
        <a href={l.href} class={`sheet-link${isActive(l.href) ? ' active' : ''}`}>{l.label}</a>
      ))}
      <div class="sheet-small">
        {utilityLinks.map(l => (
          <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener noreferrer' : undefined}>{l.label}</a>
        ))}
        <a href={ENROLL_URL} target="_blank" rel="noopener noreferrer">Enroll</a>
        <a href={PHONE_HREF}>{PHONE_TEXT}</a>
      </div>
    </nav>
    <div class="sheet-foot">
      <a href="/contact/" class="btn-forest sheet-cta">Schedule a Free Meet &amp; Greet</a>
    </div>
  </div>

</header>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    background: var(--linen-50);
  }

  /* Utility bar */
  .util {
    background: var(--linen);
    border-bottom: 1px solid var(--hairline);
    font-size: 12px;
    color: var(--sage-600);
  }
  .util-inner {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .util a {
    color: var(--sage-600);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.15s;
    white-space: nowrap;
  }
  .util a:hover { color: var(--forest); }
  .sep { color: var(--hairline-dot); margin: 0 10px; }

  /* Main bar */
  .bar { border-bottom: 1px solid var(--hairline); }
  .bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: 80px;
  }
  .logo { display: flex; align-items: center; flex-shrink: 0; }
  .logo-img { height: 42px; width: auto; display: block; }

  .nav { display: flex; align-items: center; gap: 6px; }
  .nav > a,
  .menu-trigger {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.2;
    color: var(--forest);
    padding: 8px 12px;
    border-radius: 6px;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    position: relative;
    white-space: nowrap;
    transition: background 0.18s;
  }
  .nav > a:hover,
  .hasmenu:hover .menu-trigger,
  .hasmenu:focus-within .menu-trigger { background: var(--linen-300); }
  .nav a.active::after {
    content: '';
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 2px;
    height: 2px;
    background: var(--sage);
  }
  .chev {
    width: 12px;
    height: 12px;
    stroke: var(--sage-600);
    fill: none;
    stroke-width: 1.75;
    transition: transform 0.2s;
  }
  .hasmenu:hover .chev,
  .hasmenu:focus-within .chev { transform: rotate(180deg); }

  /* Services panel: CSS-only. .hasmenu is static so the panel positions
     against the header; the trigger's ::after bridges the gap below it. */
  .hasmenu { position: static; display: inline-flex; }
  .menu-trigger::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 26px;
  }
  .panel {
    display: none;
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    background: var(--linen);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline-strong);
    box-shadow: var(--shadow-menu);
    z-index: 31;
  }
  .hasmenu:hover .panel,
  .hasmenu:focus-within .panel { display: block; }
  .hasmenu.is-dismissed .panel { display: none; }
  .panel-inner {
    display: grid;
    grid-template-columns: 1fr 1fr 1.1fr;
    gap: 56px;
    padding-top: 36px;
    padding-bottom: 40px;
  }
  .panel-head { margin-bottom: 14px; }
  .panel ul { margin: 0; padding: 0; list-style: none; }
  .panel li a {
    display: block;
    padding: 12px 0;
    border-top: 1px solid var(--hairline-strong);
    font-family: var(--font-heading);
    font-size: 18px;
    color: var(--forest);
    text-decoration: none;
    transition: padding-left 0.2s, color 0.18s;
  }
  .panel li:last-child a { border-bottom: 1px solid var(--hairline-strong); }
  .panel li a:hover,
  .panel li a.active { padding-left: 8px; color: var(--sage-600); }
  .panel-card {
    padding: 26px 28px;
    background: var(--sage-50);
    border-top: 3px solid var(--forest);
    display: flex;
    flex-direction: column;
    gap: 14px;
    align-self: start;
  }
  .panel-card-title { font-size: 22px; line-height: 1.3; color: var(--forest); margin: 0; }
  .panel-card-text { font-size: 13px; line-height: 1.6; color: var(--text-700); margin: 0; }
  .panel-card .btn-forest { align-self: flex-start; }
  .panel-card-link {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 500;
    color: var(--sage-600);
    text-decoration: none;
    border-bottom: 1px solid var(--sage);
    padding-bottom: 1px;
    transition: color 0.18s, border-color 0.18s;
  }
  .panel-card-link:hover { color: var(--forest); border-color: var(--forest); }

  .nav-cta { white-space: nowrap; flex-shrink: 0; }

  /* Hamburger */
  .burger {
    display: none;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    flex-shrink: 0;
  }
  .burger svg { stroke: var(--forest); stroke-width: 1.75; fill: none; }

  /* Mobile sheet */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: flex;
    flex-direction: column;
    background: var(--linen);
  }
  .sheet[hidden] { display: none; }
  .sheet-bar {
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 18px;
    border-bottom: 1px solid var(--hairline);
    background: var(--linen-50);
    flex-shrink: 0;
  }
  .sheet-logo { height: 34px; width: auto; display: block; }
  .sheet-close {
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }
  .sheet-close svg { stroke: var(--forest); stroke-width: 1.75; fill: none; }
  .sheet-nav {
    flex: 1;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 8px 18px 18px;
  }
  .sheet-link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--hairline-strong);
    font-size: 17px;
    font-weight: 500;
    color: var(--forest);
    text-decoration: none;
  }
  .sheet-link.active { color: var(--sage-600); }
  .sheet-group { border-bottom: 1px solid var(--hairline-strong); }
  .sheet-group-head { border-bottom: 0; padding-bottom: 10px; }
  .sheet-group-head .chev { transform: rotate(180deg); }
  .sheet-sub {
    padding: 0 0 14px 14px;
    display: flex;
    flex-direction: column;
  }
  .sheet-sub-head { padding: 6px 0; }
  .sheet-sub-head--gap { padding-top: 14px; }
  .sheet-sub a {
    padding: 9px 0;
    font-size: 15px;
    color: var(--forest);
    text-decoration: none;
  }
  .sheet-sub a.active { color: var(--sage-600); }
  .sheet-small {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    padding: 20px 0 0;
    font-size: 14px;
  }
  .sheet-small a { color: var(--sage-600); font-weight: 500; text-decoration: none; }
  .sheet-foot {
    padding: 14px 18px 22px;
    border-top: 1px solid var(--hairline);
    background: var(--linen-50);
    flex-shrink: 0;
  }
  .sheet-cta { width: 100%; min-height: 50px; font-size: 15px; }

  @media (max-width: 860px) {
    .hide-m { display: none; }
    .nav, .nav-cta { display: none; }
    .burger { display: flex; }
    .bar-inner { height: 64px; }
    .logo-img { height: 34px; }
  }
</style>

<script>
  // Mobile sheet: open/close, lock body scroll, restore on navigation.
  const btn = document.getElementById('mobile-menu-btn') as HTMLButtonElement | null;
  const closeBtn = document.getElementById('mobile-menu-close') as HTMLButtonElement | null;
  const sheet = document.getElementById('mobile-nav') as HTMLElement | null;

  function setSheet(open: boolean) {
    if (!btn || !sheet) return;
    btn.setAttribute('aria-expanded', String(open));
    sheet.hidden = !open;
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn?.focus(); else btn.focus();
  }
  btn?.addEventListener('click', () => setSheet(btn.getAttribute('aria-expanded') !== 'true'));
  closeBtn?.addEventListener('click', () => setSheet(false));
  sheet?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) document.body.style.overflow = '';
  });

  // Services panel opens with CSS (hover, focus-within). Esc closes it until
  // the pointer leaves or focus re-enters.
  const menu = document.querySelector('.hasmenu') as HTMLElement | null;
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    if (sheet && !sheet.hidden) { setSheet(false); return; }
    if (menu && menu.contains(document.activeElement)) {
      menu.classList.add('is-dismissed');
      (document.activeElement as HTMLElement | null)?.blur();
    }
  });
  menu?.addEventListener('mouseleave', () => menu.classList.remove('is-dismissed'));
  menu?.addEventListener('focusin', () => menu.classList.remove('is-dismissed'));
</script>
