---
/**
 * Who you would actually see: portrait, name, credential line, a short list
 * of verifiable facts, and the bio as prose (slot). An optional `proof` slot
 * takes a TestimonialCard or similar.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  name: string;
  credential: string;
  href: string;
  photo: ImageMetadata;
  photoAlt: string;
  facts?: string[];
}
const { name, credential, href, photo, photoAlt, facts = [] } = Astro.props;
---

<div class="ed-spotlight">
  <div class="ed-spotlight__side">
    <Image
      src={photo}
      alt={photoAlt}
      width={480}
      height={480}
      fit="cover"
      position="top"
      widths={[240, 480]}
      sizes="(max-width: 900px) 200px, 240px"
      format="webp"
      quality={82}
      loading="lazy"
      class="ed-spotlight__photo"
    />
    <p class="ed-spotlight__name">{name}</p>
    <p class="ed-spotlight__cred">{credential}</p>
    {facts.length > 0 && (
      <ul class="ed-spotlight__facts">
        {facts.map(f => <li>{f}</li>)}
      </ul>
    )}
    <a href={href} class="ed-spotlight__link">Full bio and credentials</a>
  </div>
  <div class="ed-spotlight__main">
    <div class="ed-spotlight__bio">
      <slot />
    </div>
    <slot name="proof" />
  </div>
</div>

<style>
  .ed-spotlight {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .ed-spotlight__photo {
    width: 240px;
    height: 240px;
    object-fit: cover;
    object-position: 50% 12%;
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
    background: var(--cream-200);
  }
  .ed-spotlight__name {
    font-family: var(--font-heading);
    font-size: var(--step-1);
    font-weight: 700;
    color: var(--ink-900);
    margin: var(--space-m) 0 0.15rem;
  }
  .ed-spotlight__cred {
    font-size: var(--step--1);
    color: var(--ink-700);
    line-height: 1.5;
    margin: 0 0 var(--space-m);
  }
  .ed-spotlight__facts {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-m);
    border-top: 1px solid var(--cream-300);
  }
  .ed-spotlight__facts li {
    font-size: var(--step--1);
    color: var(--ink-700);
    line-height: 1.5;
    padding: 0.55rem 0;
    border-bottom: 1px solid var(--cream-300);
  }
  .ed-spotlight__link {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--green-400);
  }
  .ed-spotlight__bio :global(p) {
    font-size: var(--step-0);
    line-height: 1.75;
    color: var(--ink-700);
    max-width: var(--measure);
    margin-bottom: var(--space-m);
  }
  .ed-spotlight__bio :global(p:first-child) {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-900);
  }
  .ed-spotlight__main > :global(*:not(.ed-spotlight__bio)) {
    margin-top: var(--space-l);
    max-width: 640px;
  }
  @media (max-width: 900px) {
    .ed-spotlight { grid-template-columns: 1fr; gap: var(--space-l); }
    .ed-spotlight__photo { width: 200px; height: 200px; }
  }
</style>
