---
/**
 * Who you would actually see, per the Local boards: a sticky column with the
 * portrait, name, credential line, practice note, a ruled list of facts and
 * the bio link, beside the bio as prose (slot). The column pins only when it
 * fits under the header. An optional `proof` slot takes a TestimonialCard.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RuledList from '../shared/RuledList.astro';

export interface Props {
  name: string;
  credential: string;
  href: string;
  photo: ImageMetadata;
  photoAlt: string;
  facts?: string[];
  /** Where the physician practices, relative to the town on the page. */
  note?: string;
}
const { name, credential, href, photo, photoAlt, facts = [], note } = Astro.props;
---

<div class="ed-spotlight">
  <div class="ed-spotlight__side" data-sticky-fit>
    <Image
      src={photo}
      alt={photoAlt}
      width={640}
      height={800}
      widths={[320, 640, 960]}
      sizes="(max-width: 860px) min(calc(100vw - 40px), 320px), 320px"
      format="webp"
      quality={82}
      loading="lazy"
      class="ed-spotlight__photo"
    />
    <p class="ed-spotlight__name rd-serif">{name}</p>
    <p class="ed-spotlight__cred">{credential}</p>
    {note && <p class="ed-spotlight__note">{note}</p>}
    {facts.length > 0 && (
      <RuledList reveal size="md" class="ed-spotlight__facts">
        {facts.map(f => <li>{f}</li>)}
      </RuledList>
    )}
    <a href={href} class="rd-link ed-spotlight__link">Full bio and credentials →</a>
  </div>
  <div class="ed-spotlight__main">
    <div class="ed-spotlight__bio">
      <slot />
    </div>
    <slot name="proof" />
  </div>
</div>

<style>
  .ed-spotlight {
    display: grid;
    grid-template-columns: minmax(0, 0.75fr) minmax(0, 1.25fr);
    gap: 72px;
    align-items: start;
  }
  .ed-spotlight__side { display: flex; flex-direction: column; gap: 14px; }
  .ed-spotlight__side p { margin: 0; }
  .ed-spotlight :global(.ed-spotlight__photo) {
    display: block;
    width: 100%;
    max-width: 320px;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 2px;
  }
  .ed-spotlight__name { font-size: 26px; line-height: 1.15; color: var(--forest); margin-top: 6px !important; }
  .ed-spotlight__cred { font-size: 14.5px; line-height: 1.6; color: var(--text-700); }
  .ed-spotlight__note { font-size: 14.5px; line-height: 1.6; color: var(--sage-600); font-weight: 500; }
  .ed-spotlight :global(.ed-spotlight__facts) { margin-top: 6px; }
  .ed-spotlight :global(.ed-spotlight__facts > li) { font-size: 14px; padding: 14px 0; color: var(--text-900); }
  .ed-spotlight__link { align-self: flex-start; margin-top: 8px; }
  .ed-spotlight__main { display: flex; flex-direction: column; gap: 20px; min-width: 0; }
  .ed-spotlight__bio { display: flex; flex-direction: column; gap: 20px; }
  .ed-spotlight__bio :global(p) { margin: 0; font-size: 16px; line-height: 1.75; color: var(--text-900); }
  .ed-spotlight__main > :global(*:not(.ed-spotlight__bio)) { margin-top: 12px; max-width: 640px; }
  @media (max-width: 860px) {
    .ed-spotlight { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
