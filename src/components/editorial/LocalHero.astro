---
/**
 * Local-page hero, per the Local boards: breadcrumb, title, lede and two
 * buttons beside a card for the physician who would actually see you. The
 * card is the routed physician (portrait, name, credential line, practice
 * note, bio link) or, when physicianRouting yields the team card, the
 * accepting physicians' portraits side by side with the team link. The
 * decorative eyebrow is no longer rendered; the prop stays for callers.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  location: string;
  eyebrow?: string;
  title: string;
  lede: string;
  cta: { label: string; href: string };
  secondary?: { label: string; href: string };
  photo?: ImageMetadata | null;
  photoAlt: string;
  physician: { name: string; credential: string; note?: string; href: string; linkLabel: string };
  /** The team card: portraits of the physicians accepting new patients. */
  portraits?: { photo: ImageMetadata; alt: string }[];
  orientation?: 'portrait' | 'landscape';
}
const { location, title, lede, cta, secondary, photo, photoAlt, physician, portraits = [] } = Astro.props;
const teamCard = !photo && portraits.length > 0;
---

<section class="lh">
  <div class="rd-wrap">
    <nav class="rd-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">›</span> <span aria-current="page">{location}</span>
    </nav>
    <div class="lh__grid">
      <div class="lh__copy">
        <h1 class="lh__h1 rd-serif">{title}</h1>
        <p class="lh__lede">{lede}</p>
        <div class="lh__actions">
          <a href={cta.href} class="btn-forest">{cta.label}</a>
          {secondary && <a href={secondary.href} class="btn-ghost">{secondary.label}</a>}
        </div>
      </div>

      {teamCard ? (
        <div class="lh-card lh-card--team">
          <div class="lh-card__row">
            {portraits.map(p => (
              <Image
                src={p.photo}
                alt={p.alt}
                width={400}
                height={500}
                widths={[200, 400, 600]}
                sizes="(max-width: 860px) calc(50vw - 36px), 170px"
                format="webp"
                quality={82}
                loading="eager"
                fetchpriority="high"
                class="lh-card__portrait"
              />
            ))}
          </div>
          <p class="lh-card__name rd-serif">{physician.name}</p>
          <p class="lh-card__role">{physician.credential}</p>
          <a href={physician.href} class="rd-link lh-card__link">{physician.linkLabel} →</a>
        </div>
      ) : (
        <div class="lh-card">
          {photo && (
            <Image
              src={photo}
              alt={photoAlt}
              width={760}
              height={608}
              widths={[380, 760, 1140]}
              sizes="(max-width: 860px) calc(100vw - 40px), 380px"
              format="webp"
              quality={82}
              loading="eager"
              fetchpriority="high"
              class="lh-card__photo"
            />
          )}
          <div class="lh-card__body">
            <p class="lh-card__name rd-serif">{physician.name}</p>
            <p class="lh-card__cred">{physician.credential}</p>
            {physician.note && <p class="lh-card__note">{physician.note}</p>}
            <a href={physician.href} class="rd-link lh-card__link">{physician.linkLabel} →</a>
          </div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .lh { background: var(--linen); padding: 80px 0 96px; }
  .lh__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
    gap: 72px;
    align-items: center;
  }
  .lh__copy { display: flex; flex-direction: column; gap: 22px; }
  .lh__h1 { margin: 0; font-size: 60px; line-height: 1.04; letter-spacing: -0.018em; color: var(--forest); max-width: 16ch; }
  .lh__lede { margin: 0; font-size: 18px; line-height: 1.7; color: var(--text-900); max-width: 620px; }
  .lh__actions { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }

  .lh-card {
    background: var(--linen-50);
    border: 1px solid var(--hairline);
    border-top: 3px solid var(--forest);
    display: flex;
    flex-direction: column;
  }
  .lh-card :global(.lh-card__photo) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 5 / 4;
    object-fit: cover;
    object-position: 50% 20%;
  }
  .lh-card__body { padding: 22px 26px 26px; display: flex; flex-direction: column; gap: 10px; }
  .lh-card__body p, .lh-card--team p { margin: 0; }
  .lh-card__name { font-size: 24px; line-height: 1.15; color: var(--forest); }
  .lh-card__cred { font-size: 14px; line-height: 1.6; color: var(--text-700); }
  .lh-card__note { font-size: 14px; line-height: 1.6; color: var(--sage-600); font-weight: 500; }
  .lh-card__link { align-self: flex-start; margin-top: 4px; }
  .lh-card--team { padding: 28px 30px; gap: 14px; }
  .lh-card__row { display: flex; gap: 10px; }
  .lh-card :global(.lh-card__portrait) {
    display: block;
    width: 50%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 2px;
  }
  .lh-card__role { font-size: 14px; color: var(--sage-600); font-weight: 500; }

  @media (max-width: 860px) {
    .lh { padding: 48px 0 64px; }
    .lh__grid { grid-template-columns: 1fr; gap: 36px; }
    .lh__h1 { font-size: 40px; max-width: none; }
    .lh__actions .btn-forest, .lh__actions .btn-ghost { width: 100%; }
  }
</style>
