---
/**
 * Practical information as a two-column definition list of hairline rows, per
 * the Local boards, fed from the `locations` collection rather than hand-typed
 * lines. Consecutive days with the same hours collapse to one range.
 */
export interface Props {
  address: { street: string; city: string; state: string; zip: string };
  phone?: string;
  fax?: string;
  email?: string;
  hours?: { day: string; open: string; close: string }[];
  extras?: { label: string; value: string }[];
  mapHref?: string;
  detailsHref?: string;
  /** "October 2026" for an office that has not opened; shown first in the Office row. */
  opening?: string;
  /** Lead-in above the list, for a town whose own office is only planned. */
  notice?: string;
}
const { address, phone, fax, email, hours = [], extras = [], mapHref, detailsHref, opening, notice } = Astro.props;

function telHref(display: string) {
  const digits = display.replace(/\D/g, '');
  return `tel:+1${digits.length === 11 ? digits.slice(1) : digits}`;
}

// Collapse runs of consecutive days sharing the same open/close.
const hourRuns: { from: string; to: string; open: string; close: string }[] = [];
for (const h of hours) {
  const last = hourRuns[hourRuns.length - 1];
  if (last && last.open === h.open && last.close === h.close) last.to = h.day;
  else hourRuns.push({ from: h.day, to: h.day, open: h.open, close: h.close });
}
// An office whose street is not yet confirmed (locations entry with an empty
// addressStreet) shows city, state and ZIP only, with no directions link: a
// map search on a bare city would send people somewhere we never said.
const hasStreet = address.street.trim().length > 0;
const cityLine = `${address.city}, ${address.state} ${address.zip}`;
const fullAddress = hasStreet ? `${address.street}, ${cityLine}` : cityLine;
---

<div class="ed-info">
  {notice && <p class="ed-info__notice">{notice}</p>}
  <dl class="ed-info__list">
    <div class="ed-info__row">
      <dt>Office</dt>
      <dd>{opening && <span class="ed-info__line ed-info__opening">Opens {opening}</span>}
        {hasStreet && <span class="ed-info__line">{address.street}</span>}
        <span class="ed-info__line">{cityLine}{hasStreet && mapHref && <Fragment> <span class="ed-info__dot" aria-hidden="true">·</span> <a href={mapHref} rel="noopener" target="_blank">Directions</a></Fragment>}</span>
      </dd>
    </div>
    {hourRuns.length > 0 && (
      <div class="ed-info__row">
        <dt>Hours</dt>
        <dd>
          {hourRuns.map(r => (
            <span class="ed-info__line">
              {r.from === r.to ? r.from : `${r.from} to ${r.to}`}, {r.open} to {r.close}
            </span>
          ))}
        </dd>
      </div>
    )}
    {phone && (
      <div class="ed-info__row">
        <dt>Phone</dt>
        <dd><a href={telHref(phone)}>{phone}</a></dd>
      </div>
    )}
    {fax && (
      <div class="ed-info__row">
        <dt>Fax</dt>
        <dd>{fax}</dd>
      </div>
    )}
    {email && (
      <div class="ed-info__row">
        <dt>Email</dt>
        <dd><a href={`mailto:${email}`}>{email}</a></dd>
      </div>
    )}
    {extras.map(x => (
      <div class="ed-info__row">
        <dt>{x.label}</dt>
        <dd>{x.value}</dd>
      </div>
    ))}
  </dl>
  {detailsHref && (
    <p class="ed-info__more"><a href={detailsHref} class="rd-link">Office details for {address.city} →</a></p>
  )}
  <span class="visually-hidden">{fullAddress}</span>
</div>

<style>
  .ed-info__notice { margin: 0 0 32px; max-width: 46rem; font-size: 16px; line-height: 1.7; color: var(--text-900); }
  .ed-info__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 48px;
    margin: 0;
  }
  .ed-info__row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 16px;
    padding: 14px 0;
    border-top: 1px solid var(--hairline-strong);
    font-size: 14px;
    line-height: 1.6;
  }
  .ed-info__row:nth-last-child(-n+2) { border-bottom: 1px solid var(--hairline-strong); }
  .ed-info__row dt { margin: 0; color: var(--text-600); }
  .ed-info__row dd { margin: 0; min-width: 0; overflow-wrap: anywhere; color: var(--forest); }
  .ed-info__line { display: block; }
  .ed-info__opening { font-weight: 600; }
  .ed-info__dot { color: var(--text-600); }
  .ed-info__row a { color: var(--sage-600); text-decoration: none; border-bottom: 1px solid var(--sage); }
  .ed-info__row a:hover { color: var(--forest); border-color: var(--forest); }
  .ed-info__more { margin: 28px 0 0; }
  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 860px) {
    .ed-info__list { grid-template-columns: 1fr; }
    .ed-info__row { border-bottom: 0 !important; }
    .ed-info__row:last-child { border-bottom: 1px solid var(--hairline-strong) !important; }
  }
  @media (max-width: 640px) {
    .ed-info__row { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
