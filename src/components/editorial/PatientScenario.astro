---
/**
 * A concrete situation and how care through the practice handles it, per the
 * Local boards: the situation in a sticky left column, the response (slot) at
 * right under "How it works at Forward Family Medicine", and the note that it
 * is illustrative. The response must stay inside what the practice already
 * publishes about access and visit length; no clinical outcomes are promised.
 */
export interface Props {
  label?: string;
  title: string;
  situation: string;
}
const { label = 'A patient scenario', title, situation } = Astro.props;
---

<aside class="ed-scenario" aria-label={title}>
  <div class="ed-scenario__setup rd-sticky">
    <p class="ed-scenario__label">{label}</p>
    <h2 class="ed-scenario__title rd-serif">{title}</h2>
    <p class="ed-scenario__situation rd-serif">{situation}</p>
  </div>
  <div class="ed-scenario__response">
    <h3 class="ed-scenario__kicker">How it works at Forward Family Medicine</h3>
    <slot />
    <p class="ed-scenario__note">An illustrative scenario, not a description of any specific patient. Care decisions are always made with your physician.</p>
  </div>
</aside>

<style>
  .ed-scenario {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 64px;
    align-items: start;
  }
  .ed-scenario__setup { display: flex; flex-direction: column; gap: 16px; }
  .ed-scenario__setup p, .ed-scenario__title { margin: 0; }
  .ed-scenario__label { font-size: 13px; font-weight: 500; color: var(--sage-600); }
  .ed-scenario__title { font-size: 40px; line-height: 1.1; letter-spacing: -0.01em; color: var(--forest); }
  .ed-scenario__situation { font-size: 21px; line-height: 1.45; color: var(--text-700); font-style: italic; }
  .ed-scenario__response { display: flex; flex-direction: column; gap: 18px; min-width: 0; }
  .ed-scenario__kicker { margin: 0; font-family: var(--font-body); font-size: 14px; font-weight: 600; color: var(--sage-600); }
  .ed-scenario__response :global(p) { margin: 0; font-size: 16px; line-height: 1.75; color: var(--text-900); }
  .ed-scenario__note {
    margin: 6px 0 0 !important;
    padding-top: 14px;
    border-top: 1px solid var(--hairline-strong);
    font-size: 13px !important;
    line-height: 1.6 !important;
    color: var(--text-600) !important;
  }
  @media (max-width: 860px) {
    .ed-scenario { grid-template-columns: 1fr; gap: 28px; }
    .ed-scenario__title { font-size: 30px; }
  }
</style>
