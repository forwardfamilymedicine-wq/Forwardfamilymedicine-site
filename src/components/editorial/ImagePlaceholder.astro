---
/**
 * A visibly labeled stand-in for an asset that has not been supplied yet.
 * Never ships as a stock substitute: the label says what belongs here so the
 * practice can shoot or source exactly that.
 */
export interface Props {
  label: string;
  aspect?: '4/3' | '3/2' | '16/9' | '1/1' | '4/5';
  caption?: string;
  class?: string;
}
const { label, aspect = '3/2', caption, class: className } = Astro.props;
---

<figure class:list={['ed-placeholder', className]}>
  <div class="ed-placeholder__box" role="img" aria-label={`Image placeholder: ${label}`} style={`aspect-ratio: ${aspect};`}>
    <span class="ed-placeholder__tag">Image placeholder</span>
    <span class="ed-placeholder__label">{label}</span>
  </div>
  {caption && <figcaption class="ed-placeholder__caption">{caption}</figcaption>}
</figure>

<style>
  .ed-placeholder { margin: 0; }
  .ed-placeholder__box {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-xs);
    width: 100%;
    padding: var(--space-m);
    background: var(--cream-200);
    border: 2px dashed var(--cream-400);
    border-radius: var(--radius);
    color: var(--ink-500);
    text-align: center;
  }
  .ed-placeholder__tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--green-400);
  }
  .ed-placeholder__label {
    font-size: var(--step--1);
    max-width: 32ch;
    line-height: 1.5;
  }
  .ed-placeholder__caption {
    margin-top: var(--space-xs);
    font-size: var(--step--1);
    color: var(--ink-500);
  }
</style>
