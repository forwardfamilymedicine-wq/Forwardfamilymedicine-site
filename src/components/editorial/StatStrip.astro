---
/**
 * Three (or so) figures in a sage band. Each figure must trace to something
 * the practice already publishes; do not add aspirational numbers here.
 */
export interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
---

<div class="ed-stats" role="list">
  <div class="ed-stats__inner">
    {stats.map(s => (
      <div class="ed-stat" role="listitem">
        <span class="ed-stat__value">{s.value}</span>
        <span class="ed-stat__label">{s.label}</span>
      </div>
    ))}
  </div>
</div>

<style>
  .ed-stats {
    background: var(--green-300);
    padding: clamp(28px, 4vw, 44px) 0;
  }
  .ed-stats__inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 0 clamp(16px, 4vw, 40px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }
  .ed-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--space-s) var(--space-m);
    border-right: 1px solid rgba(255, 255, 255, 0.22);
  }
  .ed-stat:last-child { border-right: none; }
  .ed-stat__value {
    font-family: var(--font-heading);
    font-size: var(--step-3);
    font-weight: 700;
    color: #ffffff;
    line-height: 1.1;
    margin-bottom: 0.35rem;
  }
  .ed-stat__label {
    font-size: var(--step--1);
    color: rgba(255, 255, 255, 0.85);
    line-height: 1.4;
  }
  @media (max-width: 640px) {
    .ed-stats__inner { grid-template-columns: 1fr; }
    .ed-stat {
      flex-direction: row;
      justify-content: space-between;
      align-items: baseline;
      text-align: left;
      gap: var(--space-m);
      padding: var(--space-s) 0;
      border-right: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.22);
    }
    .ed-stat:last-child { border-bottom: none; }
    .ed-stat__value { font-size: var(--step-2); margin: 0; }
  }
</style>
