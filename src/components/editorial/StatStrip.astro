---
/**
 * Three figures on forest with Playfair numerals under sage rules, per the
 * Local boards. Each figure must trace to something the practice already
 * publishes; do not add aspirational numbers here. A "$200/mo" value shows
 * its unit smaller. Figures fade up in turn on reveal.
 */
export interface Props {
  stats: { value: string; label: string }[];
}
const { stats } = Astro.props;
const split = (v: string) => {
  const m = v.match(/^(.*?)(\/[a-z]+)$/i);
  return m ? { main: m[1], unit: m[2] } : { main: v, unit: '' };
};
---

<section class="ed-stats" aria-label="Key figures">
  <div class="rd-wrap ed-stats__grid" data-reveal>
    {stats.map(s => {
      const v = split(s.value);
      return (
        <div class="ed-stat">
          <p class="ed-stat__value rd-serif">{v.main}{v.unit && <span class="ed-stat__unit">{v.unit}</span>}</p>
          <p class="ed-stat__label">{s.label}</p>
        </div>
      );
    })}
  </div>
</section>

<style>
  .ed-stats { background: var(--forest); color: var(--linen); padding: 64px 0; }
  .ed-stats__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 32px; }
  .ed-stat {
    padding: 24px 0;
    border-top: 1px solid var(--sage);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }
  .ed-stats__grid.on .ed-stat { opacity: 1; transform: none; }
  .ed-stats__grid.on .ed-stat:nth-child(2) { transition-delay: 0.2s; }
  .ed-stats__grid.on .ed-stat:nth-child(3) { transition-delay: 0.4s; }
  .ed-stat p { margin: 0; }
  .ed-stat__value { font-size: 52px; line-height: 1; letter-spacing: -0.02em; color: var(--linen); }
  .ed-stat__unit { font-size: 22px; letter-spacing: 0; }
  .ed-stat__label { margin-top: 12px !important; font-size: 14px; color: var(--on-forest); }
  @media (max-width: 860px) {
    .ed-stats { padding: 48px 0; }
    .ed-stats__grid { grid-template-columns: 1fr 1fr; }
    .ed-stat__value { font-size: 38px; }
  }
  @media (max-width: 480px) {
    .ed-stats__grid { grid-template-columns: 1fr; }
  }
</style>
