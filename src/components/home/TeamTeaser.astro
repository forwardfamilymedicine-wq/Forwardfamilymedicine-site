---
import { getCollection } from 'astro:content';
import ProviderCard from '../shared/ProviderCard.astro';
import { getAvailability } from '../../utils/availability';
import drBigleyPhoto from '../../assets/staff/dr-david-bigley.jpg';

const providers = (await getCollection('providers'))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);

// Split by availability, not by name, so this follows the data if a panel
// opens or closes later. Anyone not currently accepting drops out of the
// primary grid; the founder keeps his own block below.
const accepting = providers.filter(p => getAvailability(p.data).status !== 'full');
const founder = providers.find(p => p.data.slug === 'david-bigley-do');
const showFounderBlock = founder && getAvailability(founder.data).status === 'full';
---

<section class="team-teaser section" aria-label="Meet the team">
  <div class="container">
    <div class="team-header text-center">
      <span class="section-label">Your Care Team</span>
      <h2 class="section-title">Meet the Team</h2>
      <p class="section-intro" style="margin:0 auto;">
        Small panels, visits long enough to actually get somewhere, and direct
        access to the doctor who knows your history. The physicians below are
        accepting new patients now.
      </p>
    </div>

    <div class="team-grid">
      {accepting.map(p => <ProviderCard provider={p} />)}
    </div>

    {showFounderBlock && (
      <div class="founder-block">
        <div class="founder-header">
          <img
            src={drBigleyPhoto.src}
            alt="Dr. David Bigley, DO, founder of Forward Family Medicine"
            class="founder-photo"
            width="96"
            height="96"
            loading="lazy"
          />
          <div>
            <p class="founder-eyebrow">Our Founder</p>
            <h3 class="founder-heading">Founded by Dr. David Bigley, DO</h3>
          </div>
        </div>
        <p class="founder-body">
          Dr. Bigley opened Forward Family Medicine in 2024. His panel is
          currently full.
        </p>
        <p class="founder-body">
          That is the model working as designed. Every physician here practices
          with a deliberate cap on panel size, because the time, the direct
          access, and the continuity this practice is built on are only possible
          when a doctor has room for them. A full panel is that commitment kept.
        </p>
        <a href="/meet-the-team/david-bigley-do/" class="founder-link">
          Read Dr. Bigley's story →
        </a>
      </div>
    )}

    <div class="team-footer text-center">
      <a href="/meet-the-team/" class="team-all-link">+ Meet our wellness team →</a>
    </div>
  </div>
</section>

<style>
  .team-teaser {
    background: var(--cream-200);
  }
  .team-header {
    margin-bottom: 3rem;
  }
  /* Two accepting physicians: keep cards at card width and centred rather than
     letting them stretch across the full container. */
  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 360px));
    justify-content: center;
    gap: 2rem;
    margin-bottom: 2.5rem;
  }

  /* Founder block — secondary to the cards above, not a third card. */
  .founder-block {
    max-width: 680px;
    margin: 0 auto;
    padding: 2rem;
    background: var(--warm-50);
    border-radius: var(--radius);
    box-shadow: var(--shadow-sm);
  }
  /* Photo sits beside the eyebrow and heading as a credibility anchor, matching
     the circular treatment used by the blog AuthorBio. */
  .founder-header {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }
  .founder-photo {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 2px solid var(--green-200);
  }
  .founder-eyebrow {
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--green-500);
    margin: 0 0 0.35rem;
  }
  .founder-heading {
    font-size: 1.15rem;
    color: var(--ink-900);
    margin: 0;
  }
  .founder-body {
    font-size: 0.95rem;
    line-height: 1.75;
    color: var(--ink-700);
    margin: 0 0 1rem;
  }
  .founder-link {
    display: inline-block;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--green-400);
    text-decoration: none;
    transition: color 0.15s;
  }
  .founder-link:hover { color: var(--green-500); }

  .team-footer {
    margin-top: 1.5rem;
  }
  .team-all-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--green-400);
    text-decoration: none;
    transition: color 0.15s;
  }
  .team-all-link:hover { color: var(--green-500); }

  /* Override component flex sizing — grid handles width here */
  .team-grid :global(.provider-card) { max-width: none; min-width: 0; flex: unset; }

  @media (max-width: 780px) {
    .team-grid { grid-template-columns: minmax(0, 360px); }
  }
  @media (max-width: 540px) {
    .team-grid { grid-template-columns: 1fr; }
    .founder-block { padding: 1.5rem; }
    .founder-header { gap: 1rem; }
    .founder-photo { width: 72px; height: 72px; }
  }
</style>
