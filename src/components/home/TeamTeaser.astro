---
/**
 * Meet the Team: the physicians accepting new patients as portrait rows with
 * a status line naming their office and their credential paragraph, then the
 * founder row. Split by availability, not by name, so this follows the data
 * if a panel opens or closes later.
 *
 * The credential paragraphs are reproduced from the previous proof section
 * and must stay in step with the provider files.
 */
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { getAvailability } from '../../utils/availability';
import drBigleyPhoto from '../../assets/staff/dr-david-bigley.jpg';

const providers = (await getCollection('providers'))
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);
const openOffices = (await getCollection('locations'))
  .filter(l => l.data.status === 'open')
  .sort((a, b) => a.data.displayOrder - b.data.displayOrder);

const accepting = providers.filter(p => getAvailability(p.data).status !== 'full');
const founder = providers.find(p => p.data.slug === 'david-bigley-do');
const showFounderBlock = founder && getAvailability(founder.data).status === 'full';

const credentialCopy: Record<string, string> = {
  'philip-lieberman-md': 'Dual board-certified in Family Medicine and Lifestyle Medicine, and a diplomate of the American Board of Lifestyle Medicine. During residency at Abington he built the Lifestyle Medicine curriculum that qualified fellow residents for that same board certification. Before medicine, an Associate of Science in Culinary Arts and a Bachelor of Science in Nutrition Science.',
  'brian-landi-do': 'Board-certified through the American Osteopathic Board of Family Physicians and a Menopause Society Certified Practitioner. Served as Chief Resident of the ChristianaCare Family Medicine residency.',
};

/** The open office a physician sees patients at, by display order. */
function officeName(slugs: string[]): string | undefined {
  return openOffices.find(l => slugs.includes(l.data.slug))?.data.name;
}
const lastName = (name: string) => name.split(' ').slice(-1)[0];
---

<section class="team" aria-label="Meet the team">
  <div class="rd-wrap">
    <div class="team-head">
      <h2 class="rd-h2">Meet the Team</h2>
      <p class="team-intro">
        Small panels, visits long enough to actually get somewhere, and direct
        access to the doctor who knows your history. The physicians below are
        accepting new patients now.
      </p>
    </div>

    <div class="team-grid">
      {accepting.map(p => {
        const office = officeName(p.data.locations);
        return (
          <article class="physician">
            {p.data.photo && (
              <Image
                src={p.data.photo}
                alt={p.data.photoAlt}
                class="physician-photo"
                width={400}
                height={500}
                widths={[200, 400, 600]}
                sizes="(max-width: 860px) 160px, 200px"
                format="webp"
                quality={82}
                loading="lazy"
              />
            )}
            <div class="physician-body">
              <p class="rd-eyebrow rd-eyebrow--gold">Accepting new patients{office && ` · ${office}`}</p>
              <h3 class="physician-name rd-serif">{p.data.name}, {p.data.credentials}</h3>
              <p class="physician-title">{p.data.title}</p>
              <div class="rd-hair physician-hair"></div>
              {credentialCopy[p.data.slug] && <p class="physician-cred">{credentialCopy[p.data.slug]}</p>}
              <a class="rd-link physician-link" href={`/meet-the-team/${p.data.slug}/`}>Meet Dr. {lastName(p.data.name)} →</a>
            </div>
          </article>
        );
      })}
    </div>

    {showFounderBlock && (
      <div class="founder">
        <Image
          src={drBigleyPhoto}
          alt="Dr. David Bigley, DO, founder of Forward Family Medicine"
          class="founder-photo"
          width={240}
          height={240}
          widths={[120, 240, 360]}
          sizes="(max-width: 860px) 96px, 120px"
          format="webp"
          quality={82}
          loading="lazy"
        />
        <div class="founder-body">
          <h3 class="founder-heading rd-serif">Founded by Dr. David Bigley, DO</h3>
          <p>Dr. Bigley opened Forward Family Medicine in 2024. His panel is currently full.</p>
          <p>
            That is the model working as designed. Every physician here practices
            with a deliberate cap on panel size, because the time, the direct
            access, and the continuity this practice is built on are only possible
            when a doctor has room for them. A full panel is that commitment kept.
          </p>
          <div class="founder-links">
            <a class="rd-link" href="/meet-the-team/david-bigley-do/">Read Dr. Bigley's story →</a>
            <a class="rd-link" href="/meet-the-team/">+ Meet our wellness team →</a>
          </div>
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .team {
    background: var(--linen-50);
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
    padding: 96px 0;
  }
  .team-head { display: flex; flex-direction: column; gap: 14px; max-width: 640px; }
  .team-intro { font-size: 16px; line-height: 1.7; color: var(--text-700); margin: 0; }

  .team-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 48px;
    margin-top: 56px;
  }
  .physician {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }
  .physician-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 2px;
  }
  .physician-body { display: flex; flex-direction: column; gap: 10px; }
  .physician-name { font-size: 30px; line-height: 1.1; color: var(--forest); margin: 4px 0 0; }
  .physician-title { font-size: 14px; color: var(--sage-600); font-weight: 500; margin: 0; }
  .physician-hair { margin: 6px 0; }
  .physician-cred { font-size: 14px; line-height: 1.7; color: var(--text-700); margin: 0; }
  .physician-link { align-self: flex-start; margin-top: 8px; }

  .founder {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--hairline-strong);
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 32px;
    align-items: start;
  }
  .founder-photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    object-position: 50% 15%;
    border-radius: 50%;
  }
  .founder-body { display: flex; flex-direction: column; gap: 10px; max-width: 720px; }
  .founder-heading { font-size: 26px; line-height: 1.2; color: var(--forest); margin: 0; }
  .founder-body p { font-size: 15px; line-height: 1.7; color: var(--text-700); margin: 0; }
  .founder-links { display: flex; gap: 28px; flex-wrap: wrap; margin-top: 6px; }

  @media (max-width: 860px) {
    .team { padding: 64px 0; }
    .team-grid { grid-template-columns: 1fr; gap: 28px; margin-top: 36px; }
    .physician { grid-template-columns: 160px minmax(0, 1fr); gap: 20px; }
    .physician-name { font-size: 24px; }
    .founder { grid-template-columns: 96px minmax(0, 1fr); gap: 20px; margin-top: 40px; }
  }
  @media (max-width: 540px) {
    .physician { grid-template-columns: 1fr; }
    .physician-photo { max-width: 200px; }
  }
</style>
