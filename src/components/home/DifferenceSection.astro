---
/**
 * The four structural differences as pillars (fade in left to right), then
 * the visit comparison: the "Here" column fills row by row while the
 * "Elsewhere" rows below the cut line grey out. Reduced motion renders the
 * end states.
 */
import TitledGrid from '../shared/TitledGrid.astro';

const pillars = [
  {
    lead: '250',
    title: 'Small panels',
    body: 'Roughly 250 patients per physician, against the two to three thousand a traditional practice carries. Everything below follows from this one number.',
  },
  {
    lead: '1–2 hr',
    title: 'Longer visits',
    body: 'One to two hours, scheduled that way by default. Not a longer visit when you ask for one — the standard appointment is simply long enough to finish.',
  },
  {
    lead: 'Your doctor\'s number',
    title: 'Direct access',
    body: 'Your physician\'s phone, text, and email. Not a portal queue, not a message relayed through staff, not a callback from whoever is on that afternoon.',
  },
  {
    lead: 'Part of every visit',
    title: 'Proactive care',
    body: 'Prevention and Lifestyle Medicine are part of the appointment rather than a referral out of it. Nutrition, movement, sleep, and stress get clinical time.',
  },
];

const visitItems = [
  'The reason you booked',
  'The sleep that hasn\'t been right since spring',
  'The medication you quietly stopped',
  'Your father\'s diagnosis, and whether it\'s yours too',
  'The question you were saving',
  'A plan you could actually follow',
];
---

<section class="difference" aria-label="What makes us different">
  <div class="rd-wrap">
    <h2 class="rd-h2">Four things we do differently</h2>
    <div class="difference-rule"></div>
    <TitledGrid items={pillars} columns={4} variant="pillars" reveal />

    <div class="fits" data-reveal>
      <h3 class="fits-h3 rd-serif">The visit doesn't end before the conversation does.</h3>
      <div class="fits-grid">
        <div class="fits-col fits-col--else">
          <div class="fits-head">
            <p class="rd-eyebrow rd-eyebrow--muted">Elsewhere</p>
            <div class="fits-title rd-serif">A typical primary care visit</div>
            <div class="fits-sub">Scheduled in 15-minute increments</div>
          </div>
          <ol class="fits-list">
            <li class="fit-a">{visitItems[0]}</li>
          </ol>
          <div class="fit-cut">
            <span class="fit-cut-line"></span>
            <span class="rd-eyebrow fit-cut-label">Where fifteen minutes usually runs out</span>
            <span class="fit-cut-line"></span>
          </div>
          <ol class="fits-list fit-rest">
            {visitItems.slice(1).map(item => <li>{item}</li>)}
          </ol>
        </div>
        <div class="fits-col fits-col--here">
          <div class="fits-head">
            <p class="rd-eyebrow">Here</p>
            <div class="fits-title rd-serif">A visit at Forward Family Medicine</div>
            <div class="fits-sub">Scheduled for one to two hours, by default</div>
          </div>
          <ol class="fits-list fit-b">
            {visitItems.map((item, i) => <li class={i === visitItems.length - 1 ? 'fit-last' : undefined}>{item}</li>)}
          </ol>
          <div class="fit-end">
            <span class="fit-end-line"></span>
            <span class="rd-eyebrow fit-end-label">Nobody is standing at the door</span>
            <span class="fit-end-line"></span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .difference { background: var(--linen); padding: 96px 0 88px; }
  .difference-rule { height: 1px; background: var(--sage); margin: 36px 0 32px; }

  .fits { margin-top: 88px; padding-top: 56px; border-top: 1px solid var(--hairline-strong); }
  .fits-h3 {
    font-size: 38px;
    line-height: 1.12;
    letter-spacing: -0.01em;
    color: var(--forest);
    max-width: 18ch;
    margin: 0;
  }
  .fits-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 32px;
    align-items: start;
    margin-top: 40px;
  }
  .fits-col { padding: 28px 28px 20px; }
  .fits-col--else { border: 1px solid var(--hairline-strong); background: var(--linen); }
  .fits-col--here { background: var(--sage-50); border: 1px solid var(--sage); border-top: 3px solid var(--forest); }
  .fits-head { padding-bottom: 14px; border-bottom: 1px solid var(--hairline-strong); }
  .fits-col--here .fits-head { border-bottom-color: var(--sage); }
  .fits-title { font-size: 22px; line-height: 1.2; margin-top: 6px; color: var(--forest); }
  .fits-col--else .fits-title { color: var(--text-600); }
  .fits-sub { font-size: 13px; margin-top: 4px; color: var(--sage-600); }
  .fits-col--else .fits-sub { color: var(--text-500); }
  .fits-list {
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
    line-height: 1.5;
    color: var(--forest);
  }
  .fits-list li { padding: 13px 0; border-bottom: 1px solid var(--hairline); }
  .fits-col--here .fits-list li { border-bottom-color: #D4DBD0; }
  .fits-list li:last-child { border-bottom: 0; }
  .fit-last { font-weight: 500; }
  .fit-cut, .fit-end { display: flex; align-items: center; gap: 12px; margin: 6px 0; }
  .fit-end { margin: 6px 0 0; }
  .fit-cut-line { flex: 1; height: 2px; background: var(--text-400); }
  .fit-end-line { flex: 1; height: 2px; background: var(--sage-600); }
  .fit-cut-label, .fit-end-label { font-size: 10px; letter-spacing: 0.08em; white-space: nowrap; }
  .fit-cut-label { color: var(--text-400); }

  /* Motion */
  .fit-a, .fit-b li { opacity: 0; transform: translateY(6px); transition: opacity 0.4s ease, transform 0.4s ease; }
  .fits.on .fit-a { opacity: 1; transform: none; transition-delay: 0.2s; }
  .fits.on .fit-b li { opacity: 1; transform: none; }
  .fits.on .fit-b li:nth-child(1) { transition-delay: 0.2s; }
  .fits.on .fit-b li:nth-child(2) { transition-delay: 0.45s; }
  .fits.on .fit-b li:nth-child(3) { transition-delay: 0.7s; }
  .fits.on .fit-b li:nth-child(4) { transition-delay: 0.95s; }
  .fits.on .fit-b li:nth-child(5) { transition-delay: 1.2s; }
  .fits.on .fit-b li:nth-child(6) { transition-delay: 1.45s; }
  .fit-end { opacity: 0; transition: opacity 0.5s ease 1.9s; }
  .fits.on .fit-end { opacity: 1; }
  .fit-cut { opacity: 0; transform: scaleX(0.2); transform-origin: center; transition: opacity 0.35s ease 0.8s, transform 0.5s ease 0.8s; }
  .fits.on .fit-cut { opacity: 1; transform: none; }
  .fit-rest { transition: color 0.6s ease 1.3s; }
  .fits.on .fit-rest { color: var(--text-500); }

  @media (prefers-reduced-motion: reduce) {
    .fit-a, .fit-b li, .fit-end, .fit-cut { opacity: 1; transform: none; }
    .fit-rest { color: var(--text-500); }
  }

  @media (max-width: 860px) {
    .difference { padding: 64px 0; }
    .fits { margin-top: 56px; padding-top: 40px; }
    .fits-h3 { font-size: 30px; max-width: none; }
    .fits-grid { grid-template-columns: 1fr; gap: 28px; }
    .fits-col { padding: 22px 20px 16px; }
  }
</style>
