---
/**
 * Homepage hero, per design/boards/Main.dc.html: copy left, the Wayne
 * window-chairs photo right, a hairline and three plain facts below.
 */
import { Picture } from 'astro:assets';
import windowChairs from '../../assets/office/wayne-window-chairs.jpg';
---

<section class="hero" aria-label="Hero">
  <div class="rd-wrap">
    <div class="hero-grid">
      <div class="hero-content">
        <p class="rd-eyebrow">Wayne, PA &middot; Malvern, PA</p>
        <h1 class="hero-h1 rd-serif">Primary care with the time to know you.</h1>
        <p class="hero-sub">
          Forward Family Medicine is a membership primary care practice in Wayne, PA.
          Visits run one to two hours. You reach your doctor directly by phone, text,
          or email. Each physician caps their panel at roughly 250 patients. We are the
          only Direct Primary Care practice on the Main Line with in-person,
          board-certified Lifestyle Medicine included in every membership.
        </p>
        <div class="hero-ctas">
          <a href="/contact/" class="btn-forest">Schedule a Free Meet &amp; Greet</a>
          <a href="#meet-your-doctor" class="rd-link">Meet the physicians accepting patients</a>
        </div>
      </div>
      <Picture
        src={windowChairs}
        alt="Two green armchairs by a sunlit window in the Wayne office"
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 860px) calc(100vw - 40px), 470px"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        class="hero-img"
        pictureAttributes={{ class: 'hero-pic' }}
      />
    </div>
    <div class="rd-hair hero-hair"></div>
    <ul class="hero-facts">
      <li>Accepting new patients now</li>
      <li>Free meet &amp; greet, no obligation</li>
      <li>No insurance required</li>
    </ul>
  </div>
</section>

<style>
  .hero {
    background: var(--linen);
    padding: 96px 0 72px;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 64px;
    align-items: end;
  }
  .hero-content { display: flex; flex-direction: column; gap: 28px; }
  .hero-h1 {
    font-size: 72px;
    line-height: 1.02;
    letter-spacing: -0.015em;
    color: var(--forest);
    max-width: 10.5ch;
    margin: 0;
  }
  .hero-sub {
    font-size: 18px;
    line-height: 1.65;
    color: var(--text-900);
    max-width: 560px;
    margin: 0;
  }
  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-top: 6px;
  }
  .hero-pic { display: block; }
  .hero-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 60% 50%;
    border-radius: 2px;
  }
  .hero-hair { margin-top: 56px; }
  .hero-facts {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
  }
  .hero-facts li {
    flex: 1 1 200px;
    padding: 22px 32px 0 0;
    font-size: 14px;
    font-weight: 500;
    color: var(--sage-600);
  }
  .hero-facts li:last-child { padding-right: 0; }

  @media (max-width: 860px) {
    .hero { padding: 64px 0; }
    .hero-grid { grid-template-columns: 1fr; gap: 28px; }
    .hero-h1 { font-size: 42px; max-width: none; }
    .hero-hair { margin-top: 36px; }
  }
</style>
