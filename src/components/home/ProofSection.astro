---
/**
 * Reviews: the fourteen Google reviews from src/data/reviews.json rendered
 * twice as a marquee (translateX(-50%) loop, ~90s; 28s when sped up), paused
 * on hover and focus-within, with Pause and Speed controls. Reduced motion
 * shows a static grid with the duplicate set hidden and the controls gone.
 *
 * The text is reproduced from Google as supplied and must not be reworded,
 * reordered, or "tightened"; a trimmed excerpt would need ellipses. Order is
 * load-bearing: the first four cards are about physicians accepting new
 * patients, so no review of Dr. Bigley's care leads the marquee or shows on
 * the first screen while his panel is full. The Top Doctor note below the
 * marquee keeps his reviews in founder context.
 *
 * To do: if a sub-five-star review ever appears, swap the subline for a
 * count-based line.
 */
import { Image } from 'astro:assets';
import reviewsData from '../../data/reviews.json';
import GoogleReviewsLink from '../shared/GoogleReviewsLink.astro';
import topDoctorBadge from '../../assets/awards/main-line-today-top-doctor-2026.png';

interface Review { who: string; text: string }
const reviews = reviewsData as Review[];
---

<section class="proof" aria-label="Patient reviews">
  <div class="rd-wrap proof-head">
    <div class="proof-intro">
      <h2 class="rd-h2">Don't take our word for it.</h2>
      <p class="proof-sub">Every Google review of this practice and our physicians is five stars. Here are some of them, in patients' own words.</p>
    </div>
    <div class="proof-aside">
      <GoogleReviewsLink align="end" />
      <div class="marq-controls">
        <button type="button" class="ctl" id="marq-pause" aria-pressed="false">Pause</button>
        <button type="button" class="ctl" id="marq-speed" aria-pressed="false">Speed up</button>
      </div>
    </div>
  </div>

  <div class="marq" id="marq" role="region" aria-label="Verified Google reviews">
    <div class="marq-track" id="marq-track">
      {reviews.map(r => (
        <blockquote class="rev">
          <span class="rev-mark rd-serif" aria-hidden="true">“</span>
          <p class="rev-text">{r.text}</p>
          <footer class="rev-foot"><strong>{r.who}</strong> — Verified Google review</footer>
        </blockquote>
      ))}
      {reviews.map(r => (
        <blockquote class="rev marq-dup" aria-hidden="true">
          <span class="rev-mark rd-serif">“</span>
          <p class="rev-text">{r.text}</p>
          <footer class="rev-foot"><strong>{r.who}</strong> — Verified Google review</footer>
        </blockquote>
      ))}
    </div>
  </div>

  <div class="rd-wrap">
    <div class="topdoc">
      <Image
        src={topDoctorBadge}
        alt="Main Line Today Top Doctor 2026 badge"
        class="topdoc-badge"
        width={192}
        widths={[96, 192, 288]}
        sizes="96px"
        format="webp"
        quality={90}
        loading="lazy"
      />
      <p class="topdoc-text">
        Two of our physicians, Dr. David Bigley and Dr. Philip Lieberman, were
        named Main Line Today Top Doctors for 2026. Dr. Bigley opened the
        practice in September 2024. His panel is full and he is not currently
        taking new patients; the reviews of his care above are here as history
        rather than as an invitation. They describe the standard this practice
        was built to hold.
      </p>
    </div>
  </div>
</section>

<style>
  .proof { background: var(--linen); padding: 96px 0; }
  .proof-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 20px 40px;
  }
  .proof-intro { display: flex; flex-direction: column; gap: 16px; max-width: 620px; }
  .proof-sub { font-size: 17px; line-height: 1.6; color: var(--text-900); margin: 0; }
  .proof-aside { display: flex; flex-direction: column; align-items: flex-end; gap: 14px; }
  .marq-controls { display: flex; gap: 8px; }
  .ctl {
    font-family: var(--font-body);
    font-size: 13px;
    font-weight: 500;
    color: var(--sage-600);
    background: transparent;
    border: 1px solid var(--sage);
    border-radius: 999px;
    padding: 8px 14px;
    min-height: 36px;
    cursor: pointer;
    transition: background 0.18s, color 0.18s, border-color 0.18s;
  }
  .ctl:hover { background: var(--sage-600); color: var(--linen); border-color: var(--sage-600); }
  .ctl[aria-pressed="true"] { background: var(--forest); color: var(--linen); border-color: var(--forest); }

  .marq {
    overflow: hidden;
    margin-top: 36px;
    padding: 28px 0;
    border-top: 1px solid var(--hairline);
    border-bottom: 1px solid var(--hairline);
  }
  .marq-track {
    display: flex;
    gap: 24px;
    width: max-content;
    padding-left: 24px;
    animation: marq 90s linear infinite;
    will-change: transform;
  }
  .marq:hover .marq-track,
  .marq:focus-within .marq-track,
  .marq-track.paused { animation-play-state: paused; }
  .marq-track.fast { animation-duration: 28s; }
  @keyframes marq {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .rev {
    margin: 0;
    width: 400px;
    flex: 0 0 400px;
    min-height: 280px;
    padding: 28px 30px 24px;
    background: var(--linen-50);
    border: 1px solid var(--hairline);
    display: flex;
    flex-direction: column;
    gap: 16px;
    transition: border-color 0.2s;
  }
  .rev:hover { border-color: var(--sage); }
  .rev-mark { font-size: 56px; line-height: 0.5; color: var(--sage-mark); }
  .rev-text { margin: 0; font-size: 15px; line-height: 1.7; color: var(--text-900); }
  .rev-foot { font-size: 13px; color: var(--sage-600); margin-top: auto; }
  .rev-foot strong { color: var(--forest); }

  .topdoc {
    margin-top: 64px;
    padding-top: 40px;
    border-top: 1px solid var(--hairline-strong);
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    max-width: 820px;
  }
  .topdoc-badge { width: 96px; height: auto; display: block; }
  .topdoc-text { margin: 0; font-size: 14px; line-height: 1.7; color: var(--text-700); }

  @media (max-width: 860px) {
    .proof { padding: 64px 0; }
    .proof-aside { align-items: flex-start; }
    .rev { width: 300px; flex-basis: 300px; }
    .marq-track { animation-duration: 60s; }
    .marq-track.fast { animation-duration: 20s; }
    .topdoc { grid-template-columns: 72px minmax(0, 1fr); gap: 16px; margin-top: 40px; }
    .topdoc-badge { width: 72px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .marq-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      padding: 0 var(--content-pad);
      max-width: var(--content-w);
      margin: 0 auto;
    }
    .marq-dup { display: none; }
    .rev { width: auto; flex: 1 1 300px; }
    .marq-controls { display: none; }
  }
</style>

<script>
  const track = document.getElementById('marq-track');
  const pauseBtn = document.getElementById('marq-pause');
  const speedBtn = document.getElementById('marq-speed');

  pauseBtn?.addEventListener('click', () => {
    const paused = pauseBtn.getAttribute('aria-pressed') !== 'true';
    pauseBtn.setAttribute('aria-pressed', String(paused));
    pauseBtn.textContent = paused ? 'Resume' : 'Pause';
    track?.classList.toggle('paused', paused);
  });
  speedBtn?.addEventListener('click', () => {
    const fast = speedBtn.getAttribute('aria-pressed') !== 'true';
    speedBtn.setAttribute('aria-pressed', String(fast));
    speedBtn.textContent = fast ? 'Slow down' : 'Speed up';
    track?.classList.toggle('fast', fast);
  });
</script>
