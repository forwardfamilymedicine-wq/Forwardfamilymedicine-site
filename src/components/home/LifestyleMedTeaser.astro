---
/**
 * Lifestyle Medicine on a forest band: the case on the left, the "included
 * in every membership" card on the right.
 */
import RuledList from '../shared/RuledList.astro';

const credentials = [
  { title: 'Board-Certified', sub: 'American Board of Lifestyle Medicine' },
  { title: 'Culinary Arts + Nutrition Science', sub: 'Pre-medical training in food and metabolism' },
  { title: 'Built a Physician Training Curriculum', sub: 'Dr. Lieberman trained other physicians in Lifestyle Medicine' },
];
---

<section class="lm" aria-label="Lifestyle Medicine">
  <div class="rd-wrap lm-grid">
    <div class="lm-content">
      <h2 class="lm-h2 rd-serif">We don't just talk about lifestyle. We make it part of your care.</h2>
      <p class="lm-text">
        Lifestyle medicine is an evidence-based clinical specialty focused on preventing,
        treating, and reversing chronic disease through nutrition, movement, sleep, and
        stress. Dr. Lieberman is board-certified in it alongside Family Medicine, and
        during residency he built the Lifestyle Medicine curriculum that enabled fellow
        residents to qualify for that certification. He trained in culinary arts and
        nutrition science before medical school, which is what lets him make the food
        part of a plan specific enough to follow.
      </p>
      <p class="lm-pull rd-serif">
        At Forward Family Medicine, lifestyle medicine is built into how we
        practice, not an afterthought.
      </p>
      <div class="lm-creds">
        {credentials.map(c => (
          <div>
            <div class="lm-cred-title">{c.title}</div>
            <div class="lm-cred-sub">{c.sub}</div>
          </div>
        ))}
      </div>
      <a href="/lifestyle-medicine/" class="btn-sage lm-cta">Learn About Our Lifestyle Medicine Approach →</a>
    </div>

    <div class="lm-card">
      <p class="rd-eyebrow">Included in every membership</p>
      <h3 class="lm-card-h3 rd-serif">Lifestyle Medicine, built into primary care.</h3>
      <p class="lm-card-lead">
        No other local DPC practice offers it at all. We offer it in person, integrated into every visit — included in your membership.
      </p>
      <RuledList size="sm" class="lm-list">
        <li>Personalized nutrition guidance from a culinary-trained physician</li>
        <li>Evidence-based protocols for diabetes, hypertension &amp; heart health</li>
        <li>Physical activity planning that fits your real life</li>
        <li>Sleep optimization and stress management</li>
        <li>Ongoing accountability — not a one-time conversation</li>
        <li class="lm-list-last">No extra fee — included in your DPC membership</li>
      </RuledList>
    </div>
  </div>
</section>

<style>
  .lm {
    background: var(--forest);
    color: var(--linen);
    padding: 104px 0;
  }
  .lm-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 72px;
    align-items: start;
  }
  .lm-content { display: flex; flex-direction: column; gap: 22px; }
  .lm-h2 {
    font-size: 52px;
    line-height: 1.06;
    letter-spacing: -0.012em;
    color: var(--linen);
    margin: 0;
  }
  .lm-text { font-size: 17px; line-height: 1.7; color: var(--on-forest); max-width: 560px; margin: 0; }
  .lm-pull { font-size: 26px; line-height: 1.35; color: var(--linen); max-width: 560px; margin: 4px 0 0; }
  .lm-creds {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 12px;
    padding-top: 24px;
    border-top: 1px solid var(--sage);
  }
  .lm-cred-title { font-size: 15px; font-weight: 600; color: var(--linen); }
  .lm-cred-sub { font-size: 13px; color: var(--on-forest-faint); margin-top: 4px; line-height: 1.5; }
  .lm-cta { align-self: flex-start; margin-top: 10px; }

  .lm-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 36px 36px 28px;
    background: var(--linen);
    border-top: 4px solid var(--sage);
    color: var(--forest);
  }
  .lm-card-h3 { font-size: 28px; line-height: 1.15; color: var(--forest); margin: 0; }
  .lm-card-lead { font-size: 15px; line-height: 1.7; color: var(--text-700); margin: 0; }
  .lm-list { margin-top: 6px; }
  .lm-list :global(.lm-list-last) { color: var(--sage-600); font-weight: 600; }

  @media (max-width: 860px) {
    .lm { padding: 64px 0; }
    .lm-grid { grid-template-columns: 1fr; gap: 28px; }
    .lm-h2 { font-size: 34px; }
    .lm-pull { font-size: 22px; }
    .lm-creds { grid-template-columns: 1fr; gap: 16px; }
    .lm-card { padding: 28px 22px 22px; }
  }
</style>
