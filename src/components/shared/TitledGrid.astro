---
/**
 * Titled grid: 2, 3 or 4 columns of serif heading + body, each column opened
 * by a hairline. `variant="pillars"` is the homepage's "Four things we do
 * differently" treatment: a large serif lead above each title, the first
 * column wider with a rule on its right, and a left-to-right fade-in on
 * reveal. Items stack to one column under 860px.
 */
export interface GridItem {
  /** Large serif word or figure above the title (pillars variant). */
  lead?: string;
  title: string;
  body: string;
}

export interface Props {
  items: GridItem[];
  columns?: 2 | 3 | 4;
  variant?: 'default' | 'pillars';
  reveal?: boolean;
  class?: string;
}

const { items, columns = 3, variant = 'default', reveal = false, class: className = '' } = Astro.props;
---

<div
  class:list={['titled-grid', `titled-grid--${columns}`, `titled-grid--${variant}`, className]}
  data-reveal={reveal ? '' : undefined}
>
  {items.map(item => (
    <div class="titled-grid__item">
      {item.lead && <div class="titled-grid__lead rd-serif">{item.lead}</div>}
      <h3 class="titled-grid__title">{item.title}</h3>
      <p class="titled-grid__body">{item.body}</p>
    </div>
  ))}
</div>

<style>
  .titled-grid { display: grid; gap: 40px; }
  .titled-grid--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 48px; }
  .titled-grid--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .titled-grid--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 36px; }
  .titled-grid__item { display: flex; flex-direction: column; gap: 12px; }

  /* Default: serif title over a hairline. */
  .titled-grid--default .titled-grid__item {
    padding-top: 20px;
    border-top: 1px solid var(--hairline-strong);
  }
  .titled-grid--default .titled-grid__title {
    font-family: var(--font-heading);
    font-weight: 400;
    font-size: 22px;
    line-height: 1.25;
    color: var(--forest);
    margin: 0;
  }
  .titled-grid__body {
    font-size: 14px;
    line-height: 1.65;
    color: var(--text-700);
    margin: 0;
  }

  /* Pillars: lead figure, Inter title, first column wider with a right rule. */
  .titled-grid--pillars.titled-grid--4 { grid-template-columns: 1.5fr 1fr 1fr 1fr; }
  .titled-grid--pillars .titled-grid__lead {
    font-size: 30px;
    line-height: 1.1;
    color: var(--sage-600);
  }
  .titled-grid--pillars .titled-grid__item:first-child .titled-grid__lead {
    font-size: 56px;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--forest);
  }
  .titled-grid--pillars .titled-grid__item:first-child {
    padding-right: 28px;
    border-right: 1px solid var(--hairline-strong);
  }
  .titled-grid--pillars .titled-grid__title {
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 600;
    color: var(--forest);
    margin: 6px 0 0;
    line-height: 1.3;
  }

  /* Reveal: items fade in left to right. */
  [data-reveal] .titled-grid__item {
    opacity: 0;
    transform: translateX(-14px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .titled-grid.on .titled-grid__item { opacity: 1; transform: none; }
  .titled-grid.on .titled-grid__item:nth-child(1) { transition-delay: 0.1s; }
  .titled-grid.on .titled-grid__item:nth-child(2) { transition-delay: 0.35s; }
  .titled-grid.on .titled-grid__item:nth-child(3) { transition-delay: 0.6s; }
  .titled-grid.on .titled-grid__item:nth-child(4) { transition-delay: 0.85s; }

  @media (max-width: 860px) {
    .titled-grid--2, .titled-grid--3, .titled-grid--4,
    .titled-grid--pillars.titled-grid--4 { grid-template-columns: 1fr; gap: 28px; }
    .titled-grid--pillars .titled-grid__item:first-child { padding-right: 0; border-right: 0; }
  }
</style>
