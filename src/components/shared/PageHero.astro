---
/**
 * Support-page hero, per the Phase 4 boards: breadcrumb, serif H1, a lede in
 * the default slot, optional actions in `after`, and an optional `aside` (a
 * photo) in a second column. Copy is whatever the page passes in; this holds
 * only the layout. The aside is the page's LCP element, so the page loads it
 * eagerly.
 */
export interface Props {
  /** Current page, last crumb. `trail` adds links between Home and it. */
  crumb: string;
  trail?: { label: string; href: string }[];
  title: string;
  /** Title size in px (the boards use 60 to 64). */
  size?: number;
  /** Title max width in ch. */
  ch?: number;
  /** Max width of the copy column in px (single column only). */
  maxW?: number;
  /** Column template when there is an aside, e.g. "1.3fr .7fr". */
  cols?: string;
  /** Top and bottom padding in px. */
  pt?: number;
  pb?: number;
  /** Lede size in px. */
  lede?: number;
}
const {
  crumb, trail = [], title, size = 64, ch, maxW = 760, cols = '1.2fr .8fr',
  pt = 80, pb = 80, lede = 18,
} = Astro.props;
const hasAside = Astro.slots.has('aside');
const style = `--ph-size:${size}px;--ph-pt:${pt}px;--ph-pb:${pb}px;--ph-lede:${lede}px;--ph-max:${maxW}px;--ph-cols:${cols.split(' ').map(c => `minmax(0,${c})`).join(' ')};`;
---
<section class="ph" style={style}>
  <div class="rd-wrap">
    <nav class="rd-crumb" aria-label="Breadcrumb">
      <a href="/">Home</a> <span aria-hidden="true">›</span>
      {trail.map(t => <Fragment><a href={t.href}>{t.label}</a> <span aria-hidden="true">›</span> </Fragment>)}
      <span aria-current="page">{crumb}</span>
    </nav>
    <div class:list={['ph__grid', { 'ph__grid--split': hasAside }]}>
      <div class="ph__copy">
        <h1 class="ph__title rd-serif" style={ch ? `max-width:${ch}ch` : undefined}>{title}</h1>
        <div class="ph__lede"><slot /></div>
        <slot name="after" />
      </div>
      {hasAside && <div class="ph__aside"><slot name="aside" /></div>}
    </div>
  </div>
</section>
<style>
  .ph { background: var(--linen); padding: var(--ph-pt) 0 var(--ph-pb); }
  .ph__grid { display: block; }
  .ph__grid--split { display: grid; grid-template-columns: var(--ph-cols); gap: 72px; align-items: center; }
  .ph__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .ph__grid:not(.ph__grid--split) .ph__copy { max-width: var(--ph-max); }
  .ph__title {
    margin: 0;
    font-size: var(--ph-size);
    line-height: 1.03;
    letter-spacing: -0.018em;
    color: var(--forest);
  }
  .ph__lede { display: flex; flex-direction: column; gap: 14px; max-width: var(--ph-max); }
  .ph__lede :global(p) { margin: 0; font-size: var(--ph-lede); line-height: 1.7; color: var(--text-900); }
  .ph__lede:empty { display: none; }
  .ph__lede :global(a:not([class])) { color: var(--sage-600); border-bottom: 1px solid var(--sage); text-decoration: none; }
  .ph__lede :global(a:not([class]):hover) { color: var(--forest); border-color: var(--forest); }
  .ph__aside :global(img), .ph__aside :global(picture) { display: block; width: 100%; }
  .ph__aside :global(img) { height: auto; object-fit: cover; border-radius: 2px; }
  @media (max-width: 860px) {
    .ph { padding: 48px 0 56px; }
    .ph__grid--split { grid-template-columns: 1fr; gap: 36px; }
    .ph__aside { max-width: 420px; }
    .ph__title { font-size: 40px; max-width: none !important; }
    .ph__lede :global(p) { font-size: 17px; }
  }
</style>
