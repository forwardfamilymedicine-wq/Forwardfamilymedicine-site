---
/**
 * Service-page hero, per the Phase 2 boards: copy left, optional photo right.
 * `tone="light"` is the linen hero (DPC, Services, Membership...); `tone="dark"`
 * is the forest hero (Concierge). CTAs go in the default slot, anything that
 * belongs between the lede and the buttons (a citation line) in `after`.
 * The photo is eager and high priority: it is the LCP element.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface Props {
  title: string;
  /** Status or place line above the title. Use only where it does a job. */
  eyebrow?: string;
  tone?: 'light' | 'dark';
  image?: ImageMetadata;
  alt?: string;
  aspect?: string;
  position?: string;
  /** Max width of the title in ch; the boards set 14ch on the large titles. */
  titleCh?: number;
}

const {
  title, eyebrow, tone = 'light', image, alt = '', aspect = '4/5',
  position = '50% 50%', titleCh = 14,
} = Astro.props;
---

<section class:list={['svc-hero', `svc-hero--${tone}`]}>
  <div class:list={['rd-wrap', 'svc-hero__grid', { 'svc-hero__grid--solo': !image }]}>
    <div class="svc-hero__copy">
      <slot name="before" />
      {eyebrow && <p class="rd-eyebrow svc-hero__eyebrow">{eyebrow}</p>}
      <h1 class="svc-hero__title rd-serif" style={`max-width:${titleCh}ch`}>{title}</h1>
      <div class="svc-hero__lede"><slot name="lede" /></div>
      <slot name="after" />
      <div class="svc-hero__ctas"><slot /></div>
    </div>
    {image && (
      <Picture
        src={image}
        alt={alt}
        widths={[480, 720, 960, 1200]}
        sizes="(max-width: 860px) calc(100vw - 40px), 470px"
        formats={['avif', 'webp']}
        loading="eager"
        fetchpriority="high"
        class="svc-hero__img"
        style={`aspect-ratio:${aspect};object-position:${position}`}
        pictureAttributes={{ class: 'svc-hero__pic' }}
      />
    )}
  </div>
</section>

<style>
  .svc-hero { padding: 88px 0 96px; }
  .svc-hero--light { background: var(--linen); }
  .svc-hero--dark { background: var(--forest); color: var(--linen); }
  .svc-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: 64px;
    align-items: center;
  }
  .svc-hero__grid--solo { grid-template-columns: minmax(0, 1fr); }
  .svc-hero__copy { display: flex; flex-direction: column; align-items: flex-start; gap: 22px; }
  .svc-hero--dark .svc-hero__eyebrow { color: var(--sage); }
  .svc-hero__title {
    font-size: 62px;
    line-height: 1.03;
    letter-spacing: -0.018em;
    color: var(--forest);
    margin: 0;
  }
  .svc-hero--dark .svc-hero__title { color: var(--linen); }
  .svc-hero__lede { display: flex; flex-direction: column; gap: 14px; max-width: 600px; }
  .svc-hero__lede :global(p) {
    margin: 0;
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-900);
  }
  .svc-hero--dark .svc-hero__lede :global(p) { color: var(--on-forest); }
  .svc-hero__ctas { display: flex; flex-wrap: wrap; gap: 14px; margin-top: 6px; }
  .svc-hero__ctas:empty { display: none; }
  .svc-hero :global(.svc-hero__pic) { display: block; }
  .svc-hero :global(.svc-hero__img) {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: 2px;
  }
  @media (max-width: 860px) {
    .svc-hero { padding: 56px 0 64px; }
    .svc-hero__grid { grid-template-columns: 1fr; gap: 36px; }
    .svc-hero__title { font-size: 40px; max-width: none !important; }
    .svc-hero__lede :global(p) { font-size: 17px; }
  }
</style>
