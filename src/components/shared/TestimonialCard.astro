---
/**
 * One patient quote in the boards' staged style: serif text under a sage
 * opening mark, the reviewer's initials and "Verified Google review". Text is
 * verbatim, never reworded.
 */
export interface Props {
  quote: string;
  author: string;
  detail?: string;
}

const { quote, author, detail } = Astro.props;
---

<blockquote class="testimonial">
  <span class="testimonial__mark rd-serif" aria-hidden="true">“</span>
  <p class="testimonial__text rd-serif">{quote}</p>
  <footer class="testimonial__by">
    <strong>{author}</strong>
    {detail && <span> — {detail}</span>}
  </footer>
</blockquote>

<style>
  .testimonial { margin: 0; display: flex; flex-direction: column; gap: 14px; }
  .testimonial__mark { font-size: 64px; line-height: 0.6; color: var(--sage-mark); }
  .testimonial__text { margin: 0 !important; font-size: 19px !important; line-height: 1.5 !important; color: var(--forest) !important; }
  .testimonial__by { font-size: 13px; color: var(--sage-600); }
  .testimonial__by strong { color: var(--forest); font-weight: 600; }
</style>
