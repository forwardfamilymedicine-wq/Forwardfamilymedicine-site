---
/**
 * FAQ accordion: native <details>, plain summary with a "+" marker, hairline
 * rows; heading left, questions right. Props are unchanged so the thirteen
 * importers keep working: `label` is still accepted but no longer rendered
 * (section eyebrows were removed site-wide in the redesign). Answers render
 * as HTML; the FAQPage JSON-LD gets plain text via faqAnswerText.
 */
import { faqAnswerText } from '../../utils/faqSchema';

export interface FAQ {
  q: string;
  a: string;
}

export interface Props {
  faqs: FAQ[];
  headline?: string;
  label?: string;
  schema?: boolean;
}

const {
  faqs,
  headline = 'Frequently Asked Questions',
  schema = true,
} = Astro.props;

const faqSchema = schema ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": faqs.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faqAnswerText(f.a)
    }
  }))
} : null;
---

{faqSchema && (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
)}

<section class="faq-section rd-section">
  <div class="rd-wrap faq-inner">
    <div class="faq-head">
      <h2 class="rd-h2 faq-title">{headline}</h2>
    </div>
    <div class="faq-list">
      {faqs.map(faq => (
        <details class="faq-item">
          <summary>
            <span class="faq-q">{faq.q}</span>
            <span class="faq-mark" aria-hidden="true">+</span>
          </summary>
          <div class="faq-answer">
            <p set:html={faq.a}></p>
          </div>
        </details>
      ))}
      <slot />
    </div>
  </div>
</section>

<style>
  .faq-section { background: var(--linen); }
  .faq-inner {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 72px;
    align-items: start;
  }
  .faq-title { font-size: 40px; }
  .faq-list {
    border-top: 1px solid var(--hairline-strong);
    display: flex;
    flex-direction: column;
  }
  .faq-item { border-bottom: 1px solid var(--hairline-strong); }
  .faq-item summary {
    list-style: none;
    cursor: pointer;
    padding: 18px 0;
    font-size: 16px;
    font-weight: 500;
    color: var(--forest);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item summary:hover .faq-q { color: var(--sage-600); }
  .faq-mark {
    color: var(--sage-600);
    font-weight: 400;
    font-size: 20px;
    line-height: 1;
    flex-shrink: 0;
    transition: transform 0.2s;
  }
  .faq-item[open] .faq-mark { transform: rotate(45deg); }
  .faq-answer { padding: 0 0 18px; }
  .faq-answer p {
    font-size: 15px;
    line-height: 1.7;
    color: var(--text-700);
    margin: 0;
    max-width: 68ch;
  }
  .faq-answer :global(a) { color: var(--sage-600); }
  .faq-answer :global(a:hover) { color: var(--forest); }

  @media (max-width: 860px) {
    .faq-inner { grid-template-columns: 1fr; gap: 28px; }
    .faq-title { font-size: 30px; }
  }
</style>
