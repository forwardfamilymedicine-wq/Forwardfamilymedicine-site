---
/**
 * Team card, per the Team board: portrait left, then status line, name, role,
 * the first two credential lines and the "Meet Dr. X" link. Used on the Team
 * page and for "Physicians at This Location" on the office pages.
 *
 * Everything is read from the providers and team collections. A physician's
 * status line is derived in src/utils/availability.ts: "Accepting new patients
 * · Wayne", "Joining October 2026", or "Panel currently full" (no scheduling
 * invitation of any kind). A team member shows their location line, and their
 * job title (kept in `credentials`) after the name, as on the live page.
 */
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import { getAvailability } from '../../utils/availability';
import { physicianCredentialRows } from '../../utils/credentialRows';
import { awardLabel } from '../../utils/physicianSchema';

interface Props {
  provider: CollectionEntry<'providers'> | CollectionEntry<'team'>;
  noLink?: boolean;
  /** The card whose photo is the page's largest contentful paint: loaded eagerly, at high priority. */
  priority?: boolean;
  /** Open office named in the status line of an accepting physician. */
  office?: string;
  /** Heading level of the name: h2 under the page title, h3 under a section heading. */
  as?: 'h2' | 'h3';
}

const { provider, noLink = false, priority = false, office, as: Heading = 'h3' } = Astro.props;
const d = provider.data as any;
const isPhysician = provider.collection === 'providers';
const availability = isPhysician ? getAvailability(d) : null;
const isFull = availability?.status === 'full';

const status = !availability ? (d.title as string | undefined)
  : availability.status === 'full' ? 'Panel currently full'
  : availability.status === 'future' ? `Joining ${availability.startLabel}`
  : office ? `Accepting new patients · ${office}` : 'Accepting new patients';

const rows: string[] = (isPhysician
  ? [...physicianCredentialRows(d), ...(d.awards ?? []).map(awardLabel)]
  : (d.specialties ?? [])).slice(0, 2);
const first = d.name.split(' ')[0];
const ctaName = isPhysician ? `Dr. ${d.name.split(' ').pop()}` : first;
---

<article class="pcard">
  <div class="pcard__photo">
    {d.photo ? (
      <Image
        src={d.photo}
        alt={d.photoAlt || d.name}
        width={360}
        widths={[180, 360, 540]}
        sizes="(max-width: 860px) 140px, 180px"
        format="webp"
        quality={82}
        loading={priority ? 'eager' : 'lazy'}
        fetchpriority={priority ? 'high' : undefined}
        class="pcard__img"
      />
    ) : (
      <div class="pcard__img pcard__img--placeholder" role="img" aria-label="Photo coming soon"></div>
    )}
  </div>
  <div class="pcard__body">
    {status && <p class:list={['pcard__status', 'rd-eyebrow', { 'rd-eyebrow--gold': isPhysician && !isFull, 'pcard__status--full': isFull }]}>{status}</p>}
    <Heading class="pcard__name rd-serif">{d.name}{d.credentials ? `, ${d.credentials}` : ''}</Heading>
    {isPhysician && <p class="pcard__role">{d.title}</p>}
    {rows.length > 0 && <ul class="pcard__rows">{rows.map(r => <li>{r}</li>)}</ul>}
    {!noLink && <a href={`/meet-the-team/${d.slug}/`} class="rd-link pcard__cta">Meet {ctaName} →</a>}
  </div>
</article>

<style>
  .pcard { display: grid; grid-template-columns: 180px minmax(0, 1fr); gap: 26px; align-items: start; }
  .pcard__photo { min-width: 0; }
  .pcard :global(.pcard__img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 20%;
    border-radius: 2px;
    background: var(--linen-300);
  }
  .pcard__body { display: flex; flex-direction: column; gap: 9px; min-width: 0; }
  .pcard__body > :global(*) { margin: 0; }
  .pcard__status--full { color: var(--text-600); }
  .pcard__name { margin: 3px 0 0; font-size: 30px; line-height: 1.1; color: var(--forest); }
  .pcard__role { font-size: 14px; font-weight: 500; line-height: 1.5; color: var(--sage-600); }
  .pcard__rows {
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-direction: column;
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-700);
    border-bottom: 1px solid var(--hairline-strong);
  }
  .pcard__rows li { padding: 7px 0; border-top: 1px solid var(--hairline-strong); }
  .pcard__cta { align-self: flex-start; margin-top: 8px; }
  /* Two cards per row between 861 and 1100px leaves the text column narrow: smaller portrait and name. */
  @media (max-width: 1100px) {
    .pcard { grid-template-columns: 140px minmax(0, 1fr); gap: 20px; }
    .pcard__name { font-size: 26px; }
  }
  @media (max-width: 480px) {
    .pcard { grid-template-columns: 1fr; gap: 18px; }
    .pcard__photo { max-width: 200px; }
  }
</style>
