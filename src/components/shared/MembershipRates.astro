---
/**
 * Individual and family rates for the service pages. Every label and figure is
 * copied from /membership/, which remains the pricing page; change both
 * together. Board: a forest rule over each column, the individual price in a
 * large serif numeral, family tiers as a hairline definition list.
 */
const FAMILY_TIERS = [
  { size: '2 members', rate: '$175/person/month' },
  { size: '3 members', rate: '$150/person/month' },
  { size: '4 members', rate: '$125/person/month' },
  { size: '5+ members', rate: '$100/person/month' },
];
---
<div class="rates">
  <div class="rate-col rate-col--ind">
    <h3 class="rate-h">Individual Membership</h3>
    <p class="rate-price rd-serif">$200<span class="rate-unit">/month</span></p>
  </div>
  <div class="rate-col rate-col--fam">
    <h3 class="rate-h">Family Membership</h3>
    <dl class="rate-tiers">
      {FAMILY_TIERS.map(t => (
        <>
          <dt>{t.size}</dt>
          <dd>{t.rate}</dd>
        </>
      ))}
    </dl>
  </div>
</div>

<style>
  .rates { display: grid; grid-template-columns: 1fr 1fr; gap: 0; }
  .rate-col { border-top: 1px solid var(--forest); padding: 28px 0; display: flex; flex-direction: column; gap: 10px; }
  .rate-col--ind { padding-right: 32px; border-right: 1px solid var(--hairline-strong); }
  .rate-col--fam { padding-left: 32px; }
  .rate-h { margin: 0; font-size: 14px; font-weight: 600; color: var(--sage-600); }
  .rate-price { margin: 0; font-size: 52px; line-height: 1; letter-spacing: -0.02em; color: var(--forest); }
  .rate-unit { font-size: 18px; letter-spacing: 0; color: var(--text-600); }
  .rate-tiers { margin: 0; display: grid; grid-template-columns: 1fr auto; gap: 0; font-size: 15px; }
  .rate-tiers dt, .rate-tiers dd { margin: 0; padding: 10px 0; border-bottom: 1px solid var(--hairline-strong); }
  .rate-tiers dt { color: var(--text-700); }
  .rate-tiers dd { color: var(--forest); font-weight: 500; text-align: right; padding-left: 24px; }
  .rate-tiers dt:nth-last-of-type(1), .rate-tiers dd:last-of-type { border-bottom: 0; }
  @media (max-width: 860px) {
    .rates { grid-template-columns: 1fr; }
    .rate-col--ind { padding-right: 0; border-right: 0; padding-bottom: 20px; }
    .rate-col--fam { padding-left: 0; }
  }
</style>
