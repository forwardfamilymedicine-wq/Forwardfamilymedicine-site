# Copy this file to .env.local and fill in values for local development.
# .env.local is gitignored and never committed.

# Google Apps Script deployment URL for the Meet & Greet form
PUBLIC_GOOGLE_SCRIPT_URL=your_google_apps_script_url_here

# Meta Pixel ID for the paid-ad landing pages (/lp/). Leave empty and the
# Pixel never loads. In production this is the GitHub Actions repository
# variable PUBLIC_META_PIXEL_ID (Settings > Secrets and variables > Actions >
# Variables); the Pixel still loads only after a visitor consents to
# advertising.
PUBLIC_META_PIXEL_ID=
